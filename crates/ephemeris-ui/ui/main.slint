    // ── Drawing mode ─────────────────────────────────────────────────────
    // True when no overlay view is active (pure drawing canvas).
    // See-text is a reading view (nav visible); exclude it so chrome returns.
    private property <bool> is-obsidian-canvas-context:
        root.show-canvas-board && !root.canvas-focus-active;

    // Note ink page OR canvas text-card focus (modal ink over board).
    private property <bool> is-canvas-context:
        root.canvas-focus-active || (
        !root.show-start-page && !root.show-task-view &&
        !root.show-settings && !root.show-filebrowser &&
        !root.show-note-list && !root.show-notebook-list &&
        !root.show-canvas-folder-list && !root.show-canvas-list &&
        !root.show-canvas-board &&
        !root.show-calendar && !root.task-dialog-visible &&
        !root.note-rename-visible && !root.note-move-visible &&
        !root.notebook-rename-visible && !root.notebook-delete-visible &&
        !root.ring-visible &&
        !root.show-recording-list && !root.rec-rename-visible &&
        !root.rec-transcription-visible &&
        !root.show-profile-switcher && !root.profile-edit-dialog-visible &&
        !root.show-create-profile-picker && !root.connect-setup-visible &&
        !root.connect-soon-visible &&
        !root.show-search && !root.show-md-viewer &&
        !root.note-see-text);

