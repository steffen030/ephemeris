// Ephemeris main UI — eink-optimised layout (800 × 600 default)
//
// Layers (top → bottom in z-order):
//   1. Nav rail    — 80 px left strip: Home / Notes / Calendar / Settings
//   2. Canvas      — fills all remaining space (no chrome bars)
//   3. Overlays    — start page, note/task/settings/calendar views, action ring, dialogs

// Load Material Icons font (registers family "Material Icons" automatically).
import "fonts/MaterialIcons-Regular.otf";

// Material Icons codepoints (Unicode Private Use Area).
export global Icons {
    // Navigation
    out property <string> home:           "\u{E318}";  // home_baseline
    out property <string> notes:          "\u{E44C}";  // notes_baseline
    out property <string> calendar:       "\u{E122}";  // calendar_today_baseline
    out property <string> settings:       "\u{E57F}";  // settings_baseline
    // Drawing mode
    out property <string> menu:           "\u{E3DC}";  // menu_baseline (hamburger)
    out property <string> record-dot:     "\u{E265}";  // fiber_manual_record (record dot)
    out property <string> mic:            "\u{E3E1}";  // mic_baseline (true microphone)
    // Audio controls
    out property <string> pause:          "\u{E47C}";  // pause_baseline
    out property <string> play:           "\u{E4CB}";  // play_arrow_baseline
    // Actions
    out property <string> add:            "\u{E047}";  // add_baseline
    out property <string> edit:           "\u{E21A}";  // edit_baseline
    out property <string> rename:         "\u{E20B}";  // drive_file_rename_outline_baseline
    out property <string> delete:         "\u{E1B9}";  // delete_baseline
    out property <string> copy:           "\u{E190}";  // content_copy_baseline
    out property <string> move:           "\u{E45E}";  // open_with_baseline
    out property <string> back:           "\u{E092}";  // arrow_back_baseline
    out property <string> close:          "\u{E16A}";  // close_baseline
    out property <string> done:           "\u{E1F6}";  // done_baseline
    out property <string> refresh:        "\u{E5D5}";  // refresh_baseline
    out property <string> tasks:          "\u{E15B}";  // checklist_baseline
    // Calendar navigation
    out property <string> chevron-left:   "\u{E15E}";  // chevron_left_baseline
    out property <string> chevron-right:  "\u{E15F}";  // chevron_right_baseline
    out property <string> nav-prev:       "\u{E41C}";  // navigate_before_baseline
    out property <string> nav-next:       "\u{E41D}";  // navigate_next_baseline
    out property <string> today:          "\u{E66A}";  // today_baseline
    out property <string> date-range:     "\u{E1B6}";  // date_range_baseline
    out property <string> view-day:       "\u{E6B2}";  // view_day_baseline
    out property <string> view-week:      "\u{E6BA}";  // view_week_baseline
    out property <string> view-month:     "\u{E124}";  // calendar_view_month_baseline
    // Profile icons — Flutter Material Icons codepoints (this font's cmap).
    // Keys map to life scenarios; see profile_icon_char() in app.rs.
    out property <string> profile-work:     "\u{E11C}";  // business_center (briefcase)
    out property <string> profile-home:     "\u{E318}";  // home
    out property <string> profile-private:  "\u{E3AE}";  // lock
    out property <string> profile-person:   "\u{E491}";  // person
    out property <string> profile-kids:     "\u{E160}";  // child_care
    out property <string> profile-family:   "\u{E257}";  // family_restroom
    out property <string> profile-party:    "\u{E149}";  // celebration
    out property <string> profile-pets:     "\u{E4A1}";  // pets
    out property <string> profile-fitness:  "\u{E28D}";  // fitness_center
    out property <string> profile-music:    "\u{E415}";  // music_note
    out property <string> profile-cafe:     "\u{E38D}";  // local_cafe
    out property <string> profile-food:     "\u{E390}";  // local_restaurant
    out property <string> profile-travel:   "\u{E297}";  // flight
    out property <string> profile-beach:    "\u{E0D6}";  // beach_access
    out property <string> profile-creative: "\u{E46B}";  // palette
    out property <string> profile-code:     "\u{E176}";  // code
    out property <string> profile-night:    "\u{E42E}";  // nightlight
    out property <string> profile-group:    "\u{E2EB}";  // group
    out property <string> profile-school:   "\u{E3DD}";  // menu_book
    out property <string> profile-heart:    "\u{E25B}";  // favorite (legacy alias)
    out property <string> profile-run:      "\u{E1DC}";  // directions_run (legacy alias)
    out property <string> profile-flight:   "\u{E297}";  // flight (legacy alias → travel)
    // Connections / providers
    out property <string> link:           "\u{E157}";  // link
    // Folder / files — Flutter MaterialIcons cmap (verified via otfinfo/hb-shape).
    out property <string> folder:         "\u{E2A3}";  // folder_baseline
    out property <string> folder-open:    "\u{E2A4}";  // folder_open_baseline
    out property <string> create-folder:  "\u{E19E}";  // create_new_folder_baseline
    out property <string> cloud:          "\u{E2BD}";  // cloud
    out property <string> event-note:     "\u{E616}";  // event_note
    // Misc UI
    out property <string> expand-more:    "\u{E5CF}";  // expand_more
    out property <string> check-box:      "\u{E834}";  // check_box
    out property <string> check-box-out:  "\u{E835}";  // check_box_outline_blank
    out property <string> add-circle:     "\u{E147}";  // add_circle_outline
    out property <string> info:           "\u{E88E}";  // info
    out property <string> image:          "\u{E332}";  // image (custom icon affordance)
    out property <string> search:         "\u{E567}";  // search_baseline
    out property <string> view-list:      "\u{E6B5}";  // view_list_baseline
    out property <string> view-module:    "\u{E6B6}";  // view_module_baseline
    out property <string> grid-view:      "\u{E2EA}";  // grid_view_baseline
    out property <string> sort:           "\u{E5D2}";  // sort_baseline
    out property <string> note-add:       "\u{E44A}";  // note_add_baseline
}

/// A calendar day cell for the month grid.
export struct CalDay {
    day: int,
    has-events: bool,
    is-today: bool,
    in-month: bool,
    first-event-title: string,
}

/// A calendar event for day / week views.
export struct CalDayEvent {
    title: string,
    time-label: string,  // pre-formatted "09:30–10:00" or "All day"
    all-day: bool,
    col: int,            // 0–6 (day-of-week) for week view
}

/// One month summary for the year view.
export struct CalMonthInfo {
    name: string,
    short-name: string,
    event-count: int,
    month-num: int,
}

/// A ranked task row for the start page.
export struct TaskEntry {
    id: string,
    title: string,
    priority-label: string,
    due-label: string,
    overdue: bool,
}

/// A rendered markdown block for the vault note viewer.
export struct MdBlockEntry {
    kind: int,   // 0=h1 1=h2 2=h3 3=para 4=bullet 5=numbered 6=quote 7=code 8=rule
    text: string,
}

/// A calendar event row for the agenda view.
export struct AgendaEntry {
    title: string,
    time-label: string,
    location-label: string,
}

/// A task row for the full task CRUD view.
export struct TaskViewEntry {
    id: string,
    title: string,
    priority-label: string,
    priority-int: int,    // 0=high 1=medium 2=low
    due-label: string,
    overdue: bool,
    done: bool,
}

/// A filesystem entry for the settings file browser.
export struct FileBrowserEntry {
    name: string,
    full-path: string,
    is-dir: bool,
    is-vault: bool,
}

/// A configured calendar source (local file path or remote URL).
export struct CalSource {
    display: string,
    value: string,
}

/// A voice recording entry in the recordings browser.
export struct RecordingEntry {
    id: string,
    title: string,
    duration-label: string,
    date-label: string,
    has-transcription: bool,
}

/// A note entry in the note browser list / gallery.
export struct NoteEntry {
    id: string,
    title: string,
    date-label: string,
    has-preview: bool,
    preview: image,
    /// Show owning-profile badge (All aggregator view).
    show-profile: bool,
    profile-icon-char: string,
    has-custom-profile-icon: bool,
    custom-profile-icon: image,
}

/// A notebook / folder entry for the notes browser.
export struct NotebookEntry {
    id: string,
    title: string,
    note-count: int,
    /// Direct child folder count (for nested folders).
    folder-count: int,
    /// Show owning-profile badge (All aggregator view).
    show-profile: bool,
    profile-icon-char: string,
    has-custom-profile-icon: bool,
    custom-profile-icon: image,
}

/// A profile chip for the profile switcher.
export struct ProfileEntry {
    id: string,
    name: string,
    /// Icon key: life-scenario preset ("work", "kids", …) or "custom:/path".
    icon: string,
    /// Resolved Material Icons character (empty when has-custom-icon).
    icon-char: string,
    has-custom-icon: bool,
    custom-icon: image,
    notes-in-all: bool,
    recordings-in-all: bool,
}

/// A calendar / task connection bound to one profile.
export struct ConnectionEntry {
    id: string,
    kind: string,         // "calendar" | "vault" | "tasks"
    display: string,
    value: string,        // path or URL
    profile-id: string,   // owning profile id (never "All")
    profile-name: string, // resolved display name
    allow-in-aggregated: bool, // also visible in the All-profiles overview
}

/// A unified search result row.
export struct SearchHitEntry {
    id: string,
    source: string,       // "vault" | "local_note" | "task" | "calendar"
    title: string,
    snippet: string,
    path: string,
}

export global EinkTheme {
    in property <color> canvas-bg: white;
    in property <color> chrome-bg: white;
    in property <color> chrome-border: black;
    in property <color> btn-bg: white;
    in property <color> btn-fg: black;
    in property <color> btn-active-bg: black;
    in property <color> btn-active-fg: white;
    in property <color> btn-border: black;
    in property <color> text-secondary: black;
    in property <color> danger-fg: black;
}

/// Renders a profile icon — Material glyph or custom image.
component ProfileIcon inherits Rectangle {
    in property <string> icon-char: Icons.profile-person;
    in property <bool> has-custom: false;
    in property <image> custom-icon;
    in property <length> size: 22px;
    in property <color> fg: EinkTheme.btn-fg;
    width: size;
    height: size;
    background: transparent;

    if !has-custom: Text {
        width: parent.width; height: parent.height;
        text: root.icon-char;
        font-family: "Material Icons";
        font-size: root.size * 0.92;
        color: root.fg;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if has-custom: Image {
        width: parent.width; height: parent.height;
        source: root.custom-icon;
    }
}

export component EphemerisPage inherits Window {
    preferred-width:  800px;
    preferred-height: 600px;
    background: EinkTheme.canvas-bg;

    // ── Page metadata ────────────────────────────────────────────────────
    in property <string> page-title: "Untitled";
    in property <int> page-index: 1;
    in property <int> page-count: 1;

    // ── Active tool (pen / highlighter / eraser) ─────────────────────────
    in-out property <string> active-tool: "pen";

    // ── View visibility flags ────────────────────────────────────────────
    in property <bool> show-start-page: false;
    in property <bool> show-task-view: false;
    in property <bool> show-settings: false;
    in property <bool> show-filebrowser: false;
    in property <bool> show-note-list: false;
    in property <bool> show-notebook-list: false;
    in-out property <bool> show-search: false;
    in-out property <bool> show-md-viewer: false;

    // ── Task list (start page + CRUD view) ───────────────────────────────
    in property <[TaskEntry]> task-list: [];
    in-out property <int> agenda-range: 0;
    in property <[AgendaEntry]> agenda-list: [];
    callback agenda-range-changed(int);

    // ── Task CRUD view ───────────────────────────────────────────────────
    in property <[TaskViewEntry]> full-task-list: [];
    in-out property <bool> task-dialog-visible: false;
    in-out property <bool> task-dialog-is-edit: false;
    in-out property <string> task-dialog-id: "";
    in-out property <string> task-dialog-title: "";
    in-out property <int> task-dialog-priority: 1;
    in-out property <string> task-dialog-due: "";   // YYYY-MM-DD or empty
    in-out property <string> task-dialog-tags: "";  // space-separated tags
    in-out property <string> task-filter: "active";    // all | active | done
    in-out property <string> task-sort: "priority"; // priority | due | title | added
    // Local filter while aggregator ("All") is active — does not switch global profile.
    in-out property <string> task-profile-filter: "";
    in-out property <string> task-search-query: "";

    callback page-title-tapped();
    callback start-page-notes-tapped();
    callback start-page-tasks-tapped();
    callback task-back-tapped();
    callback task-complete-toggled(string);
    callback task-edit-requested(string);
    // title, priority, due (YYYY-MM-DD), tags (space-separated)
    callback task-confirm-add(string, int, string, string);
    // id, title, priority, due, tags
    callback task-confirm-edit(string, string, int, string, string);
    callback task-dialog-cancel();
    callback task-filter-changed(string);
    callback task-sort-changed(string);
    callback task-priority-cycle(string);
    callback task-profile-filter-changed(string);
    callback task-search-changed(string);

    // ── Action ring ──────────────────────────────────────────────────────
    in property <bool> ring-visible: false;
    in property <float> ring-cx: 400;
    in property <float> ring-cy: 300;
    in property <bool> ring-show-audio: true;

    callback ring-note-tapped();
    callback ring-calendar-tapped();
    callback ring-task-tapped();
    callback ring-audio-tapped();
    callback ring-pen-tapped();
    callback ring-highlighter-tapped();
    callback ring-eraser-tapped();
    callback ring-clear-tapped();
    callback ring-dismissed();

    // ── Drawing mode ─────────────────────────────────────────────────────
    // True when no overlay view is active (pure drawing canvas).
    // See-text is a reading view (nav visible); exclude it so chrome returns.
    private property <bool> is-canvas-context:
        !root.show-start-page && !root.show-task-view &&
        !root.show-settings && !root.show-filebrowser &&
        !root.show-note-list && !root.show-notebook-list &&
        !root.show-calendar && !root.task-dialog-visible &&
        !root.note-rename-visible && !root.note-move-visible &&
        !root.notebook-rename-visible && !root.notebook-delete-visible &&
        !root.ring-visible &&
        !root.show-recording-list && !root.rec-rename-visible &&
        !root.rec-transcription-visible &&
        !root.show-profile-switcher && !root.profile-edit-dialog-visible &&
        !root.show-create-profile-picker && !root.connect-setup-visible &&
        !root.connect-soon-visible &&
        !root.show-search && !root.show-md-viewer &&
        !root.note-see-text;

    // ── Unified search ───────────────────────────────────────────────────
    in-out property <string> search-query: "";
    in property <[SearchHitEntry]> search-results: [];
    /// Status line under the search field (vault path / index size / errors).
    in-out property <string> search-status: "";
    callback search-open();
    callback search-back();
    callback search-query-changed(string);
    // Pass the query explicitly — two-way binding may lag behind Enter/Go.
    callback search-submit(string);
    callback search-result-tapped(string, string); // id, source

    // Markdown / vault note viewer
    in-out property <string> md-viewer-title: "";
    in-out property <string> md-viewer-body: "";
    in-out property <string> md-viewer-path: "";
    in property <[MdBlockEntry]> md-viewer-blocks: [];
    callback md-viewer-back();

    in-out property <bool> drawing-menu-open: false;
    in-out property <string> active-paper: "blank";
    // See-text: overlay machine-readable / OCR text for the current note.
    in-out property <bool> note-see-text: false;
    in-out property <string> note-text-content: "";

    callback notebook-quick-new-note(string);
    callback paper-type-tapped(string);
    callback rename-canvas-note();
    callback note-see-text-toggled(bool);

    // ── Settings view ────────────────────────────────────────────────────
    in-out property <int> settings-theme-idx: 0;
    // When true, note canvas ink accepts pen (and desktop mouse) only — not finger.
    in-out property <bool> settings-pen-only: true;
    in property <string> settings-vault-path: "";
    in property <[CalSource]> settings-cal-sources: [];
    in-out property <string> settings-new-url: "";

    callback settings-open();
    callback settings-back();
    callback settings-save();
    callback settings-clear-vault();
    callback settings-browse-vault();
    callback settings-browse-ics();
    callback settings-add-url(string);
    callback settings-remove-source(int);
    callback settings-whisper-download();
    callback settings-whisper-delete();

    in property <bool> whisper-model-installed: false;
    in property <bool> whisper-downloading: false;
    in-out property <string> whisper-lang: "auto";

    // ── File browser ─────────────────────────────────────────────────────
    // 0 = vault folder, 1 = ICS file, 2 = profile icon image
    in property <int> fb-mode: 0;
    in property <bool> fb-vault-mode: true; // legacy mirror of fb-mode == 0
    in property <string> fb-current-path: "";
    in property <[FileBrowserEntry]> fb-entries: [];

    callback fb-navigate(string);
    callback fb-select-vault(string);
    callback fb-add-ics(string);
    callback fb-select-profile-icon(string);
    callback fb-cancel();

    // ── Navigation rail ──────────────────────────────────────────────────
    property <length> nav-w: 80px;
    in-out property <int> nav-section: 0;

    callback nav-overview-tapped();
    callback nav-notes-tapped();
    callback nav-tasks-tapped();

    // ── Notebook / folder browser ────────────────────────────────────────
    /// All notebooks (flat) — used by the move-note dialog.
    in property <[NotebookEntry]> notebook-list: [];
    /// Child folders at the current browser level.
    in property <[NotebookEntry]> folder-list: [];
    in-out property <string> active-notebook-id: "";
    in-out property <string> active-notebook-title: "Notes";
    /// True when browsing the root notes level (no parent folder).
    in-out property <bool> notes-at-root: true;
    /// "list" or "gallery"
    in-out property <string> notes-view-mode: "list";
    /// "edited" (default) | "created" | "title"
    in-out property <string> notes-sort-mode: "edited";
    /// Filter notes in the current folder by title + transcribed text.
    in-out property <string> notes-search-query: "";

    callback notebook-tapped(string);
    callback notebook-new-tapped();
    callback notebook-back-tapped();
    /// Request delete (may open confirm if folder has content).
    callback notebook-delete-tapped(string);
    callback notebook-delete-confirm(string);
    callback notebook-delete-cancel();

    // ── Folder delete confirmation ────────────────────────────────────────
    in-out property <bool> notebook-delete-visible: false;
    in-out property <string> notebook-delete-id: "";
    in-out property <string> notebook-delete-title: "";
    in-out property <string> notebook-delete-message: "";

    // ── Note browser ─────────────────────────────────────────────────────
    in property <[NoteEntry]> note-list: [];
    in-out property <string> active-note-id: "";

    callback note-tapped(string);
    callback note-new-tapped();
    callback note-delete-tapped(string);
    callback notes-view-mode-toggled();
    callback notes-sort-cycled();
    callback notes-search-changed(string);

    // ── Note rename dialog ────────────────────────────────────────────────
    in-out property <bool> note-rename-visible: false;
    in-out property <string> note-rename-id: "";
    in-out property <string> note-rename-title: "";

    callback note-rename-confirm(string, string);
    callback note-rename-cancel();

    // ── Note move dialog ──────────────────────────────────────────────────
    in-out property <bool> note-move-visible: false;
    in-out property <string> note-move-note-id: "";

    callback note-move-confirm(string, string);
    callback note-move-cancel();

    // ── Notebook rename / new-folder dialog ───────────────────────────────
    in-out property <bool> notebook-rename-visible: false;
    in-out property <string> notebook-rename-id: "";
    in-out property <string> notebook-rename-title: "";
    /// When true, dialog creates a folder on confirm instead of renaming.
    in-out property <bool> notebook-rename-is-create: false;
    /// Profile id for a pending new folder (set before showing create dialog).
    in-out property <string> notebook-create-profile-id: "";

    callback notebook-rename-confirm(string, string);
    callback notebook-rename-cancel();

    // ── Recordings ────────────────────────────────────────────────────────────
    in property <bool> has-mic: false;
    in property <bool> show-recording-list: false;
    in property <[RecordingEntry]> recording-list: [];

    // 0 = idle, 1 = recording, 2 = paused
    in property <int> rec-state: 0;
    in property <string> rec-duration-label: "0:00";

    in-out property <bool> rec-rename-visible: false;
    in-out property <string> rec-rename-id: "";
    in-out property <string> rec-rename-title: "";

    in-out property <bool> rec-transcription-visible: false;
    in-out property <string> rec-transcription-text: "";
    in-out property <string> rec-active-id: "";

    callback nav-rec-tapped();
    callback rec-new-tapped();
    callback rec-pause-tapped();
    callback rec-resume-tapped();
    callback rec-stop-tapped();
    callback rec-discard-tapped();
    callback rec-play-tapped(string);
    callback rec-transcribe-tapped(string);
    callback rec-delete-tapped(string);
    callback rec-rename-confirm(string, string);
    callback rec-rename-cancel();
    callback rec-transcription-close();
    callback rec-transcription-save(string);
    callback rec-transcription-retranscribe();

    // ── Calendar view ─────────────────────────────────────────────────────
    in property <bool> show-calendar: false;
    in-out property <int> cal-sub-view: 2;        // 0=day 1=week 2=month 3=year
    in property <int> cal-year: 2026;
    in property <int> cal-month: 9;
    in property <int> cal-day: 21;
    in property <string> cal-header-label: "September 2026";
    in property <[CalDay]> cal-month-days: [];
    in property <[CalDayEvent]> cal-events: [];
    in property <[string]> cal-week-day-labels: [];  // 7 labels "Mon\n21" etc.
    in property <[CalMonthInfo]> cal-year-months: [];

    callback nav-calendar-tapped();
    callback cal-sub-view-changed(int);
    callback cal-prev();
    callback cal-next();
    callback cal-today();
    callback cal-day-tapped(int, int, int);   // year, month, day

    // ── Calendar day-note link ────────────────────────────────────────────
    in property <bool> cal-day-note-exists: false;
    in property <string> cal-day-note-id: "";
    callback cal-open-day-note(int, int, int);  // year, month, day

    // ── Note anchor (backlink from note canvas to calendar day) ──────────
    in property <string> note-anchor-label: "";  // e.g. "Sep 23, 2026"
    callback note-anchor-tapped();

    // ── Profile switcher ─────────────────────────────────────────────────────
    in property <[ProfileEntry]> profile-list: [];
    in-out property <string> active-profile-id: "";  // "" = All profiles
    in-out property <bool> show-profile-switcher: false;
    // Resolved icon for the currently active profile (set by backend).
    in property <string> active-profile-icon-char: Icons.profile-group;
    in property <bool> active-profile-has-custom: false;
    in property <image> active-profile-custom-icon;
    // Resolved display name for the currently active profile (set by backend). "" means "All".
    in property <string> active-profile-name: "";
    callback profile-changed(string);

    // ── Settings section navigation (0=general 1=profiles 2=connections) ────
    in-out property <int> settings-section: 0;

    // ── Profile management (settings › Profiles) ──────────────────────────
    in-out property <bool> profile-edit-dialog-visible: false;
    in-out property <bool> profile-edit-is-new: true;
    in-out property <string> profile-edit-id: "";
    in-out property <string> profile-edit-name: "";
    in-out property <string> profile-edit-icon: "person";
    in-out property <bool> profile-edit-has-custom: false;
    in-out property <image> profile-edit-custom-image;
    // Preview glyph for the selected preset (ignored when custom).
    private property <string> profile-edit-icon-char:
        root.profile-edit-icon == "work" ? Icons.profile-work :
        root.profile-edit-icon == "home" ? Icons.profile-home :
        root.profile-edit-icon == "private" ? Icons.profile-private :
        root.profile-edit-icon == "kids" ? Icons.profile-kids :
        root.profile-edit-icon == "family" ? Icons.profile-family :
        root.profile-edit-icon == "party" ? Icons.profile-party :
        root.profile-edit-icon == "pets" ? Icons.profile-pets :
        root.profile-edit-icon == "fitness" ? Icons.profile-fitness :
        root.profile-edit-icon == "music" ? Icons.profile-music :
        root.profile-edit-icon == "cafe" ? Icons.profile-cafe :
        root.profile-edit-icon == "food" ? Icons.profile-food :
        root.profile-edit-icon == "travel" ? Icons.profile-travel :
        root.profile-edit-icon == "beach" ? Icons.profile-beach :
        root.profile-edit-icon == "creative" ? Icons.profile-creative :
        root.profile-edit-icon == "code" ? Icons.profile-code :
        root.profile-edit-icon == "night" ? Icons.profile-night :
        root.profile-edit-icon == "group" ? Icons.profile-group :
        root.profile-edit-icon == "school" ? Icons.profile-school :
        root.profile-edit-icon == "heart" ? Icons.profile-heart :
        root.profile-edit-icon == "run" ? Icons.profile-run :
        root.profile-edit-icon == "flight" ? Icons.profile-flight :
        Icons.profile-person;

    callback settings-profile-add(string, string);         // name, icon
    callback settings-profile-edit(string, string, string); // id, name, icon
    callback settings-profile-delete(string);              // id
    callback settings-profile-toggle-notes-in-all(string);       // id
    callback settings-profile-toggle-recordings-in-all(string);  // id
    callback settings-browse-profile-icon();               // open image picker for custom icon

    // ── Create-in-profile picker ───────────────────────────────────────────
    in-out property <bool> show-create-profile-picker: false;
    in-out property <string> create-picker-intent: "";  // "note" | "notebook" | "rec"
    callback create-profile-picked(string, string);     // (intent, profile-id)
    callback create-profile-pick-cancel();

    // ── Connections management (settings › Connect) ───────────────────────
    // Profile being configured for connections — never "" (All). Empty only
    // when no profiles exist yet.
    in-out property <string> connect-profile-id: "";
    in property <bool> connect-has-vault: false;
    in property <int> connect-calendar-count: 0;
    in property <[ConnectionEntry]> connection-list: [];

    // Setup modal: "vault" | "calendar"
    in-out property <bool> connect-setup-visible: false;
    in-out property <string> connect-setup-kind: "";
    in-out property <string> connect-setup-url: "";
    // Coming-soon info modal
    in-out property <bool> connect-soon-visible: false;
    in-out property <string> connect-soon-title: "";
    in-out property <string> connect-soon-body: "";

    callback connect-profile-changed(string);  // selected profile for Connect tab
    callback connection-add(string, string, string, bool);        // kind, display, value, allow_agg
    callback connection-remove(int);
    callback connection-set-profile(int, string);  // index, profile_id
    callback connection-toggle-aggregated(int);    // index
    callback connection-cycle-profile(int);        // retained for API compat; unused in new UI

    // ── Swipe detection ──────────────────────────────────────────────────
    private property <float> swipe-start-x: 0;
    private property <float> swipe-start-y: 0;
    private property <float> swipe-threshold: 50;

    callback canvas-touch(float, float);
    callback swipe-left();
    callback swipe-right();
    callback tool-selected(string);
    callback clear-page();

    // ── Canvas ───────────────────────────────────────────────────────────
    canvas := Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: EinkTheme.canvas-bg;
        clip: true;

        TouchArea {
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.swipe-start-x = self.mouse-x / 1px;
                    root.swipe-start-y = self.mouse-y / 1px;
                    root.canvas-touch(self.mouse-x / 1px, self.mouse-y / 1px);
                } else if (event.kind == PointerEventKind.up) {
                    if (
                        (self.mouse-x / 1px - root.swipe-start-x >= root.swipe-threshold ||
                         root.swipe-start-x - self.mouse-x / 1px >= root.swipe-threshold) &&
                        ((self.mouse-x / 1px - root.swipe-start-x) * (self.mouse-x / 1px - root.swipe-start-x) >
                         (self.mouse-y / 1px - root.swipe-start-y) * (self.mouse-y / 1px - root.swipe-start-y))
                    ) {
                        if (self.mouse-x / 1px > root.swipe-start-x) {
                            root.swipe-right();
                        } else {
                            root.swipe-left();
                        }
                    }
                }
            }
        }
    }

    // ── Start page ───────────────────────────────────────────────────────
    start-page := Rectangle {
        visible: root.show-start-page;
        x: root.nav-w;
        y: 0;
        width: parent.width - root.nav-w;
        height: parent.height;
        background: EinkTheme.canvas-bg;
        clip: true;

        Flickable {
            width: parent.width;
            height: parent.height;
            content-width: parent.width;
            content-height: start-page-col.preferred-height;

            start-page-col := VerticalLayout {
                padding: 16px;
                spacing: 0px;
                width: start-page.width;

                Rectangle {
                    height: 44px;
                    background: transparent;
                    HorizontalLayout {
                        alignment: space-between;
                        padding-top: 4px;
                        padding-bottom: 4px;

                        Text {
                            text: "Tasks Ahead";
                            font-size: 18px;
                            font-weight: 700;
                            color: EinkTheme.btn-fg;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            width: 96px; height: 36px;
                            background: EinkTheme.btn-bg;
                            border-radius: 4px;
                            border-width: 2px;
                            border-color: EinkTheme.btn-border;
                            Text {
                                text: "All Tasks \u{2192}";
                                font-size: 13px;
                                color: EinkTheme.btn-fg;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            TouchArea { clicked => { root.start-page-tasks-tapped(); } }
                        }
                    }
                }

                Rectangle { height: 2px; background: EinkTheme.chrome-border; }

                // Profile chips only in aggregator ("All") — filter Tasks Ahead, do not switch profile
                if root.active-profile-id == "": Rectangle {
                    height: 40px;
                    background: transparent;
                    HorizontalLayout {
                        padding-left: 4px; padding-right: 4px;
                        padding-top: 4px; padding-bottom: 4px;
                        spacing: 6px; alignment: start;

                        Rectangle {
                            property <bool> sel: root.task-profile-filter == "";
                            width: 44px; height: 32px;
                            background: sel ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                            border-radius: 16px; border-width: 2px;
                            border-color: EinkTheme.btn-border;
                            Text { text: "All"; font-size: 11px;
                                   color: sel ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                                   horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea {
                                clicked => {
                                    root.task-profile-filter = "";
                                    root.task-profile-filter-changed("");
                                }
                            }
                        }

                        for p in root.profile-list: Rectangle {
                            property <bool> sel: root.task-profile-filter == p.id;
                            width: 100px; height: 32px;
                            background: sel ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                            border-radius: 16px; border-width: 2px;
                            border-color: EinkTheme.btn-border;
                            HorizontalLayout {
                                padding-left: 6px; padding-right: 8px;
                                spacing: 4px; alignment: center;
                                ProfileIcon {
                                    icon-char: p.icon-char; has-custom: p.has-custom-icon; custom-icon: p.custom-icon;
                                    size: 16px; fg: sel ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                                }
                                Text { text: p.name; font-size: 11px;
                                       color: sel ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                                       vertical-alignment: center; overflow: elide; }
                            }
                            TouchArea {
                                clicked => {
                                    root.task-profile-filter = p.id;
                                    root.task-profile-filter-changed(p.id);
                                }
                            }
                        }
                    }
                }

                // Compact actionable task rows: check + priority + title + due.
                for item[i] in root.task-list: Rectangle {
                    height: 56px;
                    width: start-page.width - 32px;
                    background: transparent;

                    HorizontalLayout {
                        padding-left: 4px; padding-right: 4px;
                        spacing: 8px; alignment: start;

                        Rectangle {
                            width: 26px; height: 26px;
                            y: 15px;
                            border-radius: 4px; border-width: 2px;
                            border-color: EinkTheme.btn-border;
                            background: transparent;
                            TouchArea {
                                width: parent.width; height: parent.height;
                                clicked => { root.task-complete-toggled(item.id); }
                            }
                        }

                        Rectangle {
                            width: 28px; height: 22px;
                            y: 17px;
                            border-radius: 3px;
                            border-width: 1px;
                            border-color: EinkTheme.btn-border;
                            background: EinkTheme.btn-bg;
                            Text {
                                width: parent.width; height: parent.height;
                                text: item.priority-label;
                                font-size: 11px; font-weight: 700;
                                color: EinkTheme.btn-fg;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            background: transparent;
                            VerticalLayout {
                                spacing: 2px; alignment: center;
                                Text {
                                    text: item.title;
                                    font-size: 13px;
                                    color: EinkTheme.btn-fg;
                                    overflow: elide;
                                }
                                if item.due-label != "": Text {
                                    text: item.due-label;
                                    font-size: 11px;
                                    color: item.overdue ? EinkTheme.danger-fg : EinkTheme.text-secondary;
                                }
                            }
                            TouchArea {
                                width: parent.width; height: parent.height;
                                clicked => { root.task-edit-requested(item.id); }
                            }
                        }
                    }

                    Rectangle {
                        x: 0; y: parent.height - 1px;
                        width: parent.width; height: 1px;
                        background: EinkTheme.chrome-border;
                        opacity: 0.3;
                    }
                }

                if root.task-list.length == 0: Rectangle {
                    height: 64px;
                    background: transparent;
                    Text {
                        text: "All clear — no tasks ahead";
                        font-size: 14px;
                        color: EinkTheme.text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle { height: 12px; background: transparent; }

                Rectangle {
                    height: 36px;
                    background: transparent;
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;

                        Text {
                            text: "Agenda";
                            font-size: 16px;
                            font-weight: 700;
                            color: EinkTheme.btn-fg;
                            vertical-alignment: center;
                            width: 70px;
                        }

                        Rectangle {
                            width: 44px; height: 28px;
                            background: root.agenda-range == 0 ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                            border-radius: 4px;
                            border-width: 2px;
                            border-color: EinkTheme.btn-border;
                            Text {
                                text: "Day";
                                font-size: 12px;
                                color: root.agenda-range == 0 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            TouchArea { clicked => { root.agenda-range = 0; root.agenda-range-changed(0); } }
                        }

                        Rectangle {
                            width: 52px; height: 28px;
                            background: root.agenda-range == 1 ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                            border-radius: 4px;
                            border-width: 2px;
                            border-color: EinkTheme.btn-border;
                            Text {
                                text: "Week";
                                font-size: 12px;
                                color: root.agenda-range == 1 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            TouchArea { clicked => { root.agenda-range = 1; root.agenda-range-changed(1); } }
                        }

                        Rectangle {
                            width: 58px; height: 28px;
                            background: root.agenda-range == 2 ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                            border-radius: 4px;
                            border-width: 2px;
                            border-color: EinkTheme.btn-border;
                            Text {
                                text: "Month";
                                font-size: 12px;
                                color: root.agenda-range == 2 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            TouchArea { clicked => { root.agenda-range = 2; root.agenda-range-changed(2); } }
                        }
                    }
                }

                Rectangle { height: 2px; background: EinkTheme.chrome-border; }

                for item[i] in root.agenda-list: Rectangle {
                    height: 48px;
                    width: start-page.width - 32px;
                    background: transparent;

                    HorizontalLayout {
                        padding-left: 4px;
                        padding-right: 4px;
                        spacing: 8px;
                        alignment: start;

                        Text {
                            text: item.time-label;
                            font-size: 12px;
                            color: EinkTheme.text-secondary;
                            vertical-alignment: center;
                            width: 64px;
                        }

                        Text {
                            text: item.title;
                            font-size: 14px;
                            color: EinkTheme.btn-fg;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }

                        Text {
                            text: item.location-label;
                            font-size: 11px;
                            color: EinkTheme.text-secondary;
                            vertical-alignment: center;
                            width: 100px;
                            overflow: elide;
                            horizontal-alignment: right;
                        }
                    }

                    Rectangle {
                        x: 0; y: parent.height - 1px;
                        width: parent.width; height: 1px;
                        background: EinkTheme.chrome-border;
                        opacity: 0.3;
                    }
                }

                if root.agenda-list.length == 0: Rectangle {
                    height: 48px;
                    background: transparent;
                    Text {
                        text: "No events in this period";
                        font-size: 13px;
                        color: EinkTheme.text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    // ── Task page ─────────────────────────────────────────────────────────
    task-view := Rectangle {
        visible: root.show-task-view;
        x: root.nav-w; y: 0;
        width: parent.width - root.nav-w;
        height: parent.height;
        background: EinkTheme.canvas-bg;
        clip: true;

        VerticalLayout {
            padding: 0px; spacing: 0px;
            alignment: stretch;

            // ── Header ──────────────────────────────────────────────────
            Rectangle {
                height: 44px;
                background: EinkTheme.canvas-bg;
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px;
                    padding-top: 6px; padding-bottom: 6px;
                    spacing: 8px;

                    Rectangle {
                        width: 40px; height: 32px;
                        background: transparent;
                        Text {
                            text: Icons.back;
                            font-family: "Material Icons"; font-size: 22px;
                            color: EinkTheme.btn-fg;
                            horizontal-alignment: center; vertical-alignment: center;
                            width: parent.width; height: parent.height;
                        }
                        TouchArea { clicked => { root.task-back-tapped(); } }
                    }

                    Text {
                        text: "Tasks";
                        font-size: 16px; font-weight: 700;
                        color: EinkTheme.btn-fg;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        horizontal-alignment: center;
                    }

                    Rectangle {
                        width: 60px; height: 32px;
                        background: EinkTheme.btn-active-bg;
                        border-radius: 4px; border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        Text { text: "+ Add"; font-size: 13px; color: EinkTheme.btn-active-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea {
                            clicked => {
                                root.task-dialog-is-edit = false;
                                root.task-dialog-id = "";
                                root.task-dialog-title = "";
                                root.task-dialog-priority = 1;
                                root.task-dialog-due = "";
                                root.task-dialog-tags = "";
                                root.task-dialog-visible = true;
                            }
                        }
                    }
                }
            }

            Rectangle { height: 2px; background: EinkTheme.chrome-border; }

            // ── Task search (tasks only) ─────────────────────────────────
            Rectangle {
                height: 44px;
                background: EinkTheme.canvas-bg;
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px;
                    padding-top: 6px; padding-bottom: 6px;
                    spacing: 8px;

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 32px;
                        border-radius: 4px; border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        background: EinkTheme.canvas-bg;
                        task-search-input := TextInput {
                            x: 8px; width: parent.width - 16px; height: parent.height;
                            text <=> root.task-search-query;
                            font-size: 13px; color: EinkTheme.btn-fg;
                            single-line: true;
                            vertical-alignment: center;
                            edited => { root.task-search-changed(self.text); }
                            accepted => { root.task-search-changed(self.text); }
                        }
                    }
                    Rectangle {
                        width: 56px; height: 32px;
                        background: EinkTheme.btn-active-bg;
                        border-radius: 4px; border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        Text {
                            text: "Go";
                            font-size: 13px; color: EinkTheme.btn-active-fg;
                            horizontal-alignment: center; vertical-alignment: center;
                            width: parent.width; height: parent.height;
                        }
                        TouchArea {
                            clicked => { root.task-search-changed(task-search-input.text); }
                        }
                    }
                }
            }

            // ── Filter bar ──────────────────────────────────────────────
            Rectangle {
                height: 40px;
                background: EinkTheme.canvas-bg;
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px;
                    padding-top: 4px; padding-bottom: 4px;
                    spacing: 6px;

                    for f in ["all", "active", "done"]: Rectangle {
                        property <bool> sel: root.task-filter == f;
                        property <string> lbl: f == "all" ? "All"
                            : f == "active" ? "Active" : "Done";
                        width: 64px; height: 32px;
                        background: sel ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        Text { text: lbl; font-size: 13px;
                               color: sel ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => {
                            root.task-filter = f;
                            root.task-filter-changed(f);
                        } }
                    }

                    Rectangle { horizontal-stretch: 1; }
                }
            }

            // ── Sort bar ────────────────────────────────────────────────
            Rectangle {
                height: 36px;
                background: EinkTheme.canvas-bg;
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px;
                    padding-top: 2px; padding-bottom: 2px;
                    spacing: 4px;

                    Text {
                        text: "Sort:";
                        font-size: 12px; color: EinkTheme.text-secondary;
                        vertical-alignment: center;
                        width: 34px;
                    }

                    for s in ["priority", "due", "title", "added"]: Rectangle {
                        property <bool> sel: root.task-sort == s;
                        property <string> lbl: s == "priority" ? "Priority"
                            : s == "due" ? "Due" : s == "title" ? "Title" : "Added";
                        height: 28px; width: lbl == "Priority" ? 68px : 52px;
                        background: sel ? EinkTheme.btn-active-bg : transparent;
                        border-radius: 4px; border-width: sel ? 2px : 1px;
                        border-color: EinkTheme.btn-border;
                        Text { text: lbl; font-size: 11px;
                               color: sel ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => {
                            root.task-sort = s;
                            root.task-sort-changed(s);
                        } }
                    }

                    Rectangle { horizontal-stretch: 1; }
                }
            }

            Rectangle { height: 2px; background: EinkTheme.chrome-border; }

            // Profile chips only in aggregator ("All") — filter list, do not switch profile
            if root.active-profile-id == "": Rectangle {
                height: 40px;
                background: transparent;
                HorizontalLayout {
                    padding-left: 12px; padding-right: 4px;
                    padding-top: 4px; padding-bottom: 4px;
                    spacing: 6px; alignment: center;

                    Rectangle {
                        property <bool> sel: root.task-profile-filter == "";
                        width: 44px; height: 32px;
                        background: sel ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                        border-radius: 16px; border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        Text { text: "All"; font-size: 11px;
                               color: sel ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                               horizontal-alignment: center; vertical-alignment: center;
                               width: parent.width; height: parent.height; }
                        TouchArea {
                            clicked => {
                                root.task-profile-filter = "";
                                root.task-profile-filter-changed("");
                            }
                        }
                    }

                    for p in root.profile-list: Rectangle {
                        property <bool> sel: root.task-profile-filter == p.id;
                        width: 100px; height: 32px;
                        background: sel ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                        border-radius: 16px; border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        HorizontalLayout {
                            padding-left: 6px; padding-right: 8px;
                            spacing: 4px; alignment: center;
                            ProfileIcon {
                                icon-char: p.icon-char; has-custom: p.has-custom-icon; custom-icon: p.custom-icon;
                                size: 16px; fg: sel ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                            }
                            Text { text: p.name; font-size: 11px;
                                   color: sel ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                                   vertical-alignment: center; overflow: elide; }
                        }
                        TouchArea {
                            clicked => {
                                root.task-profile-filter = p.id;
                                root.task-profile-filter-changed(p.id);
                            }
                        }
                    }
                }
            }

            Flickable {
                vertical-stretch: 1;
                content-width: root.width - root.nav-w;
                content-height: task-list-col.preferred-height;

                task-list-col := VerticalLayout {
                    spacing: 0px;
                    width: root.width - root.nav-w;

                    // check | prio chip | wrapping title | due | edit
                    for item[i] in root.full-task-list: Rectangle {
                        height: 64px;
                        width: root.width - root.nav-w;
                        background: EinkTheme.canvas-bg;

                        property <length> pad: 12px;
                        property <length> check-w: 26px;
                        property <length> prio-w: 28px;
                        property <length> due-w: 56px;
                        property <length> edit-w: 32px;
                        property <length> gap: 8px;
                        property <length> x-check: self.pad;
                        property <length> x-prio: self.pad + self.check-w + self.gap;
                        property <length> x-title: self.x-prio + self.prio-w + self.gap;
                        property <length> x-edit: self.width - self.pad - self.edit-w;
                        property <length> x-due: self.x-edit - self.gap - self.due-w;
                        property <length> title-w: self.x-due - self.x-title - self.gap;

                        Rectangle {
                            x: x-check;
                            y: 18px;
                            width: check-w; height: check-w;
                            border-radius: 4px; border-width: 2px;
                            border-color: EinkTheme.btn-border;
                            background: item.done ? EinkTheme.btn-active-bg : transparent;
                            Text {
                                text: item.done ? Icons.done : "";
                                font-family: "Material Icons";
                                font-size: 16px; color: EinkTheme.btn-active-fg;
                                horizontal-alignment: center; vertical-alignment: center;
                                width: parent.width; height: parent.height;
                            }
                            TouchArea { clicked => { root.task-complete-toggled(item.id); } }
                        }

                        Rectangle {
                            x: x-prio; y: 18px;
                            width: prio-w; height: 22px;
                            border-radius: 3px;
                            border-width: 1px;
                            border-color: EinkTheme.btn-border;
                            background: item.priority-int == 0 ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                            Text {
                                width: parent.width; height: parent.height;
                                text: item.priority-label;
                                font-size: 11px; font-weight: 700;
                                color: item.priority-int == 0 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                                horizontal-alignment: center; vertical-alignment: center;
                            }
                            TouchArea { clicked => { root.task-priority-cycle(item.id); } }
                        }

                        Text {
                            x: x-title; y: 8px;
                            width: title-w > 40px ? title-w : 40px;
                            height: 48px;
                            text: item.title;
                            font-size: 13px;
                            color: item.done ? EinkTheme.text-secondary : EinkTheme.btn-fg;
                            wrap: word-wrap;
                            overflow: elide;
                            vertical-alignment: top;
                        }

                        Text {
                            x: x-due; y: 12px;
                            width: due-w;
                            text: item.due-label;
                            font-size: 11px;
                            color: item.overdue ? EinkTheme.danger-fg : EinkTheme.text-secondary;
                            horizontal-alignment: right;
                        }

                        Text {
                            x: x-edit; y: 0;
                            width: edit-w; height: parent.height;
                            text: Icons.edit;
                            font-family: "Material Icons";
                            font-size: 18px; color: EinkTheme.text-secondary;
                            horizontal-alignment: center; vertical-alignment: center;
                            TouchArea { clicked => { root.task-edit-requested(item.id); } }
                        }

                        Rectangle {
                            x: 0; y: parent.height - 1px;
                            width: parent.width; height: 1px;
                            background: EinkTheme.chrome-border; opacity: 0.3;
                        }
                    }

                    if root.full-task-list.length == 0: Rectangle {
                        height: 60px;
                        width: root.width - root.nav-w;
                        background: transparent;
                        Text {
                            text: "No tasks — tap + Add to create one";
                            font-size: 14px; color: EinkTheme.text-secondary;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

    // ── Notes browser (root + nested folders) ────────────────────────────
    // Shared chrome: folder-list (child folders) + note-list (notes here).
    // show-notebook-list = root; show-note-list = inside a folder.
    notebook-list-view := Rectangle {
        visible: root.show-notebook-list || root.show-note-list;
        x: root.nav-w; y: 0;
        width: parent.width - root.nav-w;
        height: parent.height;
        background: EinkTheme.canvas-bg;
        clip: true;

        property <length> gallery-col-w: (self.width - 24px) / 2;
        property <length> gallery-row-h: 180px;

        VerticalLayout {
            padding: 0px; spacing: 0px;

            Rectangle {
                height: 44px;
                background: EinkTheme.canvas-bg;
                HorizontalLayout {
                    padding-left: 8px; padding-right: 8px;
                    padding-top: 6px; padding-bottom: 6px;
                    spacing: 6px;

                    if !root.notes-at-root: Rectangle {
                        width: 40px; height: 32px;
                        background: EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        Text {
                            text: Icons.back;
                            font-family: "Material Icons";
                            font-size: 20px; color: EinkTheme.btn-fg;
                            horizontal-alignment: center; vertical-alignment: center;
                            width: parent.width; height: parent.height;
                        }
                        TouchArea {
                            width: parent.width; height: parent.height;
                            clicked => { root.notebook-back-tapped(); }
                        }
                    }

                    Text {
                        text: root.notes-at-root ? "Notes" : root.active-notebook-title;
                        font-size: 15px; font-weight: 700;
                        color: EinkTheme.btn-fg;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }

                    // Sort cycle: edited → title → created
                    Rectangle {
                        width: 64px; height: 32px;
                        background: EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        HorizontalLayout {
                            padding-left: 4px; padding-right: 4px;
                            spacing: 2px; alignment: center;
                            Text {
                                text: Icons.sort;
                                font-family: "Material Icons";
                                font-size: 16px; color: EinkTheme.btn-fg;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.notes-sort-mode == "title" ? "A-Z"
                                    : (root.notes-sort-mode == "created" ? "New" : "Edit");
                                font-size: 10px; color: EinkTheme.btn-fg;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea {
                            width: parent.width; height: parent.height;
                            clicked => { root.notes-sort-cycled(); }
                        }
                    }

                    // List / gallery toggle — text label so meaning is clear on eink
                    Rectangle {
                        width: 56px; height: 32px;
                        background: EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        Text {
                            text: root.notes-view-mode == "gallery" ? "List" : "Grid";
                            font-size: 12px; color: EinkTheme.btn-fg;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                        TouchArea {
                            width: parent.width; height: parent.height;
                            clicked => { root.notes-view-mode-toggled(); }
                        }
                    }

                    Rectangle {
                        width: 72px; height: 32px;
                        background: EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        Text {
                            text: "+ Folder";
                            font-size: 12px; color: EinkTheme.btn-fg;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                        TouchArea {
                            width: parent.width; height: parent.height;
                            clicked => { root.notebook-new-tapped(); }
                        }
                    }

                    Rectangle {
                        width: 72px; height: 32px;
                        background: EinkTheme.btn-active-bg;
                        border-radius: 4px; border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        Text {
                            text: "+ Note";
                            font-size: 12px; color: EinkTheme.btn-active-fg;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                        TouchArea {
                            width: parent.width; height: parent.height;
                            clicked => { root.note-new-tapped(); }
                        }
                    }
                }
            }

            // Search within current folder
            Rectangle {
                height: 40px;
                background: EinkTheme.canvas-bg;
                HorizontalLayout {
                    padding-left: 8px; padding-right: 8px;
                    padding-top: 4px; padding-bottom: 4px;
                    spacing: 6px;
                    Text {
                        text: Icons.search;
                        font-family: "Material Icons";
                        font-size: 18px; color: EinkTheme.text-secondary;
                        vertical-alignment: center; width: 24px;
                    }
                    Rectangle {
                        horizontal-stretch: 1; height: 32px;
                        background: EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 1px;
                        border-color: EinkTheme.chrome-border;
                        Text {
                            visible: root.notes-search-query == "";
                            x: 8px; y: 0;
                            width: parent.width - 16px; height: parent.height;
                            text: "Search notes in this folder…";
                            font-size: 13px; color: EinkTheme.text-secondary;
                            vertical-alignment: center;
                        }
                        TextInput {
                            x: 8px; y: 0;
                            width: parent.width - 16px; height: parent.height;
                            font-size: 13px; color: EinkTheme.btn-fg;
                            text <=> root.notes-search-query;
                            edited => { root.notes-search-changed(self.text); }
                            accepted => { root.notes-search-changed(self.text); }
                        }
                    }
                }
            }

            Rectangle { height: 2px; background: EinkTheme.chrome-border; }

            // Scrollable folder + note content
            Flickable {
                vertical-stretch: 1;
                content-width: notebook-list-view.width;
                content-height: notes-scroll-col.preferred-height;

                notes-scroll-col := VerticalLayout {
                    spacing: 0px; padding: 0px;
                    width: notebook-list-view.width;

                    // ── Folders at this level ─────────────────────────────
                    for nb[i] in root.folder-list: Rectangle {
                        height: 56px;
                        width: notebook-list-view.width;
                        background: EinkTheme.canvas-bg;

                        HorizontalLayout {
                            padding-left: 12px; padding-right: 8px;
                            padding-top: 8px; padding-bottom: 8px;
                            spacing: 6px;

                            Text {
                                text: Icons.folder;
                                font-family: "Material Icons";
                                font-size: 22px; color: EinkTheme.btn-fg;
                                vertical-alignment: center;
                                width: 28px;
                            }

                            if nb.show-profile: ProfileIcon {
                                icon-char: nb.profile-icon-char;
                                has-custom: nb.has-custom-profile-icon;
                                custom-icon: nb.custom-profile-icon;
                                size: 20px; fg: EinkTheme.text-secondary;
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                background: transparent;

                                VerticalLayout {
                                    spacing: 2px; alignment: center;

                                    Text {
                                        text: nb.title;
                                        font-size: 15px; color: EinkTheme.btn-fg;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: nb.note-count + " note" + (nb.note-count == 1 ? "" : "s")
                                            + (nb.folder-count > 0
                                                ? (" · " + nb.folder-count + " folder" + (nb.folder-count == 1 ? "" : "s"))
                                                : "");
                                        font-size: 11px; color: EinkTheme.text-secondary;
                                    }
                                }
                                TouchArea {
                                    width: parent.width; height: parent.height;
                                    clicked => { root.notebook-tapped(nb.id); }
                                }
                            }

                            Rectangle {
                                width: 36px;
                                background: transparent;
                                Text {
                                    text: Icons.note-add;
                                    font-family: "Material Icons";
                                    font-size: 22px;
                                    color: EinkTheme.text-secondary;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: parent.width;
                                    height: parent.height;
                                }
                                TouchArea {
                                    width: parent.width; height: parent.height;
                                    clicked => { root.notebook-quick-new-note(nb.id); }
                                }
                            }

                            Rectangle {
                                width: 36px;
                                background: transparent;
                                Text {
                                    text: Icons.rename;
                                    font-family: "Material Icons";
                                    font-size: 20px;
                                    color: EinkTheme.text-secondary;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: parent.width;
                                    height: parent.height;
                                }
                                TouchArea {
                                    width: parent.width; height: parent.height;
                                    clicked => {
                                        root.notebook-rename-is-create = false;
                                        root.notebook-rename-id = nb.id;
                                        root.notebook-rename-title = nb.title;
                                        root.notebook-rename-visible = true;
                                    }
                                }
                            }

                            Rectangle {
                                width: 36px;
                                background: transparent;
                                Text {
                                    text: Icons.delete;
                                    font-family: "Material Icons";
                                    font-size: 20px;
                                    color: EinkTheme.text-secondary;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: parent.width;
                                    height: parent.height;
                                }
                                TouchArea {
                                    width: parent.width; height: parent.height;
                                    clicked => { root.notebook-delete-tapped(nb.id); }
                                }
                            }
                        }

                        Rectangle {
                            x: 0; y: parent.height - 1px;
                            width: parent.width; height: 1px;
                            background: EinkTheme.chrome-border; opacity: 0.3;
                        }
                    }

                    // ── Notes: list view ──────────────────────────────────
                    if root.notes-view-mode != "gallery": VerticalLayout {
                        spacing: 0px; padding: 0px;
                        width: notebook-list-view.width;
                        for note[i] in root.note-list: Rectangle {
                            height: 56px;
                            width: notebook-list-view.width;
                            background: EinkTheme.canvas-bg;

                            HorizontalLayout {
                                padding-left: 12px; padding-right: 8px;
                                padding-top: 8px; padding-bottom: 8px;
                                spacing: 6px;

                                Rectangle {
                                    width: 40px; height: 40px;
                                    background: EinkTheme.btn-bg;
                                    border-radius: 3px; border-width: 1px;
                                    border-color: EinkTheme.chrome-border;
                                    clip: true;
                                    Image {
                                        visible: note.has-preview;
                                        source: note.preview;
                                        width: parent.width; height: parent.height;
                                        image-fit: cover;
                                    }
                                    Text {
                                        visible: !note.has-preview;
                                        text: Icons.notes;
                                        font-family: "Material Icons";
                                        font-size: 18px; color: EinkTheme.text-secondary;
                                        horizontal-alignment: center; vertical-alignment: center;
                                        width: parent.width; height: parent.height;
                                    }
                                }

                                if note.show-profile: ProfileIcon {
                                    icon-char: note.profile-icon-char;
                                    has-custom: note.has-custom-profile-icon;
                                    custom-icon: note.custom-profile-icon;
                                    size: 18px; fg: EinkTheme.text-secondary;
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                    background: transparent;

                                    VerticalLayout {
                                        spacing: 4px; alignment: center;
                                        Text {
                                            text: note.title;
                                            font-size: 14px; color: EinkTheme.btn-fg;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: note.date-label;
                                            font-size: 11px; color: EinkTheme.text-secondary;
                                        }
                                    }
                                    TouchArea {
                                        width: parent.width; height: parent.height;
                                        clicked => { root.note-tapped(note.id); }
                                    }
                                }

                                Rectangle {
                                    width: 36px; height: 36px;
                                    background: EinkTheme.btn-bg;
                                    border-radius: 4px; border-width: 1px;
                                    border-color: EinkTheme.btn-border;
                                    Text {
                                        text: Icons.move;
                                        font-family: "Material Icons";
                                        font-size: 18px; color: EinkTheme.btn-fg;
                                        horizontal-alignment: center; vertical-alignment: center;
                                        width: parent.width; height: parent.height;
                                    }
                                    TouchArea {
                                        width: parent.width; height: parent.height;
                                        clicked => {
                                            root.note-move-note-id = note.id;
                                            root.note-move-visible = true;
                                        }
                                    }
                                }

                                Rectangle {
                                    width: 36px; height: 36px;
                                    background: EinkTheme.btn-bg;
                                    border-radius: 4px; border-width: 1px;
                                    border-color: EinkTheme.btn-border;
                                    Text {
                                        text: Icons.rename;
                                        font-family: "Material Icons";
                                        font-size: 18px; color: EinkTheme.btn-fg;
                                        horizontal-alignment: center; vertical-alignment: center;
                                        width: parent.width; height: parent.height;
                                    }
                                    TouchArea {
                                        width: parent.width; height: parent.height;
                                        clicked => {
                                            root.note-rename-id = note.id;
                                            root.note-rename-title = note.title;
                                            root.note-rename-visible = true;
                                        }
                                    }
                                }

                                Rectangle {
                                    width: 36px; height: 36px;
                                    background: EinkTheme.btn-bg;
                                    border-radius: 4px; border-width: 1px;
                                    border-color: EinkTheme.btn-border;
                                    Text {
                                        text: Icons.delete;
                                        font-family: "Material Icons";
                                        font-size: 18px; color: EinkTheme.btn-fg;
                                        horizontal-alignment: center; vertical-alignment: center;
                                        width: parent.width; height: parent.height;
                                    }
                                    TouchArea {
                                        width: parent.width; height: parent.height;
                                        clicked => { root.note-delete-tapped(note.id); }
                                    }
                                }
                            }

                            Rectangle {
                                x: 0; y: parent.height - 1px;
                                width: parent.width; height: 1px;
                                background: EinkTheme.chrome-border; opacity: 0.3;
                            }
                        }
                    }

                    // ── Notes: gallery view ───────────────────────────────
                    if root.notes-view-mode == "gallery": Rectangle {
                        width: notebook-list-view.width;
                        height: ((root.note-list.length + 1) / 2) * notebook-list-view.gallery-row-h
                            + (root.note-list.length == 0 ? 80px : 8px);
                        background: EinkTheme.canvas-bg;

                        for note[i] in root.note-list: Rectangle {
                            x: 8px + Math.mod(i, 2) * (notebook-list-view.gallery-col-w + 8px);
                            y: 8px + Math.floor(i / 2) * notebook-list-view.gallery-row-h;
                            width: notebook-list-view.gallery-col-w;
                            height: notebook-list-view.gallery-row-h - 8px;
                            background: EinkTheme.canvas-bg;
                            border-radius: 6px;
                            border-width: 2px;
                            border-color: EinkTheme.chrome-border;
                            clip: true;

                            VerticalLayout {
                                padding: 0px; spacing: 0px;

                                Rectangle {
                                    height: parent.height - 64px;
                                    background: EinkTheme.btn-bg;
                                    clip: true;
                                    Image {
                                        visible: note.has-preview;
                                        source: note.preview;
                                        width: parent.width; height: parent.height;
                                        image-fit: cover;
                                    }
                                    Text {
                                        visible: !note.has-preview;
                                        text: Icons.notes;
                                        font-family: "Material Icons";
                                        font-size: 36px; color: EinkTheme.text-secondary;
                                        horizontal-alignment: center; vertical-alignment: center;
                                        width: parent.width; height: parent.height;
                                    }
                                    if note.show-profile: Rectangle {
                                        x: 6px; y: 6px; width: 22px; height: 22px;
                                        background: EinkTheme.canvas-bg;
                                        border-radius: 11px;
                                        border-width: 1px; border-color: EinkTheme.chrome-border;
                                        ProfileIcon {
                                            icon-char: note.profile-icon-char;
                                            has-custom: note.has-custom-profile-icon;
                                            custom-icon: note.custom-profile-icon;
                                            size: 16px; fg: EinkTheme.btn-fg;
                                        }
                                    }
                                    TouchArea {
                                        width: parent.width; height: parent.height;
                                        clicked => { root.note-tapped(note.id); }
                                    }
                                }

                                Rectangle {
                                    height: 32px;
                                    background: EinkTheme.canvas-bg;
                                    HorizontalLayout {
                                        padding-left: 8px; padding-right: 4px;
                                        spacing: 2px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 0px; alignment: center;
                                            Text {
                                                text: note.title;
                                                font-size: 12px; font-weight: 600;
                                                color: EinkTheme.btn-fg;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: note.date-label;
                                                font-size: 10px; color: EinkTheme.text-secondary;
                                                overflow: elide;
                                            }
                                        }
                                        Rectangle {
                                            width: 32px; height: 28px;
                                            background: transparent;
                                            Text {
                                                text: Icons.rename;
                                                font-family: "Material Icons";
                                                font-size: 18px; color: EinkTheme.btn-fg;
                                                horizontal-alignment: center; vertical-alignment: center;
                                                width: parent.width; height: parent.height;
                                            }
                                            TouchArea {
                                                width: parent.width; height: parent.height;
                                                clicked => {
                                                    root.note-rename-id = note.id;
                                                    root.note-rename-title = note.title;
                                                    root.note-rename-visible = true;
                                                }
                                            }
                                        }
                                        Rectangle {
                                            width: 32px; height: 28px;
                                            background: transparent;
                                            Text {
                                                text: Icons.delete;
                                                font-family: "Material Icons";
                                                font-size: 18px; color: EinkTheme.btn-fg;
                                                horizontal-alignment: center; vertical-alignment: center;
                                                width: parent.width; height: parent.height;
                                            }
                                            TouchArea {
                                                width: parent.width; height: parent.height;
                                                clicked => { root.note-delete-tapped(note.id); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    if root.folder-list.length == 0 && root.note-list.length == 0: Rectangle {
                        height: 80px;
                        width: notebook-list-view.width;
                        background: EinkTheme.canvas-bg;
                        Text {
                            text: root.notes-search-query != ""
                                ? "No notes match this search"
                                : "Empty — tap + Note or + Folder";
                            font-size: 14px; color: EinkTheme.text-secondary;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

    // ── Recordings browser ───────────────────────────────────────────────────
    recording-list-view := Rectangle {
        visible: root.show-recording-list;
        x: root.nav-w; y: 0;
        width: parent.width - root.nav-w;
        height: parent.height;
        background: EinkTheme.canvas-bg;
        clip: true;

        VerticalLayout {
            padding: 0px; spacing: 0px;

            Rectangle {
                height: 44px;
                background: EinkTheme.canvas-bg;
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px;
                    padding-top: 6px; padding-bottom: 6px;
                    spacing: 8px;

                    Text {
                        text: "Recordings";
                        font-size: 16px; font-weight: 700;
                        color: EinkTheme.btn-fg;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    Rectangle {
                        width: 40px; height: 32px;
                        background: root.rec-state != 0 ? EinkTheme.btn-bg : EinkTheme.btn-active-bg;
                        border-radius: 4px; border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        Text {
                            text: Icons.mic;
                            font-family: "Material Icons";
                            font-size: 20px;
                            color: root.rec-state != 0 ? EinkTheme.text-secondary : EinkTheme.btn-active-fg;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: parent.width; height: parent.height;
                        }
                        TouchArea {
                            clicked => {
                                if (root.rec-state == 0) { root.rec-new-tapped(); }
                            }
                        }
                    }
                }
            }

            Rectangle { height: 2px; background: EinkTheme.chrome-border; }

            for rec[i] in root.recording-list: Rectangle {
                height: 60px;
                background: EinkTheme.canvas-bg;

                HorizontalLayout {
                    padding-left: 16px; padding-right: 8px;
                    padding-top: 8px; padding-bottom: 8px;
                    spacing: 4px;

                    Rectangle {
                        horizontal-stretch: 1;
                        background: transparent;
                        VerticalLayout {
                            spacing: 4px; alignment: center;
                            Text {
                                text: rec.title;
                                font-size: 14px; color: EinkTheme.btn-fg;
                                overflow: elide;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: rec.duration-label;
                                    font-size: 11px; color: EinkTheme.text-secondary;
                                }
                                Text {
                                    text: rec.date-label;
                                    font-size: 11px; color: EinkTheme.text-secondary;
                                }
                            }
                        }
                    }

                    Rectangle {
                        width: 36px; height: parent.height;
                        background: transparent;
                        Text {
                            text: Icons.play;
                            font-family: "Material Icons"; font-size: 22px;
                            color: EinkTheme.btn-fg;
                            horizontal-alignment: center; vertical-alignment: center;
                            width: parent.width; height: parent.height;
                        }
                        TouchArea { clicked => { root.rec-play-tapped(rec.id); } }
                    }

                    Rectangle {
                        width: 36px; height: parent.height;
                        background: transparent;
                        Text {
                            text: rec.has-transcription ? Icons.done : Icons.edit;
                            font-family: "Material Icons"; font-size: 20px;
                            color: rec.has-transcription ? EinkTheme.btn-fg : EinkTheme.text-secondary;
                            horizontal-alignment: center; vertical-alignment: center;
                            width: parent.width; height: parent.height;
                        }
                        TouchArea { clicked => { root.rec-transcribe-tapped(rec.id); } }
                    }

                    Rectangle {
                        width: 36px; height: parent.height;
                        background: transparent;
                        Text {
                            text: Icons.rename;
                            font-family: "Material Icons"; font-size: 20px;
                            color: EinkTheme.text-secondary;
                            horizontal-alignment: center; vertical-alignment: center;
                            width: parent.width; height: parent.height;
                        }
                        TouchArea {
                            clicked => {
                                root.rec-rename-id = rec.id;
                                root.rec-rename-title = rec.title;
                                root.rec-rename-visible = true;
                            }
                        }
                    }

                    Rectangle {
                        width: 36px; height: parent.height;
                        background: transparent;
                        Text {
                            text: Icons.delete;
                            font-family: "Material Icons"; font-size: 20px;
                            color: EinkTheme.text-secondary;
                            horizontal-alignment: center; vertical-alignment: center;
                            width: parent.width; height: parent.height;
                        }
                        TouchArea { clicked => { root.rec-delete-tapped(rec.id); } }
                    }
                }

                Rectangle {
                    x: 0; y: parent.height - 1px;
                    width: parent.width; height: 1px;
                    background: EinkTheme.chrome-border; opacity: 0.3;
                }
            }

            if root.recording-list.length == 0: Rectangle {
                height: 80px;
                background: EinkTheme.canvas-bg;
                Text {
                    text: "No recordings yet — tap the mic to start";
                    font-size: 14px; color: EinkTheme.text-secondary;
                    horizontal-alignment: center; vertical-alignment: center;
                }
            }
        }
    }

    // ── Calendar view ────────────────────────────────────────────────────
    calendar-view := Rectangle {
        visible: root.show-calendar;
        x: root.nav-w; y: 0;
        width: parent.width - root.nav-w;
        height: parent.height;
        background: EinkTheme.canvas-bg;
        clip: true;

        // Explicit body size so month grid fills on first open (stretch alone
        // can leave height near-zero until a later layout pass).
        property <length> cal-chrome-h: 81px; // tabs 40 + nav 40 + border 1
        property <length> cal-body-h: self.height - self.cal-chrome-h;
        property <length> cal-body-w: self.width;

        VerticalLayout {
            padding: 0; spacing: 0;

            // Sub-view tabs: Day | Week | Month | Year
            HorizontalLayout {
                height: 40px; spacing: 0;
                for label[i] in ["Day", "Week", "Month", "Year"]: Rectangle {
                    horizontal-stretch: 1;
                    background: root.cal-sub-view == i ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                    border-width: 1px; border-color: EinkTheme.chrome-border;
                    Text {
                        text: label;
                        font-size: 13px;
                        color: root.cal-sub-view == i ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    TouchArea { clicked => { root.cal-sub-view-changed(i); } }
                }
            }

            // Navigation: ← header Today →
            HorizontalLayout {
                height: 40px; spacing: 0;
                Rectangle {
                    width: 48px;
                    Text {
                        text: Icons.nav-prev;
                        font-family: "Material Icons"; font-size: 24px;
                        color: EinkTheme.btn-fg;
                        horizontal-alignment: center; vertical-alignment: center;
                        width: parent.width; height: parent.height;
                    }
                    TouchArea { clicked => { root.cal-prev(); } }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    Text {
                        text: root.cal-header-label;
                        font-size: 15px; font-weight: 700;
                        color: EinkTheme.btn-fg;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                }
                Rectangle {
                    width: 44px;
                    Text {
                        text: Icons.today;
                        font-family: "Material Icons"; font-size: 20px;
                        color: EinkTheme.text-secondary;
                        horizontal-alignment: center; vertical-alignment: center;
                        width: parent.width; height: parent.height;
                    }
                    TouchArea { clicked => { root.cal-today(); } }
                }
                Rectangle {
                    width: 48px;
                    Text {
                        text: Icons.nav-next;
                        font-family: "Material Icons"; font-size: 24px;
                        color: EinkTheme.btn-fg;
                        horizontal-alignment: center; vertical-alignment: center;
                        width: parent.width; height: parent.height;
                    }
                    TouchArea { clicked => { root.cal-next(); } }
                }
            }

            Rectangle { height: 1px; background: EinkTheme.chrome-border; }

            // Content area — switches by sub-view
            Rectangle {
                height: calendar-view.cal-body-h;
                width: calendar-view.cal-body-w;
                clip: true;

                // Month view — single Rectangle owns col-w-f so header and cells share identical positions
                Rectangle {
                    visible: root.cal-sub-view == 2;
                    width: calendar-view.cal-body-w;
                    height: calendar-view.cal-body-h;
                    clip: true;

                    property <float> col-w-f: self.width / 1px / 7;
                    property <float> hdr-h: 24;
                    property <float> row-h-f: (self.height / 1px - hdr-h) / 6;

                    // Day-of-week header row — same math as data cells
                    for hdr[hi] in ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]: Rectangle {
                        x: hi * col-w-f * 1px;
                        y: 0px;
                        width: col-w-f * 1px;
                        height: hdr-h * 1px;
                        background: EinkTheme.chrome-bg;
                        border-width: 1px; border-color: EinkTheme.chrome-border;
                        Text {
                            text: hdr;
                            font-size: 10px; color: EinkTheme.text-secondary;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                    }

                    // Data cells (42 = 6 rows x 7 cols)
                    for day[i] in root.cal-month-days: Rectangle {
                        x: Math.mod(i, 7) * col-w-f * 1px;
                        y: hdr-h * 1px + Math.floor(i / 7) * row-h-f * 1px;
                        width: col-w-f * 1px;
                        height: row-h-f * 1px;
                        background: day.is-today
                            ? EinkTheme.btn-active-bg
                            : EinkTheme.canvas-bg;
                        border-width: 1px;
                        border-color: EinkTheme.chrome-border;

                        Text {
                            visible: day.day != 0;
                            text: day.day;
                            font-size: 13px;
                            color: day.is-today
                                ? EinkTheme.btn-active-fg
                                : (day.in-month ? EinkTheme.btn-fg : EinkTheme.text-secondary);
                            horizontal-alignment: center;
                            y: 4px;
                            width: parent.width;
                        }

                        Text {
                            visible: day.has-events && day.day != 0 && day.first-event-title != "";
                            text: day.first-event-title;
                            font-size: 9px;
                            color: day.is-today
                                ? EinkTheme.btn-active-fg
                                : EinkTheme.text-secondary;
                            horizontal-alignment: center;
                            overflow: elide;
                            y: 22px;
                            width: parent.width - 4px;
                            x: 2px;
                        }

                        Rectangle {
                            visible: day.has-events && day.day != 0;
                            x: parent.width / 2 - 3px;
                            y: parent.height - 7px;
                            width: 6px; height: 6px;
                            border-radius: 3px;
                            background: day.is-today
                                ? EinkTheme.btn-active-fg
                                : EinkTheme.btn-fg;
                        }

                        TouchArea {
                            visible: day.in-month && day.day != 0;
                            clicked => {
                                root.cal-day-tapped(root.cal-year, root.cal-month, day.day);
                            }
                        }
                    }
                }

                // Day view
                Rectangle {
                    visible: root.cal-sub-view == 0;
                    width: calendar-view.cal-body-w;
                    height: calendar-view.cal-body-h;

                    VerticalLayout {
                        padding: 0; spacing: 0;

                        // Day-note strip
                        Rectangle {
                            height: 40px;
                            background: EinkTheme.chrome-bg;
                            border-width: 1px; border-color: EinkTheme.chrome-border;
                            HorizontalLayout {
                                padding-left: 12px; padding-right: 12px;
                                padding-top: 4px; padding-bottom: 4px;
                                spacing: 8px;
                                Text {
                                    text: root.cal-day-note-exists ? "Day note" : "No day note";
                                    font-size: 12px; color: EinkTheme.btn-fg;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                Rectangle {
                                    width: root.cal-day-note-exists ? 84px : 100px;
                                    height: 28px;
                                    background: EinkTheme.btn-active-bg;
                                    border-radius: 4px; border-width: 2px;
                                    border-color: EinkTheme.btn-border;
                                    Text {
                                        text: root.cal-day-note-exists ? "Open note" : "New day note";
                                        font-size: 11px; color: EinkTheme.btn-active-fg;
                                        horizontal-alignment: center; vertical-alignment: center;
                                    }
                                    TouchArea {
                                        clicked => {
                                            root.cal-open-day-note(root.cal-year, root.cal-month, root.cal-day);
                                        }
                                    }
                                }
                            }
                        }

                        if root.cal-events.length == 0: Text {
                            text: "No events today";
                            font-size: 14px; color: EinkTheme.text-secondary;
                            horizontal-alignment: center;
                            height: 60px;
                            vertical-alignment: center;
                        }

                        for event in root.cal-events: Rectangle {
                            height: 60px;
                            background: EinkTheme.canvas-bg;
                            border-width: 1px; border-color: EinkTheme.chrome-border;

                            HorizontalLayout {
                                padding: 8px; spacing: 12px;
                                alignment: center;

                                Text {
                                    text: event.time-label;
                                    font-size: 11px; color: EinkTheme.text-secondary;
                                    vertical-alignment: center;
                                    width: 80px;
                                }
                                Rectangle {
                                    width: 1px; background: EinkTheme.chrome-border;
                                    vertical-stretch: 1;
                                }
                                Text {
                                    text: event.title;
                                    font-size: 14px; color: EinkTheme.btn-fg;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                    }
                }

                // Week view — vertical rows, one per day (much more readable than 7 narrow columns)
                Rectangle {
                    visible: root.cal-sub-view == 1;
                    width: calendar-view.cal-body-w;
                    height: calendar-view.cal-body-h;
                    clip: true;

                    VerticalLayout {
                        spacing: 0;

                        for col-label[ci] in root.cal-week-day-labels: VerticalLayout {
                            spacing: 0;

                            Rectangle {
                                height: 32px;
                                background: EinkTheme.chrome-bg;
                                border-width: 1px; border-color: EinkTheme.chrome-border;
                                Text {
                                    text: col-label;
                                    font-size: 12px; font-weight: 600;
                                    color: EinkTheme.btn-fg;
                                    x: 12px; vertical-alignment: center;
                                    height: parent.height;
                                }
                            }

                            for event in root.cal-events: Rectangle {
                                visible: event.col == ci;
                                height: event.col == ci ? 40px : 0px;
                                background: EinkTheme.canvas-bg;
                                border-width: 1px; border-color: EinkTheme.chrome-border;

                                HorizontalLayout {
                                    padding: 6px; spacing: 8px; alignment: center;
                                    Text {
                                        text: event.time-label;
                                        font-size: 10px; color: EinkTheme.text-secondary;
                                        vertical-alignment: center;
                                        width: 72px;
                                    }
                                    Text {
                                        text: event.title;
                                        font-size: 12px; color: EinkTheme.btn-fg;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                }
                            }
                        }
                    }
                }


                // ── Year view ─────────────────────────────────────────────
                Rectangle {
                    visible: root.cal-sub-view == 3;
                    width: calendar-view.cal-body-w;
                    height: calendar-view.cal-body-h;
                    clip: true;

                    property <float> mw-f: self.width / 1px / 3;
                    property <float> mh-f: self.height / 1px / 4;

                    for month[i] in root.cal-year-months: Rectangle {
                        x: Math.mod(i, 3) * mw-f * 1px;
                        y: Math.floor(i / 3) * mh-f * 1px;
                        width: mw-f * 1px; height: mh-f * 1px;
                        background: EinkTheme.canvas-bg;
                        border-width: 1px; border-color: EinkTheme.chrome-border;

                        VerticalLayout {
                            padding: 8px; spacing: 4px; alignment: center;
                            Text {
                                text: month.name;
                                font-size: 13px; font-weight: 700;
                                color: EinkTheme.btn-fg;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: month.event-count > 0
                                    ? month.event-count + (month.event-count == 1 ? " event" : " events")
                                    : "";
                                font-size: 10px; color: EinkTheme.text-secondary;
                                horizontal-alignment: center;
                            }
                        }
                        TouchArea {
                            clicked => {
                                root.cal-day-tapped(root.cal-year, month.month-num, 1);
                                root.cal-sub-view-changed(2);
                            }
                        }
                    }
                }
            }
        }
    }

    // ── Drawing mode circular ring (burger menu) ─────────────────────────
    // Placed before nav-rail so nav-rail (z-above) remains clickable when both
    // are visible. Items are all at x>80 so they don't overlap with the rail.
    // Full-screen backdrop: blocks canvas ink input and dismisses dropdown on outside tap.
    Rectangle {
        visible: root.drawing-menu-open && root.is-canvas-context;
        x: 0; y: 0; width: parent.width; height: parent.height;
        background: transparent;
        TouchArea { clicked => { root.drawing-menu-open = false; } }
    }

    // ── Burger dropdown (tool & paper selector) ──────────────────────────
    drawing-dropdown := Rectangle {
        visible: root.drawing-menu-open && root.is-canvas-context;
        x: parent.width - 192px; y: 60px;
        width: 184px; height: 200px;
        background: EinkTheme.chrome-bg;
        border-width: 2px; border-color: EinkTheme.chrome-border;
        border-radius: 6px;
        clip: true;

        // -- Tool row 1: Pen / Hi-lite / Eraser --
        Rectangle {
            x: 6px; y: 6px; width: 54px; height: 32px;
            background: root.active-tool == "pen" ? EinkTheme.btn-active-bg : transparent;
            border-radius: 3px;
            Text { text: "Pen"; font-size: 12px;
                   color: root.active-tool == "pen" ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                   horizontal-alignment: center; vertical-alignment: center;
                   width: parent.width; height: parent.height; }
            TouchArea { clicked => { root.active-tool = "pen"; root.tool-selected("pen"); root.drawing-menu-open = false; } }
        }
        Rectangle {
            x: 64px; y: 6px; width: 54px; height: 32px;
            background: root.active-tool == "highlighter" ? EinkTheme.btn-active-bg : transparent;
            border-radius: 3px;
            Text { text: "Highlight"; font-size: 11px;
                   color: root.active-tool == "highlighter" ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                   horizontal-alignment: center; vertical-alignment: center;
                   width: parent.width; height: parent.height; }
            TouchArea { clicked => { root.active-tool = "highlighter"; root.tool-selected("highlighter"); root.drawing-menu-open = false; } }
        }
        Rectangle {
            x: 122px; y: 6px; width: 56px; height: 32px;
            background: root.active-tool == "eraser" ? EinkTheme.btn-active-bg : transparent;
            border-radius: 3px;
            Text { text: "Eraser"; font-size: 11px;
                   color: root.active-tool == "eraser" ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                   horizontal-alignment: center; vertical-alignment: center;
                   width: parent.width; height: parent.height; }
            TouchArea { clicked => { root.active-tool = "eraser"; root.tool-selected("eraser"); root.drawing-menu-open = false; } }
        }

        // -- Tool row 2: Move / Clear --
        Rectangle {
            x: 6px; y: 42px; width: 84px; height: 32px;
            background: root.active-tool == "move" ? EinkTheme.btn-active-bg : transparent;
            border-radius: 3px;
            Text { text: "Move"; font-size: 12px;
                   color: root.active-tool == "move" ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                   horizontal-alignment: center; vertical-alignment: center;
                   width: parent.width; height: parent.height; }
            TouchArea { clicked => { root.active-tool = "move"; root.tool-selected("move"); root.drawing-menu-open = false; } }
        }
        Rectangle {
            x: 94px; y: 42px; width: 84px; height: 32px;
            border-radius: 3px;
            Text { text: "Clear"; font-size: 12px; color: EinkTheme.danger-fg;
                   horizontal-alignment: center; vertical-alignment: center;
                   width: parent.width; height: parent.height; }
            TouchArea { clicked => { root.clear-page(); root.drawing-menu-open = false; } }
        }

        // Separator
        Rectangle { x: 6px; y: 78px; width: 172px; height: 1px; background: EinkTheme.chrome-border; }

        // -- Paper row 1: Blank / Lined --
        Rectangle {
            x: 6px; y: 83px; width: 84px; height: 32px;
            background: root.active-paper == "blank" ? EinkTheme.btn-active-bg : transparent;
            border-radius: 3px;
            Text { text: "Blank"; font-size: 12px;
                   color: root.active-paper == "blank" ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                   horizontal-alignment: center; vertical-alignment: center;
                   width: parent.width; height: parent.height; }
            TouchArea { clicked => { root.active-paper = "blank"; root.paper-type-tapped("blank"); root.drawing-menu-open = false; } }
        }
        Rectangle {
            x: 94px; y: 83px; width: 84px; height: 32px;
            background: root.active-paper == "lined" ? EinkTheme.btn-active-bg : transparent;
            border-radius: 3px;
            Text { text: "Lined"; font-size: 12px;
                   color: root.active-paper == "lined" ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                   horizontal-alignment: center; vertical-alignment: center;
                   width: parent.width; height: parent.height; }
            TouchArea { clicked => { root.active-paper = "lined"; root.paper-type-tapped("lined"); root.drawing-menu-open = false; } }
        }

        // -- Paper row 2: Dotted / Squared --
        Rectangle {
            x: 6px; y: 119px; width: 84px; height: 32px;
            background: root.active-paper == "dotted" ? EinkTheme.btn-active-bg : transparent;
            border-radius: 3px;
            Text { text: "Dotted"; font-size: 12px;
                   color: root.active-paper == "dotted" ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                   horizontal-alignment: center; vertical-alignment: center;
                   width: parent.width; height: parent.height; }
            TouchArea { clicked => { root.active-paper = "dotted"; root.paper-type-tapped("dotted"); root.drawing-menu-open = false; } }
        }
        Rectangle {
            x: 94px; y: 119px; width: 84px; height: 32px;
            background: root.active-paper == "squared" ? EinkTheme.btn-active-bg : transparent;
            border-radius: 3px;
            Text { text: "Squared"; font-size: 11px;
                   color: root.active-paper == "squared" ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                   horizontal-alignment: center; vertical-alignment: center;
                   width: parent.width; height: parent.height; }
            TouchArea { clicked => { root.active-paper = "squared"; root.paper-type-tapped("squared"); root.drawing-menu-open = false; } }
        }

        // Separator
        Rectangle { x: 6px; y: 155px; width: 172px; height: 1px; background: EinkTheme.chrome-border; }

        // -- See text toggle (OCR / transcribed layer)
        Rectangle {
            x: 6px; y: 160px; width: 172px; height: 32px;
            background: root.note-see-text ? EinkTheme.btn-active-bg : transparent;
            border-radius: 3px;
            Text {
                text: root.note-see-text ? "See text ✓" : "See text";
                font-size: 12px;
                color: root.note-see-text ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                horizontal-alignment: center; vertical-alignment: center;
                width: parent.width; height: parent.height;
            }
            TouchArea {
                clicked => {
                    root.note-see-text = !root.note-see-text;
                    root.note-see-text-toggled(root.note-see-text);
                    root.drawing-menu-open = false;
                }
            }
        }

    }

    // See-text: first-class reading view for OCR / transcribed note text.
    // Nav rail stays visible (is-canvas-context excludes note-see-text).
    see-text-view := Rectangle {
        visible: root.note-see-text
            && !root.show-start-page && !root.show-task-view
            && !root.show-settings && !root.show-filebrowser
            && !root.show-note-list && !root.show-notebook-list
            && !root.show-calendar && !root.show-recording-list
            && !root.show-search && !root.show-md-viewer;
        x: root.nav-w;
        y: 0;
        width: parent.width - root.nav-w;
        height: parent.height;
        background: EinkTheme.canvas-bg;
        clip: true;

        property <bool> has-body: root.note-text-content != "";

        VerticalLayout {
            padding: 0px;
            spacing: 0px;

            // Header: return to ink + note title + mode badge
            Rectangle {
                height: 52px;
                background: EinkTheme.chrome-bg;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 12px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 10px;
                    alignment: stretch;

                    Rectangle {
                        width: 72px;
                        height: 36px;
                        border-radius: 4px;
                        border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        background: EinkTheme.btn-bg;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 8px;
                            spacing: 2px;
                            alignment: center;
                            Text {
                                text: Icons.back;
                                font-family: "Material Icons";
                                font-size: 18px;
                                color: EinkTheme.btn-fg;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "Ink";
                                font-size: 13px;
                                font-weight: 700;
                                color: EinkTheme.btn-fg;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea {
                            clicked => {
                                root.note-see-text = false;
                                root.note-see-text-toggled(false);
                            }
                        }
                    }

                    Text {
                        text: root.page-title == "" ? "Untitled" : root.page-title;
                        font-size: 16px;
                        font-weight: 700;
                        color: EinkTheme.btn-fg;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }

                    Rectangle {
                        width: 64px;
                        height: 28px;
                        border-radius: 4px;
                        border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        background: EinkTheme.btn-active-bg;
                        HorizontalLayout {
                            spacing: 4px;
                            alignment: center;
                            Text {
                                text: Icons.notes;
                                font-family: "Material Icons";
                                font-size: 14px;
                                color: EinkTheme.btn-active-fg;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "Text";
                                font-size: 11px;
                                font-weight: 700;
                                color: EinkTheme.btn-active-fg;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            Rectangle { height: 2px; background: EinkTheme.chrome-border; }

            if see-text-view.has-body: Flickable {
                vertical-stretch: 1;
                width: parent.width;
                content-width: parent.width;
                content-height: see-text-body.preferred-height;

                see-text-body := VerticalLayout {
                    width: parent.width;
                    padding-left: 20px;
                    padding-right: 20px;
                    padding-top: 20px;
                    padding-bottom: 28px;
                    spacing: 0px;

                    Text {
                        text: root.note-text-content;
                        font-size: 17px;
                        color: EinkTheme.btn-fg;
                        wrap: word-wrap;
                        width: parent.width - 40px;
                    }
                }
            }

            if !see-text-view.has-body: Rectangle {
                vertical-stretch: 1;
                background: EinkTheme.canvas-bg;
                VerticalLayout {
                    padding: 32px;
                    spacing: 12px;
                    alignment: center;

                    Text {
                        text: Icons.notes;
                        font-family: "Material Icons";
                        font-size: 40px;
                        color: EinkTheme.btn-fg;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "No text yet";
                        font-size: 18px;
                        font-weight: 700;
                        color: EinkTheme.btn-fg;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Handwriting is transcribed when you open Text. Block or print letters work best.";
                        font-size: 13px;
                        color: EinkTheme.text-secondary;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }

    // ── Left navigation rail ─────────────────────────────────────────────
    nav-rail := Rectangle {
        // Hidden in pure drawing mode; reappears when burger menu is open.
        visible: !root.is-canvas-context || root.drawing-menu-open;
        x: 0;
        y: 0;
        width: root.nav-w;
        height: parent.height;
        background: EinkTheme.chrome-bg;
        clip: true;

        VerticalLayout {
            padding: 0px; spacing: 0px;

            // Home
            Rectangle {
                height: 72px;
                background: root.nav-section == 0 ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                VerticalLayout {
                    padding: 6px; spacing: 2px; alignment: center;
                    Text {
                        text: Icons.home;
                        font-family: "Material Icons";
                        font-size: 26px;
                        color: root.nav-section == 0 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Home";
                        font-size: 10px;
                        color: root.nav-section == 0 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                        horizontal-alignment: center;
                    }
                }
                TouchArea {
                    clicked => { root.nav-section = 0; root.nav-overview-tapped(); }
                }
            }

            Rectangle { height: 1px; background: EinkTheme.chrome-border; }

            // Notes
            Rectangle {
                height: 72px;
                background: root.nav-section == 1 ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                VerticalLayout {
                    padding: 6px; spacing: 2px; alignment: center;
                    Text {
                        text: Icons.notes;
                        font-family: "Material Icons";
                        font-size: 26px;
                        color: root.nav-section == 1 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Notes";
                        font-size: 10px;
                        color: root.nav-section == 1 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                        horizontal-alignment: center;
                    }
                }
                TouchArea {
                    clicked => { root.nav-section = 1; root.nav-notes-tapped(); }
                }
            }

            Rectangle { height: 1px; background: EinkTheme.chrome-border; }

            // Tasks
            Rectangle {
                height: 72px;
                background: root.nav-section == 2 ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                VerticalLayout {
                    padding: 6px; spacing: 2px; alignment: center;
                    Text {
                        text: Icons.tasks;
                        font-family: "Material Icons";
                        font-size: 26px;
                        color: root.nav-section == 2 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Tasks";
                        font-size: 10px;
                        color: root.nav-section == 2 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                        horizontal-alignment: center;
                    }
                }
                TouchArea {
                    clicked => { root.nav-section = 2; root.nav-tasks-tapped(); }
                }
            }

            Rectangle { height: 1px; background: EinkTheme.chrome-border; }

            // Calendar
            Rectangle {
                height: 72px;
                background: root.nav-section == 3 ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                VerticalLayout {
                    padding: 6px; spacing: 2px; alignment: center;
                    Text {
                        text: Icons.calendar;
                        font-family: "Material Icons";
                        font-size: 26px;
                        color: root.nav-section == 3 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Cal";
                        font-size: 10px;
                        color: root.nav-section == 3 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                        horizontal-alignment: center;
                    }
                }
                TouchArea {
                    clicked => { root.nav-section = 3; root.nav-calendar-tapped(); }
                }
            }

            if root.has-mic: Rectangle { height: 1px; background: EinkTheme.chrome-border; }

            if root.has-mic: Rectangle {
                height: 72px;
                background: root.nav-section == 4 ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                VerticalLayout {
                    padding: 6px; spacing: 2px; alignment: center;
                    Text {
                        text: Icons.mic;
                        font-family: "Material Icons";
                        font-size: 26px;
                        color: root.nav-section == 4 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Rec";
                        font-size: 10px;
                        color: root.nav-section == 4 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                        horizontal-alignment: center;
                    }
                }
                TouchArea {
                    clicked => { root.nav-section = 4; root.nav-rec-tapped(); }
                }
            }

            Rectangle { height: 1px; background: EinkTheme.chrome-border; }

            // Search — after Rec, before profile/settings
            Rectangle {
                height: 72px;
                background: root.show-search || root.show-md-viewer || root.nav-section == 5
                    ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                VerticalLayout {
                    padding: 6px; spacing: 2px; alignment: center;
                    Text {
                        text: Icons.search;
                        font-family: "Material Icons";
                        font-size: 26px;
                        color: root.show-search || root.show-md-viewer || root.nav-section == 5
                            ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Search";
                        font-size: 10px;
                        color: root.show-search || root.show-md-viewer || root.nav-section == 5
                            ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                        horizontal-alignment: center;
                    }
                }
                TouchArea {
                    clicked => { root.nav-section = 5; root.search-open(); }
                }
            }

            // Spacer
            Rectangle { vertical-stretch: 1; background: EinkTheme.chrome-bg; }

            Rectangle { height: 1px; background: EinkTheme.chrome-border; }

            // ── Profile avatar button (round icon + profile name) ──────────
            // Match other nav items: full-width column, icon optically centered.
            profile-btn := Rectangle {
                height: 64px;
                background: root.show-profile-switcher ? EinkTheme.btn-active-bg : EinkTheme.chrome-bg;
                VerticalLayout {
                    padding-top: 6px; padding-bottom: 4px;
                    spacing: 2px; alignment: stretch;

                    // Full-width slot; circle centered inside (same math as nav icons)
                    Rectangle {
                        height: 36px;
                        Rectangle {
                            x: (parent.width - 36px) / 2;
                            width: 36px; height: 36px;
                            border-radius: 18px;
                            background: root.show-profile-switcher ? EinkTheme.btn-active-fg : EinkTheme.btn-bg;
                            border-width: 2px;
                            border-color: root.show-profile-switcher ? EinkTheme.btn-active-fg : EinkTheme.btn-border;
                            if root.active-profile-id == "" || !root.active-profile-has-custom: Text {
                                text: root.active-profile-id == "" ? Icons.profile-group
                                    : root.active-profile-icon-char;
                                font-family: "Material Icons";
                                font-size: 20px;
                                color: root.show-profile-switcher ? EinkTheme.btn-active-bg : EinkTheme.btn-fg;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: parent.width; height: parent.height;
                            }
                            if root.active-profile-id != "" && root.active-profile-has-custom: Image {
                                x: 6px; y: 6px;
                                width: 24px; height: 24px;
                                source: root.active-profile-custom-icon;
                            }
                        }
                    }
                    Text {
                        height: 14px;
                        text: root.active-profile-id == "" ? "All"
                            : (root.active-profile-name == "" ? "Profile" : root.active-profile-name);
                        font-size: 9px;
                        color: root.show-profile-switcher ? EinkTheme.btn-active-fg : EinkTheme.text-secondary;
                        horizontal-alignment: center;
                        overflow: elide;
                    }
                }
                TouchArea {
                    clicked => { root.show-profile-switcher = !root.show-profile-switcher; }
                }
            }

            Rectangle { height: 1px; background: EinkTheme.chrome-border; }

            // Settings (icon only)
            Rectangle {
                height: 52px;
                background: root.show-settings ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                Text {
                    text: Icons.settings;
                    font-family: "Material Icons";
                    font-size: 26px;
                    color: root.show-settings ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }
                TouchArea { clicked => { root.settings-open(); } }
            }
        }

        // Right border
        Rectangle {
            x: root.nav-w - 2px; y: 0;
            width: 2px;
            height: parent.height;
            background: EinkTheme.chrome-border;
        }
    }

    // ── Profile switcher (anchored to profile-btn, after nav for z-order) ─
    // Backdrop covers content only so the nav rail (incl. profile toggle) stays live.
    Rectangle {
        visible: root.show-profile-switcher;
        x: root.nav-w; y: 0;
        width: parent.width - root.nav-w; height: parent.height;
        background: transparent;
        TouchArea { clicked => { root.show-profile-switcher = false; } }
    }

    profile-switcher-panel := Rectangle {
        visible: root.show-profile-switcher;
        x: root.nav-w + 4px;
        width: 220px;
        background: EinkTheme.chrome-bg;
        border-width: 2px;
        border-color: EinkTheme.chrome-border;
        border-radius: 6px;
        clip: true;

        property <int> item-count: root.profile-list.length + 1;  // +1 for "All"
        property <length> content-h: item-count * 44px + 40px;    // + header
        property <length> max-h: parent.height - 16px;
        height: min(content-h, max-h);
        // Bottom-align with profile button; clamp so the menu stays on-screen.
        property <length> ideal-y: profile-btn.y + profile-btn.height - self.height;
        y: max(8px, ideal-y);

        VerticalLayout {
            padding: 0px;
            spacing: 0px;

            Rectangle {
                height: 32px;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    alignment: start;
                    Text {
                        text: "Profiles";
                        font-size: 11px;
                        font-weight: 700;
                        color: EinkTheme.text-secondary;
                        vertical-alignment: center;
                    }
                }
            }
            Rectangle { height: 1px; background: EinkTheme.chrome-border; }

            Flickable {
                vertical-stretch: 1;
                width: parent.width;
                content-width: parent.width;
                content-height: profile-switcher-list.preferred-height;

                profile-switcher-list := VerticalLayout {
                    width: parent.width;
                    padding: 4px;
                    spacing: 0px;

                    // "All" row
                    Rectangle {
                        height: 44px;
                        background: root.active-profile-id == "" ? EinkTheme.btn-active-bg : transparent;
                        border-radius: 4px;
                        HorizontalLayout {
                            padding-left: 10px; padding-right: 10px;
                            spacing: 8px; alignment: start;
                            Text {
                                text: Icons.profile-group;
                                font-family: "Material Icons"; font-size: 20px;
                                color: root.active-profile-id == "" ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                                vertical-alignment: center; width: 24px;
                            }
                            Text {
                                text: "All profiles";
                                font-size: 13px;
                                color: root.active-profile-id == "" ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                                vertical-alignment: center; horizontal-stretch: 1;
                            }
                        }
                        TouchArea {
                            clicked => {
                                root.active-profile-id = "";
                                root.profile-changed("");
                                root.show-profile-switcher = false;
                            }
                        }
                    }

                    for p in root.profile-list: Rectangle {
                        height: 44px;
                        property <bool> sel: root.active-profile-id == p.id;
                        background: sel ? EinkTheme.btn-active-bg : transparent;
                        border-radius: 4px;
                        HorizontalLayout {
                            padding-left: 10px; padding-right: 10px;
                            spacing: 8px; alignment: start;
                            ProfileIcon {
                                icon-char: p.icon-char; has-custom: p.has-custom-icon; custom-icon: p.custom-icon;
                                size: 22px; fg: sel ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                            }
                            Text {
                                text: p.name;
                                font-size: 13px;
                                color: sel ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                                vertical-alignment: center; horizontal-stretch: 1;
                                overflow: elide;
                            }
                        }
                        TouchArea {
                            clicked => {
                                root.active-profile-id = p.id;
                                root.profile-changed(p.id);
                                root.show-profile-switcher = false;
                            }
                        }
                    }
                }
            }
        }
    }

    // ── Action ring (compact cardinal FAB cluster) ───────────────────────
    ring-backdrop := Rectangle {
        visible: root.ring-visible;
        x: 0px; y: 0px;
        width: parent.width;
        height: parent.height;

        // Tap outside ring to dismiss
        TouchArea { clicked => { root.ring-dismissed(); } }

        // Soft outer disc — smaller than the old pie menu
        Rectangle {
            x: root.ring-cx * 1px - 88px;
            y: root.ring-cy * 1px - 88px;
            width: 176px; height: 176px;
            border-radius: 88px;
            background: EinkTheme.chrome-bg;
            border-width: 2px;
            border-color: EinkTheme.chrome-border;
            opacity: 0.97;
        }

        // Note — 12 o'clock (creates a new note directly)
        Rectangle {
            x: root.ring-cx * 1px - 22px;
            y: root.ring-cy * 1px - 78px;
            width: 44px; height: 44px;
            background: EinkTheme.btn-bg;
            border-radius: 22px;
            border-width: 2px; border-color: EinkTheme.btn-border;
            Text {
                text: Icons.edit;
                font-family: "Material Icons";
                font-size: 22px; color: EinkTheme.btn-fg;
                horizontal-alignment: center; vertical-alignment: center;
                width: parent.width; height: parent.height;
            }
            TouchArea { clicked => { root.ring-note-tapped(); } }
        }

        // Event — 3 o'clock
        Rectangle {
            x: root.ring-cx * 1px + 34px;
            y: root.ring-cy * 1px - 22px;
            width: 44px; height: 44px;
            background: EinkTheme.btn-bg;
            border-radius: 22px;
            border-width: 2px; border-color: EinkTheme.btn-border;
            Text {
                text: Icons.calendar;
                font-family: "Material Icons";
                font-size: 22px; color: EinkTheme.btn-fg;
                horizontal-alignment: center; vertical-alignment: center;
                width: parent.width; height: parent.height;
            }
            TouchArea { clicked => { root.ring-calendar-tapped(); } }
        }

        // Task — 6 o'clock
        Rectangle {
            x: root.ring-cx * 1px - 22px;
            y: root.ring-cy * 1px + 34px;
            width: 44px; height: 44px;
            background: EinkTheme.btn-bg;
            border-radius: 22px;
            border-width: 2px; border-color: EinkTheme.btn-border;
            Text {
                text: Icons.done;
                font-family: "Material Icons";
                font-size: 22px; color: EinkTheme.btn-fg;
                horizontal-alignment: center; vertical-alignment: center;
                width: parent.width; height: parent.height;
            }
            TouchArea { clicked => { root.ring-task-tapped(); } }
        }

        // Record — 9 o'clock (only shown when device has mic)
        Rectangle {
            visible: root.ring-show-audio;
            x: root.ring-cx * 1px - 78px;
            y: root.ring-cy * 1px - 22px;
            width: 44px; height: 44px;
            background: EinkTheme.btn-bg;
            border-radius: 22px;
            border-width: 2px; border-color: EinkTheme.btn-border;
            Text {
                text: Icons.mic;
                font-family: "Material Icons";
                font-size: 22px; color: EinkTheme.btn-fg;
                horizontal-alignment: center; vertical-alignment: center;
                width: parent.width; height: parent.height;
            }
            TouchArea { clicked => { root.ring-audio-tapped(); } }
        }

        // Center dismiss
        Rectangle {
            x: root.ring-cx * 1px - 18px;
            y: root.ring-cy * 1px - 18px;
            width: 36px; height: 36px;
            background: EinkTheme.btn-active-bg;
            border-radius: 18px;
            border-width: 2px; border-color: EinkTheme.btn-border;
            Text {
                text: Icons.close;
                font-family: "Material Icons";
                font-size: 18px; color: EinkTheme.btn-active-fg;
                horizontal-alignment: center; vertical-alignment: center;
                width: parent.width; height: parent.height;
            }
            TouchArea { clicked => { root.ring-dismissed(); } }
        }
    }

    // ── Unified search view ──────────────────────────────────────────────
    search-view := Rectangle {
        visible: root.show-search;
        x: root.nav-w; y: 0;
        width: parent.width - root.nav-w;
        height: parent.height;
        background: EinkTheme.canvas-bg;
        clip: true;

        // Swallow pointer events so they never fall through to the ink canvas
        // TouchArea underneath (empty regions are not hit-targets otherwise).
        TouchArea {
            width: parent.width;
            height: parent.height;
        }

        VerticalLayout {
            padding: 12px;
            spacing: 10px;

            HorizontalLayout {
                spacing: 8px;
                height: 40px;
                Rectangle {
                    width: 40px; height: 40px;
                    border-radius: 4px;
                    border-width: 1px; border-color: EinkTheme.btn-border;
                    background: EinkTheme.btn-bg;
                    Text {
                        text: Icons.back;
                        font-family: "Material Icons"; font-size: 22px;
                        color: EinkTheme.btn-fg;
                        horizontal-alignment: center; vertical-alignment: center;
                        width: parent.width; height: parent.height;
                    }
                    TouchArea { clicked => { root.search-back(); } }
                }
                Text {
                    text: "Search";
                    font-size: 18px; font-weight: 700;
                    color: EinkTheme.btn-fg;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }

            HorizontalLayout {
                spacing: 8px;
                height: 40px;
                Rectangle {
                    horizontal-stretch: 1;
                    height: 40px;
                    border-width: 1px; border-color: EinkTheme.btn-border;
                    border-radius: 4px;
                    background: EinkTheme.btn-bg;
                    search-input := TextInput {
                        x: 8px; width: parent.width - 16px; height: parent.height;
                        text <=> root.search-query;
                        font-size: 14px;
                        color: EinkTheme.btn-fg;
                        single-line: true;
                        edited => { root.search-query-changed(self.text); }
                        accepted => { root.search-submit(self.text); }
                    }
                }
                Rectangle {
                    width: 72px; height: 40px;
                    border-radius: 4px;
                    border-width: 1px; border-color: EinkTheme.btn-border;
                    background: EinkTheme.btn-active-bg;
                    Text {
                        text: "Go";
                        font-size: 14px; color: EinkTheme.btn-active-fg;
                        horizontal-alignment: center; vertical-alignment: center;
                        width: parent.width; height: parent.height;
                    }
                    TouchArea {
                        // Pass the TextInput value directly (not the bound property)
                        // so Enter/Go never race a stale two-way binding.
                        clicked => { root.search-submit(search-input.text); }
                    }
                }
            }

            Text {
                text: root.search-status;
                font-size: 11px;
                color: EinkTheme.text-secondary;
                wrap: word-wrap;
            }

            Text {
                text: root.search-results.length == 0
                    ? (root.search-query == ""
                        ? "Type a query and tap Go — searches vault, notes, tasks, calendar."
                        : "No matching notes, tasks, or events.")
                    : "Results listed below.";
                font-size: 12px;
                color: EinkTheme.text-secondary;
            }

            Flickable {
                vertical-stretch: 1;
                content-width: parent.width - 24px;
                content-height: search-results-col.preferred-height;

                search-results-col := VerticalLayout {
                    spacing: 6px; width: parent.width;
                    for hit[i] in root.search-results: Rectangle {
                        height: 64px;
                        border-width: 1px; border-color: EinkTheme.chrome-border;
                        border-radius: 4px;
                        background: EinkTheme.btn-bg;
                        HorizontalLayout {
                            padding: 8px; spacing: 8px;
                            VerticalLayout {
                                spacing: 2px; horizontal-stretch: 1;
                                Text {
                                    text: hit.title;
                                    font-size: 14px; font-weight: 700;
                                    color: EinkTheme.btn-fg;
                                    overflow: elide;
                                }
                                Text {
                                    text: hit.source + "  ·  " + hit.snippet;
                                    font-size: 11px;
                                    color: EinkTheme.text-secondary;
                                    overflow: elide;
                                }
                            }
                        }
                        TouchArea {
                            clicked => { root.search-result-tapped(hit.id, hit.source); }
                        }
                    }
                }
            }
        }
    }

    // ── Markdown / vault note viewer ─────────────────────────────────────
    md-viewer := Rectangle {
        visible: root.show-md-viewer;
        x: root.nav-w; y: 0;
        width: parent.width - root.nav-w;
        height: parent.height;
        background: EinkTheme.canvas-bg;
        clip: true;

        // Behind the layout: swallow empty-region taps so they don't reach the ink canvas.
        TouchArea {
            width: parent.width;
            height: parent.height;
        }

        VerticalLayout {
            padding: 12px;
            spacing: 10px;
            alignment: stretch;

            HorizontalLayout {
                spacing: 8px;
                height: 40px;
                Rectangle {
                    width: 40px; height: 40px;
                    border-radius: 4px;
                    border-width: 1px; border-color: EinkTheme.btn-border;
                    background: EinkTheme.btn-bg;
                    Text {
                        text: Icons.back;
                        font-family: "Material Icons"; font-size: 22px;
                        color: EinkTheme.btn-fg;
                        horizontal-alignment: center; vertical-alignment: center;
                        width: parent.width; height: parent.height;
                    }
                    TouchArea { clicked => { root.md-viewer-back(); } }
                }
                VerticalLayout {
                    spacing: 0px; horizontal-stretch: 1;
                    Text {
                        text: root.md-viewer-title;
                        font-size: 16px; font-weight: 700;
                        color: EinkTheme.btn-fg;
                        overflow: elide;
                    }
                    Text {
                        text: root.md-viewer-path;
                        font-size: 11px;
                        color: EinkTheme.text-secondary;
                        overflow: elide;
                    }
                }
            }

            // Constrain viewport so content taller than the pane can scroll.
            Flickable {
                vertical-stretch: 1;
                width: root.width - root.nav-w - 24px;
                // Use root geometry (not parent.*) to avoid Flickable layout loops.
                content-width: root.width - root.nav-w - 24px;
                content-height: md-blocks-col.preferred-height;

                md-blocks-col := VerticalLayout {
                    spacing: 10px;
                    width: root.width - root.nav-w - 24px;

                    for block[i] in root.md-viewer-blocks: Text {
                        width: root.width - root.nav-w - 24px;
                        text: block.kind == 8 ? "────────"
                            : block.kind == 4 ? ("•  " + block.text)
                            : block.kind == 6 ? ("│  " + block.text)
                            : block.text;
                        wrap: word-wrap;
                        color: block.kind == 6 || block.kind == 7 || block.kind == 8
                            ? EinkTheme.text-secondary
                            : EinkTheme.btn-fg;
                        font-size: block.kind == 0 ? 20px
                            : block.kind == 1 ? 17px
                            : block.kind == 2 ? 15px
                            : 14px;
                        font-weight: block.kind <= 2 ? 700 : 400;
                    }

                    if root.md-viewer-blocks.length == 0: Text {
                        width: root.width - root.nav-w - 24px;
                        text: root.md-viewer-body;
                        font-size: 14px;
                        color: EinkTheme.btn-fg;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }

    // ── Settings view ────────────────────────────────────────────────────
    settings-view := Rectangle {
        visible: root.show-settings;
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        background: EinkTheme.canvas-bg;
        clip: true;

        HorizontalLayout {
            padding: 0px; spacing: 0px;

            // ── Left section navigation ──────────────────────────────────
            Rectangle {
                width: 80px;
                background: EinkTheme.chrome-bg;
                clip: true;

                VerticalLayout {
                    padding: 0px; spacing: 0px;

                    // Back
                    Rectangle {
                        height: 56px;
                        background: EinkTheme.btn-bg;
                        VerticalLayout {
                            padding: 4px; spacing: 2px; alignment: center;
                            Text {
                                text: Icons.back;
                                font-family: "Material Icons"; font-size: 22px;
                                color: EinkTheme.btn-fg;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "Back";
                                font-size: 9px; color: EinkTheme.text-secondary;
                                horizontal-alignment: center;
                            }
                        }
                        TouchArea { clicked => { root.settings-back(); } }
                    }

                    Rectangle { height: 2px; background: EinkTheme.chrome-border; }

                    // General
                    Rectangle {
                        height: 72px;
                        background: root.settings-section == 0 ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                        VerticalLayout {
                            padding: 6px; spacing: 2px; alignment: center;
                            Text {
                                text: Icons.settings;
                                font-family: "Material Icons"; font-size: 24px;
                                color: root.settings-section == 0 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "General";
                                font-size: 9px;
                                color: root.settings-section == 0 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                                horizontal-alignment: center;
                            }
                        }
                        TouchArea { clicked => { root.settings-section = 0; } }
                    }

                    Rectangle { height: 1px; background: EinkTheme.chrome-border; }

                    // Profiles
                    Rectangle {
                        height: 72px;
                        background: root.settings-section == 1 ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                        VerticalLayout {
                            padding: 6px; spacing: 2px; alignment: center;
                            Text {
                                text: Icons.profile-person;
                                font-family: "Material Icons"; font-size: 24px;
                                color: root.settings-section == 1 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "Profiles";
                                font-size: 9px;
                                color: root.settings-section == 1 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                                horizontal-alignment: center;
                            }
                        }
                        TouchArea { clicked => { root.settings-section = 1; } }
                    }

                    Rectangle { height: 1px; background: EinkTheme.chrome-border; }

                    // Connections
                    Rectangle {
                        height: 72px;
                        background: root.settings-section == 2 ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                        VerticalLayout {
                            padding: 6px; spacing: 2px; alignment: center;
                            Text {
                                text: Icons.link;
                                font-family: "Material Icons"; font-size: 24px;
                                color: root.settings-section == 2 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "Connect";
                                font-size: 9px;
                                color: root.settings-section == 2 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                                horizontal-alignment: center;
                            }
                        }
                        TouchArea {
                            clicked => {
                                root.settings-section = 2;
                                // Prefer the app's active profile; else first profile.
                                if (root.connect-profile-id == "") {
                                    if (root.active-profile-id != "") {
                                        root.connect-profile-id = root.active-profile-id;
                                    }
                                }
                                root.connect-profile-changed(root.connect-profile-id);
                            }
                        }
                    }

                    // Spacer
                    Rectangle { vertical-stretch: 1; background: EinkTheme.chrome-bg; }

                    Rectangle { height: 1px; background: EinkTheme.chrome-border; }

                    // Save
                    Rectangle {
                        height: 52px;
                        background: EinkTheme.btn-active-bg;
                        VerticalLayout {
                            padding: 4px; spacing: 2px; alignment: center;
                            Text {
                                text: Icons.done;
                                font-family: "Material Icons"; font-size: 22px;
                                color: EinkTheme.btn-active-fg;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "Save";
                                font-size: 9px; color: EinkTheme.btn-active-fg;
                                horizontal-alignment: center;
                            }
                        }
                        TouchArea { clicked => { root.settings-save(); } }
                    }
                }

                // Right border of section nav
                Rectangle {
                    x: 78px; y: 0;
                    width: 2px; height: parent.height;
                    background: EinkTheme.chrome-border;
                }
            }

            // ── Section content area ──────────────────────────────────────
            Rectangle {
                horizontal-stretch: 1;
                clip: true;

                // ── General section ──────────────────────────────────────
                Rectangle {
                    visible: root.settings-section == 0;
                    width: parent.width; height: parent.height;
                    clip: true;

                    VerticalLayout {
                        padding: 0px; spacing: 0px;

                        Rectangle {
                            height: 44px;
                            background: EinkTheme.canvas-bg;
                            HorizontalLayout {
                                padding-left: 16px; padding-right: 16px;
                                padding-top: 6px; padding-bottom: 6px;
                                spacing: 12px;

                                Text {
                                    text: "Theme";
                                    font-size: 14px; color: EinkTheme.btn-fg;
                                    vertical-alignment: center; width: 80px;
                                }

                                Rectangle {
                                    width: 72px; height: 32px;
                                    background: root.settings-theme-idx == 0 ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                                    border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                                    Text { text: "Light"; font-size: 13px;
                                           color: root.settings-theme-idx == 0 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                                           horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.settings-theme-idx = 0; } }
                                }

                                Rectangle {
                                    width: 72px; height: 32px;
                                    background: root.settings-theme-idx == 1 ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                                    border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                                    Text { text: "Dark"; font-size: 13px;
                                           color: root.settings-theme-idx == 1 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                                           horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.settings-theme-idx = 1; } }
                                }

                                Rectangle { horizontal-stretch: 1; }
                            }
                        }

                        Rectangle { height: 2px; background: EinkTheme.chrome-border; }

                        Rectangle {
                            height: 44px;
                            background: EinkTheme.canvas-bg;
                            HorizontalLayout {
                                padding-left: 16px; padding-right: 16px;
                                padding-top: 6px; padding-bottom: 6px;
                                spacing: 12px;

                                Text {
                                    text: "Ink input";
                                    font-size: 14px; color: EinkTheme.btn-fg;
                                    vertical-alignment: center; width: 80px;
                                }

                                Rectangle {
                                    width: 84px; height: 32px;
                                    background: root.settings-pen-only ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                                    border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                                    Text { text: "Pen only"; font-size: 13px;
                                           color: root.settings-pen-only ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                                           horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.settings-pen-only = true; } }
                                }

                                Rectangle {
                                    width: 110px; height: 32px;
                                    background: !root.settings-pen-only ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                                    border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                                    Text { text: "Pen + finger"; font-size: 13px;
                                           color: !root.settings-pen-only ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                                           horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.settings-pen-only = false; } }
                                }

                                Rectangle { horizontal-stretch: 1; }
                            }
                        }

                        Rectangle { height: 2px; background: EinkTheme.chrome-border; }

                        if root.has-mic: Rectangle {
                            height: 36px;
                            background: EinkTheme.canvas-bg;
                            HorizontalLayout {
                                padding-left: 16px; padding-top: 4px; padding-bottom: 4px;
                                Text {
                                    text: "Transcription";
                                    font-size: 14px; font-weight: 700; color: EinkTheme.btn-fg;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        if root.has-mic: Rectangle {
                            height: 48px;
                            background: EinkTheme.canvas-bg;
                            HorizontalLayout {
                                padding-left: 16px; padding-right: 16px;
                                padding-top: 6px; padding-bottom: 6px;
                                spacing: 8px;

                                Text {
                                    text: "Whisper model";
                                    font-size: 14px; color: EinkTheme.btn-fg;
                                    vertical-alignment: center; width: 110px;
                                }

                                Text {
                                    text: root.whisper-downloading ? "Downloading…"
                                        : root.whisper-model-installed ? "Installed (ggml-base)"
                                        : "Not installed";
                                    font-size: 12px;
                                    color: root.whisper-model-installed ? EinkTheme.btn-fg : EinkTheme.text-secondary;
                                    vertical-alignment: center; horizontal-stretch: 1;
                                }

                                if !root.whisper-downloading && !root.whisper-model-installed: Rectangle {
                                    width: 84px; height: 32px;
                                    background: EinkTheme.btn-bg;
                                    border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                                    Text { text: "Download"; font-size: 12px; color: EinkTheme.btn-fg;
                                           horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.settings-whisper-download(); } }
                                }

                                if !root.whisper-downloading && root.whisper-model-installed: Rectangle {
                                    width: 60px; height: 32px;
                                    background: EinkTheme.btn-bg;
                                    border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                                    Text { text: "Delete"; font-size: 12px; color: EinkTheme.danger-fg;
                                           horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.settings-whisper-delete(); } }
                                }
                            }
                        }

                        if root.has-mic: Rectangle {
                            height: 44px;
                            background: EinkTheme.canvas-bg;
                            HorizontalLayout {
                                padding-left: 16px; padding-right: 16px;
                                padding-top: 6px; padding-bottom: 6px;
                                spacing: 8px;

                                Text {
                                    text: "Language";
                                    font-size: 14px; color: EinkTheme.btn-fg;
                                    vertical-alignment: center; width: 110px;
                                }

                                for lang-opt in ["auto", "en", "de"]: Rectangle {
                                    property <string> lbl: lang-opt == "auto" ? "Auto"
                                        : lang-opt == "en" ? "English" : "German";
                                    property <bool> active: root.whisper-lang == lang-opt;
                                    width: 72px; height: 32px;
                                    background: active ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                                    border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                                    Text { text: lbl; font-size: 12px;
                                           color: active ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                                           horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.whisper-lang = lang-opt; } }
                                }

                                Rectangle { horizontal-stretch: 1; }
                            }
                        }
                    }
                }

                // ── Profiles section ─────────────────────────────────────
                Rectangle {
                    visible: root.settings-section == 1;
                    width: parent.width; height: parent.height;
                    clip: true;

                    VerticalLayout {
                        padding: 0px; spacing: 0px;

                        Rectangle {
                            height: 48px;
                            background: EinkTheme.canvas-bg;
                            HorizontalLayout {
                                padding-left: 16px; padding-right: 16px;
                                padding-top: 8px; padding-bottom: 8px;
                                spacing: 8px;

                                Text {
                                    text: "Profiles";
                                    font-size: 14px; font-weight: 700; color: EinkTheme.btn-fg;
                                    vertical-alignment: center; horizontal-stretch: 1;
                                }

                                Rectangle {
                                    width: 108px; height: 32px;
                                    background: EinkTheme.btn-active-bg;
                                    border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                                    Text { text: "+ Add Profile"; font-size: 12px; color: EinkTheme.btn-active-fg;
                                           horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea {
                                        clicked => {
                                            root.profile-edit-is-new = true;
                                            root.profile-edit-id = "";
                                            root.profile-edit-name = "";
                                            root.profile-edit-icon = "person";
                                            root.profile-edit-has-custom = false;
                                            root.profile-edit-dialog-visible = true;
                                        }
                                    }
                                }
                            }
                        }

                        Rectangle { height: 2px; background: EinkTheme.chrome-border; }

                        for p in root.profile-list: Rectangle {
                            height: 104px;
                            background: EinkTheme.canvas-bg;

                            VerticalLayout {
                                padding: 0px; spacing: 0px;

                                // Row 1: icon + name + edit + delete
                                HorizontalLayout {
                                    padding-left: 16px; padding-right: 12px;
                                    padding-top: 8px; padding-bottom: 4px;
                                    spacing: 8px;

                                    Rectangle {
                                        width: 40px; height: 40px;
                                        border-radius: 20px;
                                        background: EinkTheme.btn-bg;
                                        border-width: 2px; border-color: EinkTheme.btn-border;
                                        ProfileIcon {
                                            x: 7px; y: 7px;
                                            icon-char: p.icon-char; has-custom: p.has-custom-icon; custom-icon: p.custom-icon;
                                            size: 26px; fg: EinkTheme.btn-fg;
                                        }
                                    }

                                    Text {
                                        text: p.name;
                                        font-size: 14px; color: EinkTheme.btn-fg;
                                        vertical-alignment: center; horizontal-stretch: 1;
                                        overflow: elide;
                                    }

                                    Rectangle {
                                        width: 36px; height: 36px;
                                        background: transparent;
                                        Text {
                                            text: Icons.edit;
                                            font-family: "Material Icons"; font-size: 20px;
                                            color: EinkTheme.text-secondary;
                                            horizontal-alignment: center; vertical-alignment: center;
                                            width: parent.width; height: parent.height;
                                        }
                                        TouchArea {
                                            clicked => {
                                                root.profile-edit-is-new = false;
                                                root.profile-edit-id = p.id;
                                                root.profile-edit-name = p.name;
                                                root.profile-edit-icon = p.icon;
                                                root.profile-edit-has-custom = p.has-custom-icon;
                                                root.profile-edit-custom-image = p.custom-icon;
                                                root.profile-edit-dialog-visible = true;
                                            }
                                        }
                                    }

                                    Rectangle {
                                        width: 36px; height: 36px;
                                        background: transparent;
                                        Text {
                                            text: Icons.delete;
                                            font-family: "Material Icons"; font-size: 20px;
                                            color: EinkTheme.danger-fg;
                                            horizontal-alignment: center; vertical-alignment: center;
                                            width: parent.width; height: parent.height;
                                        }
                                        TouchArea { clicked => { root.settings-profile-delete(p.id); } }
                                    }
                                }

                                // Row 2: notes-in-all toggle
                                Rectangle {
                                    height: 28px;
                                    HorizontalLayout {
                                        padding-left: 62px; padding-right: 12px;
                                        padding-top: 4px; padding-bottom: 4px;
                                        spacing: 6px; alignment: start;
                                        Text {
                                            text: "Notes visible in All";
                                            font-size: 11px; color: EinkTheme.text-secondary;
                                            vertical-alignment: center; horizontal-stretch: 1;
                                        }
                                        Text {
                                            text: p.notes-in-all ? Icons.check-box : Icons.check-box-out;
                                            font-family: "Material Icons"; font-size: 18px;
                                            color: EinkTheme.btn-fg;
                                            vertical-alignment: center;
                                        }
                                    }
                                    TouchArea {
                                        clicked => { root.settings-profile-toggle-notes-in-all(p.id); }
                                    }
                                }

                                // Row 3: recordings-in-all toggle
                                Rectangle {
                                    height: 28px;
                                    HorizontalLayout {
                                        padding-left: 62px; padding-right: 12px;
                                        padding-top: 4px; padding-bottom: 4px;
                                        spacing: 6px; alignment: start;
                                        Text {
                                            text: "Recordings visible in All";
                                            font-size: 11px; color: EinkTheme.text-secondary;
                                            vertical-alignment: center; horizontal-stretch: 1;
                                        }
                                        Text {
                                            text: p.recordings-in-all ? Icons.check-box : Icons.check-box-out;
                                            font-family: "Material Icons"; font-size: 18px;
                                            color: EinkTheme.btn-fg;
                                            vertical-alignment: center;
                                        }
                                    }
                                    TouchArea {
                                        clicked => { root.settings-profile-toggle-recordings-in-all(p.id); }
                                    }
                                }
                            }

                            Rectangle {
                                x: 0; y: parent.height - 1px;
                                width: parent.width; height: 1px;
                                background: EinkTheme.chrome-border; opacity: 0.3;
                            }
                        }

                        if root.profile-list.length == 0: Rectangle {
                            height: 80px;
                            background: EinkTheme.canvas-bg;
                            Text {
                                text: "No profiles yet — tap + Add Profile";
                                font-size: 13px; color: EinkTheme.text-secondary;
                                horizontal-alignment: center; vertical-alignment: center;
                            }
                        }
                    }
                }

                // ── Connect section (per-profile providers) ───────────────
                Rectangle {
                    visible: root.settings-section == 2;
                    width: parent.width; height: parent.height;
                    clip: true;

                    VerticalLayout {
                        padding: 0px; spacing: 0px;

                        // Header
                        Rectangle {
                            height: 44px;
                            background: EinkTheme.canvas-bg;
                            HorizontalLayout {
                                padding-left: 16px; padding-right: 12px;
                                padding-top: 8px; padding-bottom: 8px;
                                spacing: 8px;
                                Text {
                                    text: "Connect";
                                    font-size: 14px; font-weight: 700; color: EinkTheme.btn-fg;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "Providers for one profile";
                                    font-size: 11px; color: EinkTheme.text-secondary;
                                    vertical-alignment: center; horizontal-stretch: 1;
                                }
                            }
                        }

                        Rectangle { height: 1px; background: EinkTheme.chrome-border; }

                        // Profile picker (no "All" — connections are always per-profile)
                        Rectangle {
                            height: 48px;
                            background: EinkTheme.canvas-bg;
                            HorizontalLayout {
                                padding-left: 12px; padding-right: 12px;
                                padding-top: 8px; padding-bottom: 8px;
                                spacing: 6px; alignment: start;

                                Text {
                                    text: "Profile";
                                    font-size: 12px; color: EinkTheme.text-secondary;
                                    vertical-alignment: center; width: 48px;
                                }

                                for p in root.profile-list: Rectangle {
                                    property <bool> sel: root.connect-profile-id == p.id;
                                    // icon via p.icon-char / ProfileIcon
                                    min-width: 88px; height: 32px;
                                    background: sel ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                                    border-radius: 4px; border-width: 2px;
                                    border-color: EinkTheme.btn-border;
                                    HorizontalLayout {
                                        padding-left: 8px; padding-right: 10px;
                                        spacing: 4px; alignment: center;
                                        ProfileIcon {
                                            icon-char: p.icon-char; has-custom: p.has-custom-icon; custom-icon: p.custom-icon;
                                            size: 16px; fg: sel ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                                        }
                                        Text { text: p.name; font-size: 12px;
                                               color: sel ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                                               vertical-alignment: center; overflow: elide; }
                                    }
                                    TouchArea {
                                        clicked => {
                                            root.connect-profile-id = p.id;
                                            root.connect-profile-changed(p.id);
                                        }
                                    }
                                }

                                Rectangle { horizontal-stretch: 1; }
                            }
                        }

                        Rectangle { height: 2px; background: EinkTheme.chrome-border; }

                        // Empty: no profiles yet
                        if root.profile-list.length == 0: Rectangle {
                            vertical-stretch: 1;
                            background: EinkTheme.canvas-bg;
                            VerticalLayout {
                                padding: 24px; spacing: 12px; alignment: center;
                                Text {
                                    text: Icons.profile-person;
                                    font-family: "Material Icons"; font-size: 36px;
                                    color: EinkTheme.text-secondary;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: "Create a profile first";
                                    font-size: 14px; font-weight: 700; color: EinkTheme.btn-fg;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: "Connections belong to a profile\n(Work, Home, …). Add one under Profiles.";
                                    font-size: 12px; color: EinkTheme.text-secondary;
                                    horizontal-alignment: center;
                                }
                                Rectangle {
                                    width: 160px; height: 36px;
                                    background: EinkTheme.btn-active-bg;
                                    border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                                    Text { text: "Go to Profiles"; font-size: 13px; color: EinkTheme.btn-active-fg;
                                           horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.settings-section = 1; } }
                                }
                            }
                        }

                        // Provider catalog (scrollable)
                        if root.profile-list.length > 0: Flickable {
                            vertical-stretch: 1;

                            VerticalLayout {
                                spacing: 0px;

                                // ── NOTES ────────────────────────────────
                                Rectangle {
                                    height: 32px;
                                    background: EinkTheme.canvas-bg;
                                    Text {
                                        x: 16px; y: 0; width: parent.width - 16px; height: parent.height;
                                        text: "NOTES";
                                        font-size: 11px; font-weight: 700; color: EinkTheme.text-secondary;
                                        vertical-alignment: center;
                                    }
                                }

                                // Obsidian Vault
                                Rectangle {
                                    height: root.connect-has-vault ? 88px : 72px;
                                    background: EinkTheme.canvas-bg;
                                    VerticalLayout {
                                        padding-left: 12px; padding-right: 12px;
                                        padding-top: 8px; padding-bottom: 8px;
                                        spacing: 4px;

                                        HorizontalLayout {
                                            spacing: 10px;
                                            Rectangle {
                                                width: 36px; height: 36px;
                                                border-radius: 4px;
                                                background: EinkTheme.btn-bg;
                                                border-width: 2px; border-color: EinkTheme.btn-border;
                                                Text {
                                                    text: Icons.folder;
                                                    font-family: "Material Icons"; font-size: 20px;
                                                    color: EinkTheme.btn-fg;
                                                    horizontal-alignment: center; vertical-alignment: center;
                                                    width: parent.width; height: parent.height;
                                                }
                                            }
                                            VerticalLayout {
                                                spacing: 2px; alignment: center; horizontal-stretch: 1;
                                                Text {
                                                    text: "Obsidian Vault";
                                                    font-size: 13px; font-weight: 700; color: EinkTheme.btn-fg;
                                                }
                                                Text {
                                                    text: root.connect-has-vault ? "Connected" : "Not connected — tasks & notes";
                                                    font-size: 11px; color: EinkTheme.text-secondary;
                                                }
                                            }
                                            if !root.connect-has-vault: Rectangle {
                                                width: 72px; height: 32px;
                                                background: EinkTheme.btn-active-bg;
                                                border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                                                Text { text: "Set up"; font-size: 12px; color: EinkTheme.btn-active-fg;
                                                       horizontal-alignment: center; vertical-alignment: center; }
                                                TouchArea {
                                                    clicked => {
                                                        root.connect-setup-kind = "vault";
                                                        root.connect-setup-visible = true;
                                                    }
                                                }
                                            }
                                        }

                                        for conn[i] in root.connection-list: Rectangle {
                                            visible: conn.kind == "vault" && conn.profile-id == root.connect-profile-id;
                                            height: self.visible ? 36px : 0px;
                                            clip: true;
                                            HorizontalLayout {
                                                spacing: 8px; padding-left: 46px;
                                                VerticalLayout {
                                                    spacing: 1px; horizontal-stretch: 1; alignment: center;
                                                    Text { text: conn.display; font-size: 12px; color: EinkTheme.btn-fg; overflow: elide; }
                                                    Text { text: conn.value; font-size: 10px; color: EinkTheme.text-secondary; overflow: elide; }
                                                }
                                                Rectangle {
                                                    height: 28px; min-width: 70px;
                                                    HorizontalLayout {
                                                        spacing: 4px; alignment: center;
                                                        Text {
                                                            text: conn.allow-in-aggregated ? Icons.check-box : Icons.check-box-out;
                                                            font-family: "Material Icons"; font-size: 18px; color: EinkTheme.btn-fg;
                                                            vertical-alignment: center;
                                                        }
                                                        Text {
                                                            text: "In All"; font-size: 10px; color: EinkTheme.text-secondary;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                    TouchArea { clicked => { root.connection-toggle-aggregated(i); } }
                                                }
                                                Rectangle {
                                                    width: 28px; height: 28px;
                                                    Text { text: Icons.delete; font-family: "Material Icons"; font-size: 16px;
                                                           color: EinkTheme.danger-fg;
                                                           horizontal-alignment: center; vertical-alignment: center;
                                                           width: parent.width; height: parent.height; }
                                                    TouchArea { clicked => { root.connection-remove(i); } }
                                                }
                                            }
                                        }
                                    }
                                    Rectangle {
                                        x: 12px; y: parent.height - 1px; width: parent.width - 24px; height: 1px;
                                        background: EinkTheme.chrome-border; opacity: 0.35;
                                    }
                                }

                                // Evernote (soon)
                                Rectangle {
                                    height: 64px;
                                    background: EinkTheme.canvas-bg;
                                    HorizontalLayout {
                                        padding-left: 12px; padding-right: 12px;
                                        padding-top: 10px; padding-bottom: 10px;
                                        spacing: 10px;
                                        Rectangle {
                                            width: 36px; height: 36px;
                                            border-radius: 4px;
                                            background: EinkTheme.btn-bg;
                                            border-width: 2px; border-color: EinkTheme.btn-border;
                                            Text {
                                                text: Icons.event-note;
                                                font-family: "Material Icons"; font-size: 20px;
                                                color: EinkTheme.text-secondary;
                                                horizontal-alignment: center; vertical-alignment: center;
                                                width: parent.width; height: parent.height;
                                            }
                                        }
                                        VerticalLayout {
                                            spacing: 2px; alignment: center; horizontal-stretch: 1;
                                            Text { text: "Evernote"; font-size: 13px; font-weight: 700; color: EinkTheme.btn-fg; }
                                            Text { text: "Coming soon"; font-size: 11px; color: EinkTheme.text-secondary; }
                                        }
                                        Rectangle {
                                            width: 72px; height: 32px;
                                            background: EinkTheme.btn-bg;
                                            border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                                            Text { text: "Info"; font-size: 12px; color: EinkTheme.btn-fg;
                                                   horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea {
                                                clicked => {
                                                    root.connect-soon-title = "Evernote";
                                                    root.connect-soon-body = "Evernote sync for this profile is on the roadmap. You will connect an account here.";
                                                    root.connect-soon-visible = true;
                                                }
                                            }
                                        }
                                    }
                                    Rectangle {
                                        x: 12px; y: parent.height - 1px; width: parent.width - 24px; height: 1px;
                                        background: EinkTheme.chrome-border; opacity: 0.35;
                                    }
                                }

                                // Drive notes (soon)
                                Rectangle {
                                    height: 64px;
                                    background: EinkTheme.canvas-bg;
                                    HorizontalLayout {
                                        padding-left: 12px; padding-right: 12px;
                                        padding-top: 10px; padding-bottom: 10px;
                                        spacing: 10px;
                                        Rectangle {
                                            width: 36px; height: 36px;
                                            border-radius: 4px;
                                            background: EinkTheme.btn-bg;
                                            border-width: 2px; border-color: EinkTheme.btn-border;
                                            Text {
                                                text: Icons.cloud;
                                                font-family: "Material Icons"; font-size: 20px;
                                                color: EinkTheme.text-secondary;
                                                horizontal-alignment: center; vertical-alignment: center;
                                                width: parent.width; height: parent.height;
                                            }
                                        }
                                        VerticalLayout {
                                            spacing: 2px; alignment: center; horizontal-stretch: 1;
                                            Text { text: "Drive (notes)"; font-size: 13px; font-weight: 700; color: EinkTheme.btn-fg; }
                                            Text { text: "Coming soon — WebDAV / Drive sync"; font-size: 11px; color: EinkTheme.text-secondary; }
                                        }
                                        Rectangle {
                                            width: 72px; height: 32px;
                                            background: EinkTheme.btn-bg;
                                            border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                                            Text { text: "Info"; font-size: 12px; color: EinkTheme.btn-fg;
                                                   horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea {
                                                clicked => {
                                                    root.connect-soon-title = "Drive for notes";
                                                    root.connect-soon-body = "File sync (WebDAV first, Google Drive later) will let each profile keep notes in the cloud.";
                                                    root.connect-soon-visible = true;
                                                }
                                            }
                                        }
                                    }
                                    Rectangle {
                                        x: 12px; y: parent.height - 1px; width: parent.width - 24px; height: 1px;
                                        background: EinkTheme.chrome-border; opacity: 0.35;
                                    }
                                }

                                // ── TASKS ────────────────────────────────
                                Rectangle {
                                    height: 32px;
                                    background: EinkTheme.canvas-bg;
                                    Text {
                                        x: 16px; y: 0; width: parent.width - 16px; height: parent.height;
                                        text: "TASKS";
                                        font-size: 11px; font-weight: 700; color: EinkTheme.text-secondary;
                                        vertical-alignment: center;
                                    }
                                }

                                Rectangle {
                                    height: 64px;
                                    background: EinkTheme.canvas-bg;
                                    HorizontalLayout {
                                        padding-left: 12px; padding-right: 12px;
                                        padding-top: 10px; padding-bottom: 10px;
                                        spacing: 10px;
                                        Rectangle {
                                            width: 36px; height: 36px;
                                            border-radius: 4px;
                                            background: EinkTheme.btn-bg;
                                            border-width: 2px; border-color: EinkTheme.btn-border;
                                            Text {
                                                text: Icons.tasks;
                                                font-family: "Material Icons"; font-size: 20px;
                                                color: EinkTheme.text-secondary;
                                                horizontal-alignment: center; vertical-alignment: center;
                                                width: parent.width; height: parent.height;
                                            }
                                        }
                                        VerticalLayout {
                                            spacing: 2px; alignment: center; horizontal-stretch: 1;
                                            Text { text: "Todoist"; font-size: 13px; font-weight: 700; color: EinkTheme.btn-fg; }
                                            Text { text: "Coming soon"; font-size: 11px; color: EinkTheme.text-secondary; }
                                        }
                                        Rectangle {
                                            width: 72px; height: 32px;
                                            background: EinkTheme.btn-bg;
                                            border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                                            Text { text: "Info"; font-size: 12px; color: EinkTheme.btn-fg;
                                                   horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea {
                                                clicked => {
                                                    root.connect-soon-title = "Todoist";
                                                    root.connect-soon-body = "Todoist will connect as a task provider for this profile. Obsidian vault tasks work today when a vault is set up.";
                                                    root.connect-soon-visible = true;
                                                }
                                            }
                                        }
                                    }
                                    Rectangle {
                                        x: 12px; y: parent.height - 1px; width: parent.width - 24px; height: 1px;
                                        background: EinkTheme.chrome-border; opacity: 0.35;
                                    }
                                }

                                // ── CALENDAR ─────────────────────────────
                                Rectangle {
                                    height: 32px;
                                    background: EinkTheme.canvas-bg;
                                    HorizontalLayout {
                                        padding-left: 16px; padding-right: 12px;
                                        spacing: 8px;
                                        Text {
                                            text: "CALENDAR";
                                            font-size: 11px; font-weight: 700; color: EinkTheme.text-secondary;
                                            vertical-alignment: center; horizontal-stretch: 1;
                                        }
                                        Text {
                                            text: root.connect-calendar-count == 0
                                                ? "None set up"
                                                : root.connect-calendar-count == 1
                                                    ? "1 connected"
                                                    : "\{root.connect-calendar-count} connected";
                                            font-size: 11px; color: EinkTheme.text-secondary;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                for conn[i] in root.connection-list: Rectangle {
                                    visible: conn.kind == "calendar" && conn.profile-id == root.connect-profile-id;
                                    height: self.visible ? 72px : 0px;
                                    background: EinkTheme.canvas-bg;
                                    clip: true;
                                    VerticalLayout {
                                        padding-left: 12px; padding-right: 12px;
                                        padding-top: 8px; padding-bottom: 6px;
                                        spacing: 4px;

                                        HorizontalLayout {
                                            spacing: 10px;
                                            Rectangle {
                                                width: 36px; height: 36px;
                                                border-radius: 4px;
                                                background: EinkTheme.btn-bg;
                                                border-width: 2px; border-color: EinkTheme.btn-border;
                                                Text {
                                                    text: Icons.calendar;
                                                    font-family: "Material Icons"; font-size: 20px;
                                                    color: EinkTheme.btn-fg;
                                                    horizontal-alignment: center; vertical-alignment: center;
                                                    width: parent.width; height: parent.height;
                                                }
                                            }
                                            VerticalLayout {
                                                spacing: 2px; alignment: center; horizontal-stretch: 1;
                                                Text { text: conn.display; font-size: 13px; font-weight: 700; color: EinkTheme.btn-fg; overflow: elide; }
                                                Text { text: conn.value; font-size: 10px; color: EinkTheme.text-secondary; overflow: elide; }
                                            }
                                            Rectangle {
                                                width: 28px; height: 28px;
                                                Text { text: Icons.delete; font-family: "Material Icons"; font-size: 16px;
                                                       color: EinkTheme.danger-fg;
                                                       horizontal-alignment: center; vertical-alignment: center;
                                                       width: parent.width; height: parent.height; }
                                                TouchArea { clicked => { root.connection-remove(i); } }
                                            }
                                        }

                                        Rectangle {
                                            height: 24px;
                                            HorizontalLayout {
                                                padding-left: 46px; spacing: 6px;
                                                Text {
                                                    text: conn.allow-in-aggregated ? Icons.check-box : Icons.check-box-out;
                                                    font-family: "Material Icons"; font-size: 18px; color: EinkTheme.btn-fg;
                                                    vertical-alignment: center;
                                                }
                                                Text {
                                                    text: "Also show when viewing All profiles";
                                                    font-size: 11px; color: EinkTheme.text-secondary;
                                                    vertical-alignment: center; horizontal-stretch: 1;
                                                }
                                            }
                                            TouchArea { clicked => { root.connection-toggle-aggregated(i); } }
                                        }
                                    }
                                    Rectangle {
                                        x: 12px; y: parent.height - 1px; width: parent.width - 24px; height: 1px;
                                        background: EinkTheme.chrome-border; opacity: 0.35;
                                    }
                                }

                                // Add calendar CTA
                                Rectangle {
                                    height: 56px;
                                    background: EinkTheme.canvas-bg;
                                    HorizontalLayout {
                                        padding-left: 12px; padding-right: 12px;
                                        padding-top: 8px; padding-bottom: 8px;
                                        spacing: 10px;

                                        Rectangle {
                                            horizontal-stretch: 1; height: 40px;
                                            background: EinkTheme.btn-bg;
                                            border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                                            HorizontalLayout {
                                                spacing: 6px; alignment: center;
                                                Text {
                                                    text: Icons.add-circle;
                                                    font-family: "Material Icons"; font-size: 18px;
                                                    color: EinkTheme.btn-fg; vertical-alignment: center;
                                                }
                                                Text {
                                                    text: root.connect-calendar-count == 0 ? "Set up calendar" : "Add another calendar";
                                                    font-size: 13px; color: EinkTheme.btn-fg;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            TouchArea {
                                                clicked => {
                                                    root.connect-setup-kind = "calendar";
                                                    root.connect-setup-url = "";
                                                    root.settings-new-url = "";
                                                    root.connect-setup-visible = true;
                                                }
                                            }
                                        }
                                    }
                                }

                                // Bottom spacer for scroll comfort
                                Rectangle { height: 24px; background: EinkTheme.canvas-bg; }
                            }
                        }
                    }
                }
            }
        }
    }

    // ── File browser ─────────────────────────────────────────────────────
    fb-view := Rectangle {
        visible: root.show-filebrowser;
        x: root.nav-w; y: 0;
        width: parent.width - root.nav-w;
        height: parent.height;
        background: EinkTheme.canvas-bg;
        clip: true;

        VerticalLayout {
            padding: 0px; spacing: 0px;

            Rectangle {
                height: 44px;
                background: EinkTheme.canvas-bg;
                HorizontalLayout {
                    padding-left: 8px; padding-right: 12px;
                    padding-top: 6px; padding-bottom: 6px;
                    spacing: 8px;

                    Rectangle {
                        width: 56px; height: 32px;
                        background: EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        Text { text: "Back"; font-size: 13px; color: EinkTheme.btn-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.fb-cancel(); } }
                    }

                    Text {
                        text: root.fb-current-path;
                        font-size: 11px; color: EinkTheme.text-secondary;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                }
            }

            Rectangle { height: 2px; background: EinkTheme.chrome-border; }

            if root.fb-mode == 0: Rectangle {
                height: 44px;
                background: EinkTheme.canvas-bg;
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px;
                    padding-top: 6px; padding-bottom: 6px;

                    Rectangle {
                        width: 240px; height: 32px;
                        background: EinkTheme.btn-active-bg;
                        border-radius: 4px; border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        Text { text: "Select this folder as Vault";
                               font-size: 12px; color: EinkTheme.btn-active-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.fb-select-vault(root.fb-current-path); } }
                    }

                    Rectangle { horizontal-stretch: 1; }
                }
            }

            if root.fb-mode == 2: Rectangle {
                height: 36px;
                background: EinkTheme.canvas-bg;
                Text {
                    x: 12px; y: 0; width: parent.width - 24px; height: parent.height;
                    text: "Choose a PNG or JPEG image for this profile";
                    font-size: 12px; color: EinkTheme.text-secondary;
                    vertical-alignment: center;
                }
            }

            Flickable {
                vertical-stretch: 1;

                VerticalLayout {
                    for entry[i] in root.fb-entries: Rectangle {
                    height: 44px;
                    background: EinkTheme.canvas-bg;

                    if entry.is-dir: TouchArea {
                        clicked => { root.fb-navigate(entry.full-path); }
                    }

                    HorizontalLayout {
                        padding-left: 12px; padding-right: 12px;
                        padding-top: 4px; padding-bottom: 4px;
                        spacing: 8px;

                        Text {
                            text: entry.is-dir ? (entry.name == ".." ? ".." : (entry.is-vault ? "[V]" : "[D]")) : "[F]";
                            font-size: 12px; color: EinkTheme.text-secondary;
                            vertical-alignment: center;
                            width: 28px; horizontal-alignment: center;
                        }

                        Text {
                            text: entry.name;
                            font-size: 14px; color: EinkTheme.btn-fg;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }

                        if entry.is-vault: Text {
                            text: "vault";
                            font-size: 11px; color: EinkTheme.text-secondary;
                            vertical-alignment: center;
                            width: 44px;
                        }

                        if root.fb-mode == 1 && !entry.is-dir: Rectangle {
                            width: 56px; height: 32px;
                            background: EinkTheme.btn-active-bg;
                            border-radius: 4px; border-width: 2px;
                            border-color: EinkTheme.btn-border;
                            Text { text: "Add"; font-size: 12px; color: EinkTheme.btn-active-fg;
                                   horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.fb-add-ics(entry.full-path); } }
                        }

                        if root.fb-mode == 2 && !entry.is-dir: Rectangle {
                            width: 56px; height: 32px;
                            background: EinkTheme.btn-active-bg;
                            border-radius: 4px; border-width: 2px;
                            border-color: EinkTheme.btn-border;
                            Text { text: "Use"; font-size: 12px; color: EinkTheme.btn-active-fg;
                                   horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.fb-select-profile-icon(entry.full-path); } }
                        }
                    }

                    Rectangle {
                        x: 0; y: parent.height - 1px;
                        width: parent.width; height: 1px;
                        background: EinkTheme.chrome-border; opacity: 0.3;
                    }
                }


                    if root.fb-entries.length == 0: Rectangle {
                        height: 48px;
                        background: EinkTheme.canvas-bg;
                        Text {
                            text: "Empty folder";
                            font-size: 13px; color: EinkTheme.text-secondary;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

    // ── Connect setup modal (vault / calendar) ───────────────────────────
    connect-setup-dialog := Rectangle {
        visible: root.connect-setup-visible;
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        background: EinkTheme.chrome-bg;
        opacity: 0.97;

        Rectangle {
            x: (parent.width - 460px) / 2;
            y: (parent.height - (root.connect-setup-kind == "calendar" ? 320px : 240px)) / 2;
            width: 460px;
            height: root.connect-setup-kind == "calendar" ? 320px : 240px;
            background: EinkTheme.canvas-bg;
            border-radius: 8px;
            border-width: 3px;
            border-color: EinkTheme.chrome-border;

            VerticalLayout {
                padding: 20px; spacing: 14px;

                Text {
                    text: root.connect-setup-kind == "vault" ? "Set up Obsidian Vault" : "Add Calendar";
                    font-size: 16px; font-weight: 700; color: EinkTheme.btn-fg;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.connect-setup-kind == "vault"
                        ? "Choose the vault folder for this profile. Tasks and notes will be read from it."
                        : "Add an ICS calendar file or a subscribe URL for this profile.";
                    font-size: 12px; color: EinkTheme.text-secondary;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                if root.connect-setup-kind == "vault": Rectangle {
                    height: 44px;
                    background: EinkTheme.btn-active-bg;
                    border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                    Text {
                        text: "Browse for vault folder…";
                        font-size: 14px; color: EinkTheme.btn-active-fg;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    TouchArea {
                        clicked => {
                            root.connect-setup-visible = false;
                            root.settings-browse-vault();
                        }
                    }
                }

                if root.connect-setup-kind == "calendar": VerticalLayout {
                    spacing: 10px;

                    Rectangle {
                        height: 44px;
                        background: EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                        HorizontalLayout {
                            spacing: 8px; alignment: center;
                            Text {
                                text: Icons.folder;
                                font-family: "Material Icons"; font-size: 18px;
                                color: EinkTheme.btn-fg; vertical-alignment: center;
                            }
                            Text {
                                text: "Browse .ics file…";
                                font-size: 14px; color: EinkTheme.btn-fg;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea {
                            clicked => {
                                root.connect-setup-visible = false;
                                root.settings-browse-ics();
                            }
                        }
                    }

                    Text {
                        text: "or paste a calendar URL";
                        font-size: 11px; color: EinkTheme.text-secondary;
                        horizontal-alignment: center;
                    }

                    Rectangle {
                        height: 44px;
                        border-radius: 4px; border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        background: EinkTheme.canvas-bg;
                        TextInput {
                            x: 10px; y: 0;
                            width: parent.width - 20px; height: parent.height;
                            font-size: 13px; color: EinkTheme.btn-fg;
                            text <=> root.settings-new-url;
                            vertical-alignment: center;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 16px; alignment: center;

                    Rectangle {
                        width: 120px; height: 44px;
                        background: EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                        Text { text: "Cancel"; font-size: 14px; color: EinkTheme.btn-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea {
                            clicked => {
                                root.connect-setup-visible = false;
                                root.settings-new-url = "";
                            }
                        }
                    }

                    if root.connect-setup-kind == "calendar": Rectangle {
                        width: 120px; height: 44px;
                        background: EinkTheme.btn-active-bg;
                        border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                        Text { text: "Add URL"; font-size: 14px; color: EinkTheme.btn-active-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea {
                            clicked => {
                                if (root.settings-new-url != "") {
                                    root.settings-add-url(root.settings-new-url);
                                    root.connect-setup-visible = false;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ── Connect coming-soon info modal ───────────────────────────────────
    connect-soon-dialog := Rectangle {
        visible: root.connect-soon-visible;
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        background: EinkTheme.chrome-bg;
        opacity: 0.97;

        Rectangle {
            x: (parent.width - 400px) / 2;
            y: (parent.height - 220px) / 2;
            width: 400px; height: 220px;
            background: EinkTheme.canvas-bg;
            border-radius: 8px;
            border-width: 3px;
            border-color: EinkTheme.chrome-border;

            VerticalLayout {
                padding: 20px; spacing: 12px;

                Text {
                    text: Icons.info;
                    font-family: "Material Icons"; font-size: 28px;
                    color: EinkTheme.btn-fg;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.connect-soon-title;
                    font-size: 16px; font-weight: 700; color: EinkTheme.btn-fg;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.connect-soon-body;
                    font-size: 12px; color: EinkTheme.text-secondary;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    vertical-stretch: 1;
                }

                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 120px; height: 40px;
                        background: EinkTheme.btn-active-bg;
                        border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                        Text { text: "Got it"; font-size: 14px; color: EinkTheme.btn-active-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.connect-soon-visible = false; } }
                    }
                }
            }
        }
    }

    // ── Profile add / edit dialog ────────────────────────────────────────
    profile-edit-dialog := Rectangle {
        visible: root.profile-edit-dialog-visible;
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        background: EinkTheme.chrome-bg;
        opacity: 0.97;

        Rectangle {
            x: (parent.width - 480px) / 2;
            y: (parent.height - 480px) / 2;
            width: 480px; height: 480px;
            background: EinkTheme.canvas-bg;
            border-radius: 8px;
            border-width: 3px;
            border-color: EinkTheme.chrome-border;

            VerticalLayout {
                padding: 16px; spacing: 10px;

                Text {
                    text: root.profile-edit-is-new ? "New Profile" : "Edit Profile";
                    font-size: 16px; font-weight: 700; color: EinkTheme.btn-fg;
                    horizontal-alignment: center;
                }

                Rectangle {
                    height: 40px;
                    border-radius: 4px; border-width: 2px;
                    border-color: EinkTheme.btn-border;
                    background: EinkTheme.canvas-bg;
                    TextInput {
                        x: 8px; y: 0;
                        width: parent.width - 16px; height: parent.height;
                        font-size: 14px; color: EinkTheme.btn-fg;
                        text <=> root.profile-edit-name;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: "Icon — life scenarios";
                    font-size: 12px; color: EinkTheme.text-secondary;
                }

                // Row 1: work / home / private / person / kids
                HorizontalLayout {
                    spacing: 8px; alignment: center;
                    for icon-key in ["work", "home", "private", "person", "kids"]: Rectangle {
                        property <bool> sel: !root.profile-edit-has-custom && root.profile-edit-icon == icon-key;
                        property <string> ic:
                            icon-key == "work" ? Icons.profile-work :
                            icon-key == "home" ? Icons.profile-home :
                            icon-key == "private" ? Icons.profile-private :
                            icon-key == "kids" ? Icons.profile-kids :
                            Icons.profile-person;
                        width: 48px; height: 48px;
                        border-radius: 24px;
                        background: sel ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                        border-width: 2px; border-color: sel ? EinkTheme.btn-border : EinkTheme.chrome-border;
                        Text {
                            text: ic; font-family: "Material Icons"; font-size: 24px;
                            color: sel ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                            horizontal-alignment: center; vertical-alignment: center;
                            width: parent.width; height: parent.height;
                        }
                        TouchArea {
                            clicked => {
                                root.profile-edit-has-custom = false;
                                root.profile-edit-icon = icon-key;
                            }
                        }
                    }
                }

                // Row 2: family / party / pets / fitness / music
                HorizontalLayout {
                    spacing: 8px; alignment: center;
                    for icon-key in ["family", "party", "pets", "fitness", "music"]: Rectangle {
                        property <bool> sel: !root.profile-edit-has-custom && root.profile-edit-icon == icon-key;
                        property <string> ic:
                            icon-key == "family" ? Icons.profile-family :
                            icon-key == "party" ? Icons.profile-party :
                            icon-key == "pets" ? Icons.profile-pets :
                            icon-key == "fitness" ? Icons.profile-fitness :
                            Icons.profile-music;
                        width: 48px; height: 48px;
                        border-radius: 24px;
                        background: sel ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                        border-width: 2px; border-color: sel ? EinkTheme.btn-border : EinkTheme.chrome-border;
                        Text {
                            text: ic; font-family: "Material Icons"; font-size: 24px;
                            color: sel ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                            horizontal-alignment: center; vertical-alignment: center;
                            width: parent.width; height: parent.height;
                        }
                        TouchArea {
                            clicked => {
                                root.profile-edit-has-custom = false;
                                root.profile-edit-icon = icon-key;
                            }
                        }
                    }
                }

                // Row 3: cafe / food / travel / beach / creative
                HorizontalLayout {
                    spacing: 8px; alignment: center;
                    for icon-key in ["cafe", "food", "travel", "beach", "creative"]: Rectangle {
                        property <bool> sel: !root.profile-edit-has-custom && root.profile-edit-icon == icon-key;
                        property <string> ic:
                            icon-key == "cafe" ? Icons.profile-cafe :
                            icon-key == "food" ? Icons.profile-food :
                            icon-key == "travel" ? Icons.profile-travel :
                            icon-key == "beach" ? Icons.profile-beach :
                            Icons.profile-creative;
                        width: 48px; height: 48px;
                        border-radius: 24px;
                        background: sel ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                        border-width: 2px; border-color: sel ? EinkTheme.btn-border : EinkTheme.chrome-border;
                        Text {
                            text: ic; font-family: "Material Icons"; font-size: 24px;
                            color: sel ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                            horizontal-alignment: center; vertical-alignment: center;
                            width: parent.width; height: parent.height;
                        }
                        TouchArea {
                            clicked => {
                                root.profile-edit-has-custom = false;
                                root.profile-edit-icon = icon-key;
                            }
                        }
                    }
                }

                // Row 4: code / night / group / school / custom
                HorizontalLayout {
                    spacing: 8px; alignment: center;
                    for icon-key in ["code", "night", "group", "school"]: Rectangle {
                        property <bool> sel: !root.profile-edit-has-custom && root.profile-edit-icon == icon-key;
                        property <string> ic:
                            icon-key == "code" ? Icons.profile-code :
                            icon-key == "night" ? Icons.profile-night :
                            icon-key == "group" ? Icons.profile-group :
                            Icons.profile-school;
                        width: 48px; height: 48px;
                        border-radius: 24px;
                        background: sel ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                        border-width: 2px; border-color: sel ? EinkTheme.btn-border : EinkTheme.chrome-border;
                        Text {
                            text: ic; font-family: "Material Icons"; font-size: 24px;
                            color: sel ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                            horizontal-alignment: center; vertical-alignment: center;
                            width: parent.width; height: parent.height;
                        }
                        TouchArea {
                            clicked => {
                                root.profile-edit-has-custom = false;
                                root.profile-edit-icon = icon-key;
                            }
                        }
                    }
                    // Custom image
                    Rectangle {
                        property <bool> sel: root.profile-edit-has-custom;
                        width: 48px; height: 48px;
                        border-radius: 24px;
                        background: sel ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                        border-width: 2px; border-color: sel ? EinkTheme.btn-border : EinkTheme.chrome-border;
                        if sel: Image {
                            x: 8px; y: 8px; width: 32px; height: 32px;
                            source: root.profile-edit-custom-image;
                        }
                        if !sel: Text {
                            text: Icons.image;
                            font-family: "Material Icons"; font-size: 24px;
                            color: EinkTheme.btn-fg;
                            horizontal-alignment: center; vertical-alignment: center;
                            width: parent.width; height: parent.height;
                        }
                        TouchArea { clicked => { root.settings-browse-profile-icon(); } }
                    }
                }

                Text {
                    text: root.profile-edit-has-custom
                        ? "Custom image selected — tap image circle to change"
                        : "Last circle: choose a custom PNG/JPEG";
                    font-size: 11px; color: EinkTheme.text-secondary;
                    horizontal-alignment: center;
                }

                HorizontalLayout {
                    spacing: 16px; alignment: center;

                    Rectangle {
                        width: 120px; height: 44px;
                        background: EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                        Text { text: "Cancel"; font-size: 14px; color: EinkTheme.btn-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.profile-edit-dialog-visible = false; } }
                    }

                    Rectangle {
                        width: 120px; height: 44px;
                        background: EinkTheme.btn-active-bg;
                        border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                        Text { text: root.profile-edit-is-new ? "Create" : "Save"; font-size: 14px;
                               color: EinkTheme.btn-active-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea {
                            clicked => {
                                if (root.profile-edit-is-new) {
                                    root.settings-profile-add(root.profile-edit-name, root.profile-edit-icon);
                                } else {
                                    root.settings-profile-edit(root.profile-edit-id, root.profile-edit-name, root.profile-edit-icon);
                                }
                                root.profile-edit-dialog-visible = false;
                            }
                        }
                    }
                }
            }
        }
    }

    // ── Task add / edit dialog ───────────────────────────────────────────
    task-dialog := Rectangle {
        visible: root.task-dialog-visible;
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        background: EinkTheme.chrome-bg;
        opacity: 0.95;

        Rectangle {
            x: (parent.width - 440px) / 2;
            y: (parent.height - 420px) / 2;
            width: 440px; height: 420px;
            background: EinkTheme.canvas-bg;
            border-radius: 8px;
            border-width: 3px;
            border-color: EinkTheme.chrome-border;

            VerticalLayout {
                padding: 20px; spacing: 12px;

                Text {
                    text: root.task-dialog-is-edit ? "Edit Task" : "New Task";
                    font-size: 16px; font-weight: 700;
                    color: EinkTheme.btn-fg;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Title";
                    font-size: 11px; color: EinkTheme.text-secondary;
                }
                Rectangle {
                    height: 44px;
                    border-radius: 4px; border-width: 2px;
                    border-color: EinkTheme.btn-border;
                    background: EinkTheme.canvas-bg;

                    TextInput {
                        x: 8px; y: 0px;
                        width: parent.width - 16px;
                        height: parent.height;
                        font-size: 14px; color: EinkTheme.btn-fg;
                        text <=> root.task-dialog-title;
                        vertical-alignment: center;
                        single-line: true;
                    }
                }

                Text {
                    text: "Due (YYYY-MM-DD)";
                    font-size: 11px; color: EinkTheme.text-secondary;
                }
                Rectangle {
                    height: 40px;
                    border-radius: 4px; border-width: 2px;
                    border-color: EinkTheme.btn-border;
                    background: EinkTheme.canvas-bg;

                    TextInput {
                        x: 8px; y: 0px;
                        width: parent.width - 16px;
                        height: parent.height;
                        font-size: 14px; color: EinkTheme.btn-fg;
                        text <=> root.task-dialog-due;
                        vertical-alignment: center;
                        single-line: true;
                        input-type: text;
                    }
                }

                Text {
                    text: "Tags (space-separated)";
                    font-size: 11px; color: EinkTheme.text-secondary;
                }
                Rectangle {
                    height: 40px;
                    border-radius: 4px; border-width: 2px;
                    border-color: EinkTheme.btn-border;
                    background: EinkTheme.canvas-bg;

                    TextInput {
                        x: 8px; y: 0px;
                        width: parent.width - 16px;
                        height: parent.height;
                        font-size: 14px; color: EinkTheme.btn-fg;
                        text <=> root.task-dialog-tags;
                        vertical-alignment: center;
                        single-line: true;
                    }
                }

                HorizontalLayout {
                    spacing: 8px; alignment: center;

                    Rectangle {
                        width: 80px; height: 34px;
                        background: root.task-dialog-priority == 0 ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                        Text { text: "High"; font-size: 13px;
                               color: root.task-dialog-priority == 0 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.task-dialog-priority = 0; } }
                    }

                    Rectangle {
                        width: 80px; height: 34px;
                        background: root.task-dialog-priority == 1 ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                        Text { text: "Medium"; font-size: 13px;
                               color: root.task-dialog-priority == 1 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.task-dialog-priority = 1; } }
                    }

                    Rectangle {
                        width: 80px; height: 34px;
                        background: root.task-dialog-priority == 2 ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                        Text { text: "Low"; font-size: 13px;
                               color: root.task-dialog-priority == 2 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.task-dialog-priority = 2; } }
                    }
                }

                HorizontalLayout {
                    spacing: 16px; alignment: center;

                    Rectangle {
                        width: 120px; height: 48px;
                        background: EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                        Text { text: "Cancel"; font-size: 15px; color: EinkTheme.btn-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.task-dialog-cancel(); } }
                    }

                    Rectangle {
                        width: 120px; height: 48px;
                        background: EinkTheme.btn-active-bg;
                        border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                        Text { text: "Save"; font-size: 15px; color: EinkTheme.btn-active-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea {
                            clicked => {
                                if (root.task-dialog-is-edit) {
                                    root.task-confirm-edit(
                                        root.task-dialog-id,
                                        root.task-dialog-title,
                                        root.task-dialog-priority,
                                        root.task-dialog-due,
                                        root.task-dialog-tags);
                                } else {
                                    root.task-confirm-add(
                                        root.task-dialog-title,
                                        root.task-dialog-priority,
                                        root.task-dialog-due,
                                        root.task-dialog-tags);
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ── Create-in-profile picker (late z-order above nav + notes) ─────────
    Rectangle {
        visible: root.show-create-profile-picker;
        x: 0; y: 0; width: parent.width; height: parent.height;
        background: #00000066;
        TouchArea {
            width: parent.width; height: parent.height;
            clicked => {
                root.show-create-profile-picker = false;
                root.create-profile-pick-cancel();
            }
        }
    }
    Rectangle {
        visible: root.show-create-profile-picker;
        width: 280px;
        // Recordings must belong to a real profile — All is aggregator-only.
        property <int> row-count: root.profile-list.length + (root.create-picker-intent != "rec" ? 1 : 0);
        height: 52px + row-count * 48px + 12px + 48px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: EinkTheme.chrome-bg;
        border-width: 2px; border-color: EinkTheme.chrome-border;
        border-radius: 8px;
        clip: true;

        VerticalLayout {
            padding: 6px; spacing: 2px;

            Rectangle {
                height: 44px;
                Text {
                    text: "Add to profile…";
                    font-size: 14px; font-weight: 600;
                    color: EinkTheme.btn-fg;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width; height: parent.height;
                }
            }

            if root.create-picker-intent != "rec": Rectangle {
                height: 48px;
                border-radius: 4px;
                background: EinkTheme.btn-bg;
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px;
                    spacing: 10px; alignment: start;
                    Text {
                        text: Icons.profile-group;
                        font-family: "Material Icons"; font-size: 22px;
                        color: EinkTheme.btn-fg;
                        vertical-alignment: center; width: 28px;
                    }
                    Text {
                        text: "All profiles";
                        font-size: 14px; color: EinkTheme.btn-fg;
                        vertical-alignment: center; horizontal-stretch: 1;
                    }
                }
                TouchArea {
                    width: parent.width; height: parent.height;
                    clicked => {
                        root.show-create-profile-picker = false;
                        root.create-profile-picked(root.create-picker-intent, "");
                    }
                }
            }

            for p in root.profile-list: Rectangle {
                height: 48px;
                border-radius: 4px;
                background: EinkTheme.btn-bg;
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px;
                    spacing: 10px; alignment: start;
                    ProfileIcon {
                        icon-char: p.icon-char; has-custom: p.has-custom-icon; custom-icon: p.custom-icon;
                        size: 24px; fg: EinkTheme.btn-fg;
                    }
                    Text {
                        text: p.name;
                        font-size: 14px; color: EinkTheme.btn-fg;
                        vertical-alignment: center; horizontal-stretch: 1;
                        overflow: elide;
                    }
                }
                TouchArea {
                    width: parent.width; height: parent.height;
                    clicked => {
                        root.show-create-profile-picker = false;
                        root.create-profile-picked(root.create-picker-intent, p.id);
                    }
                }
            }

            Rectangle {
                height: 48px;
                border-radius: 4px;
                background: EinkTheme.canvas-bg;
                border-width: 1px; border-color: EinkTheme.chrome-border;
                Text {
                    text: "Cancel";
                    font-size: 14px; color: EinkTheme.btn-fg;
                    horizontal-alignment: center; vertical-alignment: center;
                    width: parent.width; height: parent.height;
                }
                TouchArea {
                    width: parent.width; height: parent.height;
                    clicked => {
                        root.show-create-profile-picker = false;
                        root.create-profile-pick-cancel();
                    }
                }
            }
        }
    }

    // ── Note rename dialog ───────────────────────────────────────────────
    note-rename-dialog := Rectangle {
        visible: root.note-rename-visible;
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        background: EinkTheme.chrome-bg;
        opacity: 0.95;

        Rectangle {
            x: (parent.width - 380px) / 2;
            y: (parent.height - 200px) / 2;
            width: 380px; height: 200px;
            background: EinkTheme.canvas-bg;
            border-radius: 8px;
            border-width: 3px;
            border-color: EinkTheme.chrome-border;

            VerticalLayout {
                padding: 20px; spacing: 14px;

                Text {
                    text: "Rename Note";
                    font-size: 16px; font-weight: 700;
                    color: EinkTheme.btn-fg;
                    horizontal-alignment: center;
                }

                Rectangle {
                    height: 44px;
                    border-radius: 4px; border-width: 2px;
                    border-color: EinkTheme.btn-border;
                    background: EinkTheme.canvas-bg;

                    TextInput {
                        x: 8px; y: 0;
                        width: parent.width - 16px;
                        height: parent.height;
                        font-size: 14px; color: EinkTheme.btn-fg;
                        text <=> root.note-rename-title;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 12px; alignment: center;

                    Rectangle {
                        width: 110px; height: 42px;
                        background: EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        Text { text: "Cancel"; font-size: 14px; color: EinkTheme.btn-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.note-rename-cancel(); } }
                    }

                    Rectangle {
                        width: 110px; height: 42px;
                        background: EinkTheme.btn-active-bg;
                        border-radius: 4px; border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        Text { text: "Rename"; font-size: 14px; color: EinkTheme.btn-active-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea {
                            clicked => {
                                root.note-rename-confirm(root.note-rename-id, root.note-rename-title);
                            }
                        }
                    }
                }
            }
        }
    }

    // ── Note move dialog ─────────────────────────────────────────────────
    note-move-dialog := Rectangle {
        visible: root.note-move-visible;
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        background: EinkTheme.chrome-bg;
        opacity: 0.95;

        Rectangle {
            x: (parent.width - 360px) / 2;
            y: (parent.height - 320px) / 2;
            width: 360px;
            height: 320px;
            background: EinkTheme.canvas-bg;
            border-radius: 8px;
            border-width: 3px;
            border-color: EinkTheme.chrome-border;
            clip: true;

            VerticalLayout {
                padding: 0px; spacing: 0px;

                Rectangle {
                    height: 44px;
                    background: EinkTheme.canvas-bg;
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 16px;
                        padding-top: 8px; padding-bottom: 8px;
                        Text {
                            text: "Move to Folder";
                            font-size: 15px; font-weight: 700;
                            color: EinkTheme.btn-fg;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            horizontal-alignment: center;
                        }
                    }
                }

                Rectangle { height: 2px; background: EinkTheme.chrome-border; }

                // Root (unfiled)
                Rectangle {
                    height: 48px;
                    background: EinkTheme.canvas-bg;
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 16px;
                        padding-top: 8px; padding-bottom: 8px;
                        Text {
                            text: "Root (no folder)";
                            font-size: 14px; color: EinkTheme.btn-fg;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                    TouchArea {
                        clicked => {
                            root.note-move-confirm(root.note-move-note-id, "0");
                        }
                    }
                    Rectangle {
                        x: 0; y: parent.height - 1px;
                        width: parent.width; height: 1px;
                        background: EinkTheme.chrome-border; opacity: 0.3;
                    }
                }

                for nb[i] in root.notebook-list: Rectangle {
                    height: 48px;
                    background: EinkTheme.canvas-bg;

                    HorizontalLayout {
                        padding-left: 16px; padding-right: 16px;
                        padding-top: 8px; padding-bottom: 8px;
                        Text {
                            text: nb.title;
                            font-size: 14px; color: EinkTheme.btn-fg;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                    TouchArea {
                        clicked => {
                            root.note-move-confirm(root.note-move-note-id, nb.id);
                        }
                    }
                    Rectangle {
                        x: 0; y: parent.height - 1px;
                        width: parent.width; height: 1px;
                        background: EinkTheme.chrome-border; opacity: 0.3;
                    }
                }

                Rectangle {
                    height: 56px;
                    background: EinkTheme.canvas-bg;
                    HorizontalLayout {
                        padding: 10px;
                        alignment: center;
                        Rectangle {
                            width: 120px; height: 36px;
                            background: EinkTheme.btn-bg;
                            border-radius: 4px; border-width: 2px;
                            border-color: EinkTheme.btn-border;
                            Text { text: "Cancel"; font-size: 14px; color: EinkTheme.btn-fg;
                                   horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.note-move-cancel(); } }
                        }
                    }
                }
            }
        }
    }

    // ── Notebook rename / new-folder dialog ───────────────────────────────
    notebook-rename-dialog := Rectangle {
        visible: root.notebook-rename-visible;
        x: 0; y: 0; width: parent.width; height: parent.height;
        background: #00000040;

        Rectangle {
            x: parent.width / 2 - 220px;
            y: parent.height / 2 - 120px;
            width: 440px; height: 240px;
            background: EinkTheme.canvas-bg;
            border-radius: 8px; border-width: 2px; border-color: EinkTheme.chrome-border;

            VerticalLayout {
                padding: 20px; spacing: 16px;

                Text {
                    text: root.notebook-rename-is-create ? "New Folder" : "Rename Folder";
                    font-size: 16px; font-weight: 700;
                    color: EinkTheme.btn-fg;
                    horizontal-alignment: center;
                }

                Rectangle {
                    height: 48px;
                    border-radius: 6px; border-width: 2px; border-color: EinkTheme.btn-border;
                    background: EinkTheme.canvas-bg;
                    Text {
                        visible: root.notebook-rename-title == "";
                        x: 10px; y: 0;
                        width: parent.width - 20px; height: parent.height;
                        text: "Folder name";
                        font-size: 15px; color: EinkTheme.text-secondary;
                        vertical-alignment: center;
                    }
                    TextInput {
                        x: 10px; y: 0;
                        width: parent.width - 20px; height: parent.height;
                        font-size: 15px; color: EinkTheme.btn-fg;
                        text <=> root.notebook-rename-title;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 16px; alignment: center;

                    Rectangle {
                        width: 140px; height: 44px;
                        background: EinkTheme.btn-bg;
                        border-radius: 6px; border-width: 2px; border-color: EinkTheme.btn-border;
                        Text { text: "Cancel"; font-size: 14px; color: EinkTheme.btn-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.notebook-rename-cancel(); } }
                    }

                    Rectangle {
                        width: 140px; height: 44px;
                        background: EinkTheme.btn-active-bg;
                        border-radius: 6px; border-width: 2px; border-color: EinkTheme.btn-border;
                        Text {
                            text: root.notebook-rename-is-create ? "Create" : "Rename";
                            font-size: 14px; color: EinkTheme.btn-active-fg;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                        TouchArea {
                            clicked => {
                                root.notebook-rename-confirm(root.notebook-rename-id, root.notebook-rename-title);
                            }
                        }
                    }
                }
            }
        }
    }

    // ── Folder delete confirmation ────────────────────────────────────────
    notebook-delete-dialog := Rectangle {
        visible: root.notebook-delete-visible;
        x: 0; y: 0; width: parent.width; height: parent.height;
        background: #00000040;

        Rectangle {
            x: parent.width / 2 - 220px;
            y: parent.height / 2 - 110px;
            width: 440px; height: 220px;
            background: EinkTheme.canvas-bg;
            border-radius: 8px; border-width: 2px; border-color: EinkTheme.chrome-border;

            VerticalLayout {
                padding: 20px; spacing: 14px;

                Text {
                    text: "Delete folder?";
                    font-size: 16px; font-weight: 700;
                    color: EinkTheme.btn-fg;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.notebook-delete-title;
                    font-size: 14px; font-weight: 600;
                    color: EinkTheme.btn-fg;
                    horizontal-alignment: center;
                    overflow: elide;
                }

                Text {
                    text: root.notebook-delete-message;
                    font-size: 13px;
                    color: EinkTheme.text-secondary;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 16px; alignment: center;

                    Rectangle {
                        width: 140px; height: 44px;
                        background: EinkTheme.btn-bg;
                        border-radius: 6px; border-width: 2px; border-color: EinkTheme.btn-border;
                        Text { text: "Cancel"; font-size: 14px; color: EinkTheme.btn-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea {
                            width: parent.width; height: parent.height;
                            clicked => {
                                root.notebook-delete-visible = false;
                                root.notebook-delete-cancel();
                            }
                        }
                    }

                    Rectangle {
                        width: 140px; height: 44px;
                        background: EinkTheme.btn-active-bg;
                        border-radius: 6px; border-width: 2px; border-color: EinkTheme.btn-border;
                        Text { text: "Delete"; font-size: 14px; color: EinkTheme.btn-active-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea {
                            width: parent.width; height: parent.height;
                            clicked => {
                                root.notebook-delete-visible = false;
                                root.notebook-delete-confirm(root.notebook-delete-id);
                            }
                        }
                    }
                }
            }
        }
    }

    // ── Recording rename dialog ──────────────────────────────────────────────
    rec-rename-dialog := Rectangle {
        visible: root.rec-rename-visible;
        x: 0; y: 0; width: parent.width; height: parent.height;
        background: #00000040;

        Rectangle {
            x: parent.width / 2 - 190px;
            y: parent.height / 2 - 100px;
            width: 380px; height: 200px;
            background: EinkTheme.canvas-bg;
            border-radius: 8px; border-width: 2px; border-color: EinkTheme.chrome-border;

            VerticalLayout {
                padding: 20px; spacing: 14px;

                Text {
                    text: "Rename Recording";
                    font-size: 16px; font-weight: 700;
                    color: EinkTheme.btn-fg;
                    horizontal-alignment: center;
                }

                Rectangle {
                    height: 44px;
                    border-radius: 4px; border-width: 2px;
                    border-color: EinkTheme.btn-border;
                    background: EinkTheme.canvas-bg;
                    TextInput {
                        x: 8px; y: 0;
                        width: parent.width - 16px; height: parent.height;
                        font-size: 14px; color: EinkTheme.btn-fg;
                        text <=> root.rec-rename-title;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 12px; alignment: center;
                    Rectangle {
                        width: 110px; height: 42px;
                        background: EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                        Text { text: "Cancel"; font-size: 14px; color: EinkTheme.btn-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.rec-rename-cancel(); } }
                    }
                    Rectangle {
                        width: 110px; height: 42px;
                        background: EinkTheme.btn-active-bg;
                        border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                        Text { text: "Rename"; font-size: 14px; color: EinkTheme.btn-active-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea {
                            clicked => {
                                root.rec-rename-confirm(root.rec-rename-id, root.rec-rename-title);
                            }
                        }
                    }
                }
            }
        }
    }

    // ── Recording transcription editor ───────────────────────────────────────
    rec-transcription-dialog := Rectangle {
        visible: root.rec-transcription-visible;
        x: 0; y: 0; width: parent.width; height: parent.height;
        background: EinkTheme.canvas-bg;
        clip: true;

        VerticalLayout {
            padding: 0px; spacing: 0px;

            Rectangle {
                height: 44px;
                background: EinkTheme.canvas-bg;
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px;
                    padding-top: 6px; padding-bottom: 6px;
                    spacing: 8px;

                    Rectangle {
                        width: 40px; height: 32px;
                        background: transparent;
                        Text {
                            text: Icons.back;
                            font-family: "Material Icons"; font-size: 22px;
                            color: EinkTheme.btn-fg;
                            horizontal-alignment: center; vertical-alignment: center;
                            width: parent.width; height: parent.height;
                        }
                        TouchArea { clicked => { root.rec-transcription-save(root.rec-transcription-text); } }
                    }

                    Text {
                        text: "Transcription";
                        font-size: 16px; font-weight: 700;
                        color: EinkTheme.btn-fg;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        horizontal-alignment: center;
                    }

                    Rectangle {
                        width: 36px; height: 32px;
                        background: transparent;
                        Text {
                            text: Icons.refresh;
                            font-family: "Material Icons"; font-size: 22px;
                            color: EinkTheme.btn-fg;
                            horizontal-alignment: center; vertical-alignment: center;
                            width: parent.width; height: parent.height;
                        }
                        TouchArea { clicked => { root.rec-transcription-retranscribe(); } }
                    }

                    Rectangle {
                        width: 52px; height: 32px;
                        background: EinkTheme.btn-active-bg;
                        border-radius: 4px; border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        Text { text: "Save"; font-size: 13px; color: EinkTheme.btn-active-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.rec-transcription-save(root.rec-transcription-text); } }
                    }
                }
            }

            Rectangle { height: 2px; background: EinkTheme.chrome-border; }

            Flickable {
                vertical-stretch: 1;
                interactive: true;
                content-height: txn-input.preferred-height + 24px;

                txn-input := TextInput {
                    x: 16px; y: 12px;
                    width: parent.width - 32px;
                    text <=> root.rec-transcription-text;
                    font-size: 14px; color: EinkTheme.btn-fg;
                    wrap: word-wrap;
                    single-line: false;
                }
            }
        }
    }

    // ── Recording status bar (persistent overlay while recording) ────────────
    // Visible over all views — placed late in z-order so it renders on top.
    rec-status-bar := Rectangle {
        visible: root.rec-state != 0;
        x: 0;
        y: parent.height - 44px;
        width: parent.width;
        height: 44px;
        background: EinkTheme.chrome-bg;
        border-width: 2px; border-color: EinkTheme.chrome-border;

        HorizontalLayout {
            padding-left: 12px; padding-right: 8px;
            padding-top: 6px; padding-bottom: 6px;
            spacing: 8px;

            // Record indicator dot
            Text {
                text: Icons.record-dot;
                font-family: "Material Icons";
                font-size: 18px;
                color: root.rec-state == 2 ? EinkTheme.text-secondary : EinkTheme.btn-fg;
                vertical-alignment: center;
                width: 22px;
            }

            // Duration counter
            Text {
                text: root.rec-duration-label;
                font-size: 14px; font-weight: 700;
                color: EinkTheme.btn-fg;
                vertical-alignment: center;
                width: 52px;
            }

            Rectangle { horizontal-stretch: 1; }

            // Pause / resume toggle
            Rectangle {
                width: 40px; height: 32px;
                background: EinkTheme.btn-bg;
                border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                Text {
                    text: root.rec-state == 2 ? Icons.play : Icons.pause;
                    font-family: "Material Icons"; font-size: 20px;
                    color: EinkTheme.btn-fg;
                    horizontal-alignment: center; vertical-alignment: center;
                    width: parent.width; height: parent.height;
                }
                TouchArea {
                    clicked => {
                        if (root.rec-state == 2) {
                            root.rec-resume-tapped();
                        } else {
                            root.rec-pause-tapped();
                        }
                    }
                }
            }

            // Stop and save (done icon = checkmark)
            Rectangle {
                width: 40px; height: 32px;
                background: EinkTheme.btn-active-bg;
                border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                Text {
                    text: Icons.done;
                    font-family: "Material Icons"; font-size: 20px;
                    color: EinkTheme.btn-active-fg;
                    horizontal-alignment: center; vertical-alignment: center;
                    width: parent.width; height: parent.height;
                }
                TouchArea { clicked => { root.rec-stop-tapped(); } }
            }

            // Discard (delete/trash icon)
            Rectangle {
                width: 40px; height: 32px;
                background: EinkTheme.btn-bg;
                border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                Text {
                    text: Icons.delete;
                    font-family: "Material Icons"; font-size: 20px;
                    color: EinkTheme.btn-fg;
                    horizontal-alignment: center; vertical-alignment: center;
                    width: parent.width; height: parent.height;
                }
                TouchArea { clicked => { root.rec-discard-tapped(); } }
            }
        }
    }

    // ── Canvas note title + rename pencil (shown right of nav rail when burger open) ──
    note-title-bar := Rectangle {
        visible: root.drawing-menu-open && root.is-canvas-context;
        x: root.nav-w + 8px;
        y: 8px;
        height: 44px;
        width: parent.width - root.nav-w - 60px;
        background: transparent;

        HorizontalLayout {
            spacing: 4px;
            alignment: start;
            padding: 4px;

            Text {
                text: root.page-title;
                font-size: 13px;
                color: EinkTheme.btn-fg;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }

            // Anchor chip: shown when this note is linked to a calendar day
            if root.note-anchor-label != "": Rectangle {
                height: 26px;
                width: 90px;
                border-radius: 13px;
                border-width: 1px;
                border-color: EinkTheme.btn-border;
                background: EinkTheme.btn-bg;
                HorizontalLayout {
                    spacing: 2px; padding-left: 6px; padding-right: 6px;
                    alignment: center;
                    Text {
                        text: Icons.calendar;
                        font-family: "Material Icons"; font-size: 13px;
                        color: EinkTheme.btn-fg;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.note-anchor-label;
                        font-size: 10px; color: EinkTheme.btn-fg;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                TouchArea { clicked => { root.note-anchor-tapped(); } }
            }

            Rectangle {
                width: 36px;
                background: transparent;
                Text {
                    text: Icons.edit;
                    font-family: "Material Icons";
                    font-size: 18px;
                    color: EinkTheme.btn-fg;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }
                TouchArea {
                    clicked => { root.rename-canvas-note(); }
                }
            }
        }
    }

    // ── Drawing mode burger button (top-right corner) ─────────────────────
    // On top of everything (last in z-order); only visible when canvas is active.
    drawing-burger := Rectangle {
        visible: root.is-canvas-context;
        x: parent.width - 52px;
        y: 8px;
        width: 44px;
        height: 44px;
        background: root.drawing-menu-open ? EinkTheme.btn-active-bg : transparent;
        border-radius: 22px;
        border-width: root.drawing-menu-open ? 2px : 1px;
        border-color: root.drawing-menu-open ? EinkTheme.btn-border : EinkTheme.text-secondary;
        opacity: root.drawing-menu-open ? 1.0 : 0.3;

        Text {
            text: root.drawing-menu-open ? Icons.close : Icons.menu;
            font-family: "Material Icons";
            font-size: 20px;
            color: root.drawing-menu-open ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: parent.width;
            height: parent.height;
        }
        TouchArea {
            clicked => { root.drawing-menu-open = !root.drawing-menu-open; }
        }
    }
}
