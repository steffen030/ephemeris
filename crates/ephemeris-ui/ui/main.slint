    in-out property <string> profile-edit-name: "";
    in-out property <string> profile-edit-icon: "person";
    in-out property <bool> profile-edit-has-custom: false;
    in-out property <image> profile-edit-custom-image;
    // Preview glyph for the selected preset (ignored when custom).
    private property <string> profile-edit-icon-char:
        root.profile-edit-icon == "work" ? Icons.profile-work :
        root.profile-edit-icon == "home" ? Icons.profile-home :
        root.profile-edit-icon == "private" ? Icons.profile-private :
        root.profile-edit-icon == "kids" ? Icons.profile-kids :
        root.profile-edit-icon == "family" ? Icons.profile-family :
        root.profile-edit-icon == "party" ? Icons.profile-party :
        root.profile-edit-icon == "pets" ? Icons.profile-pets :
        root.profile-edit-icon == "fitness" ? Icons.profile-fitness :
        root.profile-edit-icon == "music" ? Icons.profile-music :
        root.profile-edit-icon == "cafe" ? Icons.profile-cafe :
        root.profile-edit-icon == "food" ? Icons.profile-food :
        root.profile-edit-icon == "travel" ? Icons.profile-travel :
        root.profile-edit-icon == "beach" ? Icons.profile-beach :
        root.profile-edit-icon == "creative" ? Icons.profile-creative :
        root.profile-edit-icon == "code" ? Icons.profile-code :
        root.profile-edit-icon == "night" ? Icons.profile-night :
        root.profile-edit-icon == "group" ? Icons.profile-group :
        root.profile-edit-icon == "school" ? Icons.profile-school :
        root.profile-edit-icon == "heart" ? Icons.profile-heart :
        root.profile-edit-icon == "run" ? Icons.profile-run :
        root.profile-edit-icon == "flight" ? Icons.profile-flight :
        Icons.profile-person;

    callback settings-profile-add(string, string);         // name, icon
    callback settings-profile-edit(string, string, string); // id, name, icon
    callback settings-profile-delete(string);              // id
    callback settings-profile-toggle-notes-in-all(string);       // id
    callback settings-profile-toggle-recordings-in-all(string);  // id
    callback settings-browse-profile-icon();               // open image picker for custom icon

    // ── Create-in-profile picker ───────────────────────────────────────────
    in-out property <bool> show-create-profile-picker: false;
    in-out property <string> create-picker-intent: "";  // "note" | "notebook" | "rec" | "canvas" | "canvas-folder"
    callback create-profile-picked(string, string);     // (intent, profile-id)
    callback create-profile-pick-cancel();

    // ── Connections management (settings › Connect) ───────────────────────
    // Profile being configured for connections — never "" (All). Empty only
    // when no profiles exist yet.
    in-out property <string> connect-profile-id: "";
    in property <bool> connect-has-vault: false;
    in property <int> connect-calendar-count: 0;
    in property <[ConnectionEntry]> connection-list: [];

    // Setup modal: "vault" | "calendar" | "vault-git"
    in-out property <bool> connect-setup-visible: false;
    in-out property <string> connect-setup-kind: "";
    in-out property <string> connect-setup-url: "";
    in-out property <string> connect-setup-user: "";
    in-out property <string> connect-setup-pass: "";
    /// Vault-relative folder for local PDF/MD note exports (default Ephemeris).
    in-out property <string> connect-setup-export-subdir: "Ephemeris";
    /// Offer / enable background git pull + autocommit/push for the vault.
    in-out property <bool> connect-setup-git-enabled: false;
    in-out property <bool> connect-setup-git-detected: false;
    // Coming-soon info modal
    in-out property <bool> connect-soon-visible: false;
    in-out property <string> connect-soon-title: "";
    in-out property <string> connect-soon-body: "";
    /// Confirm vault setup options (export path / git) after browsing.
    callback connect-vault-setup-confirm();

    callback connect-profile-changed(string);  // selected profile for Connect tab
    callback connection-add(string, string, string, bool);        // kind, display, value, allow_agg
    callback connection-remove(int);
    callback connection-set-profile(int, string);  // index, profile_id
    callback connection-toggle-aggregated(int);    // index
    callback connection-cycle-profile(int);        // retained for API compat; unused in new UI

    // ── Page-flip swipe detection (finger/mouse; pen gated in app) ────────
    // Book-style edge turns only — not full-canvas scrubbing:
    //   right border → left into page  → swipe-left  (next / create)
    //   left border  → right into page → swipe-right (previous)
    private property <float> swipe-start-x: 0;
    private property <float> swipe-start-y: 0;
    private property <float> swipe-threshold: 50;
    private property <float> page-swipe-edge: 48;

    callback canvas-touch(float, float);
    callback swipe-left();
    callback swipe-right();
    callback tool-selected(string);
    callback pen-width-selected(string);
    callback clear-page();

    // ── Canvas ───────────────────────────────────────────────────────────
    canvas := Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: EinkTheme.canvas-bg;
        clip: true;

        TouchArea {
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.swipe-start-x = self.mouse-x / 1px;
                    root.swipe-start-y = self.mouse-y / 1px;
                    root.canvas-touch(self.mouse-x / 1px, self.mouse-y / 1px);
                } else if (event.kind == PointerEventKind.up) {
                    // Swipe math in floats (Slint TouchArea coords are lengths).
                    if (
                        (self.mouse-x / 1px - root.swipe-start-x >= root.swipe-threshold ||
                         root.swipe-start-x - self.mouse-x / 1px >= root.swipe-threshold) &&
                        ((self.mouse-x / 1px - root.swipe-start-x) * (self.mouse-x / 1px - root.swipe-start-x) >
                         (self.mouse-y / 1px - root.swipe-start-y) * (self.mouse-y / 1px - root.swipe-start-y))
                    ) {
                        if (self.mouse-x / 1px > root.swipe-start-x) {
                            // Finger moved right: only from left border.
                            if (root.swipe-start-x <= root.page-swipe-edge) {
                                root.swipe-right();
                            }
                        } else {
                            // Finger moved left: only from right border.
                            if (root.swipe-start-x >= parent.width / 1px - root.page-swipe-edge) {
                                root.swipe-left();
                            }
                        }
                    }
                }
            }
        }
    }

    // ── Start page ───────────────────────────────────────────────────────
    start-page := Rectangle {
        visible: root.show-start-page;
        x: root.nav-w;
        y: 0;
        width: parent.width - root.nav-w;
        height: parent.height;
        background: EinkTheme.canvas-bg;
        clip: true;

        Flickable {
            width: parent.width;
            height: parent.height;
            content-width: parent.width;
            content-height: start-page-col.preferred-height;

            start-page-col := VerticalLayout {
                padding: 16px;
                spacing: 0px;
                width: start-page.width;

                Rectangle {
                    height: 44px;
                    background: transparent;
                    HorizontalLayout {
                        alignment: space-between;
                        padding-top: 4px;
                        padding-bottom: 4px;

                        Text {
                            text: "Engage";
                            font-size: 18px;
                            font-weight: 700;
                            color: EinkTheme.btn-fg;
                            vertical-alignment: center;
                        }
                        // Subtitle lives in WIP / empty-state copy; chips filter by context.
                        Rectangle {
                            width: 96px; height: 36px;
                            background: EinkTheme.btn-bg;
                            border-radius: 4px;
                            border-width: 2px;
                            border-color: EinkTheme.btn-border;
                            Text {
                                text: "All Tasks \u{2192}";
                                font-size: 13px;
                                color: EinkTheme.btn-fg;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            TouchArea { clicked => { root.start-page-tasks-tapped(); } }
                        }
                    }
                }

                if root.task-wip-warning != "": Rectangle {
                    height: 28px;
                    background: transparent;
                    Text {
                        text: root.task-wip-warning;
                        font-size: 12px;
                        color: EinkTheme.text-secondary;
                        vertical-alignment: center;
                    }
                }

                // Context filter chips for Engage (GTD: what can I do now?)
                Rectangle {
                    height: 36px;
                    background: transparent;
                    HorizontalLayout {
                        spacing: 6px; alignment: start;
                        Rectangle {
                            property <bool> sel: root.task-context-filter == "";
                            width: 44px; height: 28px;
                            background: sel ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                            border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                            Text { text: "Any"; font-size: 11px;
                                   color: sel ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                                   horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => {
                                root.task-context-filter = "";
                                root.task-context-filter-changed("");
                            } }
                        }
                        for c in ["phone", "computer", "home", "errand", "office"]: Rectangle {
                            property <bool> sel: root.task-context-filter == c;
                            height: 28px; width: 72px;
                            background: sel ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                            border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                            Text { text: c; font-size: 11px;
                                   color: sel ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                                   horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => {
                                root.task-context-filter = c;
                                root.task-context-filter-changed(c);
                            } }
                        }
                    }
                }

                Rectangle { height: 2px; background: EinkTheme.chrome-border; }

                // Profile chips only in aggregator ("All") — filter Tasks Ahead, do not switch profile
                if root.active-profile-id == "": Rectangle {
                    height: 40px;
                    background: transparent;
                    HorizontalLayout {
                        padding-left: 4px; padding-right: 4px;
                        padding-top: 4px; padding-bottom: 4px;
                        spacing: 6px; alignment: start;

                        Rectangle {
                            property <bool> sel: root.task-profile-filter == "";
                            width: 44px; height: 32px;
                            background: sel ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                            border-radius: 16px; border-width: 2px;
                            border-color: EinkTheme.btn-border;
                            Text { text: "All"; font-size: 11px;
                                   color: sel ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                                   horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea {
                                clicked => {
                                    root.task-profile-filter = "";
                                    root.task-profile-filter-changed("");
                                }
                            }
                        }

                        for p in root.profile-list: ProfileChip {
                            label: p.name;
                            icon-char: p.icon-char;
                            has-custom: p.has-custom-icon;
                            custom-icon: p.custom-icon;
                            selected: root.task-profile-filter == p.id;
                            pill: true;
                            chip-width: 100px;
                            TouchArea {
                                width: parent.width; height: parent.height;
                                clicked => {
                                    root.task-profile-filter = p.id;
                                    root.task-profile-filter-changed(p.id);
                                }
                            }
                        }
                    }
                }

                // Compact actionable task rows: check + priority + title + due.
                for item[i] in root.task-list: Rectangle {
                    height: 56px;
                    width: start-page.width - 32px;
                    background: transparent;

                    HorizontalLayout {
                        padding-left: 4px; padding-right: 4px;
                        spacing: 8px; alignment: start;

                        Rectangle {
                            width: 26px; height: 26px;
                            y: 15px;
                            border-radius: 4px; border-width: 2px;
                            border-color: EinkTheme.btn-border;
                            background: transparent;
                            TouchArea {
                                width: parent.width; height: parent.height;
                                clicked => { root.task-complete-toggled(item.id); }
                            }
                        }

                        if item.show-profile: Rectangle {
                            width: 22px; height: 26px;
                            y: 15px;
                            background: transparent;
                            ProfileIcon {
                                icon-char: item.profile-icon-char;
                                has-custom: item.has-custom-profile-icon;
                                custom-icon: item.custom-profile-icon;
                                size: 18px; fg: EinkTheme.btn-fg;
                            }
                        }

                        Rectangle {
                            width: 28px; height: 22px;
                            y: 17px;
                            border-radius: 3px;
                            border-width: 1px;
                            border-color: EinkTheme.btn-border;
                            background: EinkTheme.btn-bg;
                            Text {
                                width: parent.width; height: parent.height;
                                text: item.priority-label;
                                font-size: 11px; font-weight: 700;
                                color: EinkTheme.btn-fg;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            background: transparent;
                            VerticalLayout {
                                spacing: 2px; alignment: center;
                                Text {
                                    text: item.title;
                                    font-size: 13px;
                                    color: EinkTheme.btn-fg;
                                    overflow: elide;
                                }
                                if item.due-label != "": Text {
                                    text: item.due-label;
                                    font-size: 11px;
                                    color: item.overdue ? EinkTheme.danger-fg : EinkTheme.text-secondary;
                                }
                            }
                            TouchArea {
                                width: parent.width; height: parent.height;
                                clicked => { root.task-edit-requested(item.id); }
                            }
                        }
                    }

                    Rectangle {
                        x: 0; y: parent.height - 1px;
                        width: parent.width; height: 1px;
                        background: EinkTheme.chrome-border;
                        opacity: 0.3;
                    }
                }

                if root.task-list.length == 0: Rectangle {
                    height: 64px;
                    background: transparent;
                    Text {
                        text: "All clear — nothing actionable in Now/Next";
                        font-size: 14px;
                        color: EinkTheme.text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle { height: 12px; background: transparent; }

                Rectangle {
                    height: 36px;
                    background: transparent;
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;

                        Text {
                            text: "Agenda";
                            font-size: 16px;
                            font-weight: 700;
                            color: EinkTheme.btn-fg;
                            vertical-alignment: center;
                            width: 70px;
                        }

                        Rectangle {
                            width: 44px; height: 28px;
                            background: root.agenda-range == 0 ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                            border-radius: 4px;
                            border-width: 2px;
                            border-color: EinkTheme.btn-border;
                            Text {
                                text: "Day";
                                font-size: 12px;
                                color: root.agenda-range == 0 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            TouchArea { clicked => { root.agenda-range = 0; root.agenda-range-changed(0); } }
                        }

                        Rectangle {
                            width: 52px; height: 28px;
                            background: root.agenda-range == 1 ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                            border-radius: 4px;
                            border-width: 2px;
                            border-color: EinkTheme.btn-border;
                            Text {
                                text: "Week";
                                font-size: 12px;
                                color: root.agenda-range == 1 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            TouchArea { clicked => { root.agenda-range = 1; root.agenda-range-changed(1); } }
                        }

                        Rectangle {
                            width: 58px; height: 28px;
                            background: root.agenda-range == 2 ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                            border-radius: 4px;
                            border-width: 2px;
                            border-color: EinkTheme.btn-border;
                            Text {
                                text: "Month";
                                font-size: 12px;
                                color: root.agenda-range == 2 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            TouchArea { clicked => { root.agenda-range = 2; root.agenda-range-changed(2); } }
                        }
                    }
                }

                Rectangle { height: 2px; background: EinkTheme.chrome-border; }

                for item[i] in root.agenda-list: Rectangle {
                    height: 48px;
                    width: start-page.width - 32px;
                    background: transparent;

                    HorizontalLayout {
                        padding-left: 4px;
                        padding-right: 4px;
                        spacing: 8px;
                        alignment: start;

                        Text {
                            text: item.time-label;
                            font-size: 12px;
                            color: EinkTheme.text-secondary;
                            vertical-alignment: center;
                            width: 64px;
                        }

                        Text {
                            text: item.title;
                            font-size: 14px;
                            color: EinkTheme.btn-fg;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }

                        Text {
                            text: item.location-label;
                            font-size: 11px;
                            color: EinkTheme.text-secondary;
                            vertical-alignment: center;
                            width: 100px;
                            overflow: elide;
                            horizontal-alignment: right;
                        }
                    }

                    Rectangle {
                        x: 0; y: parent.height - 1px;
                        width: parent.width; height: 1px;
                        background: EinkTheme.chrome-border;
                        opacity: 0.3;
                    }
                }

                if root.agenda-list.length == 0: Rectangle {
                    height: 48px;
                    background: transparent;
                    Text {
                        text: "No events in this period";
                        font-size: 13px;
                        color: EinkTheme.text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    // ── Task page ─────────────────────────────────────────────────────────
    task-view := Rectangle {
        visible: root.show-task-view;
        x: root.nav-w; y: 0;
        width: parent.width - root.nav-w;
        height: parent.height;
        background: EinkTheme.canvas-bg;
        clip: true;

        VerticalLayout {
            padding: 0px; spacing: 0px;
            alignment: stretch;

            // ── Header ──────────────────────────────────────────────────
            Rectangle {
                height: 44px;
                background: EinkTheme.canvas-bg;
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px;
                    padding-top: 6px; padding-bottom: 6px;
                    spacing: 8px;

                    Rectangle {
                        width: 40px; height: 32px;
                        background: transparent;
                        Text {
                            text: Icons.back;
                            font-family: "Material Icons"; font-size: 22px;
                            color: EinkTheme.btn-fg;
                            horizontal-alignment: center; vertical-alignment: center;
                            width: parent.width; height: parent.height;
                        }
                        TouchArea { clicked => { root.task-back-tapped(); } }
                    }

                    Text {
                        text: "Tasks";
                        font-size: 16px; font-weight: 700;
                        color: EinkTheme.btn-fg;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        horizontal-alignment: center;
                    }

                    Rectangle {
                        width: 72px; height: 32px;
                        background: EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        Text { text: "Review"; font-size: 12px; color: EinkTheme.btn-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.review-start(); } }
                    }

                    Rectangle {
                        width: 60px; height: 32px;
                        background: EinkTheme.btn-active-bg;
                        border-radius: 4px; border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        Text { text: "+ Add"; font-size: 13px; color: EinkTheme.btn-active-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea {
                            clicked => {
                                root.task-dialog-is-edit = false;
                                root.task-dialog-id = "";
                                root.task-dialog-title = "";
                                root.task-dialog-priority = 2;
                                root.task-dialog-due = "";
                                root.task-dialog-tags = "";
                                root.task-dialog-lane = "next";
                                root.task-dialog-contexts = "";
                                root.task-dialog-waiting = "";
                                root.task-dialog-has-source-note = false;
                                root.task-dialog-visible = true;
                            }
                        }
                    }
                }
            }

            Rectangle { height: 2px; background: EinkTheme.chrome-border; }

            // ── Task search (tasks only) ─────────────────────────────────
            Rectangle {
                height: 44px;
                background: EinkTheme.canvas-bg;
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px;
                    padding-top: 6px; padding-bottom: 6px;
                    spacing: 8px;

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 32px;
                        border-radius: 4px; border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        background: EinkTheme.canvas-bg;
                        task-search-input := TextInput {
                            x: 8px; width: parent.width - 16px; height: parent.height;
                            text <=> root.task-search-query;
                            font-size: 13px; color: EinkTheme.btn-fg;
                            single-line: true;
                            vertical-alignment: center;
                            edited => { root.task-search-changed(self.text); }
                            accepted => { root.task-search-changed(self.text); }
                        }
                    }
                    Rectangle {
                        width: 56px; height: 32px;
                        background: EinkTheme.btn-active-bg;
                        border-radius: 4px; border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        Text {
                            text: "Go";
                            font-size: 13px; color: EinkTheme.btn-active-fg;
                            horizontal-alignment: center; vertical-alignment: center;
                            width: parent.width; height: parent.height;
                        }
                        TouchArea {
                            clicked => { root.task-search-changed(task-search-input.text); }
                        }
                    }
                }
            }

            // ── Horizon lanes ────────────────────────────────────────────
            Rectangle {
                height: 40px;
                background: EinkTheme.canvas-bg;
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px;
                    padding-top: 4px; padding-bottom: 4px;
                    spacing: 6px;

                    Rectangle {
                        property <bool> sel: root.task-lane-filter == "";
                        width: 44px; height: 32px;
                        background: sel ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                        Text { text: "All"; font-size: 12px;
                               color: sel ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => {
                            root.task-lane-filter = "";
                            root.task-lane-changed("");
                        } }
                    }

                    for lane in root.task-lane-list: Rectangle {
                        property <bool> sel: root.task-lane-filter == lane.id;
                        height: 32px; width: 78px;
                        background: sel ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                        Text {
                            text: lane.label + " " + lane.count;
                            font-size: 12px;
                            color: sel ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                        TouchArea { clicked => {
                            root.task-lane-filter = lane.id;
                            root.task-lane-changed(lane.id);
                        } }
                    }

                    Rectangle { horizontal-stretch: 1; }
                }
            }

            // ── Filter bar ──────────────────────────────────────────────
            Rectangle {
                height: 40px;
                background: EinkTheme.canvas-bg;
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px;
                    padding-top: 4px; padding-bottom: 4px;
                    spacing: 6px;

                    for f in ["all", "active", "done"]: Rectangle {
                        property <bool> sel: root.task-filter == f;
                        property <string> lbl: f == "all" ? "All"
                            : f == "active" ? "Active" : "Done";
                        width: 64px; height: 32px;
                        background: sel ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        Text { text: lbl; font-size: 13px;
                               color: sel ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => {
                            root.task-filter = f;
                            root.task-filter-changed(f);
                        } }
                    }

                    Rectangle { horizontal-stretch: 1; }
                }
            }

            // ── Sort bar ────────────────────────────────────────────────
            Rectangle {
                height: 36px;
                background: EinkTheme.canvas-bg;
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px;
                    padding-top: 2px; padding-bottom: 2px;
                    spacing: 4px;

                    Text {
                        text: "Sort:";
                        font-size: 12px; color: EinkTheme.text-secondary;
                        vertical-alignment: center;
                        width: 34px;
                    }

                    for s in ["priority", "due", "title", "added"]: Rectangle {
                        property <bool> sel: root.task-sort == s;
                        property <string> lbl: s == "priority" ? "Priority"
                            : s == "due" ? "Due" : s == "title" ? "Title" : "Added";
                        height: 28px; width: lbl == "Priority" ? 68px : 52px;
                        background: sel ? EinkTheme.btn-active-bg : transparent;
                        border-radius: 4px; border-width: sel ? 2px : 1px;
                        border-color: EinkTheme.btn-border;
                        Text { text: lbl; font-size: 11px;
                               color: sel ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => {
                            root.task-sort = s;
                            root.task-sort-changed(s);
                        } }
                    }

                    Rectangle { horizontal-stretch: 1; }
                }
            }

            Rectangle { height: 2px; background: EinkTheme.chrome-border; }

            // Profile chips only in aggregator ("All") — filter list, do not switch profile
            if root.active-profile-id == "": Rectangle {
                height: 40px;
                background: transparent;
                HorizontalLayout {
                    padding-left: 12px; padding-right: 4px;
                    padding-top: 4px; padding-bottom: 4px;
                    spacing: 6px; alignment: center;

                    Rectangle {
                        property <bool> sel: root.task-profile-filter == "";
                        width: 44px; height: 32px;
                        background: sel ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                        border-radius: 16px; border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        Text { text: "All"; font-size: 11px;
                               color: sel ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                               horizontal-alignment: center; vertical-alignment: center;
                               width: parent.width; height: parent.height; }
                        TouchArea {
                            clicked => {
                                root.task-profile-filter = "";
                                root.task-profile-filter-changed("");
                            }
                        }
                    }

                    for p in root.profile-list: ProfileChip {
                        label: p.name;
                        icon-char: p.icon-char;
                        has-custom: p.has-custom-icon;
                        custom-icon: p.custom-icon;
                        selected: root.task-profile-filter == p.id;
                        pill: true;
                        chip-width: 100px;
                        TouchArea {
                            width: parent.width; height: parent.height;
                            clicked => {
                                root.task-profile-filter = p.id;
                                root.task-profile-filter-changed(p.id);
                            }
                        }
                    }
                }
            }

            Flickable {
                vertical-stretch: 1;
                content-width: root.width - root.nav-w;
                content-height: task-list-col.preferred-height;

                task-list-col := VerticalLayout {
                    spacing: 0px;
                    width: root.width - root.nav-w;

                    // check | profile | prio chip | wrapping title | due | note? | edit
                    for item[i] in root.full-task-list: Rectangle {
                        height: 64px;
                        width: root.width - root.nav-w;
                        background: EinkTheme.canvas-bg;

                        property <length> pad: 12px;
                        property <length> check-w: 26px;
                        property <length> profile-w: item.show-profile ? 22px : 0px;
                        property <length> prio-w: 28px;
                        property <length> due-w: 56px;
                        property <length> note-w: item.has-source-note ? 32px : 0px;
                        property <length> gap: 8px;
                        property <length> x-check: self.pad;
                        property <length> x-profile: self.pad + self.check-w + self.gap;
                        property <length> x-prio: self.x-profile + self.profile-w + (item.show-profile ? self.gap : 0px);
                        property <length> x-title: self.x-prio + self.prio-w + self.gap;
                        property <length> x-note: self.width - self.pad - self.note-w;
                        property <length> x-due: self.x-note - (item.has-source-note ? self.gap : 0px) - self.due-w;
                        property <length> title-w: self.x-due - self.x-title - self.gap;

                        Rectangle {
                            x: x-check;
                            y: 18px;
                            width: check-w; height: check-w;
                            border-radius: 4px; border-width: 2px;
                            border-color: EinkTheme.btn-border;
                            background: item.done ? EinkTheme.btn-active-bg : transparent;
                            Text {
                                text: item.done ? Icons.done : "";
                                font-family: "Material Icons";
                                font-size: 16px; color: EinkTheme.btn-active-fg;
                                horizontal-alignment: center; vertical-alignment: center;
                                width: parent.width; height: parent.height;
                            }
                            TouchArea { clicked => { root.task-complete-toggled(item.id); } }
                        }

                        if item.show-profile: Rectangle {
                            x: x-profile; y: 20px;
                            width: 22px; height: 22px;
                            background: transparent;
                            ProfileIcon {
                                icon-char: item.profile-icon-char;
                                has-custom: item.has-custom-profile-icon;
                                custom-icon: item.custom-profile-icon;
                                size: 18px; fg: EinkTheme.btn-fg;
                            }
                        }

                        Rectangle {
                            x: x-prio; y: 18px;
                            width: prio-w; height: 22px;
                            border-radius: 3px;
                            border-width: 1px;
                            border-color: EinkTheme.btn-border;
                            background: item.priority-int == 0 ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                            Text {
                                width: parent.width; height: parent.height;
                                text: item.priority-label;
                                font-size: 11px; font-weight: 700;
                                color: item.priority-int == 0 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                                horizontal-alignment: center; vertical-alignment: center;
                            }
                            TouchArea { clicked => { root.task-priority-cycle(item.id); } }
                        }

                        // Title tap opens the task (same as home Engage rows).
                        Rectangle {
                            x: x-title; y: 8px;
                            width: title-w > 40px ? title-w : 40px;
                            height: 48px;
                            background: transparent;
                            Text {
                                width: parent.width; height: parent.height;
                                text: item.title;
                                font-size: 13px;
                                color: item.done ? EinkTheme.text-secondary : EinkTheme.btn-fg;
                                wrap: word-wrap;
                                overflow: elide;
                                vertical-alignment: top;
                            }
                            TouchArea {
                                width: parent.width; height: parent.height;
                                clicked => { root.task-edit-requested(item.id); }
                            }
                        }

                        // Scratch-out for completed items (closure cue; stays visible for the day).
                        if item.done: Rectangle {
                            x: x-title;
                            y: 16px;
                            width: title-w > 40px ? title-w : 40px;
                            height: 1.5px;
                            background: EinkTheme.text-secondary;
                            opacity: 0.85;
                        }

                        Text {
                            x: x-due; y: 12px;
                            width: due-w;
                            text: item.due-label;
                            font-size: 11px;
                            color: item.done ? EinkTheme.text-secondary
                                : (item.overdue ? EinkTheme.danger-fg : EinkTheme.text-secondary);
                            horizontal-alignment: right;
                        }

                        if item.has-source-note: Text {
                            x: x-note; y: 0;
                            width: note-w; height: parent.height;
                            text: Icons.notes;
                            font-family: "Material Icons";
                            font-size: 18px; color: EinkTheme.text-secondary;
                            horizontal-alignment: center; vertical-alignment: center;
                            TouchArea { clicked => { root.task-view-source-note(item.id); } }
                        }

                        Rectangle {
                            x: 0; y: parent.height - 1px;
                            width: parent.width; height: 1px;
                            background: EinkTheme.chrome-border; opacity: 0.3;
                        }
                    }

                    if root.full-task-list.length == 0: Rectangle {
                        height: 60px;
                        width: root.width - root.nav-w;
                        background: transparent;
                        Text {
                            text: "No tasks — tap + Add to create one";
                            font-size: 14px; color: EinkTheme.text-secondary;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

    // ── Notes browser (root + nested folders) ────────────────────────────
    // Shared chrome: folder-list (child folders) + note-list (notes here).
    // show-notebook-list = root; show-note-list = inside a folder.
    notebook-list-view := Rectangle {
        visible: root.show-notebook-list || root.show-note-list;
        x: root.nav-w; y: 0;
        width: parent.width - root.nav-w;
        height: parent.height;
        background: EinkTheme.canvas-bg;
        clip: true;

        // 3-up on PineNote portrait; preview pane matches note frame (~3∶4).
        property <int> gallery-cols: 3;
        property <length> gallery-gap: 8px;
        property <length> gallery-col-w: (self.width - gallery-gap * (gallery-cols + 1)) / gallery-cols;
        property <length> gallery-preview-h: gallery-col-w * 4 / 3;
        property <length> gallery-caption-h: 40px;
        property <length> gallery-row-h: gallery-preview-h + gallery-caption-h + gallery-gap;

        VerticalLayout {
            padding: 0px; spacing: 0px;

            Rectangle {
                height: 44px;
                background: EinkTheme.canvas-bg;
                HorizontalLayout {
                    padding-left: 8px; padding-right: 8px;
                    padding-top: 6px; padding-bottom: 6px;
                    spacing: 6px;

                    if !root.notes-at-root: Rectangle {
                        width: 40px; height: 32px;
                        background: EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        Text {
                            text: Icons.back;
                            font-family: "Material Icons";
                            font-size: 20px; color: EinkTheme.btn-fg;
                            horizontal-alignment: center; vertical-alignment: center;
                            width: parent.width; height: parent.height;
                        }
                        TouchArea {
                            width: parent.width; height: parent.height;
                            clicked => { root.notebook-back-tapped(); }
                        }
                    }

                    Text {
                        text: root.notes-at-root ? "Notes" : root.active-notebook-title;
                        font-size: 15px; font-weight: 700;
                        color: EinkTheme.btn-fg;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }

                    // Sort cycle: edited → title → created
                    Rectangle {
                        width: 64px; height: 32px;
                        background: EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        HorizontalLayout {
                            padding-left: 4px; padding-right: 4px;
                            spacing: 2px; alignment: center;
                            Text {
                                text: Icons.sort;
                                font-family: "Material Icons";
                                font-size: 16px; color: EinkTheme.btn-fg;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.notes-sort-mode == "title" ? "A-Z"
                                    : (root.notes-sort-mode == "created" ? "New" : "Edit");
                                font-size: 10px; color: EinkTheme.btn-fg;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea {
                            width: parent.width; height: parent.height;
                            clicked => { root.notes-sort-cycled(); }
                        }
                    }

                    // List / gallery toggle — text label so meaning is clear on eink
                    Rectangle {
                        width: 56px; height: 32px;
                        background: EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        Text {
                            text: root.notes-view-mode == "gallery" ? "List" : "Grid";
                            font-size: 12px; color: EinkTheme.btn-fg;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                        TouchArea {
                            width: parent.width; height: parent.height;
                            clicked => { root.notes-view-mode-toggled(); }
                        }
                    }

                    Rectangle {
                        width: 72px; height: 32px;
                        background: EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        Text {
                            text: "+ Folder";
                            font-size: 12px; color: EinkTheme.btn-fg;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                        TouchArea {
                            width: parent.width; height: parent.height;
                            clicked => { root.notebook-new-tapped(); }
                        }
                    }

                    Rectangle {
                        width: 72px; height: 32px;
                        background: EinkTheme.btn-active-bg;
                        border-radius: 4px; border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        Text {
                            text: "+ Note";
                            font-size: 12px; color: EinkTheme.btn-active-fg;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                        TouchArea {
                            width: parent.width; height: parent.height;
                            clicked => { root.note-new-tapped(); }
                        }
                    }
                }
            }

            // Search within current folder
            Rectangle {
                height: 40px;
                background: EinkTheme.canvas-bg;
                HorizontalLayout {
                    padding-left: 8px; padding-right: 8px;
                    padding-top: 4px; padding-bottom: 4px;
                    spacing: 6px;
                    Text {
                        text: Icons.search;
                        font-family: "Material Icons";
                        font-size: 18px; color: EinkTheme.text-secondary;
                        vertical-alignment: center; width: 24px;
                    }
                    Rectangle {
                        horizontal-stretch: 1; height: 32px;
                        background: EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 1px;
                        border-color: EinkTheme.chrome-border;
                        Text {
                            visible: root.notes-search-query == "";
                            x: 8px; y: 0;
                            width: parent.width - 16px; height: parent.height;
                            text: "Search notes in this folder…";
                            font-size: 13px; color: EinkTheme.text-secondary;
                            vertical-alignment: center;
                        }
                        TextInput {
                            x: 8px; y: 0;
                            width: parent.width - 16px; height: parent.height;
                            font-size: 13px; color: EinkTheme.btn-fg;
                            text <=> root.notes-search-query;
                            edited => { root.notes-search-changed(self.text); }
                            accepted => { root.notes-search-changed(self.text); }
                        }
                    }
                }
            }

            Rectangle { height: 2px; background: EinkTheme.chrome-border; }

            // Scrollable folder + note content
            Flickable {
                vertical-stretch: 1;
                content-width: notebook-list-view.width;
                content-height: notes-scroll-col.preferred-height;

                notes-scroll-col := VerticalLayout {
                    spacing: 0px; padding: 0px;
                    width: notebook-list-view.width;

                    // ── Folders at this level ─────────────────────────────
                    for nb[i] in root.folder-list: Rectangle {
                        height: 56px;
                        width: notebook-list-view.width;
                        background: EinkTheme.canvas-bg;

                        HorizontalLayout {
                            padding-left: 12px; padding-right: 8px;
                            padding-top: 8px; padding-bottom: 8px;
                            spacing: 6px;

                            Text {
                                text: Icons.folder;
                                font-family: "Material Icons";
                                font-size: 22px; color: EinkTheme.btn-fg;
                                vertical-alignment: center;
                                width: 28px;
                            }

                            if nb.show-profile: ProfileIcon {
                                icon-char: nb.profile-icon-char;
                                has-custom: nb.has-custom-profile-icon;
                                custom-icon: nb.custom-profile-icon;
                                size: 20px; fg: EinkTheme.text-secondary;
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                background: transparent;

                                VerticalLayout {
                                    spacing: 2px; alignment: center;

                                    Text {
                                        text: nb.title;
                                        font-size: 15px; color: EinkTheme.btn-fg;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: nb.note-count + " note" + (nb.note-count == 1 ? "" : "s")
                                            + (nb.folder-count > 0
                                                ? (" · " + nb.folder-count + " folder" + (nb.folder-count == 1 ? "" : "s"))
                                                : "");
                                        font-size: 11px; color: EinkTheme.text-secondary;
                                    }
                                }
                                TouchArea {
                                    width: parent.width; height: parent.height;
                                    clicked => { root.notebook-tapped(nb.id); }
                                }
                            }

                            Rectangle {
                                width: 36px;
                                background: transparent;
                                Text {
                                    text: Icons.note-add;
                                    font-family: "Material Icons";
                                    font-size: 22px;
                                    color: EinkTheme.text-secondary;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: parent.width;
                                    height: parent.height;
                                }
                                TouchArea {
                                    width: parent.width; height: parent.height;
                                    clicked => { root.notebook-quick-new-note(nb.id); }
                                }
                            }

                            Rectangle {
                                width: 36px;
                                background: transparent;
                                Text {
                                    text: Icons.rename;
                                    font-family: "Material Icons";
                                    font-size: 20px;
                                    color: EinkTheme.text-secondary;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: parent.width;
                                    height: parent.height;
                                }
                                TouchArea {
                                    width: parent.width; height: parent.height;
                                    clicked => {
                                        root.notebook-rename-is-create = false;
                                        root.notebook-rename-id = nb.id;
                                        root.notebook-rename-title = nb.title;
                                        root.notebook-rename-visible = true;
                                    }
                                }
                            }

                            Rectangle {
                                width: 36px;
                                background: transparent;
                                Text {
                                    text: Icons.delete;
                                    font-family: "Material Icons";
                                    font-size: 20px;
                                    color: EinkTheme.text-secondary;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: parent.width;
                                    height: parent.height;
                                }
                                TouchArea {
                                    width: parent.width; height: parent.height;
                                    clicked => { root.notebook-delete-tapped(nb.id); }
                                }
                            }
                        }

                        Rectangle {
                            x: 0; y: parent.height - 1px;
                            width: parent.width; height: 1px;
                            background: EinkTheme.chrome-border; opacity: 0.3;
                        }
                    }

                    // ── Notes: list view ──────────────────────────────────
                    if root.notes-view-mode != "gallery": VerticalLayout {
                        spacing: 0px; padding: 0px;
                        width: notebook-list-view.width;
                        for note[i] in root.note-list: Rectangle {
                            height: 56px;
                            width: notebook-list-view.width;
                            background: EinkTheme.canvas-bg;

                            HorizontalLayout {
                                padding-left: 12px; padding-right: 8px;
                                padding-top: 8px; padding-bottom: 8px;
                                spacing: 6px;

                                Rectangle {
                                    width: 40px; height: 40px;
                                    background: EinkTheme.btn-bg;
                                    border-radius: 3px; border-width: 1px;
                                    border-color: EinkTheme.chrome-border;
                                    clip: true;
                                    Image {
                                        visible: note.has-preview;
                                        source: note.preview;
                                        width: parent.width; height: parent.height;
                                        image-fit: cover;
                                    }
                                    Text {
                                        visible: !note.has-preview;
                                        text: Icons.notes;
                                        font-family: "Material Icons";
                                        font-size: 18px; color: EinkTheme.text-secondary;
                                        horizontal-alignment: center; vertical-alignment: center;
                                        width: parent.width; height: parent.height;
                                    }
                                }

                                if note.show-profile: ProfileIcon {
                                    icon-char: note.profile-icon-char;
                                    has-custom: note.has-custom-profile-icon;
                                    custom-icon: note.custom-profile-icon;
                                    size: 18px; fg: EinkTheme.text-secondary;
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                    background: transparent;

                                    VerticalLayout {
                                        spacing: 4px; alignment: center;
                                        Text {
                                            text: note.title;
                                            font-size: 14px; color: EinkTheme.btn-fg;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: note.date-label;
                                            font-size: 11px; color: EinkTheme.text-secondary;
                                        }
                                    }
                                    TouchArea {
                                        width: parent.width; height: parent.height;
                                        clicked => { root.note-tapped(note.id); }
                                    }
                                }

                                Rectangle {
                                    width: 36px; height: 36px;
                                    background: EinkTheme.btn-bg;
                                    border-radius: 4px; border-width: 1px;
                                    border-color: EinkTheme.btn-border;
                                    Text {
                                        text: Icons.move;
                                        font-family: "Material Icons";
                                        font-size: 18px; color: EinkTheme.btn-fg;
                                        horizontal-alignment: center; vertical-alignment: center;
                                        width: parent.width; height: parent.height;
                                    }
                                    TouchArea {
                                        width: parent.width; height: parent.height;
                                        clicked => {
                                            root.note-move-note-id = note.id;
                                            root.note-move-visible = true;
                                        }
                                    }
                                }

                                Rectangle {
                                    width: 36px; height: 36px;
                                    background: EinkTheme.btn-bg;
                                    border-radius: 4px; border-width: 1px;
                                    border-color: EinkTheme.btn-border;
                                    Text {
                                        text: Icons.rename;
                                        font-family: "Material Icons";
                                        font-size: 18px; color: EinkTheme.btn-fg;
                                        horizontal-alignment: center; vertical-alignment: center;
                                        width: parent.width; height: parent.height;
                                    }
                                    TouchArea {
                                        width: parent.width; height: parent.height;
                                        clicked => {
                                            root.note-rename-id = note.id;
                                            root.note-rename-title = note.title;
                                            root.note-rename-visible = true;
                                        }
                                    }
                                }

                                Rectangle {
                                    width: 36px; height: 36px;
                                    background: EinkTheme.btn-bg;
                                    border-radius: 4px; border-width: 1px;
                                    border-color: EinkTheme.btn-border;
                                    Text {
                                        text: Icons.delete;
                                        font-family: "Material Icons";
                                        font-size: 18px; color: EinkTheme.btn-fg;
                                        horizontal-alignment: center; vertical-alignment: center;
                                        width: parent.width; height: parent.height;
                                    }
                                    TouchArea {
                                        width: parent.width; height: parent.height;
                                        clicked => { root.note-delete-tapped(note.id); }
                                    }
                                }
                            }

                            Rectangle {
                                x: 0; y: parent.height - 1px;
                                width: parent.width; height: 1px;
                                background: EinkTheme.chrome-border; opacity: 0.3;
                            }
                        }
                    }

                    // ── Notes: gallery view ───────────────────────────────
                    if root.notes-view-mode == "gallery": Rectangle {
                        width: notebook-list-view.width;
                        height: ((root.note-list.length + notebook-list-view.gallery-cols - 1)
                                / notebook-list-view.gallery-cols)
                            * notebook-list-view.gallery-row-h
                            + (root.note-list.length == 0 ? 80px : 8px);
                        background: EinkTheme.canvas-bg;

                        for note[i] in root.note-list: Rectangle {
                            x: notebook-list-view.gallery-gap
                                + Math.mod(i, notebook-list-view.gallery-cols)
                                    * (notebook-list-view.gallery-col-w + notebook-list-view.gallery-gap);
                            y: notebook-list-view.gallery-gap
                                + Math.floor(i / notebook-list-view.gallery-cols)
                                    * notebook-list-view.gallery-row-h;
                            width: notebook-list-view.gallery-col-w;
                            height: notebook-list-view.gallery-preview-h
                                + notebook-list-view.gallery-caption-h;
                            background: EinkTheme.canvas-bg;
                            border-radius: 6px;
                            border-width: 2px;
                            border-color: EinkTheme.chrome-border;
                            clip: true;

                            VerticalLayout {
                                padding: 0px; spacing: 0px;

                                Rectangle {
                                    height: notebook-list-view.gallery-preview-h;
                                    background: EinkTheme.btn-bg;
                                    clip: true;
                                    Image {
                                        visible: note.has-preview;
                                        source: note.preview;
                                        width: parent.width; height: parent.height;
                                        image-fit: contain;
                                    }
                                    Text {
                                        visible: !note.has-preview;
                                        text: Icons.notes;
                                        font-family: "Material Icons";
                                        font-size: 36px; color: EinkTheme.text-secondary;
                                        horizontal-alignment: center; vertical-alignment: center;
                                        width: parent.width; height: parent.height;
                                    }
                                    if note.show-profile: Rectangle {
                                        x: 6px; y: 6px; width: 22px; height: 22px;
                                        background: EinkTheme.canvas-bg;
                                        border-radius: 11px;
                                        border-width: 1px; border-color: EinkTheme.chrome-border;
                                        ProfileIcon {
                                            icon-char: note.profile-icon-char;
                                            has-custom: note.has-custom-profile-icon;
                                            custom-icon: note.custom-profile-icon;
                                            size: 16px; fg: EinkTheme.btn-fg;
                                        }
                                    }
                                    TouchArea {
                                        width: parent.width; height: parent.height;
                                        clicked => { root.note-tapped(note.id); }
                                    }
                                }

                                Rectangle {
                                    height: notebook-list-view.gallery-caption-h;
                                    background: EinkTheme.canvas-bg;
                                    HorizontalLayout {
                                        padding-left: 6px; padding-right: 2px;
                                        spacing: 2px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 0px; alignment: center;
                                            Text {
                                                text: note.title;
                                                font-size: 11px; font-weight: 600;
                                                color: EinkTheme.btn-fg;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: note.date-label;
                                                font-size: 9px; color: EinkTheme.text-secondary;
                                                overflow: elide;
                                            }
                                        }
                                        Rectangle {
                                            width: 28px; height: 28px;
                                            background: transparent;
                                            Text {
                                                text: Icons.rename;
                                                font-family: "Material Icons";
                                                font-size: 16px; color: EinkTheme.btn-fg;
                                                horizontal-alignment: center; vertical-alignment: center;
                                                width: parent.width; height: parent.height;
                                            }
                                            TouchArea {
                                                width: parent.width; height: parent.height;
                                                clicked => {
                                                    root.note-rename-id = note.id;
                                                    root.note-rename-title = note.title;
                                                    root.note-rename-visible = true;
                                                }
                                            }
                                        }
                                        Rectangle {
                                            width: 28px; height: 28px;
                                            background: transparent;
                                            Text {
                                                text: Icons.delete;
                                                font-family: "Material Icons";
                                                font-size: 16px; color: EinkTheme.btn-fg;
                                                horizontal-alignment: center; vertical-alignment: center;
                                                width: parent.width; height: parent.height;
                                            }
                                            TouchArea {
                                                width: parent.width; height: parent.height;
                                                clicked => { root.note-delete-tapped(note.id); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    if root.folder-list.length == 0 && root.note-list.length == 0: Rectangle {
                        height: 80px;
                        width: notebook-list-view.width;
                        background: EinkTheme.canvas-bg;
                        Text {
                            text: root.notes-search-query != ""
                                ? "No notes match this search"
                                : "Empty — tap + Note or + Folder";
                            font-size: 14px; color: EinkTheme.text-secondary;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

    // ── Recordings browser ───────────────────────────────────────────────────
    recording-list-view := Rectangle {
        visible: root.show-recording-list;
        x: root.nav-w; y: 0;
        width: parent.width - root.nav-w;
        height: parent.height;
        background: EinkTheme.canvas-bg;
        clip: true;

        VerticalLayout {
            padding: 0px; spacing: 0px;
            alignment: stretch;

            Rectangle {
                height: 44px;
                background: EinkTheme.canvas-bg;
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px;
                    padding-top: 6px; padding-bottom: 6px;
                    spacing: 8px;

                    Text {
                        text: "Recordings";
                        font-size: 16px; font-weight: 700;
                        color: EinkTheme.btn-fg;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    Rectangle {
                        width: 40px; height: 32px;
                        background: root.rec-state != 0 ? EinkTheme.btn-bg : EinkTheme.btn-active-bg;
                        border-radius: 4px; border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        Text {
                            text: Icons.mic;
                            font-family: "Material Icons";
                            font-size: 20px;
                            color: root.rec-state != 0 ? EinkTheme.text-secondary : EinkTheme.btn-active-fg;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: parent.width; height: parent.height;
                        }
                        TouchArea {
                            clicked => {
                                if (root.rec-state == 0) { root.rec-new-tapped(); }
                            }
                        }
                    }
                }
            }

            Rectangle { height: 2px; background: EinkTheme.chrome-border; }

            // Search (mirrors Tasks)
            Rectangle {
                height: 44px;
                background: EinkTheme.canvas-bg;
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px;
                    padding-top: 6px; padding-bottom: 6px;
                    spacing: 8px;

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 32px;
                        border-radius: 4px; border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        background: EinkTheme.canvas-bg;
                        rec-search-input := TextInput {
                            x: 8px; width: parent.width - 16px; height: parent.height;
                            text <=> root.rec-search-query;
                            font-size: 13px; color: EinkTheme.btn-fg;
                            single-line: true;
                            vertical-alignment: center;
                            edited => { root.rec-search-changed(self.text); }
                            accepted => { root.rec-search-changed(self.text); }
                        }
                    }
                    Rectangle {
                        width: 56px; height: 32px;
                        background: EinkTheme.btn-active-bg;
                        border-radius: 4px; border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        Text {
                            text: "Go";
                            font-size: 13px; color: EinkTheme.btn-active-fg;
                            horizontal-alignment: center; vertical-alignment: center;
                            width: parent.width; height: parent.height;
                        }
                        TouchArea {
                            clicked => { root.rec-search-changed(rec-search-input.text); }
                        }
                    }
                }
            }

            // Sort bar
            Rectangle {
                height: 36px;
                background: EinkTheme.canvas-bg;
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px;
                    padding-top: 2px; padding-bottom: 2px;
                    spacing: 4px;

                    Text {
                        text: "Sort:";
                        font-size: 12px; color: EinkTheme.text-secondary;
                        vertical-alignment: center;
                        width: 34px;
                    }

                    for s in ["date", "title", "duration"]: Rectangle {
                        property <bool> sel: root.rec-sort == s;
                        property <string> lbl: s == "date" ? "Date"
                            : s == "title" ? "Title" : "Length";
                        height: 28px; width: lbl == "Length" ? 56px : 52px;
                        background: sel ? EinkTheme.btn-active-bg : transparent;
                        border-radius: 4px; border-width: sel ? 2px : 1px;
                        border-color: EinkTheme.btn-border;
                        Text { text: lbl; font-size: 11px;
                               color: sel ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => {
                            root.rec-sort = s;
                            root.rec-sort-changed(s);
                        } }
                    }

                    Rectangle { horizontal-stretch: 1; }
                }
            }

            Rectangle { height: 2px; background: EinkTheme.chrome-border; }

            Flickable {
                vertical-stretch: 1;
                content-width: root.width - root.nav-w;
                content-height: rec-list-col.preferred-height;

                rec-list-col := VerticalLayout {
                    spacing: 0px;
                    width: root.width - root.nav-w;

                    for rec[i] in root.recording-list: Rectangle {
                        // Taller when a transcript line is present so preview breathes.
                        height: (rec.is-transcribing || rec.transcript-preview != "") ? 88px : 68px;
                        width: root.width - root.nav-w;
                        background: EinkTheme.canvas-bg;

                        // Fixed columns so aggregator profile badges don't shift title/meta.
                        property <length> pad: 14px;
                        property <length> profile-w: root.active-profile-id == "" ? 26px : 0px;
                        property <length> delete-w: 40px;
                        property <length> gap: 8px;
                        property <length> meta-dur-w: 52px;
                        property <length> meta-date-w: 110px;
                        property <length> x-profile: self.pad;
                        property <length> x-body: self.pad + self.profile-w + (root.active-profile-id == "" ? self.gap : 0px);
                        property <length> x-delete: self.width - self.pad - self.delete-w;
                        property <length> body-w: self.x-delete - self.x-body - self.gap;

                        if root.active-profile-id == "": Rectangle {
                            x: x-profile;
                            y: (parent.height - 20px) / 2;
                            width: 22px; height: 22px;
                            background: transparent;
                            ProfileIcon {
                                icon-char: rec.profile-icon-char;
                                has-custom: rec.has-custom-profile-icon;
                                custom-icon: rec.custom-profile-icon;
                                size: 18px; fg: EinkTheme.btn-fg;
                            }
                        }

                        // Primary body: title → transcript preview → meta columns
                        Rectangle {
                            x: x-body; y: 0;
                            width: body-w > 40px ? body-w : 40px;
                            height: parent.height;
                            background: transparent;

                            VerticalLayout {
                                padding-top: 10px; padding-bottom: 10px;
                                spacing: 3px; alignment: start;

                                Text {
                                    text: rec.title;
                                    font-size: 14px; font-weight: 700;
                                    color: EinkTheme.btn-fg;
                                    overflow: elide;
                                }

                                if rec.is-transcribing: Text {
                                    text: "Transcribing…";
                                    font-size: 12px;
                                    color: EinkTheme.btn-fg;
                                    overflow: elide;
                                }

                                if !rec.is-transcribing && rec.transcript-preview != "": Text {
                                    text: rec.transcript-preview;
                                    font-size: 12px;
                                    color: EinkTheme.text-secondary;
                                    overflow: elide;
                                }

                                HorizontalLayout {
                                    spacing: 0px;
                                    Text {
                                        width: meta-dur-w;
                                        text: rec.duration-label;
                                        font-size: 11px; color: EinkTheme.text-secondary;
                                    }
                                    Text {
                                        width: meta-date-w;
                                        text: rec.date-label;
                                        font-size: 11px; color: EinkTheme.text-secondary;
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                            }

                            TouchArea {
                                width: parent.width; height: parent.height;
                                clicked => { root.rec-open-tapped(rec.id); }
                            }
                        }

                        Rectangle {
                            x: x-delete; y: 0;
                            width: delete-w; height: parent.height;
                            background: transparent;
                            Text {
                                text: Icons.delete;
                                font-family: "Material Icons"; font-size: 20px;
                                color: EinkTheme.text-secondary;
                                horizontal-alignment: center; vertical-alignment: center;
                                width: parent.width; height: parent.height;
                            }
                            TouchArea { clicked => { root.rec-delete-tapped(rec.id); } }
                        }

                        Rectangle {
                            x: 0; y: parent.height - 1px;
                            width: parent.width; height: 1px;
                            background: EinkTheme.chrome-border; opacity: 0.3;
                        }
                    }

                    if root.recording-list.length == 0: Rectangle {
                        height: 100px;
                        width: root.width - root.nav-w;
                        background: EinkTheme.canvas-bg;
                        Text {
                            text: root.rec-search-query != ""
                                ? "No recordings match your search"
                                : "No recordings yet — tap the mic to start";
                            font-size: 14px; color: EinkTheme.text-secondary;
                            horizontal-alignment: center; vertical-alignment: center;
                            width: parent.width; height: parent.height;
                        }
                    }
                }
            }
        }
    }

    // ── Calendar view ────────────────────────────────────────────────────
    calendar-view := Rectangle {
        visible: root.show-calendar;
        x: root.nav-w; y: 0;
        width: parent.width - root.nav-w;
        height: parent.height;
        background: EinkTheme.canvas-bg;
        clip: true;

        // Explicit body size so month grid fills on first open (stretch alone
        // can leave height near-zero until a later layout pass).
        property <length> cal-chrome-h: 81px; // tabs 40 + nav 40 + border 1
        property <length> cal-body-h: self.height - self.cal-chrome-h;
        property <length> cal-body-w: self.width;

        VerticalLayout {
            padding: 0; spacing: 0;

            // Sub-view tabs: Day | Week | Month | Year
            HorizontalLayout {
                height: 40px; spacing: 0;
                for label[i] in ["Day", "Week", "Month", "Year"]: Rectangle {
                    horizontal-stretch: 1;
                    background: root.cal-sub-view == i ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                    border-width: 1px; border-color: EinkTheme.chrome-border;
                    Text {
                        text: label;
                        font-size: 13px;
                        color: root.cal-sub-view == i ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    TouchArea { clicked => { root.cal-sub-view-changed(i); } }
                }
            }

            // Navigation: ← header Today →
            HorizontalLayout {
                height: 40px; spacing: 0;
                Rectangle {
                    width: 48px;
                    Text {
                        text: Icons.nav-prev;
                        font-family: "Material Icons"; font-size: 24px;
                        color: EinkTheme.btn-fg;
                        horizontal-alignment: center; vertical-alignment: center;
                        width: parent.width; height: parent.height;
                    }
                    TouchArea { clicked => { root.cal-prev(); } }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    Text {
                        text: root.cal-header-label;
                        font-size: 15px; font-weight: 700;
                        color: EinkTheme.btn-fg;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                }
                Rectangle {
                    width: 44px;
                    Text {
                        text: Icons.today;
                        font-family: "Material Icons"; font-size: 20px;
                        color: EinkTheme.text-secondary;
                        horizontal-alignment: center; vertical-alignment: center;
                        width: parent.width; height: parent.height;
                    }
                    TouchArea { clicked => { root.cal-today(); } }
                }
                Rectangle {
                    width: 48px;
                    Text {
                        text: Icons.nav-next;
                        font-family: "Material Icons"; font-size: 24px;
                        color: EinkTheme.btn-fg;
                        horizontal-alignment: center; vertical-alignment: center;
                        width: parent.width; height: parent.height;
                    }
                    TouchArea { clicked => { root.cal-next(); } }
                }
            }

            Rectangle { height: 1px; background: EinkTheme.chrome-border; }

            // Content area — switches by sub-view
            Rectangle {
                height: calendar-view.cal-body-h;
                width: calendar-view.cal-body-w;
                clip: true;

                // Month view — single Rectangle owns col-w-f so header and cells share identical positions
                Rectangle {
                    visible: root.cal-sub-view == 2;
                    width: calendar-view.cal-body-w;
                    height: calendar-view.cal-body-h;
                    clip: true;

                    property <float> col-w-f: self.width / 1px / 7;
                    property <float> hdr-h: 24;
                    property <float> row-h-f: (self.height / 1px - hdr-h) / 6;

                    // Day-of-week header row — same math as data cells
                    for hdr[hi] in ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]: Rectangle {
                        x: hi * col-w-f * 1px;
                        y: 0px;
                        width: col-w-f * 1px;
                        height: hdr-h * 1px;
                        background: EinkTheme.chrome-bg;
                        border-width: 1px; border-color: EinkTheme.chrome-border;
                        Text {
                            text: hdr;
                            font-size: 10px; color: EinkTheme.text-secondary;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                    }

                    // Data cells (42 = 6 rows x 7 cols)
                    for day[i] in root.cal-month-days: Rectangle {
                        x: Math.mod(i, 7) * col-w-f * 1px;
                        y: hdr-h * 1px + Math.floor(i / 7) * row-h-f * 1px;
                        width: col-w-f * 1px;
                        height: row-h-f * 1px;
                        background: day.is-today
                            ? EinkTheme.btn-active-bg
                            : EinkTheme.canvas-bg;
                        border-width: 1px;
                        border-color: EinkTheme.chrome-border;

                        Text {
                            visible: day.day != 0;
                            text: day.day;
                            font-size: 13px;
                            color: day.is-today
                                ? EinkTheme.btn-active-fg
                                : (day.in-month ? EinkTheme.btn-fg : EinkTheme.text-secondary);
                            horizontal-alignment: center;
                            y: 4px;
                            width: parent.width;
                        }

                        Text {
                            visible: day.has-events && day.day != 0 && day.first-event-title != "";
                            text: day.first-event-title;
                            font-size: 9px;
                            color: day.is-today
                                ? EinkTheme.btn-active-fg
                                : EinkTheme.text-secondary;
                            horizontal-alignment: center;
                            overflow: elide;
                            y: 22px;
                            width: parent.width - 4px;
                            x: 2px;
                        }

                        Rectangle {
                            visible: day.has-events && day.day != 0;
                            x: parent.width / 2 - 3px;
                            y: parent.height - 7px;
                            width: 6px; height: 6px;
                            border-radius: 3px;
                            background: day.is-today
                                ? EinkTheme.btn-active-fg
                                : EinkTheme.btn-fg;
                        }

                        TouchArea {
                            visible: day.in-month && day.day != 0;
                            clicked => {
                                root.cal-day-tapped(root.cal-year, root.cal-month, day.day);
                            }
                        }
                    }
                }

                // Day view
                Rectangle {
                    visible: root.cal-sub-view == 0;
                    width: calendar-view.cal-body-w;
                    height: calendar-view.cal-body-h;

                    VerticalLayout {
                        padding: 0; spacing: 0;

                        // Day-note strip
                        Rectangle {
                            height: 40px;
                            background: EinkTheme.chrome-bg;
                            border-width: 1px; border-color: EinkTheme.chrome-border;
                            HorizontalLayout {
                                padding-left: 12px; padding-right: 12px;
                                padding-top: 4px; padding-bottom: 4px;
                                spacing: 8px;
                                Text {
                                    text: root.cal-day-note-exists ? "Day note" : "No day note";
                                    font-size: 12px; color: EinkTheme.btn-fg;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                Rectangle {
                                    width: root.cal-day-note-exists ? 84px : 100px;
                                    height: 28px;
                                    background: EinkTheme.btn-active-bg;
                                    border-radius: 4px; border-width: 2px;
                                    border-color: EinkTheme.btn-border;
                                    Text {
                                        text: root.cal-day-note-exists ? "Open note" : "New day note";
                                        font-size: 11px; color: EinkTheme.btn-active-fg;
                                        horizontal-alignment: center; vertical-alignment: center;
                                    }
                                    TouchArea {
                                        clicked => {
                                            root.cal-open-day-note(root.cal-year, root.cal-month, root.cal-day);
                                        }
                                    }
                                }
                            }
                        }

                        if root.cal-events.length == 0: Text {
                            text: "No events today";
                            font-size: 14px; color: EinkTheme.text-secondary;
                            horizontal-alignment: center;
                            height: 60px;
                            vertical-alignment: center;
                        }

                        for event in root.cal-events: Rectangle {
                            height: 60px;
                            background: EinkTheme.canvas-bg;
                            border-width: 1px; border-color: EinkTheme.chrome-border;

                            HorizontalLayout {
                                padding: 8px; spacing: 12px;
                                alignment: center;

                                Text {
                                    text: event.time-label;
                                    font-size: 11px; color: EinkTheme.text-secondary;
                                    vertical-alignment: center;
                                    width: 80px;
                                }
                                Rectangle {
                                    width: 1px; background: EinkTheme.chrome-border;
                                    vertical-stretch: 1;
                                }
                                if event.item-kind == "note": Text {
                                    text: Icons.notes;
                                    font-family: "Material Icons";
                                    font-size: 18px; color: EinkTheme.btn-fg;
                                    vertical-alignment: center;
                                    width: 22px;
                                }
                                if event.item-kind == "recording": Text {
                                    text: Icons.mic;
                                    font-family: "Material Icons";
                                    font-size: 18px; color: EinkTheme.btn-fg;
                                    vertical-alignment: center;
                                    width: 22px;
                                }
                                Text {
                                    text: event.title;
                                    font-size: 14px; color: EinkTheme.btn-fg;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                            }
                            TouchArea {
                                visible: event.item-kind == "note" || event.item-kind == "recording";
                                clicked => {
                                    root.cal-item-tapped(event.item-kind, event.item-id);
                                }
                            }
                        }
                    }
                }

                // Week view — vertical rows, one per day (much more readable than 7 narrow columns)
                Rectangle {
                    visible: root.cal-sub-view == 1;
                    width: calendar-view.cal-body-w;
                    height: calendar-view.cal-body-h;
                    clip: true;

                    VerticalLayout {
                        spacing: 0;

                        for col-label[ci] in root.cal-week-day-labels: VerticalLayout {
                            spacing: 0;

                            Rectangle {
                                height: 32px;
                                background: EinkTheme.chrome-bg;
                                border-width: 1px; border-color: EinkTheme.chrome-border;
                                Text {
                                    text: col-label;
                                    font-size: 12px; font-weight: 600;
                                    color: EinkTheme.btn-fg;
                                    x: 12px; vertical-alignment: center;
                                    height: parent.height;
                                }
                            }

                            for event in root.cal-events: Rectangle {
                                visible: event.col == ci;
                                height: event.col == ci ? 40px : 0px;
                                background: EinkTheme.canvas-bg;
                                border-width: 1px; border-color: EinkTheme.chrome-border;

                                HorizontalLayout {
                                    padding: 6px; spacing: 8px; alignment: center;
                                    Text {
                                        text: event.time-label;
                                        font-size: 10px; color: EinkTheme.text-secondary;
                                        vertical-alignment: center;
                                        width: 72px;
                                    }
                                    if event.item-kind == "note": Text {
                                        text: Icons.notes;
                                        font-family: "Material Icons";
                                        font-size: 14px; color: EinkTheme.btn-fg;
                                        vertical-alignment: center;
                                        width: 18px;
                                    }
                                    if event.item-kind == "recording": Text {
                                        text: Icons.mic;
                                        font-family: "Material Icons";
                                        font-size: 14px; color: EinkTheme.btn-fg;
                                        vertical-alignment: center;
                                        width: 18px;
                                    }
                                    Text {
                                        text: event.title;
                                        font-size: 12px; color: EinkTheme.btn-fg;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                }
                                TouchArea {
                                    visible: event.item-kind == "note" || event.item-kind == "recording";
                                    clicked => {
                                        root.cal-item-tapped(event.item-kind, event.item-id);
                                    }
                                }
                            }
                        }
                    }
                }


                // ── Year view ─────────────────────────────────────────────
                Rectangle {
                    visible: root.cal-sub-view == 3;
                    width: calendar-view.cal-body-w;
                    height: calendar-view.cal-body-h;
                    clip: true;

                    property <float> mw-f: self.width / 1px / 3;
                    property <float> mh-f: self.height / 1px / 4;

                    for month[i] in root.cal-year-months: Rectangle {
                        x: Math.mod(i, 3) * mw-f * 1px;
                        y: Math.floor(i / 3) * mh-f * 1px;
                        width: mw-f * 1px; height: mh-f * 1px;
                        background: EinkTheme.canvas-bg;
                        border-width: 1px; border-color: EinkTheme.chrome-border;

                        VerticalLayout {
                            padding: 8px; spacing: 4px; alignment: center;
                            Text {
                                text: month.name;
                                font-size: 13px; font-weight: 700;
                                color: EinkTheme.btn-fg;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: month.event-count > 0
                                    ? month.event-count + (month.event-count == 1 ? " event" : " events")
                                    : "";
                                font-size: 10px; color: EinkTheme.text-secondary;
                                horizontal-alignment: center;
                            }
                        }
                        TouchArea {
                            clicked => {
                                root.cal-day-tapped(root.cal-year, month.month-num, 1);
                                root.cal-sub-view-changed(2);
                            }
                        }
                    }
                }
            }
        }
    }

    // ── Drawing mode circular ring (burger menu) ─────────────────────────
    // Placed before nav-rail so nav-rail (z-above) remains clickable when both
    // are visible. Items are all at x>80 so they don't overlap with the rail.
    // Full-screen backdrop: blocks canvas ink input and dismisses dropdown on outside tap.
    Rectangle {
        visible: root.drawing-menu-open && root.is-canvas-context;
        x: 0; y: 0; width: parent.width; height: parent.height;
        background: transparent;
        TouchArea { clicked => { root.drawing-menu-open = false; } }
    }

    // ── Burger dropdown (tool & paper selector) ──────────────────────────
    // Icon-primary + micro-label (e-ink UX): glyphs carry the action, short
    // labels keep first-use discoverability without crowding the palette.
    drawing-dropdown := Rectangle {
        visible: root.drawing-menu-open && root.is-canvas-context;
        x: parent.width - 192px; y: 60px;
        // Last row (See text) ends at y 282; +6px bottom padding like the top.
        width: 184px; height: 288px;
        background: EinkTheme.chrome-bg;
        border-width: 2px; border-color: EinkTheme.chrome-border;
        border-radius: 6px;
        clip: true;

        // -- Tool row 1: Pen / Highlight / Eraser --
        Rectangle {
            x: 6px; y: 6px; width: 54px; height: 42px;
            background: root.active-tool == "pen" ? EinkTheme.btn-active-bg : transparent;
            border-radius: 3px;
            Text {
                y: 2px; width: parent.width; height: 24px;
                text: Icons.tool-pen; font-family: "Material Icons"; font-size: 20px;
                color: root.active-tool == "pen" ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                horizontal-alignment: center; vertical-alignment: center;
            }
            Text {
                y: 26px; width: parent.width; height: 14px;
                text: "Pen"; font-size: 9px;
                color: root.active-tool == "pen" ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                horizontal-alignment: center; vertical-alignment: center;
            }
            TouchArea { clicked => { root.active-tool = "pen"; root.tool-selected("pen"); root.drawing-menu-open = false; } }
        }
        Rectangle {
            x: 64px; y: 6px; width: 54px; height: 42px;
            background: root.active-tool == "highlighter" ? EinkTheme.btn-active-bg : transparent;
            border-radius: 3px;
            Text {
                y: 2px; width: parent.width; height: 24px;
                text: Icons.tool-highlight; font-family: "Material Icons"; font-size: 20px;
                color: root.active-tool == "highlighter" ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                horizontal-alignment: center; vertical-alignment: center;
            }
            Text {
                y: 26px; width: parent.width; height: 14px;
                text: "Mark"; font-size: 9px;
                color: root.active-tool == "highlighter" ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                horizontal-alignment: center; vertical-alignment: center;
            }
            TouchArea { clicked => { root.active-tool = "highlighter"; root.tool-selected("highlighter"); root.drawing-menu-open = false; } }
        }
        Rectangle {
            x: 122px; y: 6px; width: 56px; height: 42px;
            background: root.active-tool == "eraser" ? EinkTheme.btn-active-bg : transparent;
            border-radius: 3px;
            Text {
                y: 2px; width: parent.width; height: 24px;
                text: Icons.tool-eraser; font-family: "Material Icons"; font-size: 20px;
                color: root.active-tool == "eraser" ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                horizontal-alignment: center; vertical-alignment: center;
            }
            Text {
                y: 26px; width: parent.width; height: 14px;
                text: "Eraser"; font-size: 9px;
                color: root.active-tool == "eraser" ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                horizontal-alignment: center; vertical-alignment: center;
            }
            TouchArea { clicked => { root.active-tool = "eraser"; root.tool-selected("eraser"); root.drawing-menu-open = false; } }
        }

        // -- Tool row 2: Move / Clear --
        Rectangle {
            x: 6px; y: 52px; width: 84px; height: 42px;
            background: root.active-tool == "move" ? EinkTheme.btn-active-bg : transparent;
            border-radius: 3px;
            Text {
                y: 2px; width: parent.width; height: 24px;
                text: Icons.move; font-family: "Material Icons"; font-size: 20px;
                color: root.active-tool == "move" ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                horizontal-alignment: center; vertical-alignment: center;
            }
            Text {
                y: 26px; width: parent.width; height: 14px;
                text: "Move"; font-size: 9px;
                color: root.active-tool == "move" ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                horizontal-alignment: center; vertical-alignment: center;
            }
            TouchArea { clicked => { root.active-tool = "move"; root.tool-selected("move"); root.drawing-menu-open = false; } }
        }
        Rectangle {
            x: 94px; y: 52px; width: 84px; height: 42px;
            border-radius: 3px;
            Text {
                y: 2px; width: parent.width; height: 24px;
                text: Icons.tool-clear; font-family: "Material Icons"; font-size: 20px;
                color: EinkTheme.danger-fg;
                horizontal-alignment: center; vertical-alignment: center;
            }
            Text {
                y: 26px; width: parent.width; height: 14px;
                text: "Clear"; font-size: 9px; color: EinkTheme.danger-fg;
                horizontal-alignment: center; vertical-alignment: center;
            }
            TouchArea { clicked => { root.clear-page(); root.drawing-menu-open = false; } }
        }

        // -- Pen width: Thin / Med / Thick (same glyph, scaled weight cue)
        Rectangle {
            x: 6px; y: 98px; width: 54px; height: 36px;
            background: root.active-pen-width == "thin" ? EinkTheme.btn-active-bg : transparent;
            border-radius: 3px;
            Text {
                y: 1px; width: parent.width; height: 20px;
                text: Icons.line-weight; font-family: "Material Icons"; font-size: 14px;
                color: root.active-pen-width == "thin" ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                horizontal-alignment: center; vertical-alignment: center;
            }
            Text {
                y: 20px; width: parent.width; height: 14px;
                text: "Thin"; font-size: 9px;
                color: root.active-pen-width == "thin" ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                horizontal-alignment: center; vertical-alignment: center;
            }
            TouchArea { clicked => {
                root.active-pen-width = "thin";
                root.pen-width-selected("thin");
                root.active-tool = "pen";
                root.tool-selected("pen");
                root.drawing-menu-open = false;
            } }
        }
        Rectangle {
            x: 64px; y: 98px; width: 54px; height: 36px;
            background: root.active-pen-width == "medium" ? EinkTheme.btn-active-bg : transparent;
            border-radius: 3px;
            Text {
                y: 1px; width: parent.width; height: 20px;
                text: Icons.line-weight; font-family: "Material Icons"; font-size: 18px;
                color: root.active-pen-width == "medium" ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                horizontal-alignment: center; vertical-alignment: center;
            }
            Text {
                y: 20px; width: parent.width; height: 14px;
                text: "Med"; font-size: 9px;
                color: root.active-pen-width == "medium" ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                horizontal-alignment: center; vertical-alignment: center;
            }
            TouchArea { clicked => {
                root.active-pen-width = "medium";
                root.pen-width-selected("medium");
                root.active-tool = "pen";
                root.tool-selected("pen");
                root.drawing-menu-open = false;
            } }
        }
        Rectangle {
            x: 122px; y: 98px; width: 56px; height: 36px;
            background: root.active-pen-width == "thick" ? EinkTheme.btn-active-bg : transparent;
            border-radius: 3px;
            Text {
                y: 1px; width: parent.width; height: 20px;
                text: Icons.line-weight; font-family: "Material Icons"; font-size: 22px;
                color: root.active-pen-width == "thick" ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                horizontal-alignment: center; vertical-alignment: center;
            }
            Text {
                y: 20px; width: parent.width; height: 14px;
                text: "Thick"; font-size: 9px;
                color: root.active-pen-width == "thick" ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                horizontal-alignment: center; vertical-alignment: center;
            }
            TouchArea { clicked => {
                root.active-pen-width = "thick";
                root.pen-width-selected("thick");
                root.active-tool = "pen";
                root.tool-selected("pen");
                root.drawing-menu-open = false;
            } }
        }

        // Separator
        Rectangle { x: 6px; y: 138px; width: 172px; height: 1px; background: EinkTheme.chrome-border; }

        // -- Paper row 1: Blank / Lined --
        Rectangle {
            x: 6px; y: 143px; width: 84px; height: 42px;
            background: root.active-paper == "blank" ? EinkTheme.btn-active-bg : transparent;
            border-radius: 3px;
            Text {
                y: 2px; width: parent.width; height: 24px;
                text: Icons.paper-blank; font-family: "Material Icons"; font-size: 20px;
                color: root.active-paper == "blank" ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                horizontal-alignment: center; vertical-alignment: center;
            }
            Text {
                y: 26px; width: parent.width; height: 14px;
                text: "Blank"; font-size: 9px;
                color: root.active-paper == "blank" ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                horizontal-alignment: center; vertical-alignment: center;
            }
            TouchArea { clicked => { root.active-paper = "blank"; root.paper-type-tapped("blank"); root.drawing-menu-open = false; } }
        }
        Rectangle {
            x: 94px; y: 143px; width: 84px; height: 42px;
            background: root.active-paper == "lined" ? EinkTheme.btn-active-bg : transparent;
            border-radius: 3px;
            Text {
                y: 2px; width: parent.width; height: 24px;
                text: Icons.paper-lined; font-family: "Material Icons"; font-size: 20px;
                color: root.active-paper == "lined" ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                horizontal-alignment: center; vertical-alignment: center;
            }
            Text {
                y: 26px; width: parent.width; height: 14px;
                text: "Lined"; font-size: 9px;
                color: root.active-paper == "lined" ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                horizontal-alignment: center; vertical-alignment: center;
            }
            TouchArea { clicked => { root.active-paper = "lined"; root.paper-type-tapped("lined"); root.drawing-menu-open = false; } }
        }

        // -- Paper row 2: Dotted / Squared --
        Rectangle {
            x: 6px; y: 189px; width: 84px; height: 42px;
            background: root.active-paper == "dotted" ? EinkTheme.btn-active-bg : transparent;
            border-radius: 3px;
            Text {
                y: 2px; width: parent.width; height: 24px;
                text: Icons.paper-dotted; font-family: "Material Icons"; font-size: 20px;
                color: root.active-paper == "dotted" ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                horizontal-alignment: center; vertical-alignment: center;
            }
            Text {
                y: 26px; width: parent.width; height: 14px;
                text: "Dotted"; font-size: 9px;
                color: root.active-paper == "dotted" ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                horizontal-alignment: center; vertical-alignment: center;
            }
            TouchArea { clicked => { root.active-paper = "dotted"; root.paper-type-tapped("dotted"); root.drawing-menu-open = false; } }
        }
        Rectangle {
            x: 94px; y: 189px; width: 84px; height: 42px;
            background: root.active-paper == "squared" ? EinkTheme.btn-active-bg : transparent;
            border-radius: 3px;
            Text {
                y: 2px; width: parent.width; height: 24px;
                text: Icons.paper-squared; font-family: "Material Icons"; font-size: 20px;
                color: root.active-paper == "squared" ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                horizontal-alignment: center; vertical-alignment: center;
            }
            Text {
                y: 26px; width: parent.width; height: 14px;
                text: "Grid"; font-size: 9px;
                color: root.active-paper == "squared" ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                horizontal-alignment: center; vertical-alignment: center;
            }
            TouchArea { clicked => { root.active-paper = "squared"; root.paper-type-tapped("squared"); root.drawing-menu-open = false; } }
        }

        // Separator
        Rectangle { x: 6px; y: 235px; width: 172px; height: 1px; background: EinkTheme.chrome-border; }

        // -- See text toggle (OCR / transcribed layer)
        Rectangle {
            x: 6px; y: 240px; width: 172px; height: 42px;
            background: root.note-see-text ? EinkTheme.btn-active-bg : transparent;
            border-radius: 3px;
            Text {
                x: 10px; y: 2px; width: 28px; height: 38px;
                text: Icons.see-text; font-family: "Material Icons"; font-size: 20px;
                color: root.note-see-text ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                horizontal-alignment: center; vertical-alignment: center;
            }
            Text {
                x: 40px; width: parent.width - 50px; height: parent.height;
                text: root.note-see-text ? "See text ✓" : "See text";
                font-size: 12px;
                color: root.note-see-text ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                horizontal-alignment: left; vertical-alignment: center;
            }
            TouchArea {
                clicked => {
                    root.note-see-text = !root.note-see-text;
                    root.note-see-text-toggled(root.note-see-text);
                    root.drawing-menu-open = false;
                }
            }
        }

    }

    // Page X/Y + prev/next — visible only while the note burger menu is open.
    // Buttons use the same next/create and prev rules as finger edge swipes.
    note-page-indicator := Rectangle {
        visible: root.drawing-menu-open && root.is-canvas-context;
        x: parent.width - 168px;
        y: parent.height - 40px;
        width: 158px;
        height: 28px;
        background: EinkTheme.chrome-bg;
        border-width: 1px;
        border-color: EinkTheme.chrome-border;
        border-radius: 4px;

        HorizontalLayout {
            spacing: 0px;
            padding-left: 2px;
            padding-right: 2px;
            alignment: center;

            Rectangle {
                width: 32px; height: parent.height;
                background: transparent;
                opacity: root.page-index > 1 ? 1.0 : 0.35;
                Text {
                    text: Icons.nav-prev;
                    font-family: "Material Icons";
                    font-size: 18px;
                    color: EinkTheme.btn-fg;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width; height: parent.height;
                }
                TouchArea {
                    clicked => {
                        if (root.page-index > 1) {
                            root.page-prev-tapped();
                        }
                    }
                }
            }

            Text {
                horizontal-stretch: 1;
                text: "\{root.page-index}/\{root.page-count}";
                font-size: 13px;
                color: EinkTheme.btn-fg;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            Rectangle {
                width: 32px; height: parent.height;
                background: transparent;
                Text {
                    text: Icons.nav-next;
                    font-family: "Material Icons";
                    font-size: 18px;
                    color: EinkTheme.btn-fg;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width; height: parent.height;
                }
                TouchArea { clicked => { root.page-next-tapped(); } }
            }
        }
    }

    // See-text: first-class reading view for OCR / transcribed note text.
    // Nav rail stays visible (is-canvas-context excludes note-see-text).
    see-text-view := Rectangle {
        visible: root.note-see-text
            && !root.show-start-page && !root.show-task-view
            && !root.show-settings && !root.show-filebrowser
            && !root.show-note-list && !root.show-notebook-list
            && !root.show-calendar && !root.show-recording-list
            && !root.show-search && !root.show-md-viewer;
        x: root.nav-w;
        y: 0;
        width: parent.width - root.nav-w;
        height: parent.height;
        background: EinkTheme.canvas-bg;
        clip: true;

        property <bool> has-body: root.see-text-lines.length > 0;

        VerticalLayout {
            padding: 0px;
            spacing: 0px;

            // Header: return to ink + note title + mode badge
            Rectangle {
                height: 52px;
                background: EinkTheme.chrome-bg;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 12px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 10px;
                    alignment: stretch;

                    Rectangle {
                        width: 72px;
                        height: 36px;
                        border-radius: 4px;
                        border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        background: EinkTheme.btn-bg;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 8px;
                            spacing: 2px;
                            alignment: center;
                            Text {
                                text: Icons.back;
                                font-family: "Material Icons";
                                font-size: 18px;
                                color: EinkTheme.btn-fg;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "Ink";
                                font-size: 13px;
                                font-weight: 700;
                                color: EinkTheme.btn-fg;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea {
                            clicked => {
                                root.see-text-edit-open = false;
                                root.note-see-text = false;
                                root.note-see-text-toggled(false);
                            }
                        }
                    }

                    Text {
                        text: root.page-title == "" ? "Untitled" : root.page-title;
                        font-size: 16px;
                        font-weight: 700;
                        color: EinkTheme.btn-fg;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }

                    Rectangle {
                        width: 64px;
                        height: 28px;
                        border-radius: 4px;
                        border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        background: EinkTheme.btn-active-bg;
                        HorizontalLayout {
                            spacing: 4px;
                            alignment: center;
                            Text {
                                text: Icons.notes;
                                font-family: "Material Icons";
                                font-size: 14px;
                                color: EinkTheme.btn-active-fg;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "Text";
                                font-size: 11px;
                                font-weight: 700;
                                color: EinkTheme.btn-active-fg;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            Rectangle { height: 2px; background: EinkTheme.chrome-border; }

            if see-text-view.has-body: Flickable {
                vertical-stretch: 1;
                width: parent.width;
                content-width: parent.width;
                content-height: see-text-body.preferred-height;

                see-text-body := VerticalLayout {
                    width: parent.width;
                    padding-left: 20px;
                    padding-right: 20px;
                    padding-top: 20px;
                    padding-bottom: 28px;
                    spacing: 0px;

                    for line[i] in root.see-text-lines: TouchArea {
                      enabled: line.editable && !root.see-text-edit-open;
                      clicked => {
                        root.see-text-edit-index = line.line-index;
                        root.see-text-edit-text = line.plain;
                        root.see-text-edit-kind = line.kind;
                        root.see-text-edit-number = line.number;
                        root.see-text-edit-indent = line.indent;
                        root.see-text-edit-highlight = line.whole-highlight;
                        root.see-text-edit-underline = line.whole-underline;
                        root.see-text-edit-stale = line.stale;
                        root.see-text-edit-open = true;
                        edit-input.focus();
                      }
                      HorizontalLayout {
                        min-height: 36px;
                        spacing: 8px;
                        padding-top: line.gap-before ? 14px : 4px;
                        padding-bottom: 4px;
                        padding-left: line.indent * 24px;

                        if line.kind == 4: Text {
                            text: "•";
                            font-size: 17px;
                            color: EinkTheme.btn-fg;
                            width: 16px;
                            vertical-alignment: top;
                        }
                        if line.kind == 5: Text {
                            text: line.number + ".";
                            font-size: 17px;
                            color: EinkTheme.btn-fg;
                            width: 28px;
                            horizontal-alignment: right;
                            vertical-alignment: top;
                        }
                        if line.kind == 6: Rectangle {
                            width: 16px;
                            height: 16px;
                            y: 3px;
                            border-width: 2px;
                            border-color: EinkTheme.btn-fg;
                            background: line.checked ? EinkTheme.btn-fg : transparent;
                            Text {
                                text: line.checked ? "✓" : "";
                                font-size: 12px;
                                font-weight: 700;
                                color: EinkTheme.canvas-bg;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        StyledText {
                            text: line.body;
                            horizontal-stretch: 1;
                            default-font-size: line.kind == 0 ? 20px
                                : line.kind == 1 ? 17px
                                : line.kind == 2 ? 15px
                                : 17px;
                            default-color: line.pending ? EinkTheme.text-secondary : EinkTheme.btn-fg;
                        }
                        if line.stale: Text {
                            text: "✎";
                            font-size: 12px;
                            color: EinkTheme.text-secondary;
                            width: 16px;
                            vertical-alignment: top;
                        }
                      }
                    }
                }
            }

            if !see-text-view.has-body: Rectangle {
                vertical-stretch: 1;
                background: EinkTheme.canvas-bg;
                VerticalLayout {
                    padding: 32px;
                    spacing: 12px;
                    alignment: center;

                    Text {
                        text: Icons.notes;
                        font-family: "Material Icons";
                        font-size: 40px;
                        color: EinkTheme.btn-fg;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "No text yet";
                        font-size: 18px;
                        font-weight: 700;
                        color: EinkTheme.btn-fg;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Handwriting is transcribed when you open Text. Block or print letters work best.";
                        font-size: 13px;
                        color: EinkTheme.text-secondary;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }
                }
            }
        }

        // Line editor bottom sheet: plain-text edit + format chips. No
        // animation; chips invert (not colour-only) when active.
        see-text-sheet := Rectangle {
            visible: root.see-text-edit-open;
            x: 0;
            y: parent.height - self.height;
            width: parent.width;
            height: root.see-text-edit-stale ? 316px : 264px;
            background: EinkTheme.canvas-bg;
            border-width: 2px;
            border-color: EinkTheme.chrome-border;

            VerticalLayout {
                padding: 12px;
                spacing: 8px;

                Rectangle {
                    height: 84px;
                    border-width: 2px;
                    border-color: EinkTheme.btn-border;
                    background: EinkTheme.canvas-bg;
                    edit-input := TextInput {
                        x: 8px;
                        y: 6px;
                        width: parent.width - 16px;
                        height: parent.height - 12px;
                        text <=> root.see-text-edit-text;
                        font-size: 17px;
                        color: EinkTheme.btn-fg;
                        wrap: word-wrap;
                        single-line: false;
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    SeeChip { label: "H1"; active: root.see-text-edit-kind == 0; clicked => { root.see-text-edit-kind = 0; } }
                    SeeChip { label: "H2"; active: root.see-text-edit-kind == 1; clicked => { root.see-text-edit-kind = 1; } }
                    SeeChip { label: "¶"; active: root.see-text-edit-kind == 3; clicked => { root.see-text-edit-kind = 3; } }
                    SeeChip { label: "•"; active: root.see-text-edit-kind == 4; clicked => { root.see-text-edit-kind = 4; } }
                    SeeChip { label: "1."; active: root.see-text-edit-kind == 5; clicked => { root.see-text-edit-kind = 5; } }
                    SeeChip { label: "Task"; active: root.see-text-edit-kind == 6; clicked => { root.see-text-edit-kind = 6; } }
                }

                HorizontalLayout {
                    spacing: 6px;
                    SeeChip {
                        label: "← Indent";
                        min-w: 84px;
                        clicked => { root.see-text-edit-indent = max(0, root.see-text-edit-indent - 1); }
                    }
                    SeeChip {
                        label: "Indent →";
                        min-w: 84px;
                        clicked => { root.see-text-edit-indent = min(3, root.see-text-edit-indent + 1); }
                    }
                    SeeChip {
                        label: "Highlight";
                        min-w: 84px;
                        active: root.see-text-edit-highlight;
                        clicked => { root.see-text-edit-highlight = !root.see-text-edit-highlight; }
                    }
                    SeeChip {
                        label: "Underline";
                        min-w: 84px;
                        active: root.see-text-edit-underline;
                        clicked => { root.see-text-edit-underline = !root.see-text-edit-underline; }
                    }
                }

                if root.see-text-edit-stale: HorizontalLayout {
                    spacing: 6px;
                    SeeChip {
                        label: "Keep my edit";
                        min-w: 120px;
                        horizontal-stretch: 1;
                        clicked => {
                            root.see-text-line-keep(root.see-text-edit-index);
                            root.see-text-edit-open = false;
                        }
                    }
                    SeeChip {
                        label: "Use new recognition";
                        min-w: 120px;
                        horizontal-stretch: 1;
                        clicked => {
                            root.see-text-line-accept(root.see-text-edit-index);
                            root.see-text-edit-open = false;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    SeeChip {
                        label: "Reset line";
                        min-w: 100px;
                        clicked => {
                            root.see-text-line-reset(root.see-text-edit-index);
                            root.see-text-edit-open = false;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    SeeChip {
                        label: "Cancel";
                        min-w: 90px;
                        clicked => { root.see-text-edit-open = false; }
                    }
                    SeeChip {
                        label: "Save";
                        min-w: 90px;
                        active: true;
                        clicked => {
                            root.see-text-line-save(
                                root.see-text-edit-index, root.see-text-edit-text,
                                root.see-text-edit-kind, root.see-text-edit-number,
                                root.see-text-edit-indent, root.see-text-edit-highlight,
                                root.see-text-edit-underline);
                            root.see-text-edit-open = false;
                        }
                    }
                }
            }
        }
    }


    // ── Canvas browser (folders + canvases) ───────────────────────────────
    canvas-browser-view := Rectangle {
        visible: root.show-canvas-folder-list || root.show-canvas-list;
        x: root.nav-w; y: 0;
        width: parent.width - root.nav-w;
        height: parent.height;
        background: EinkTheme.canvas-bg;
        clip: true;
        property <int> gallery-cols: 3;
        property <length> gallery-gap: 8px;
        property <length> gallery-col-w: (self.width - gallery-gap * (gallery-cols + 1)) / gallery-cols;
        property <length> gallery-preview-h: gallery-col-w * 3 / 4;
        property <length> gallery-caption-h: 40px;
        property <length> gallery-row-h: gallery-preview-h + gallery-caption-h + gallery-gap;

        VerticalLayout {
            padding: 0px; spacing: 0px;
            Rectangle {
                height: 44px;
                background: EinkTheme.canvas-bg;
                HorizontalLayout {
                    padding-left: 8px; padding-right: 8px;
                    padding-top: 6px; padding-bottom: 6px;
                    spacing: 6px;
                    Rectangle {
                        width: 40px; height: 32px;
                        background: EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                        Text {
                            text: Icons.back; font-family: "Material Icons"; font-size: 20px;
                            color: EinkTheme.btn-fg;
                            horizontal-alignment: center; vertical-alignment: center;
                            width: parent.width; height: parent.height;
                        }
                        TouchArea { clicked => { root.canvas-browser-back-tapped(); } }
                    }
                    Text {
                        text: root.canvas-browser-title;
                        font-size: 15px; font-weight: 700; color: EinkTheme.btn-fg;
                        vertical-alignment: center; horizontal-stretch: 1; overflow: elide;
                    }
                    Rectangle {
                        width: 48px; height: 32px;
                        background: EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                        Text {
                            text: root.canvas-sort-mode == "title" ? "A-Z"
                                : (root.canvas-sort-mode == "created" ? "New" : "Edit");
                            font-size: 11px; color: EinkTheme.btn-fg;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                        TouchArea { clicked => { root.canvas-sort-toggled(); } }
                    }
                    Rectangle {
                        width: 48px; height: 32px;
                        background: EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                        Text {
                            text: root.canvas-view-mode == "gallery" ? "List" : "Grid";
                            font-size: 11px; color: EinkTheme.btn-fg;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                        TouchArea { clicked => { root.canvas-view-mode-toggled(); } }
                    }
                    Rectangle {
                        width: 72px; height: 32px;
                        background: EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                        Text { text: "+ Folder"; font-size: 12px; color: EinkTheme.btn-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.canvas-folder-new-tapped(); } }
                    }
                    Rectangle {
                        width: 72px; height: 32px;
                        background: EinkTheme.btn-active-bg;
                        border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                        Text { text: "+ Canvas"; font-size: 12px; color: EinkTheme.btn-active-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.canvas-new-tapped(); } }
                    }
                }
            }
            Rectangle { height: 2px; background: EinkTheme.chrome-border; }
            Flickable {
                content-height: folders-col.preferred-height
                    + (root.canvas-view-mode == "gallery"
                        ? (((root.canvas-list.length + canvas-browser-view.gallery-cols - 1)
                            / canvas-browser-view.gallery-cols) * canvas-browser-view.gallery-row-h)
                        : (root.canvas-list.length * 56px))
                    + 24px;
                VerticalLayout {
                    padding: 8px; spacing: 4px;
                    folders-col := VerticalLayout {
                        spacing: 4px;
                        for f in root.canvas-folder-list: Rectangle {
                            height: 52px;
                            background: EinkTheme.btn-bg;
                            border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                            HorizontalLayout {
                                padding-left: 10px; padding-right: 10px; spacing: 8px;
                                Text {
                                    text: Icons.folder; font-family: "Material Icons"; font-size: 22px;
                                    color: EinkTheme.btn-fg; vertical-alignment: center;
                                }
                                if f.show-profile: ProfileIcon {
                                    icon-char: f.profile-icon-char;
                                    has-custom: f.has-custom-profile-icon;
                                    custom-icon: f.custom-profile-icon;
                                    size: 18px; fg: EinkTheme.text-secondary;
                                }
                                VerticalLayout {
                                    alignment: center; spacing: 2px; horizontal-stretch: 1;
                                    Text { text: f.title; font-size: 14px; font-weight: 600; color: EinkTheme.btn-fg; overflow: elide; }
                                    Text {
                                        text: "Open folder";
                                        font-size: 11px; color: EinkTheme.text-secondary;
                                    }
                                }
                            }
                            TouchArea { clicked => { root.canvas-folder-tapped(f.id); } }
                            Rectangle {
                                x: parent.width - 44px; y: 8px; width: 36px; height: 36px;
                                background: transparent;
                                Text {
                                    text: Icons.edit; font-family: "Material Icons"; font-size: 18px;
                                    color: EinkTheme.btn-fg;
                                    horizontal-alignment: center; vertical-alignment: center;
                                    width: parent.width; height: parent.height;
                                }
                                TouchArea { clicked => { root.canvas-rename-request("folder", f.id); } }
                            }
                        }
                    }
                    if root.canvas-view-mode != "gallery": canvases-col := VerticalLayout {
                        spacing: 4px;
                        for c in root.canvas-list: Rectangle {
                            height: 52px;
                            background: transparent;
                            HorizontalLayout {
                                padding-left: 10px; padding-right: 10px; spacing: 8px;
                                Text {
                                    text: Icons.grid-view; font-family: "Material Icons"; font-size: 22px;
                                    color: EinkTheme.btn-fg; vertical-alignment: center;
                                }
                                if c.show-profile: ProfileIcon {
                                    icon-char: c.profile-icon-char;
                                    has-custom: c.has-custom-profile-icon;
                                    custom-icon: c.custom-profile-icon;
                                    size: 18px; fg: EinkTheme.text-secondary;
                                }
                                VerticalLayout {
                                    alignment: center; spacing: 2px; horizontal-stretch: 1;
                                    Text { text: c.title; font-size: 14px; font-weight: 600; color: EinkTheme.btn-fg; overflow: elide; }
                                    Text { text: c.date-label; font-size: 11px; color: EinkTheme.text-secondary; }
                                }
                            }
                            TouchArea { clicked => { root.canvas-tapped(c.id); } }
                            Rectangle {
                                x: parent.width - 44px; y: 8px; width: 36px; height: 36px;
                                background: transparent;
                                Text {
                                    text: Icons.edit; font-family: "Material Icons"; font-size: 18px;
                                    color: EinkTheme.btn-fg;
                                    horizontal-alignment: center; vertical-alignment: center;
                                    width: parent.width; height: parent.height;
                                }
                                TouchArea { clicked => { root.canvas-rename-request("canvas", c.id); } }
                            }
                            Rectangle {
                                x: 0; y: parent.height - 1px; width: parent.width; height: 1px;
                                background: EinkTheme.chrome-border; opacity: 0.4;
                            }
                        }
                    }
                    if root.canvas-view-mode == "gallery": Rectangle {
                        height: ((root.canvas-list.length + canvas-browser-view.gallery-cols - 1)
                                / canvas-browser-view.gallery-cols)
                            * canvas-browser-view.gallery-row-h;
                        for c[i] in root.canvas-list: Rectangle {
                            x: canvas-browser-view.gallery-gap
                                + Math.mod(i, canvas-browser-view.gallery-cols)
                                    * (canvas-browser-view.gallery-col-w + canvas-browser-view.gallery-gap);
                            y: canvas-browser-view.gallery-gap
                                + Math.floor(i / canvas-browser-view.gallery-cols)
                                    * canvas-browser-view.gallery-row-h;
                            width: canvas-browser-view.gallery-col-w;
                            height: canvas-browser-view.gallery-preview-h
                                + canvas-browser-view.gallery-caption-h;
                            border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                            background: EinkTheme.btn-bg;
                            VerticalLayout {
                                spacing: 0px;
                                Rectangle {
                                    height: canvas-browser-view.gallery-preview-h;
                                    background: EinkTheme.canvas-bg;
                                    Text {
                                        text: Icons.grid-view; font-family: "Material Icons"; font-size: 36px;
                                        color: EinkTheme.btn-fg;
                                        horizontal-alignment: center; vertical-alignment: center;
                                        width: parent.width; height: parent.height;
                                    }
                                    if c.show-profile: Rectangle {
                                        x: 6px; y: 6px; width: 22px; height: 22px;
                                        background: EinkTheme.canvas-bg;
                                        border-radius: 11px;
                                        border-width: 1px; border-color: EinkTheme.chrome-border;
                                        ProfileIcon {
                                            icon-char: c.profile-icon-char;
                                            has-custom: c.has-custom-profile-icon;
                                            custom-icon: c.custom-profile-icon;
                                            size: 16px; fg: EinkTheme.btn-fg;
                                        }
                                    }
                                }
                                Rectangle {
                                    height: canvas-browser-view.gallery-caption-h;
                                    VerticalLayout {
                                        padding-left: 6px; padding-right: 6px; padding-top: 4px;
                                        spacing: 1px;
                                        Text { text: c.title; font-size: 12px; font-weight: 600; color: EinkTheme.btn-fg; overflow: elide; }
                                        Text { text: c.date-label; font-size: 10px; color: EinkTheme.text-secondary; overflow: elide; }
                                    }
                                }
                            }
                            TouchArea { clicked => { root.canvas-tapped(c.id); } }
                        }
                    }
                    if root.canvas-folder-list.length == 0 && root.canvas-list.length == 0: Rectangle {
                        height: 64px;
                        Text {
                            text: "No canvases yet — tap + Canvas";
                            font-size: 13px; color: EinkTheme.text-secondary;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

    // ── Canvas board overview (fullscreen; burger restores chrome) ────────
    canvas-board-view := Rectangle {
        visible: root.show-canvas-board;
        x: 0; y: 0; width: parent.width; height: parent.height;
        background: EinkTheme.canvas-bg;
        Image {
            width: parent.width; height: parent.height;
            source: root.canvas-board-image;
            image-fit: fill;
        }
        if !root.canvas-focus-active: TouchArea {
            width: parent.width; height: parent.height;
            property <bool> tracked: false;
            property <float> down-x: 0;
            property <float> down-y: 0;
            property <bool> did-drag: false;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    self.tracked = true; self.did-drag = false;
                    self.down-x = self.mouse-x / 1px; self.down-y = self.mouse-y / 1px;
                    root.canvas-board-pointer(self.down-x, self.down-y, "down", "finger");
                }
                if (event.kind == PointerEventKind.move && self.tracked) {
                    if ((self.mouse-x / 1px - self.down-x).abs() > 6 || (self.mouse-y / 1px - self.down-y).abs() > 6) {
                        self.did-drag = true;
                    }
                    root.canvas-board-pointer(self.mouse-x / 1px, self.mouse-y / 1px, "move", "finger");
                }
                if (event.kind == PointerEventKind.up && self.tracked) {
                    self.tracked = false;
                    root.canvas-board-pointer(self.mouse-x / 1px, self.mouse-y / 1px, "up", "finger");
                    if (!self.did-drag) {
                        root.canvas-board-pointer(self.mouse-x / 1px, self.mouse-y / 1px, "tap", "finger");
                    }
                }
            }
        }
        // Title chrome above board pointer (Notes-like).
        if !root.canvas-focus-active: Rectangle {
            x: 12px; y: 8px; width: parent.width - 120px; height: 40px;
            background: EinkTheme.chrome-bg;
            border-radius: 6px; border-width: 2px; border-color: EinkTheme.btn-border;
            HorizontalLayout {
                padding-left: 10px; padding-right: 6px; spacing: 6px;
                Text {
                    text: root.canvas-board-title;
                    font-size: 15px; font-weight: 700; color: EinkTheme.btn-fg;
                    vertical-alignment: center; horizontal-stretch: 1; overflow: elide;
                }
                Rectangle {
                    width: 36px; height: 32px; background: transparent;
                    Text {
                        text: Icons.edit; font-family: "Material Icons"; font-size: 18px;
                        color: EinkTheme.btn-fg;
                        horizontal-alignment: center; vertical-alignment: center;
                        width: parent.width; height: parent.height;
                    }
                    TouchArea { clicked => { root.canvas-rename-request("board", ""); } }
                }
            }
        }
    }

    // Multi-select strip
    if root.show-canvas-board && !root.canvas-focus-active && root.canvas-multi-select: Rectangle {
        x: 12px; y: parent.height - 56px; width: parent.width - 24px; height: 44px;
        background: EinkTheme.chrome-bg;
        border-radius: 6px; border-width: 2px; border-color: EinkTheme.btn-border;
        HorizontalLayout {
            padding-left: 10px; padding-right: 8px; spacing: 8px;
            Text {
                text: root.canvas-selection-count + " selected";
                font-size: 13px; font-weight: 600; color: EinkTheme.btn-fg;
                vertical-alignment: center; horizontal-stretch: 1;
            }
            Rectangle {
                width: 64px; height: 32px; background: EinkTheme.btn-bg;
                border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                Text { text: "Clear"; font-size: 12px; color: EinkTheme.btn-fg;
                       horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { clicked => { root.canvas-clear-selection(); } }
            }
            Rectangle {
                width: 72px; height: 32px; background: EinkTheme.btn-bg;
                border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                Text { text: "Delete"; font-size: 12px; color: EinkTheme.danger-fg;
                       horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { clicked => { root.canvas-delete-selected(); } }
            }
        }
    }

    // Canvas board burger + iconized menu
    canvas-burger := Rectangle {
        visible: root.is-obsidian-canvas-context;
        x: parent.width - 52px; y: 8px; width: 44px; height: 44px;
        background: root.canvas-menu-open ? EinkTheme.btn-active-bg : EinkTheme.chrome-bg;
        border-radius: 22px; border-width: 2px; border-color: EinkTheme.btn-border;
        Text {
            text: root.canvas-menu-open ? Icons.close : Icons.menu;
            font-family: "Material Icons"; font-size: 20px;
            color: root.canvas-menu-open ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
            horizontal-alignment: center; vertical-alignment: center;
            width: parent.width; height: parent.height;
        }
        TouchArea { clicked => { root.canvas-menu-open = !root.canvas-menu-open; } }
    }

    if root.canvas-menu-open && root.is-obsidian-canvas-context: Rectangle {
        x: 0; y: 0; width: parent.width; height: parent.height;
        background: transparent;
        TouchArea { clicked => { root.canvas-menu-open = false; } }
    }

    canvas-dropdown := Rectangle {
        visible: root.canvas-menu-open && root.is-obsidian-canvas-context;
        x: parent.width - 200px; y: 60px; width: 192px; height: 320px;
        background: EinkTheme.chrome-bg;
        border-width: 2px; border-color: EinkTheme.chrome-border; border-radius: 6px;
        clip: true;

        // Title (tappable rename)
        Rectangle {
            x: 8px; y: 8px; width: parent.width - 16px; height: 28px;
            Text {
                text: root.canvas-board-title; font-size: 12px; font-weight: 700;
                color: EinkTheme.btn-fg; overflow: elide;
                vertical-alignment: center; width: parent.width; height: parent.height;
            }
            TouchArea {
                clicked => {
                    root.canvas-rename-request("board", "");
                    root.canvas-menu-open = false;
                }
            }
        }
        // Add
        Rectangle {
            x: 6px; y: 40px; width: 84px; height: 48px;
            background: EinkTheme.btn-bg; border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
            Text {
                y: 4px; width: parent.width; height: 24px;
                text: Icons.note-add; font-family: "Material Icons"; font-size: 20px;
                color: EinkTheme.btn-fg; horizontal-alignment: center; vertical-alignment: center;
            }
            Text {
                y: 28px; width: parent.width; height: 14px;
                text: "Add"; font-size: 9px; color: EinkTheme.btn-fg;
                horizontal-alignment: center; vertical-alignment: center;
            }
            TouchArea { clicked => { root.canvas-add-visible = true; root.canvas-menu-open = false; } }
        }
        // Connect
        Rectangle {
            x: 98px; y: 40px; width: 88px; height: 48px;
            background: root.canvas-connect-mode ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
            border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
            Text {
                y: 4px; width: parent.width; height: 24px;
                text: Icons.link; font-family: "Material Icons"; font-size: 20px;
                color: root.canvas-connect-mode ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                horizontal-alignment: center; vertical-alignment: center;
            }
            Text {
                y: 28px; width: parent.width; height: 14px;
                text: root.canvas-connect-mode ? "Linking" : "Connect"; font-size: 9px;
                color: root.canvas-connect-mode ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                horizontal-alignment: center; vertical-alignment: center;
            }
            TouchArea {
                clicked => {
                    root.canvas-connect-mode = !root.canvas-connect-mode;
                    root.canvas-tool = "select";
                    root.canvas-menu-open = false;
                }
            }
        }
        // Move
        Rectangle {
            x: 6px; y: 96px; width: 84px; height: 48px;
            background: root.canvas-tool == "move" ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
            border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
            Text {
                y: 4px; width: parent.width; height: 24px;
                text: Icons.move; font-family: "Material Icons"; font-size: 20px;
                color: root.canvas-tool == "move" ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                horizontal-alignment: center; vertical-alignment: center;
            }
            Text {
                y: 28px; width: parent.width; height: 14px;
                text: "Move"; font-size: 9px;
                color: root.canvas-tool == "move" ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                horizontal-alignment: center; vertical-alignment: center;
            }
            TouchArea {
                clicked => {
                    root.canvas-tool = root.canvas-tool == "move" ? "select" : "move";
                    root.canvas-connect-mode = false;
                    root.canvas-menu-open = false;
                }
            }
        }
        // Delete
        Rectangle {
            x: 98px; y: 96px; width: 88px; height: 48px;
            background: EinkTheme.btn-bg; border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
            Text {
                y: 4px; width: parent.width; height: 24px;
                text: Icons.tool-clear; font-family: "Material Icons"; font-size: 20px;
                color: EinkTheme.danger-fg; horizontal-alignment: center; vertical-alignment: center;
            }
            Text {
                y: 28px; width: parent.width; height: 14px;
                text: "Delete"; font-size: 9px; color: EinkTheme.danger-fg;
                horizontal-alignment: center; vertical-alignment: center;
            }
            TouchArea { clicked => { root.canvas-delete-selected(); root.canvas-menu-open = false; } }
        }
        // Zoom row
        Rectangle {
            x: 6px; y: 152px; width: 56px; height: 48px;
            background: EinkTheme.btn-bg; border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
            Text {
                y: 4px; width: parent.width; height: 24px;
                text: Icons.zoom-out-map; font-family: "Material Icons"; font-size: 20px;
                color: EinkTheme.btn-fg; horizontal-alignment: center; vertical-alignment: center;
            }
            Text {
                y: 28px; width: parent.width; height: 14px;
                text: "Fit"; font-size: 9px; color: EinkTheme.btn-fg;
                horizontal-alignment: center; vertical-alignment: center;
            }
            TouchArea { clicked => { root.canvas-zoom-preset("fit"); root.canvas-menu-open = false; } }
        }
        Rectangle {
            x: 68px; y: 152px; width: 56px; height: 48px;
            background: EinkTheme.btn-bg; border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
            Text {
                y: 4px; width: parent.width; height: 24px;
                text: "1:1"; font-size: 14px; font-weight: 700;
                color: EinkTheme.btn-fg; horizontal-alignment: center; vertical-alignment: center;
            }
            Text {
                y: 28px; width: parent.width; height: 14px;
                text: "100%"; font-size: 9px; color: EinkTheme.btn-fg;
                horizontal-alignment: center; vertical-alignment: center;
            }
            TouchArea { clicked => { root.canvas-zoom-preset("100"); root.canvas-menu-open = false; } }
        }
        Rectangle {
            x: 130px; y: 152px; width: 56px; height: 48px;
            background: EinkTheme.btn-bg; border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
            Text {
                y: 4px; width: parent.width; height: 24px;
                text: Icons.center-focus; font-family: "Material Icons"; font-size: 20px;
                color: EinkTheme.btn-fg; horizontal-alignment: center; vertical-alignment: center;
            }
            Text {
                y: 28px; width: parent.width; height: 14px;
                text: "Focus"; font-size: 9px; color: EinkTheme.btn-fg;
                horizontal-alignment: center; vertical-alignment: center;
            }
            TouchArea { clicked => { root.canvas-zoom-preset("focus"); root.canvas-menu-open = false; } }
        }
        // Leave
        Rectangle {
            x: 6px; y: 212px; width: parent.width - 12px; height: 48px;
            background: EinkTheme.btn-active-bg; border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
            Text {
                y: 4px; width: parent.width; height: 24px;
                text: Icons.logout; font-family: "Material Icons"; font-size: 20px;
                color: EinkTheme.btn-active-fg; horizontal-alignment: center; vertical-alignment: center;
            }
            Text {
                y: 28px; width: parent.width; height: 14px;
                text: "Leave board"; font-size: 9px; color: EinkTheme.btn-active-fg;
                horizontal-alignment: center; vertical-alignment: center;
            }
            TouchArea { clicked => { root.canvas-leave-board(); } }
        }
    }

    // Focus modal: dimmed board + catcher + Done (ink composites over white regions)
    if root.canvas-focus-active: Rectangle {
        x: 0; y: 0; width: parent.width; height: parent.height;
        background: #00000000;
        // Dim veil — blocks board pan / palm scroll
        Rectangle {
            width: parent.width; height: parent.height;
            background: #c8c8c8;
            opacity: 0.55;
            TouchArea { }
        }
        // Modal frame
        Rectangle {
            x: 24px; y: 56px;
            width: parent.width - 48px; height: parent.height - 112px;
            background: transparent;
            border-width: 3px; border-color: EinkTheme.btn-border; border-radius: 8px;
        }
        Rectangle {
            x: parent.width - 96px; y: 8px; width: 88px; height: 44px;
            background: EinkTheme.btn-active-bg;
            border-radius: 6px; border-width: 2px; border-color: EinkTheme.btn-border;
            Text { text: "Done"; font-size: 14px; font-weight: 700; color: EinkTheme.btn-active-fg;
                   horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { clicked => { root.canvas-focus-done(); } }
        }
        Text {
            x: 28px; y: 14px; width: parent.width - 140px; height: 32px;
            text: root.page-title;
            font-size: 14px; font-weight: 700; color: EinkTheme.btn-fg; overflow: elide;
            vertical-alignment: center;
        }
    }

    // Add card sheet
    if root.canvas-add-visible: Rectangle {
        x: 0; y: 0; width: parent.width; height: parent.height;
        background: #00000055;
        TouchArea { clicked => { root.canvas-add-visible = false; } }
        Rectangle {
            x: (parent.width - 280px) / 2; y: (parent.height - 260px) / 2;
            width: 280px; height: 260px;
            background: EinkTheme.chrome-bg;
            border-radius: 8px; border-width: 2px; border-color: EinkTheme.btn-border;
            VerticalLayout {
                padding: 16px; spacing: 10px;
                Text { text: "Add to canvas"; font-size: 16px; font-weight: 700; color: EinkTheme.btn-fg; }
                Rectangle {
                    height: 40px; background: EinkTheme.btn-bg; border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                    Text { text: "Text card"; font-size: 14px; color: EinkTheme.btn-fg; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.canvas-add-confirm("text"); } }
                }
                Rectangle {
                    height: 40px; background: EinkTheme.btn-bg; border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                    Text { text: "File card"; font-size: 14px; color: EinkTheme.btn-fg; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.canvas-add-confirm("file"); } }
                }
                Rectangle {
                    height: 40px; background: EinkTheme.btn-bg; border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                    Text { text: "Link card"; font-size: 14px; color: EinkTheme.btn-fg; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.canvas-add-confirm("link"); } }
                }
                Rectangle {
                    height: 40px; background: EinkTheme.btn-bg; border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                    Text { text: "Group"; font-size: 14px; color: EinkTheme.btn-fg; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.canvas-add-confirm("group"); } }
                }
            }
        }
    }

    // File path dialog
    if root.canvas-file-dialog-visible: Rectangle {
        x: 0; y: 0; width: parent.width; height: parent.height; background: #00000055;
        TouchArea { clicked => { root.canvas-file-dialog-visible = false; } }
        Rectangle {
            x: (parent.width - 320px) / 2; y: (parent.height - 160px) / 2;
            width: 320px; height: 160px; background: EinkTheme.chrome-bg;
            border-radius: 8px; border-width: 2px; border-color: EinkTheme.btn-border;
            VerticalLayout {
                padding: 16px; spacing: 10px;
                Text { text: "Vault-relative file path"; font-size: 14px; font-weight: 700; color: EinkTheme.btn-fg; }
                TextInput {
                    text <=> root.canvas-file-path; font-size: 14px; color: EinkTheme.btn-fg;
                    height: 36px;
                }
                Rectangle {
                    height: 40px; background: EinkTheme.btn-active-bg; border-radius: 4px;
                    Text { text: "Add file card"; font-size: 14px; color: EinkTheme.btn-active-fg;
                           horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.canvas-file-confirm(); } }
                }
            }
        }
    }

    // Link URL dialog
    if root.canvas-link-dialog-visible: Rectangle {
        x: 0; y: 0; width: parent.width; height: parent.height; background: #00000055;
        TouchArea { clicked => { root.canvas-link-dialog-visible = false; } }
        Rectangle {
            x: (parent.width - 320px) / 2; y: (parent.height - 160px) / 2;
            width: 320px; height: 160px; background: EinkTheme.chrome-bg;
            border-radius: 8px; border-width: 2px; border-color: EinkTheme.btn-border;
            VerticalLayout {
                padding: 16px; spacing: 10px;
                Text { text: "URL"; font-size: 14px; font-weight: 700; color: EinkTheme.btn-fg; }
                TextInput {
                    text <=> root.canvas-link-url; font-size: 14px; color: EinkTheme.btn-fg;
                    height: 36px;
                }
                Rectangle {
                    height: 40px; background: EinkTheme.btn-active-bg; border-radius: 4px;
                    Text { text: "Add link card"; font-size: 14px; color: EinkTheme.btn-active-fg;
                           horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.canvas-link-confirm(); } }
                }
            }
        }
    }


    // ── Left navigation rail ─────────────────────────────────────────────
    nav-rail := Rectangle {
        // Hidden in pure drawing mode; reappears when burger menu is open.
        visible: (!root.is-canvas-context && !root.is-obsidian-canvas-context) || root.drawing-menu-open || root.canvas-menu-open;
        x: 0;
        y: 0;
        width: root.nav-w;
        height: parent.height;
        background: EinkTheme.chrome-bg;
        clip: true;

        VerticalLayout {
            padding: 0px; spacing: 0px;

            // Home
            Rectangle {
                height: 72px;
                background: root.nav-section == 0 ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                VerticalLayout {
                    padding: 6px; spacing: 2px; alignment: center;
                    Text {
                        text: Icons.home;
                        font-family: "Material Icons";
                        font-size: 26px;
                        color: root.nav-section == 0 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Home";
                        font-size: 10px;
                        color: root.nav-section == 0 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                        horizontal-alignment: center;
                    }
                }
                TouchArea {
                    clicked => { root.nav-section = 0; root.nav-overview-tapped(); }
                }
            }

            Rectangle { height: 1px; background: EinkTheme.chrome-border; }

            // Notes
            Rectangle {
                height: 72px;
                background: root.nav-section == 1 ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                VerticalLayout {
                    padding: 6px; spacing: 2px; alignment: center;
                    Text {
                        text: Icons.notes;
                        font-family: "Material Icons";
                        font-size: 26px;
                        color: root.nav-section == 1 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Notes";
                        font-size: 10px;
                        color: root.nav-section == 1 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                        horizontal-alignment: center;
                    }
                }
                TouchArea {
                    clicked => { root.nav-section = 1; root.nav-notes-tapped(); }
                }
            }

            Rectangle { height: 1px; background: EinkTheme.chrome-border; }

            // Canvas (Obsidian-compatible spatial boards)
            Rectangle {
                height: 72px;
                background: root.nav-section == 2 ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                VerticalLayout {
                    padding: 6px; spacing: 2px; alignment: center;
                    Text {
                        text: Icons.grid-view;
                        font-family: "Material Icons";
                        font-size: 26px;
                        color: root.nav-section == 2 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Canvas";
                        font-size: 10px;
                        color: root.nav-section == 2 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                        horizontal-alignment: center;
                    }
                }
                TouchArea {
                    clicked => { root.nav-section = 2; root.nav-canvas-tapped(); }
                }
            }

            Rectangle { height: 1px; background: EinkTheme.chrome-border; }

            // Tasks
            Rectangle {
                height: 72px;
                background: root.nav-section == 3 ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                VerticalLayout {
                    padding: 6px; spacing: 2px; alignment: center;
                    Text {
                        text: Icons.tasks;
                        font-family: "Material Icons";
                        font-size: 26px;
                        color: root.nav-section == 3 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Tasks";
                        font-size: 10px;
                        color: root.nav-section == 3 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                        horizontal-alignment: center;
                    }
                }
                TouchArea {
                    clicked => { root.nav-section = 3; root.nav-tasks-tapped(); }
                }
            }

            Rectangle { height: 1px; background: EinkTheme.chrome-border; }

            // Calendar
            Rectangle {
                height: 72px;
                background: root.nav-section == 4 ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                VerticalLayout {
                    padding: 6px; spacing: 2px; alignment: center;
                    Text {
                        text: Icons.calendar;
                        font-family: "Material Icons";
                        font-size: 26px;
                        color: root.nav-section == 4 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Cal";
                        font-size: 10px;
                        color: root.nav-section == 4 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                        horizontal-alignment: center;
                    }
                }
                TouchArea {
                    clicked => { root.nav-section = 4; root.nav-calendar-tapped(); }
                }
            }

            if root.has-mic: Rectangle { height: 1px; background: EinkTheme.chrome-border; }

            if root.has-mic: Rectangle {
                height: 72px;
                background: root.nav-section == 5 ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                VerticalLayout {
                    padding: 6px; spacing: 2px; alignment: center;
                    Text {
                        text: Icons.mic;
                        font-family: "Material Icons";
                        font-size: 26px;
                        color: root.nav-section == 5 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Rec";
                        font-size: 10px;
                        color: root.nav-section == 5 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                        horizontal-alignment: center;
                    }
                }
                TouchArea {
                    clicked => { root.nav-section = 5; root.nav-rec-tapped(); }
                }
            }

            Rectangle { height: 1px; background: EinkTheme.chrome-border; }

            // Search — after Rec, before profile/settings
            Rectangle {
                height: 72px;
                background: root.show-search || root.show-md-viewer || root.nav-section == 6
                    ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                VerticalLayout {
                    padding: 6px; spacing: 2px; alignment: center;
                    Text {
                        text: Icons.search;
                        font-family: "Material Icons";
                        font-size: 26px;
                        color: root.show-search || root.show-md-viewer || root.nav-section == 6
                            ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Search";
                        font-size: 10px;
                        color: root.show-search || root.show-md-viewer || root.nav-section == 6
                            ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                        horizontal-alignment: center;
                    }
                }
                TouchArea {
                    clicked => { root.nav-section = 6; root.search-open(); }
                }
            }

            // Spacer
            Rectangle { vertical-stretch: 1; background: EinkTheme.chrome-bg; }

            Rectangle { height: 1px; background: EinkTheme.chrome-border; }

            // ── Profile avatar button (round icon + profile name) ──────────
            // Match other nav items: full-width column, icon optically centered.
            profile-btn := Rectangle {
                height: 64px;
                background: root.show-profile-switcher ? EinkTheme.btn-active-bg : EinkTheme.chrome-bg;
                VerticalLayout {
                    padding-top: 6px; padding-bottom: 4px;
                    spacing: 2px; alignment: stretch;

                    // Full-width slot; circle centered inside (same math as nav icons)
                    Rectangle {
                        height: 36px;
                        Rectangle {
                            x: (parent.width - 36px) / 2;
                            width: 36px; height: 36px;
                            border-radius: 18px;
                            background: root.show-profile-switcher ? EinkTheme.btn-active-fg : EinkTheme.btn-bg;
                            border-width: 2px;
                            border-color: root.show-profile-switcher ? EinkTheme.btn-active-fg : EinkTheme.btn-border;
                            if root.active-profile-id == "" || !root.active-profile-has-custom: Text {
                                text: root.active-profile-id == "" ? Icons.profile-group
                                    : root.active-profile-icon-char;
                                font-family: "Material Icons";
                                font-size: 20px;
                                color: root.show-profile-switcher ? EinkTheme.btn-active-bg : EinkTheme.btn-fg;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: parent.width; height: parent.height;
                            }
                            if root.active-profile-id != "" && root.active-profile-has-custom: Image {
                                x: 6px; y: 6px;
                                width: 24px; height: 24px;
                                source: root.active-profile-custom-icon;
                            }
                        }
                    }
                    Text {
                        height: 14px;
                        text: root.active-profile-id == "" ? "All"
                            : (root.active-profile-name == "" ? "Profile" : root.active-profile-name);
                        font-size: 9px;
                        color: root.show-profile-switcher ? EinkTheme.btn-active-fg : EinkTheme.text-secondary;
                        horizontal-alignment: center;
                        overflow: elide;
                    }
                }
                TouchArea {
                    clicked => { root.show-profile-switcher = !root.show-profile-switcher; }
                }
            }

            Rectangle { height: 1px; background: EinkTheme.chrome-border; }

            // Settings (icon only)
            Rectangle {
                height: 52px;
                background: root.show-settings ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                Text {
                    text: Icons.settings;
                    font-family: "Material Icons";
                    font-size: 26px;
                    color: root.show-settings ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }
                TouchArea { clicked => { root.settings-open(); } }
            }
        }

        // Right border
        Rectangle {
            x: root.nav-w - 2px; y: 0;
            width: 2px;
            height: parent.height;
            background: EinkTheme.chrome-border;
        }
    }

    // ── Profile switcher (anchored to profile-btn, after nav for z-order) ─
    // Backdrop covers content only so the nav rail (incl. profile toggle) stays live.
    Rectangle {
        visible: root.show-profile-switcher;
        x: root.nav-w; y: 0;
        width: parent.width - root.nav-w; height: parent.height;
        background: transparent;
        TouchArea { clicked => { root.show-profile-switcher = false; } }
    }

    profile-switcher-panel := Rectangle {
        visible: root.show-profile-switcher;
        x: root.nav-w + 4px;
        width: 220px;
        background: EinkTheme.chrome-bg;
        border-width: 2px;
        border-color: EinkTheme.chrome-border;
        border-radius: 6px;
        clip: true;

        property <int> item-count: root.profile-list.length + 1;  // +1 for "All"
        property <length> content-h: item-count * 44px + 40px;    // + header
        property <length> max-h: parent.height - 16px;
        height: min(content-h, max-h);
        // Bottom-align with profile button; clamp so the menu stays on-screen.
        property <length> ideal-y: profile-btn.y + profile-btn.height - self.height;
        y: max(8px, ideal-y);

        VerticalLayout {
            padding: 0px;
            spacing: 0px;

            Rectangle {
                height: 32px;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    alignment: start;
                    Text {
                        text: "Profiles";
                        font-size: 11px;
                        font-weight: 700;
                        color: EinkTheme.text-secondary;
                        vertical-alignment: center;
                    }
                }
            }
            Rectangle { height: 1px; background: EinkTheme.chrome-border; }

            Flickable {
                vertical-stretch: 1;
                width: parent.width;
                content-width: parent.width;
                content-height: profile-switcher-list.preferred-height;

                profile-switcher-list := VerticalLayout {
                    width: parent.width;
                    padding: 4px;
                    spacing: 0px;

                    // "All" row
                    Rectangle {
                        height: 44px;
                        background: root.active-profile-id == "" ? EinkTheme.btn-active-bg : transparent;
                        border-radius: 4px;
                        HorizontalLayout {
                            padding-left: 10px; padding-right: 10px;
                            spacing: 8px; alignment: start;
                            Text {
                                text: Icons.profile-group;
                                font-family: "Material Icons"; font-size: 20px;
                                color: root.active-profile-id == "" ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                                vertical-alignment: center; width: 24px;
                            }
                            Text {
                                text: "All profiles";
                                font-size: 13px;
                                color: root.active-profile-id == "" ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                                vertical-alignment: center; horizontal-stretch: 1;
                            }
                        }
                        TouchArea {
                            clicked => {
                                root.active-profile-id = "";
                                root.profile-changed("");
                                root.show-profile-switcher = false;
                            }
                        }
                    }

                    for p in root.profile-list: Rectangle {
                        height: 44px;
                        property <bool> sel: root.active-profile-id == p.id;
                        background: sel ? EinkTheme.btn-active-bg : transparent;
                        border-radius: 4px;
                        HorizontalLayout {
                            padding-left: 10px; padding-right: 10px;
                            spacing: 8px; alignment: start;
                            ProfileIcon {
                                icon-char: p.icon-char; has-custom: p.has-custom-icon; custom-icon: p.custom-icon;
                                size: 22px; fg: sel ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                            }
                            Text {
                                text: p.name;
                                font-size: 13px;
                                color: sel ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                                vertical-alignment: center; horizontal-stretch: 1;
                                overflow: elide;
                            }
                        }
                        TouchArea {
                            clicked => {
                                root.active-profile-id = p.id;
                                root.profile-changed(p.id);
                                root.show-profile-switcher = false;
                            }
                        }
                    }
                }
            }
        }
    }

    // ── Action ring (compact cardinal FAB cluster) ───────────────────────
    ring-backdrop := Rectangle {
        visible: root.ring-visible;
        x: 0px; y: 0px;
        width: parent.width;
        height: parent.height;

        // Tap outside ring to dismiss
        TouchArea { clicked => { root.ring-dismissed(); } }

        // Soft outer disc — smaller than the old pie menu
        Rectangle {
            x: root.ring-cx * 1px - 88px;
            y: root.ring-cy * 1px - 88px;
            width: 176px; height: 176px;
            border-radius: 88px;
            background: EinkTheme.chrome-bg;
            border-width: 2px;
            border-color: EinkTheme.chrome-border;
            opacity: 0.97;
        }

        // Note — 12 o'clock (creates a new note directly)
        Rectangle {
            x: root.ring-cx * 1px - 22px;
            y: root.ring-cy * 1px - 78px;
            width: 44px; height: 44px;
            background: EinkTheme.btn-bg;
            border-radius: 22px;
            border-width: 2px; border-color: EinkTheme.btn-border;
            Text {
                text: Icons.edit;
                font-family: "Material Icons";
                font-size: 22px; color: EinkTheme.btn-fg;
                horizontal-alignment: center; vertical-alignment: center;
                width: parent.width; height: parent.height;
            }
            TouchArea { clicked => { root.ring-note-tapped(); } }
        }

        // Event — 3 o'clock
        Rectangle {
            x: root.ring-cx * 1px + 34px;
            y: root.ring-cy * 1px - 22px;
            width: 44px; height: 44px;
            background: EinkTheme.btn-bg;
            border-radius: 22px;
            border-width: 2px; border-color: EinkTheme.btn-border;
            Text {
                text: Icons.calendar;
                font-family: "Material Icons";
                font-size: 22px; color: EinkTheme.btn-fg;
                horizontal-alignment: center; vertical-alignment: center;
                width: parent.width; height: parent.height;
            }
            TouchArea { clicked => { root.ring-calendar-tapped(); } }
        }

        // Task — 6 o'clock
        Rectangle {
            x: root.ring-cx * 1px - 22px;
            y: root.ring-cy * 1px + 34px;
            width: 44px; height: 44px;
            background: EinkTheme.btn-bg;
            border-radius: 22px;
            border-width: 2px; border-color: EinkTheme.btn-border;
            Text {
                text: Icons.done;
                font-family: "Material Icons";
                font-size: 22px; color: EinkTheme.btn-fg;
                horizontal-alignment: center; vertical-alignment: center;
                width: parent.width; height: parent.height;
            }
            TouchArea { clicked => { root.ring-task-tapped(); } }
        }

        // Record — 9 o'clock (only shown when device has mic)
        Rectangle {
            visible: root.ring-show-audio;
            x: root.ring-cx * 1px - 78px;
            y: root.ring-cy * 1px - 22px;
            width: 44px; height: 44px;
            background: EinkTheme.btn-bg;
            border-radius: 22px;
            border-width: 2px; border-color: EinkTheme.btn-border;
            Text {
                text: Icons.mic;
                font-family: "Material Icons";
                font-size: 22px; color: EinkTheme.btn-fg;
                horizontal-alignment: center; vertical-alignment: center;
                width: parent.width; height: parent.height;
            }
            TouchArea { clicked => { root.ring-audio-tapped(); } }
        }

        // Center dismiss
        Rectangle {
            x: root.ring-cx * 1px - 18px;
            y: root.ring-cy * 1px - 18px;
            width: 36px; height: 36px;
            background: EinkTheme.btn-active-bg;
            border-radius: 18px;
            border-width: 2px; border-color: EinkTheme.btn-border;
            Text {
                text: Icons.close;
                font-family: "Material Icons";
                font-size: 18px; color: EinkTheme.btn-active-fg;
                horizontal-alignment: center; vertical-alignment: center;
                width: parent.width; height: parent.height;
            }
            TouchArea { clicked => { root.ring-dismissed(); } }
        }
    }

    // ── Unified search view ──────────────────────────────────────────────
    search-view := Rectangle {
        visible: root.show-search;
        x: root.nav-w; y: 0;
        width: parent.width - root.nav-w;
        height: parent.height;
        background: EinkTheme.canvas-bg;
        clip: true;

        // Swallow pointer events so they never fall through to the ink canvas
        // TouchArea underneath (empty regions are not hit-targets otherwise).
        TouchArea {
            width: parent.width;
            height: parent.height;
        }

        VerticalLayout {
            padding: 12px;
            spacing: 10px;

            HorizontalLayout {
                spacing: 8px;
                height: 40px;
                Rectangle {
                    width: 40px; height: 40px;
                    border-radius: 4px;
                    border-width: 1px; border-color: EinkTheme.btn-border;
                    background: EinkTheme.btn-bg;
                    Text {
                        text: Icons.back;
                        font-family: "Material Icons"; font-size: 22px;
                        color: EinkTheme.btn-fg;
                        horizontal-alignment: center; vertical-alignment: center;
                        width: parent.width; height: parent.height;
                    }
                    TouchArea { clicked => { root.search-back(); } }
                }
                Text {
                    text: "Search";
                    font-size: 18px; font-weight: 700;
                    color: EinkTheme.btn-fg;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }

            HorizontalLayout {
                spacing: 8px;
                height: 40px;
                Rectangle {
                    horizontal-stretch: 1;
                    height: 40px;
                    border-width: 1px; border-color: EinkTheme.btn-border;
                    border-radius: 4px;
                    background: EinkTheme.btn-bg;
                    search-input := TextInput {
                        x: 8px; width: parent.width - 16px; height: parent.height;
                        text <=> root.search-query;
                        font-size: 14px;
                        color: EinkTheme.btn-fg;
                        single-line: true;
                        edited => { root.search-query-changed(self.text); }
                        accepted => { root.search-submit(self.text); }
                    }
                }
                Rectangle {
                    width: 72px; height: 40px;
                    border-radius: 4px;
                    border-width: 1px; border-color: EinkTheme.btn-border;
                    background: EinkTheme.btn-active-bg;
                    Text {
                        text: "Go";
                        font-size: 14px; color: EinkTheme.btn-active-fg;
                        horizontal-alignment: center; vertical-alignment: center;
                        width: parent.width; height: parent.height;
                    }
                    TouchArea {
                        // Pass the TextInput value directly (not the bound property)
                        // so Enter/Go never race a stale two-way binding.
                        clicked => { root.search-submit(search-input.text); }
                    }
                }
            }

            Text {
                text: root.search-status;
                font-size: 11px;
                color: EinkTheme.text-secondary;
                wrap: word-wrap;
            }

            Text {
                text: root.search-results.length == 0
                    ? (root.search-query == ""
                        ? "Type a query and tap Go — searches vault, notes, tasks, calendar."
                        : "No matching notes, tasks, or events.")
                    : "Results listed below.";
                font-size: 12px;
                color: EinkTheme.text-secondary;
            }

            Flickable {
                vertical-stretch: 1;
                content-width: parent.width - 24px;
                content-height: search-results-col.preferred-height;

                search-results-col := VerticalLayout {
                    spacing: 6px; width: parent.width;
                    for hit[i] in root.search-results: Rectangle {
                        height: 64px;
                        border-width: 1px; border-color: EinkTheme.chrome-border;
                        border-radius: 4px;
                        background: EinkTheme.btn-bg;
                        HorizontalLayout {
                            padding: 8px; spacing: 8px;
                            VerticalLayout {
                                spacing: 2px; horizontal-stretch: 1;
                                Text {
                                    text: hit.title;
                                    font-size: 14px; font-weight: 700;
                                    color: EinkTheme.btn-fg;
                                    overflow: elide;
                                }
                                Text {
                                    text: hit.source + "  ·  " + hit.snippet;
                                    font-size: 11px;
                                    color: EinkTheme.text-secondary;
                                    overflow: elide;
                                }
                            }
                        }
                        TouchArea {
                            clicked => { root.search-result-tapped(hit.id, hit.source); }
                        }
                    }
                }
            }
        }
    }

    // ── Markdown / vault note viewer ─────────────────────────────────────
    md-viewer := Rectangle {
        visible: root.show-md-viewer;
        x: root.nav-w; y: 0;
        width: parent.width - root.nav-w;
        height: parent.height;
        background: EinkTheme.canvas-bg;
        clip: true;

        // Behind the layout: swallow empty-region taps so they don't reach the ink canvas.
        TouchArea {
            width: parent.width;
            height: parent.height;
        }

        VerticalLayout {
            padding: 12px;
            spacing: 10px;
            alignment: stretch;

            HorizontalLayout {
                spacing: 8px;
                height: 40px;
                Rectangle {
                    width: 40px; height: 40px;
                    border-radius: 4px;
                    border-width: 1px; border-color: EinkTheme.btn-border;
                    background: EinkTheme.btn-bg;
                    Text {
                        text: Icons.back;
                        font-family: "Material Icons"; font-size: 22px;
                        color: EinkTheme.btn-fg;
                        horizontal-alignment: center; vertical-alignment: center;
                        width: parent.width; height: parent.height;
                    }
                    TouchArea { clicked => { root.md-viewer-back(); } }
                }
                VerticalLayout {
                    spacing: 0px; horizontal-stretch: 1;
                    Text {
                        text: root.md-viewer-title;
                        font-size: 16px; font-weight: 700;
                        color: EinkTheme.btn-fg;
                        overflow: elide;
                    }
                    Text {
                        text: root.md-viewer-path;
                        font-size: 11px;
                        color: EinkTheme.text-secondary;
                        overflow: elide;
                    }
                }
            }

            // Constrain viewport so content taller than the pane can scroll.
            Flickable {
                vertical-stretch: 1;
                width: root.width - root.nav-w - 24px;
                // Use root geometry (not parent.*) to avoid Flickable layout loops.
                content-width: root.width - root.nav-w - 24px;
                content-height: md-blocks-col.preferred-height;

                md-blocks-col := VerticalLayout {
                    spacing: 10px;
                    width: root.width - root.nav-w - 24px;

                    for block[i] in root.md-viewer-blocks: Text {
                        width: root.width - root.nav-w - 24px;
                        text: block.kind == 8 ? "────────"
                            : block.kind == 4 ? ("•  " + block.text)
                            : block.kind == 6 ? ("│  " + block.text)
                            : block.text;
                        wrap: word-wrap;
                        color: block.kind == 6 || block.kind == 7 || block.kind == 8
                            ? EinkTheme.text-secondary
                            : EinkTheme.btn-fg;
                        font-size: block.kind == 0 ? 20px
                            : block.kind == 1 ? 17px
                            : block.kind == 2 ? 15px
                            : 14px;
                        font-weight: block.kind <= 2 ? 700 : 400;
                    }

                    if root.md-viewer-blocks.length == 0: Text {
                        width: root.width - root.nav-w - 24px;
                        text: root.md-viewer-body;
                        font-size: 14px;
                        color: EinkTheme.btn-fg;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }

    // ── Settings view ────────────────────────────────────────────────────
    settings-view := Rectangle {
        visible: root.show-settings;
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        background: EinkTheme.canvas-bg;
        clip: true;

        HorizontalLayout {
            padding: 0px; spacing: 0px;

            // ── Left section navigation ──────────────────────────────────
            Rectangle {
                width: 80px;
                background: EinkTheme.chrome-bg;
                clip: true;

                VerticalLayout {
                    padding: 0px; spacing: 0px;

                    // Back
                    Rectangle {
                        height: 56px;
                        background: EinkTheme.btn-bg;
                        VerticalLayout {
                            padding: 4px; spacing: 2px; alignment: center;
                            Text {
                                text: Icons.back;
                                font-family: "Material Icons"; font-size: 22px;
                                color: EinkTheme.btn-fg;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "Back";
                                font-size: 9px; color: EinkTheme.text-secondary;
                                horizontal-alignment: center;
                            }
                        }
                        TouchArea { clicked => { root.settings-back(); } }
                    }

                    Rectangle { height: 2px; background: EinkTheme.chrome-border; }

                    // General
                    Rectangle {
                        height: 72px;
                        background: root.settings-section == 0 ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                        VerticalLayout {
                            padding: 6px; spacing: 2px; alignment: center;
                            Text {
                                text: Icons.settings;
                                font-family: "Material Icons"; font-size: 24px;
                                color: root.settings-section == 0 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "General";
                                font-size: 9px;
                                color: root.settings-section == 0 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                                horizontal-alignment: center;
                            }
                        }
                        TouchArea { clicked => { root.settings-section = 0; } }
                    }

                    Rectangle { height: 1px; background: EinkTheme.chrome-border; }

                    // Profiles
                    Rectangle {
                        height: 72px;
                        background: root.settings-section == 1 ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                        VerticalLayout {
                            padding: 6px; spacing: 2px; alignment: center;
                            Text {
                                text: Icons.profile-person;
                                font-family: "Material Icons"; font-size: 24px;
                                color: root.settings-section == 1 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "Profiles";
                                font-size: 9px;
                                color: root.settings-section == 1 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                                horizontal-alignment: center;
                            }
                        }
                        TouchArea { clicked => { root.settings-section = 1; } }
                    }

                    Rectangle { height: 1px; background: EinkTheme.chrome-border; }

                    // Connections
                    Rectangle {
                        height: 72px;
                        background: root.settings-section == 2 ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                        VerticalLayout {
                            padding: 6px; spacing: 2px; alignment: center;
                            Text {
                                text: Icons.link;
                                font-family: "Material Icons"; font-size: 24px;
                                color: root.settings-section == 2 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "Connect";
                                font-size: 9px;
                                color: root.settings-section == 2 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                                horizontal-alignment: center;
                            }
                        }
                        TouchArea {
                            clicked => {
                                root.settings-section = 2;
                                // Prefer the app's active profile; else first profile.
                                if (root.connect-profile-id == "") {
                                    if (root.active-profile-id != "") {
                                        root.connect-profile-id = root.active-profile-id;
                                    }
                                }
                                root.connect-profile-changed(root.connect-profile-id);
                            }
                        }
                    }

                    Rectangle { height: 1px; background: EinkTheme.chrome-border; }

                    // Tasks (GTD lanes)
                    Rectangle {
                        height: 72px;
                        background: root.settings-section == 3 ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                        VerticalLayout {
                            padding: 6px; spacing: 2px; alignment: center;
                            Text {
                                text: Icons.tasks;
                                font-family: "Material Icons"; font-size: 24px;
                                color: root.settings-section == 3 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "Tasks";
                                font-size: 9px;
                                color: root.settings-section == 3 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                                horizontal-alignment: center;
                            }
                        }
                        TouchArea { clicked => { root.settings-section = 3; } }
                    }

                    // Spacer
                    Rectangle { vertical-stretch: 1; background: EinkTheme.chrome-bg; }

                    Rectangle { height: 1px; background: EinkTheme.chrome-border; }

                    // Save
                    Rectangle {
                        height: 52px;
                        background: EinkTheme.btn-active-bg;
                        VerticalLayout {
                            padding: 4px; spacing: 2px; alignment: center;
                            Text {
                                text: Icons.done;
                                font-family: "Material Icons"; font-size: 22px;
                                color: EinkTheme.btn-active-fg;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "Save";
                                font-size: 9px; color: EinkTheme.btn-active-fg;
                                horizontal-alignment: center;
                            }
                        }
                        TouchArea { clicked => { root.settings-save(); } }
                    }
                }

                // Right border of section nav
                Rectangle {
                    x: 78px; y: 0;
                    width: 2px; height: parent.height;
                    background: EinkTheme.chrome-border;
                }
            }

            // ── Section content area ──────────────────────────────────────
            Rectangle {
                horizontal-stretch: 1;
                clip: true;

                // ── General section ──────────────────────────────────────
                Rectangle {
                    visible: root.settings-section == 0;
                    width: parent.width; height: parent.height;
                    clip: true;

                    VerticalLayout {
                        padding: 0px; spacing: 0px;

                        Rectangle {
                            height: 44px;
                            background: EinkTheme.canvas-bg;
                            HorizontalLayout {
                                padding-left: 16px; padding-right: 16px;
                                padding-top: 6px; padding-bottom: 6px;
                                spacing: 12px;

                                Text {
                                    text: "Theme";
                                    font-size: 14px; color: EinkTheme.btn-fg;
                                    vertical-alignment: center; width: 80px;
                                }

                                Rectangle {
                                    width: 72px; height: 32px;
                                    background: root.settings-theme-idx == 0 ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                                    border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                                    Text { text: "Light"; font-size: 13px;
                                           color: root.settings-theme-idx == 0 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                                           horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.settings-theme-idx = 0; } }
                                }

                                Rectangle {
                                    width: 72px; height: 32px;
                                    background: root.settings-theme-idx == 1 ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                                    border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                                    Text { text: "Dark"; font-size: 13px;
                                           color: root.settings-theme-idx == 1 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                                           horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.settings-theme-idx = 1; } }
                                }

                                Rectangle { horizontal-stretch: 1; }
                            }
                        }

                        Rectangle { height: 2px; background: EinkTheme.chrome-border; }

                        Rectangle {
                            height: 44px;
                            background: EinkTheme.canvas-bg;
                            HorizontalLayout {
                                padding-left: 16px; padding-right: 16px;
                                padding-top: 6px; padding-bottom: 6px;
                                spacing: 12px;

                                Text {
                                    text: "Ink input";
                                    font-size: 14px; color: EinkTheme.btn-fg;
                                    vertical-alignment: center; width: 80px;
                                }

                                Rectangle {
                                    width: 84px; height: 32px;
                                    background: root.settings-pen-only ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                                    border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                                    Text { text: "Pen only"; font-size: 13px;
                                           color: root.settings-pen-only ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                                           horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.settings-pen-only = true; } }
                                }

                                Rectangle {
                                    width: 110px; height: 32px;
                                    background: !root.settings-pen-only ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                                    border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                                    Text { text: "Pen + finger"; font-size: 13px;
                                           color: !root.settings-pen-only ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                                           horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.settings-pen-only = false; } }
                                }

                                Rectangle { horizontal-stretch: 1; }
                            }
                        }

                        Rectangle { height: 2px; background: EinkTheme.chrome-border; }

                        Rectangle {
                            height: 72px;
                            background: EinkTheme.canvas-bg;
                            VerticalLayout {
                                padding-left: 16px; padding-right: 16px;
                                padding-top: 6px; padding-bottom: 6px;
                                spacing: 4px;

                                Text {
                                    text: "New note title";
                                    font-size: 14px; color: EinkTheme.btn-fg;
                                    vertical-alignment: center;
                                }
                                Rectangle {
                                    height: 32px;
                                    border-radius: 4px; border-width: 2px;
                                    border-color: EinkTheme.btn-border;
                                    background: EinkTheme.canvas-bg;
                                    TextInput {
                                        x: 8px; width: parent.width - 16px; height: parent.height;
                                        font-size: 13px; color: EinkTheme.btn-fg;
                                        text <=> root.settings-note-title-pattern;
                                        vertical-alignment: center; single-line: true;
                                    }
                                }
                                Text {
                                    text: "Tokens: yyyy mm dd · {n} = counter";
                                    font-size: 11px; color: EinkTheme.text-secondary;
                                }
                            }
                        }

                        Rectangle { height: 2px; background: EinkTheme.chrome-border; }

                        if root.has-mic: Rectangle {
                            height: 36px;
                            background: EinkTheme.canvas-bg;
                            HorizontalLayout {
                                padding-left: 16px; padding-top: 4px; padding-bottom: 4px;
                                Text {
                                    text: "Transcription";
                                    font-size: 14px; font-weight: 700; color: EinkTheme.btn-fg;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        if root.has-mic: Rectangle {
                            height: 48px;
                            background: EinkTheme.canvas-bg;
                            HorizontalLayout {
                                padding-left: 16px; padding-right: 16px;
                                padding-top: 6px; padding-bottom: 6px;
                                spacing: 8px;

                                Text {
                                    text: "Whisper model";
                                    font-size: 14px; color: EinkTheme.btn-fg;
                                    vertical-alignment: center; width: 110px;
                                }

                                Text {
                                    text: root.whisper-downloading ? "Downloading…"
                                        : root.whisper-model-installed ? "Installed (ggml-base)"
                                        : "Not installed";
                                    font-size: 12px;
                                    color: root.whisper-model-installed ? EinkTheme.btn-fg : EinkTheme.text-secondary;
                                    vertical-alignment: center; horizontal-stretch: 1;
                                }

                                if !root.whisper-downloading && !root.whisper-model-installed: Rectangle {
                                    width: 84px; height: 32px;
                                    background: EinkTheme.btn-bg;
                                    border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                                    Text { text: "Download"; font-size: 12px; color: EinkTheme.btn-fg;
                                           horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.settings-whisper-download(); } }
                                }

                                if !root.whisper-downloading && root.whisper-model-installed: Rectangle {
                                    width: 60px; height: 32px;
                                    background: EinkTheme.btn-bg;
                                    border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                                    Text { text: "Delete"; font-size: 12px; color: EinkTheme.danger-fg;
                                           horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.settings-whisper-delete(); } }
                                }
                            }
                        }

                        if root.has-mic: Rectangle {
                            height: 44px;
                            background: EinkTheme.canvas-bg;
                            HorizontalLayout {
                                padding-left: 16px; padding-right: 16px;
                                padding-top: 6px; padding-bottom: 6px;
                                spacing: 8px;

                                Text {
                                    text: "Language";
                                    font-size: 14px; color: EinkTheme.btn-fg;
                                    vertical-alignment: center; width: 110px;
                                }

                                for lang-opt in ["auto", "en", "de"]: Rectangle {
                                    property <string> lbl: lang-opt == "auto" ? "Auto"
                                        : lang-opt == "en" ? "English" : "German";
                                    property <bool> active: root.whisper-lang == lang-opt;
                                    width: 72px; height: 32px;
                                    background: active ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                                    border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                                    Text { text: lbl; font-size: 12px;
                                           color: active ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                                           horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.whisper-lang = lang-opt; } }
                                }

                                Rectangle { horizontal-stretch: 1; }
                            }
                        }

                        Rectangle {
                            height: 36px;
                            background: EinkTheme.canvas-bg;
                            HorizontalLayout {
                                padding-left: 16px; padding-top: 4px; padding-bottom: 4px;
                                Text {
                                    text: "Handwriting";
                                    font-size: 14px; font-weight: 700; color: EinkTheme.btn-fg;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Rectangle {
                            height: 48px;
                            background: EinkTheme.canvas-bg;
                            HorizontalLayout {
                                padding-left: 16px; padding-right: 16px;
                                padding-top: 6px; padding-bottom: 6px;
                                spacing: 8px;

                                Text {
                                    text: "HTR model";
                                    font-size: 14px; color: EinkTheme.btn-fg;
                                    vertical-alignment: center; width: 110px;
                                }

                                Text {
                                    text: root.htr-downloading ? "Downloading…"
                                        : root.htr-model-installed ? "Installed (stroke HTR)"
                                        : "Not installed (OCR fallback)";
                                    font-size: 12px;
                                    color: root.htr-model-installed ? EinkTheme.btn-fg : EinkTheme.text-secondary;
                                    vertical-alignment: center; horizontal-stretch: 1;
                                }

                                if !root.htr-downloading && !root.htr-model-installed: Rectangle {
                                    width: 84px; height: 32px;
                                    background: EinkTheme.btn-bg;
                                    border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                                    Text { text: "Download"; font-size: 12px; color: EinkTheme.btn-fg;
                                           horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.settings-htr-download(); } }
                                }

                                if !root.htr-downloading && root.htr-model-installed: Rectangle {
                                    width: 60px; height: 32px;
                                    background: EinkTheme.btn-bg;
                                    border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                                    Text { text: "Delete"; font-size: 12px; color: EinkTheme.danger-fg;
                                           horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.settings-htr-delete(); } }
                                }
                            }
                        }

                        Rectangle {
                            height: 48px;
                            background: EinkTheme.canvas-bg;
                            HorizontalLayout {
                                padding-left: 16px; padding-right: 16px;
                                padding-top: 6px; padding-bottom: 6px;
                                spacing: 8px;

                                Text {
                                    text: "Line model";
                                    font-size: 14px; color: EinkTheme.btn-fg;
                                    vertical-alignment: center; width: 110px;
                                }

                                Text {
                                    text: root.line-htr-downloading ? "Downloading…"
                                        : root.line-htr-model-installed ? "Installed (DE·HTR ~10MB)"
                                        : "Optional image HTR (DE+Latin)";
                                    font-size: 12px;
                                    color: root.line-htr-model-installed ? EinkTheme.btn-fg : EinkTheme.text-secondary;
                                    vertical-alignment: center; horizontal-stretch: 1;
                                }

                                if !root.line-htr-downloading && !root.line-htr-model-installed: Rectangle {
                                    width: 84px; height: 32px;
                                    background: EinkTheme.btn-bg;
                                    border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                                    Text { text: "Download"; font-size: 12px; color: EinkTheme.btn-fg;
                                           horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.settings-line-htr-download(); } }
                                }

                                if !root.line-htr-downloading && root.line-htr-model-installed: Rectangle {
                                    width: 60px; height: 32px;
                                    background: EinkTheme.btn-bg;
                                    border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                                    Text { text: "Delete"; font-size: 12px; color: EinkTheme.danger-fg;
                                           horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.settings-line-htr-delete(); } }
                                }
                            }
                        }

                        Rectangle {
                            height: 48px;
                            background: EinkTheme.canvas-bg;
                            HorizontalLayout {
                                padding-left: 16px; padding-right: 16px;
                                padding-top: 6px; padding-bottom: 6px;
                                spacing: 8px;

                                Text {
                                    text: "Language";
                                    font-size: 14px; color: EinkTheme.btn-fg;
                                    vertical-alignment: center; width: 110px;
                                }

                                for lang-opt in ["auto", "en", "de"]: Rectangle {
                                    property <string> lbl: lang-opt == "auto" ? "Auto"
                                        : lang-opt == "en" ? "English" : "German";
                                    property <bool> active: root.settings-handwriting-lang == lang-opt;
                                    width: 72px; height: 32px;
                                    background: active ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                                    border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                                    Text { text: lbl; font-size: 12px;
                                           color: active ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                                           horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.settings-handwriting-lang = lang-opt; } }
                                }

                                Rectangle { horizontal-stretch: 1; }
                            }
                        }

                        Rectangle {
                            height: 48px;
                            background: EinkTheme.canvas-bg;
                            HorizontalLayout {
                                padding-left: 16px; padding-right: 16px;
                                padding-top: 6px; padding-bottom: 6px;
                                spacing: 8px;

                                Text {
                                    text: "Printed OCR";
                                    font-size: 14px; color: EinkTheme.btn-fg;
                                    vertical-alignment: center; width: 110px;
                                }

                                Text {
                                    text: "Tesseract last resort (printed / weak lines)";
                                    font-size: 12px; color: EinkTheme.text-secondary;
                                    vertical-alignment: center; horizontal-stretch: 1;
                                }

                                Rectangle {
                                    width: 52px; height: 32px;
                                    background: root.settings-ocr-enabled ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                                    border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                                    Text {
                                        text: root.settings-ocr-enabled ? "On" : "Off";
                                        font-size: 12px;
                                        color: root.settings-ocr-enabled ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                                        horizontal-alignment: center; vertical-alignment: center;
                                    }
                                    TouchArea {
                                        clicked => {
                                            root.settings-ocr-enabled = !root.settings-ocr-enabled;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // ── Profiles section ─────────────────────────────────────
                Rectangle {
                    visible: root.settings-section == 1;
                    width: parent.width; height: parent.height;
                    clip: true;

                    VerticalLayout {
                        padding: 0px; spacing: 0px;

                        Rectangle {
                            height: 48px;
                            background: EinkTheme.canvas-bg;
                            HorizontalLayout {
                                padding-left: 16px; padding-right: 16px;
                                padding-top: 8px; padding-bottom: 8px;
                                spacing: 8px;

                                Text {
                                    text: "Profiles";
                                    font-size: 14px; font-weight: 700; color: EinkTheme.btn-fg;
                                    vertical-alignment: center; horizontal-stretch: 1;
                                }

                                Rectangle {
                                    width: 108px; height: 32px;
                                    background: EinkTheme.btn-active-bg;
                                    border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                                    Text { text: "+ Add Profile"; font-size: 12px; color: EinkTheme.btn-active-fg;
                                           horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea {
                                        clicked => {
                                            root.profile-edit-is-new = true;
                                            root.profile-edit-id = "";
                                            root.profile-edit-name = "";
                                            root.profile-edit-icon = "person";
                                            root.profile-edit-has-custom = false;
                                            root.profile-edit-dialog-visible = true;
                                        }
                                    }
                                }
                            }
                        }

                        Rectangle { height: 2px; background: EinkTheme.chrome-border; }

                        for p in root.profile-list: Rectangle {
                            height: 104px;
                            background: EinkTheme.canvas-bg;

                            VerticalLayout {
                                padding: 0px; spacing: 0px;

                                // Row 1: icon + name + edit + delete
                                HorizontalLayout {
                                    padding-left: 16px; padding-right: 12px;
                                    padding-top: 8px; padding-bottom: 4px;
                                    spacing: 8px;

                                    Rectangle {
                                        width: 40px; height: 40px;
                                        border-radius: 20px;
                                        background: EinkTheme.btn-bg;
                                        border-width: 2px; border-color: EinkTheme.btn-border;
                                        ProfileIcon {
                                            x: 7px; y: 7px;
                                            icon-char: p.icon-char; has-custom: p.has-custom-icon; custom-icon: p.custom-icon;
                                            size: 26px; fg: EinkTheme.btn-fg;
                                        }
                                    }

                                    Text {
                                        text: p.name;
                                        font-size: 14px; color: EinkTheme.btn-fg;
                                        vertical-alignment: center; horizontal-stretch: 1;
                                        overflow: elide;
                                    }

                                    Rectangle {
                                        width: 36px; height: 36px;
                                        background: transparent;
                                        Text {
                                            text: Icons.edit;
                                            font-family: "Material Icons"; font-size: 20px;
                                            color: EinkTheme.text-secondary;
                                            horizontal-alignment: center; vertical-alignment: center;
                                            width: parent.width; height: parent.height;
                                        }
                                        TouchArea {
                                            clicked => {
                                                root.profile-edit-is-new = false;
                                                root.profile-edit-id = p.id;
                                                root.profile-edit-name = p.name;
                                                root.profile-edit-icon = p.icon;
                                                root.profile-edit-has-custom = p.has-custom-icon;
                                                root.profile-edit-custom-image = p.custom-icon;
                                                root.profile-edit-dialog-visible = true;
                                            }
                                        }
                                    }

                                    Rectangle {
                                        width: 36px; height: 36px;
                                        background: transparent;
                                        Text {
                                            text: Icons.delete;
                                            font-family: "Material Icons"; font-size: 20px;
                                            color: EinkTheme.danger-fg;
                                            horizontal-alignment: center; vertical-alignment: center;
                                            width: parent.width; height: parent.height;
                                        }
                                        TouchArea { clicked => { root.settings-profile-delete(p.id); } }
                                    }
                                }

                                // Row 2: notes-in-all toggle
                                Rectangle {
                                    height: 28px;
                                    HorizontalLayout {
                                        padding-left: 62px; padding-right: 12px;
                                        padding-top: 4px; padding-bottom: 4px;
                                        spacing: 6px; alignment: start;
                                        Text {
                                            text: "Notes visible in All";
                                            font-size: 11px; color: EinkTheme.text-secondary;
                                            vertical-alignment: center; horizontal-stretch: 1;
                                        }
                                        Text {
                                            text: p.notes-in-all ? Icons.check-box : Icons.check-box-out;
                                            font-family: "Material Icons"; font-size: 18px;
                                            color: EinkTheme.btn-fg;
                                            vertical-alignment: center;
                                        }
                                    }
                                    TouchArea {
                                        clicked => { root.settings-profile-toggle-notes-in-all(p.id); }
                                    }
                                }

                                // Row 3: recordings-in-all toggle
                                Rectangle {
                                    height: 28px;
                                    HorizontalLayout {
                                        padding-left: 62px; padding-right: 12px;
                                        padding-top: 4px; padding-bottom: 4px;
                                        spacing: 6px; alignment: start;
                                        Text {
                                            text: "Recordings visible in All";
                                            font-size: 11px; color: EinkTheme.text-secondary;
                                            vertical-alignment: center; horizontal-stretch: 1;
                                        }
                                        Text {
                                            text: p.recordings-in-all ? Icons.check-box : Icons.check-box-out;
                                            font-family: "Material Icons"; font-size: 18px;
                                            color: EinkTheme.btn-fg;
                                            vertical-alignment: center;
                                        }
                                    }
                                    TouchArea {
                                        clicked => { root.settings-profile-toggle-recordings-in-all(p.id); }
                                    }
                                }
                            }

                            Rectangle {
                                x: 0; y: parent.height - 1px;
                                width: parent.width; height: 1px;
                                background: EinkTheme.chrome-border; opacity: 0.3;
                            }
                        }

                        if root.profile-list.length == 0: Rectangle {
                            height: 80px;
                            background: EinkTheme.canvas-bg;
                            Text {
                                text: "No profiles yet — tap + Add Profile";
                                font-size: 13px; color: EinkTheme.text-secondary;
                                horizontal-alignment: center; vertical-alignment: center;
                            }
                        }
                    }
                }

                // ── Connect section (per-profile providers) ───────────────
                Rectangle {
                    visible: root.settings-section == 2;
                    width: parent.width; height: parent.height;
                    clip: true;

                    VerticalLayout {
                        padding: 0px; spacing: 0px;

                        // Header
                        Rectangle {
                            height: 44px;
                            background: EinkTheme.canvas-bg;
                            HorizontalLayout {
                                padding-left: 16px; padding-right: 12px;
                                padding-top: 8px; padding-bottom: 8px;
                                spacing: 8px;
                                Text {
                                    text: "Connect";
                                    font-size: 14px; font-weight: 700; color: EinkTheme.btn-fg;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "Providers for one profile";
                                    font-size: 11px; color: EinkTheme.text-secondary;
                                    vertical-alignment: center; horizontal-stretch: 1;
                                }
                            }
                        }

                        Rectangle { height: 1px; background: EinkTheme.chrome-border; }

                        // Profile picker (no "All" — connections are always per-profile)
                        Rectangle {
                            height: 48px;
                            background: EinkTheme.canvas-bg;
                            HorizontalLayout {
                                padding-left: 12px; padding-right: 12px;
                                padding-top: 8px; padding-bottom: 8px;
                                spacing: 6px; alignment: start;

                                Text {
                                    text: "Profile";
                                    font-size: 12px; color: EinkTheme.text-secondary;
                                    vertical-alignment: center; width: 48px;
                                }

                                for p in root.profile-list: ProfileChip {
                                    label: p.name;
                                    icon-char: p.icon-char;
                                    has-custom: p.has-custom-icon;
                                    custom-icon: p.custom-icon;
                                    selected: root.connect-profile-id == p.id;
                                    pill: false;
                                    chip-width: 100px;
                                    label-size: 12px;
                                    TouchArea {
                                        width: parent.width; height: parent.height;
                                        clicked => {
                                            root.connect-profile-id = p.id;
                                            root.connect-profile-changed(p.id);
                                        }
                                    }
                                }

                                Rectangle { horizontal-stretch: 1; }
                            }
                        }

                        Rectangle { height: 2px; background: EinkTheme.chrome-border; }

                        // Empty: no profiles yet
                        if root.profile-list.length == 0: Rectangle {
                            vertical-stretch: 1;
                            background: EinkTheme.canvas-bg;
                            VerticalLayout {
                                padding: 24px; spacing: 12px; alignment: center;
                                Text {
                                    text: Icons.profile-person;
                                    font-family: "Material Icons"; font-size: 36px;
                                    color: EinkTheme.text-secondary;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: "Create a profile first";
                                    font-size: 14px; font-weight: 700; color: EinkTheme.btn-fg;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: "Connections belong to a profile\n(Work, Home, …). Add one under Profiles.";
                                    font-size: 12px; color: EinkTheme.text-secondary;
                                    horizontal-alignment: center;
                                }
                                Rectangle {
                                    width: 160px; height: 36px;
                                    background: EinkTheme.btn-active-bg;
                                    border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                                    Text { text: "Go to Profiles"; font-size: 13px; color: EinkTheme.btn-active-fg;
                                           horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea { clicked => { root.settings-section = 1; } }
                                }
                            }
                        }

                        // Provider catalog (scrollable)
                        if root.profile-list.length > 0: Flickable {
                            vertical-stretch: 1;

                            VerticalLayout {
                                spacing: 0px;

                                // ── NOTES ────────────────────────────────
                                Rectangle {
                                    height: 32px;
                                    background: EinkTheme.canvas-bg;
                                    Text {
                                        x: 16px; y: 0; width: parent.width - 16px; height: parent.height;
                                        text: "NOTES";
                                        font-size: 11px; font-weight: 700; color: EinkTheme.text-secondary;
                                        vertical-alignment: center;
                                    }
                                }

                                // Obsidian Vault
                                Rectangle {
                                    height: root.connect-has-vault ? 88px : 72px;
                                    background: EinkTheme.canvas-bg;
                                    VerticalLayout {
                                        padding-left: 12px; padding-right: 12px;
                                        padding-top: 8px; padding-bottom: 8px;
                                        spacing: 4px;

                                        HorizontalLayout {
                                            spacing: 10px;
                                            Rectangle {
                                                width: 36px; height: 36px;
                                                border-radius: 4px;
                                                background: EinkTheme.btn-bg;
                                                border-width: 2px; border-color: EinkTheme.btn-border;
                                                Text {
                                                    text: Icons.folder;
                                                    font-family: "Material Icons"; font-size: 20px;
                                                    color: EinkTheme.btn-fg;
                                                    horizontal-alignment: center; vertical-alignment: center;
                                                    width: parent.width; height: parent.height;
                                                }
                                            }
                                            VerticalLayout {
                                                spacing: 2px; alignment: center; horizontal-stretch: 1;
                                                Text {
                                                    text: "Obsidian Vault";
                                                    font-size: 13px; font-weight: 700; color: EinkTheme.btn-fg;
                                                }
                                                Text {
                                                    text: root.connect-has-vault ? "Connected" : "Not connected — tasks & notes";
                                                    font-size: 11px; color: EinkTheme.text-secondary;
                                                }
                                            }
                                            Rectangle {
                                                width: 88px; height: 32px;
                                                background: EinkTheme.btn-active-bg;
                                                border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                                                Text {
                                                    text: root.connect-has-vault ? "Configure" : "Set up";
                                                    font-size: 12px; color: EinkTheme.btn-active-fg;
                                                    horizontal-alignment: center; vertical-alignment: center;
                                                }
                                                TouchArea {
                                                    clicked => {
                                                        root.connect-setup-kind = "vault";
                                                        root.connect-setup-visible = true;
                                                    }
                                                }
                                            }
                                        }

                                        for conn[i] in root.connection-list: Rectangle {
                                            visible: conn.kind == "vault" && conn.profile-id == root.connect-profile-id;
                                            height: self.visible ? 36px : 0px;
                                            clip: true;
                                            HorizontalLayout {
                                                spacing: 8px; padding-left: 46px;
                                                VerticalLayout {
                                                    spacing: 1px; horizontal-stretch: 1; alignment: center;
                                                    Text { text: conn.display; font-size: 12px; color: EinkTheme.btn-fg; overflow: elide; }
                                                    Text { text: conn.value; font-size: 10px; color: EinkTheme.text-secondary; overflow: elide; }
                                                }
                                                Rectangle {
                                                    height: 28px; min-width: 70px;
                                                    HorizontalLayout {
                                                        spacing: 4px; alignment: center;
                                                        Text {
                                                            text: conn.allow-in-aggregated ? Icons.check-box : Icons.check-box-out;
                                                            font-family: "Material Icons"; font-size: 18px; color: EinkTheme.btn-fg;
                                                            vertical-alignment: center;
                                                        }
                                                        Text {
                                                            text: "In All"; font-size: 10px; color: EinkTheme.text-secondary;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                    TouchArea { clicked => { root.connection-toggle-aggregated(i); } }
                                                }
                                                Rectangle {
                                                    width: 28px; height: 28px;
                                                    Text { text: Icons.delete; font-family: "Material Icons"; font-size: 16px;
                                                           color: EinkTheme.danger-fg;
                                                           horizontal-alignment: center; vertical-alignment: center;
                                                           width: parent.width; height: parent.height; }
                                                    TouchArea { clicked => { root.connection-remove(i); } }
                                                }
                                            }
                                        }
                                    }
                                    Rectangle {
                                        x: 12px; y: parent.height - 1px; width: parent.width - 24px; height: 1px;
                                        background: EinkTheme.chrome-border; opacity: 0.35;
                                    }
                                }

                                // Evernote (soon)
                                Rectangle {
                                    height: 64px;
                                    background: EinkTheme.canvas-bg;
                                    HorizontalLayout {
                                        padding-left: 12px; padding-right: 12px;
                                        padding-top: 10px; padding-bottom: 10px;
                                        spacing: 10px;
                                        Rectangle {
                                            width: 36px; height: 36px;
                                            border-radius: 4px;
                                            background: EinkTheme.btn-bg;
                                            border-width: 2px; border-color: EinkTheme.btn-border;
                                            Text {
                                                text: Icons.event-note;
                                                font-family: "Material Icons"; font-size: 20px;
                                                color: EinkTheme.text-secondary;
                                                horizontal-alignment: center; vertical-alignment: center;
                                                width: parent.width; height: parent.height;
                                            }
                                        }
                                        VerticalLayout {
                                            spacing: 2px; alignment: center; horizontal-stretch: 1;
                                            Text { text: "Evernote"; font-size: 13px; font-weight: 700; color: EinkTheme.btn-fg; }
                                            Text { text: "Coming soon"; font-size: 11px; color: EinkTheme.text-secondary; }
                                        }
                                        Rectangle {
                                            width: 72px; height: 32px;
                                            background: EinkTheme.btn-bg;
                                            border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                                            Text { text: "Info"; font-size: 12px; color: EinkTheme.btn-fg;
                                                   horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea {
                                                clicked => {
                                                    root.connect-soon-title = "Evernote";
                                                    root.connect-soon-body = "Evernote sync for this profile is on the roadmap. You will connect an account here.";
                                                    root.connect-soon-visible = true;
                                                }
                                            }
                                        }
                                    }
                                    Rectangle {
                                        x: 12px; y: parent.height - 1px; width: parent.width - 24px; height: 1px;
                                        background: EinkTheme.chrome-border; opacity: 0.35;
                                    }
                                }

                                // Drive notes (soon)
                                Rectangle {
                                    height: 64px;
                                    background: EinkTheme.canvas-bg;
                                    HorizontalLayout {
                                        padding-left: 12px; padding-right: 12px;
                                        padding-top: 10px; padding-bottom: 10px;
                                        spacing: 10px;
                                        Rectangle {
                                            width: 36px; height: 36px;
                                            border-radius: 4px;
                                            background: EinkTheme.btn-bg;
                                            border-width: 2px; border-color: EinkTheme.btn-border;
                                            Text {
                                                text: Icons.cloud;
                                                font-family: "Material Icons"; font-size: 20px;
                                                color: EinkTheme.text-secondary;
                                                horizontal-alignment: center; vertical-alignment: center;
                                                width: parent.width; height: parent.height;
                                            }
                                        }
                                        VerticalLayout {
                                            spacing: 2px; alignment: center; horizontal-stretch: 1;
                                            Text { text: "Drive (notes)"; font-size: 13px; font-weight: 700; color: EinkTheme.btn-fg; }
                                            Text { text: "Coming soon — WebDAV / Drive sync"; font-size: 11px; color: EinkTheme.text-secondary; }
                                        }
                                        Rectangle {
                                            width: 72px; height: 32px;
                                            background: EinkTheme.btn-bg;
                                            border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                                            Text { text: "Info"; font-size: 12px; color: EinkTheme.btn-fg;
                                                   horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea {
                                                clicked => {
                                                    root.connect-soon-title = "Drive for notes";
                                                    root.connect-soon-body = "File sync (WebDAV first, Google Drive later) will let each profile keep notes in the cloud.";
                                                    root.connect-soon-visible = true;
                                                }
                                            }
                                        }
                                    }
                                    Rectangle {
                                        x: 12px; y: parent.height - 1px; width: parent.width - 24px; height: 1px;
                                        background: EinkTheme.chrome-border; opacity: 0.35;
                                    }
                                }

                                // ── TASKS ────────────────────────────────
                                Rectangle {
                                    height: 32px;
                                    background: EinkTheme.canvas-bg;
                                    Text {
                                        x: 16px; y: 0; width: parent.width - 16px; height: parent.height;
                                        text: "TASKS";
                                        font-size: 11px; font-weight: 700; color: EinkTheme.text-secondary;
                                        vertical-alignment: center;
                                    }
                                }

                                Rectangle {
                                    height: 64px;
                                    background: EinkTheme.canvas-bg;
                                    HorizontalLayout {
                                        padding-left: 12px; padding-right: 12px;
                                        padding-top: 10px; padding-bottom: 10px;
                                        spacing: 10px;
                                        Rectangle {
                                            width: 36px; height: 36px;
                                            border-radius: 4px;
                                            background: EinkTheme.btn-bg;
                                            border-width: 2px; border-color: EinkTheme.btn-border;
                                            Text {
                                                text: Icons.tasks;
                                                font-family: "Material Icons"; font-size: 20px;
                                                color: EinkTheme.text-secondary;
                                                horizontal-alignment: center; vertical-alignment: center;
                                                width: parent.width; height: parent.height;
                                            }
                                        }
                                        VerticalLayout {
                                            spacing: 2px; alignment: center; horizontal-stretch: 1;
                                            Text { text: "Todoist"; font-size: 13px; font-weight: 700; color: EinkTheme.btn-fg; }
                                            Text { text: "Coming soon"; font-size: 11px; color: EinkTheme.text-secondary; }
                                        }
                                        Rectangle {
                                            width: 72px; height: 32px;
                                            background: EinkTheme.btn-bg;
                                            border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                                            Text { text: "Info"; font-size: 12px; color: EinkTheme.btn-fg;
                                                   horizontal-alignment: center; vertical-alignment: center; }
                                            TouchArea {
                                                clicked => {
                                                    root.connect-soon-title = "Todoist";
                                                    root.connect-soon-body = "Todoist will connect as a task provider for this profile. Obsidian vault tasks work today when a vault is set up.";
                                                    root.connect-soon-visible = true;
                                                }
                                            }
                                        }
                                    }
                                    Rectangle {
                                        x: 12px; y: parent.height - 1px; width: parent.width - 24px; height: 1px;
                                        background: EinkTheme.chrome-border; opacity: 0.35;
                                    }
                                }

                                // ── CALENDAR ─────────────────────────────
                                Rectangle {
                                    height: 32px;
                                    background: EinkTheme.canvas-bg;
                                    HorizontalLayout {
                                        padding-left: 16px; padding-right: 12px;
                                        spacing: 8px;
                                        Text {
                                            text: "CALENDAR";
                                            font-size: 11px; font-weight: 700; color: EinkTheme.text-secondary;
                                            vertical-alignment: center; horizontal-stretch: 1;
                                        }
                                        Text {
                                            text: root.connect-calendar-count == 0
                                                ? "None set up"
                                                : root.connect-calendar-count == 1
                                                    ? "1 connected"
                                                    : "\{root.connect-calendar-count} connected";
                                            font-size: 11px; color: EinkTheme.text-secondary;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                for conn[i] in root.connection-list: Rectangle {
                                    visible: (conn.kind == "calendar" || conn.kind == "caldav") && conn.profile-id == root.connect-profile-id;
                                    height: self.visible ? 72px : 0px;
                                    background: EinkTheme.canvas-bg;
                                    clip: true;
                                    VerticalLayout {
                                        padding-left: 12px; padding-right: 12px;
                                        padding-top: 8px; padding-bottom: 6px;
                                        spacing: 4px;

                                        HorizontalLayout {
                                            spacing: 10px;
                                            Rectangle {
                                                width: 36px; height: 36px;
                                                border-radius: 4px;
                                                background: EinkTheme.btn-bg;
                                                border-width: 2px; border-color: EinkTheme.btn-border;
                                                Text {
                                                    text: Icons.calendar;
                                                    font-family: "Material Icons"; font-size: 20px;
                                                    color: EinkTheme.btn-fg;
                                                    horizontal-alignment: center; vertical-alignment: center;
                                                    width: parent.width; height: parent.height;
                                                }
                                            }
                                            VerticalLayout {
                                                spacing: 2px; alignment: center; horizontal-stretch: 1;
                                                Text { text: conn.display; font-size: 13px; font-weight: 700; color: EinkTheme.btn-fg; overflow: elide; }
                                                Text {
                                                    text: conn.kind == "caldav" ? "CalDAV · " + conn.value : conn.value;
                                                    font-size: 10px; color: EinkTheme.text-secondary; overflow: elide;
                                                }
                                            }
                                            Rectangle {
                                                width: 28px; height: 28px;
                                                Text { text: Icons.delete; font-family: "Material Icons"; font-size: 16px;
                                                       color: EinkTheme.danger-fg;
                                                       horizontal-alignment: center; vertical-alignment: center;
                                                       width: parent.width; height: parent.height; }
                                                TouchArea { clicked => { root.connection-remove(i); } }
                                            }
                                        }

                                        Rectangle {
                                            height: 24px;
                                            HorizontalLayout {
                                                padding-left: 46px; spacing: 6px;
                                                Text {
                                                    text: conn.allow-in-aggregated ? Icons.check-box : Icons.check-box-out;
                                                    font-family: "Material Icons"; font-size: 18px; color: EinkTheme.btn-fg;
                                                    vertical-alignment: center;
                                                }
                                                Text {
                                                    text: "Also show when viewing All profiles";
                                                    font-size: 11px; color: EinkTheme.text-secondary;
                                                    vertical-alignment: center; horizontal-stretch: 1;
                                                }
                                            }
                                            TouchArea { clicked => { root.connection-toggle-aggregated(i); } }
                                        }
                                    }
                                    Rectangle {
                                        x: 12px; y: parent.height - 1px; width: parent.width - 24px; height: 1px;
                                        background: EinkTheme.chrome-border; opacity: 0.35;
                                    }
                                }

                                // Add calendar CTA
                                Rectangle {
                                    height: 56px;
                                    background: EinkTheme.canvas-bg;
                                    HorizontalLayout {
                                        padding-left: 12px; padding-right: 12px;
                                        padding-top: 8px; padding-bottom: 8px;
                                        spacing: 10px;

                                        Rectangle {
                                            horizontal-stretch: 1; height: 40px;
                                            background: EinkTheme.btn-bg;
                                            border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                                            HorizontalLayout {
                                                spacing: 6px; alignment: center;
                                                Text {
                                                    text: Icons.add-circle;
                                                    font-family: "Material Icons"; font-size: 18px;
                                                    color: EinkTheme.btn-fg; vertical-alignment: center;
                                                }
                                                Text {
                                                    text: root.connect-calendar-count == 0 ? "Set up calendar" : "Add another calendar";
                                                    font-size: 13px; color: EinkTheme.btn-fg;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            TouchArea {
                                                clicked => {
                                                    root.connect-setup-kind = "calendar";
                                                    root.connect-setup-url = "";
                                                    root.settings-new-url = "";
                                                    root.connect-setup-visible = true;
                                                }
                                            }
                                        }
                                    }
                                }

                                // Bottom spacer for scroll comfort
                                Rectangle { height: 24px; background: EinkTheme.canvas-bg; }
                            }
                        }
                    }
                }

                // ── Tasks section (GTD lanes) ─────────────────────────────
                Rectangle {
                    visible: root.settings-section == 3;
                    width: parent.width; height: parent.height;
                    clip: true;

                    Flickable {
                        width: parent.width; height: parent.height;
                        content-width: parent.width;
                        content-height: tasks-settings-col.preferred-height;

                        tasks-settings-col := VerticalLayout {
                            padding: 0px; spacing: 0px;
                            width: parent.width;

                            Rectangle {
                                height: 44px;
                                background: EinkTheme.canvas-bg;
                                Text {
                                    text: "Horizon lanes & Engage";
                                    font-size: 14px; font-weight: 700; color: EinkTheme.btn-fg;
                                    vertical-alignment: center;
                                    x: 16px; height: parent.height;
                                }
                            }
                            Rectangle { height: 1px; background: EinkTheme.chrome-border; }

                            for lane in root.settings-task-lanes: Rectangle {
                                height: 72px;
                                background: EinkTheme.canvas-bg;
                                VerticalLayout {
                                    padding-left: 16px; padding-right: 12px;
                                    padding-top: 6px; padding-bottom: 6px;
                                    spacing: 4px;

                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text {
                                            text: lane.id;
                                            font-size: 11px; color: EinkTheme.text-secondary;
                                            vertical-alignment: center; width: 64px;
                                        }
                                        Rectangle {
                                            horizontal-stretch: 1; height: 32px;
                                            border-radius: 4px; border-width: 2px;
                                            border-color: EinkTheme.btn-border;
                                            background: EinkTheme.canvas-bg;
                                            TextInput {
                                                x: 8px; width: parent.width - 16px; height: parent.height;
                                                font-size: 13px; color: EinkTheme.btn-fg;
                                                text: lane.label;
                                                vertical-alignment: center; single-line: true;
                                                edited => {
                                                    root.settings-lane-label-changed(lane.id, self.text);
                                                }
                                            }
                                        }
                                        Rectangle {
                                            width: 64px; height: 28px;
                                            background: lane.visible ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                                            border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                                            Text {
                                                text: lane.visible ? "Show" : "Hide";
                                                font-size: 11px;
                                                color: lane.visible ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                                                horizontal-alignment: center; vertical-alignment: center;
                                            }
                                            TouchArea { clicked => { root.settings-lane-visible-toggled(lane.id); } }
                                        }
                                        Rectangle {
                                            width: 72px; height: 28px;
                                            background: EinkTheme.btn-bg;
                                            border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                                            Text {
                                                text: lane.wip-limit == 0 ? "WIP —" : "WIP " + lane.wip-limit;
                                                font-size: 11px; color: EinkTheme.btn-fg;
                                                horizontal-alignment: center; vertical-alignment: center;
                                            }
                                            TouchArea { clicked => { root.settings-lane-wip-cycle(lane.id); } }
                                        }
                                    }
                                }
                                Rectangle {
                                    y: parent.height - 1px; height: 1px; width: parent.width;
                                    background: EinkTheme.chrome-border; opacity: 0.4;
                                }
                            }

                            Rectangle { height: 8px; background: EinkTheme.canvas-bg; }

                            Rectangle {
                                height: 44px;
                                background: EinkTheme.canvas-bg;
                                HorizontalLayout {
                                    padding-left: 16px; padding-right: 16px; spacing: 12px;
                                    Text {
                                        text: "Stale after (days)";
                                        font-size: 13px; color: EinkTheme.btn-fg;
                                        vertical-alignment: center; width: 140px;
                                    }
                                    Rectangle {
                                        width: 40px; height: 32px; background: EinkTheme.btn-bg;
                                        border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                                        Text { text: "−"; font-size: 18px; color: EinkTheme.btn-fg;
                                               horizontal-alignment: center; vertical-alignment: center; }
                                        TouchArea {
                                            clicked => {
                                                if (root.settings-staleness-days > 1) {
                                                    root.settings-staleness-days = root.settings-staleness-days - 1;
                                                }
                                            }
                                        }
                                    }
                                    Text {
                                        text: root.settings-staleness-days;
                                        font-size: 14px; color: EinkTheme.btn-fg;
                                        vertical-alignment: center; width: 36px;
                                        horizontal-alignment: center;
                                    }
                                    Rectangle {
                                        width: 40px; height: 32px; background: EinkTheme.btn-bg;
                                        border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                                        Text { text: "+"; font-size: 18px; color: EinkTheme.btn-fg;
                                               horizontal-alignment: center; vertical-alignment: center; }
                                        TouchArea {
                                            clicked => {
                                                root.settings-staleness-days = root.settings-staleness-days + 1;
                                            }
                                        }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                            }

                            Rectangle {
                                height: 44px;
                                background: EinkTheme.canvas-bg;
                                HorizontalLayout {
                                    padding-left: 16px; padding-right: 16px; spacing: 8px;
                                    Text {
                                        text: "Engage lane";
                                        font-size: 13px; color: EinkTheme.btn-fg;
                                        vertical-alignment: center; width: 100px;
                                    }
                                    for lid in ["now", "next", "later"]: Rectangle {
                                        property <bool> sel: root.settings-engage-lane == lid;
                                        width: 56px; height: 28px;
                                        background: sel ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                                        border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                                        Text { text: lid; font-size: 11px;
                                               color: sel ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                                               horizontal-alignment: center; vertical-alignment: center; }
                                        TouchArea { clicked => { root.settings-engage-lane = lid; } }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                            }

                            Rectangle {
                                height: 44px;
                                background: EinkTheme.canvas-bg;
                                HorizontalLayout {
                                    padding-left: 16px; padding-right: 16px; spacing: 8px;
                                    Text {
                                        text: "Capture lane";
                                        font-size: 13px; color: EinkTheme.btn-fg;
                                        vertical-alignment: center; width: 100px;
                                    }
                                    for lid in ["now", "next", "later", "someday"]: Rectangle {
                                        property <bool> sel: root.settings-capture-lane == lid;
                                        width: 64px; height: 28px;
                                        background: sel ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                                        border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                                        Text { text: lid; font-size: 11px;
                                               color: sel ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                                               horizontal-alignment: center; vertical-alignment: center; }
                                        TouchArea { clicked => { root.settings-capture-lane = lid; } }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                            }

                            Rectangle {
                                height: 44px;
                                background: EinkTheme.canvas-bg;
                                HorizontalLayout {
                                    padding-left: 16px; padding-right: 16px; spacing: 12px;
                                    Text {
                                        text: "Clarify after capture";
                                        font-size: 13px; color: EinkTheme.btn-fg;
                                        vertical-alignment: center; horizontal-stretch: 1;
                                    }
                                    Rectangle {
                                        width: 72px; height: 28px;
                                        background: root.settings-clarify-after-capture ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                                        border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                                        Text {
                                            text: root.settings-clarify-after-capture ? "On" : "Off";
                                            font-size: 12px;
                                            color: root.settings-clarify-after-capture ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                                            horizontal-alignment: center; vertical-alignment: center;
                                        }
                                        TouchArea {
                                            clicked => {
                                                root.settings-clarify-after-capture = !root.settings-clarify-after-capture;
                                            }
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                height: 36px;
                                background: EinkTheme.canvas-bg;
                                Text {
                                    text: "Context presets (space-separated)";
                                    font-size: 12px; color: EinkTheme.text-secondary;
                                    x: 16px; vertical-alignment: center; height: parent.height;
                                }
                            }
                            Rectangle {
                                height: 40px;
                                background: EinkTheme.canvas-bg;
                                Rectangle {
                                    x: 16px; width: parent.width - 32px; height: 36px;
                                    border-radius: 4px; border-width: 2px;
                                    border-color: EinkTheme.btn-border;
                                    TextInput {
                                        x: 8px; width: parent.width - 16px; height: parent.height;
                                        font-size: 13px; color: EinkTheme.btn-fg;
                                        text <=> root.settings-context-presets;
                                        vertical-alignment: center; single-line: true;
                                    }
                                }
                            }

                            Rectangle { height: 32px; background: EinkTheme.canvas-bg; }
                        }
                    }
                }
            }
        }
    }

    // ── File browser ─────────────────────────────────────────────────────
    fb-view := Rectangle {
        visible: root.show-filebrowser;
        x: root.nav-w; y: 0;
        width: parent.width - root.nav-w;
        height: parent.height;
        background: EinkTheme.canvas-bg;
        clip: true;

        VerticalLayout {
            padding: 0px; spacing: 0px;

            Rectangle {
                height: 44px;
                background: EinkTheme.canvas-bg;
                HorizontalLayout {
                    padding-left: 8px; padding-right: 12px;
                    padding-top: 6px; padding-bottom: 6px;
                    spacing: 8px;

                    Rectangle {
                        width: 56px; height: 32px;
                        background: EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        Text { text: "Back"; font-size: 13px; color: EinkTheme.btn-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.fb-cancel(); } }
                    }

                    Text {
                        text: root.fb-current-path;
                        font-size: 11px; color: EinkTheme.text-secondary;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                }
            }

            Rectangle { height: 2px; background: EinkTheme.chrome-border; }

            if root.fb-mode == 0: Rectangle {
                height: 44px;
                background: EinkTheme.canvas-bg;
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px;
                    padding-top: 6px; padding-bottom: 6px;

                    Rectangle {
                        width: 240px; height: 32px;
                        background: EinkTheme.btn-active-bg;
                        border-radius: 4px; border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        Text { text: "Select this folder as Vault";
                               font-size: 12px; color: EinkTheme.btn-active-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.fb-select-vault(root.fb-current-path); } }
                    }

                    Rectangle { horizontal-stretch: 1; }
                }
            }

            if root.fb-mode == 2: Rectangle {
                height: 36px;
                background: EinkTheme.canvas-bg;
                Text {
                    x: 12px; y: 0; width: parent.width - 24px; height: parent.height;
                    text: "Choose a PNG or JPEG image for this profile";
                    font-size: 12px; color: EinkTheme.text-secondary;
                    vertical-alignment: center;
                }
            }

            Flickable {
                vertical-stretch: 1;

                VerticalLayout {
                    for entry[i] in root.fb-entries: Rectangle {
                    height: 44px;
                    background: EinkTheme.canvas-bg;

                    if entry.is-dir: TouchArea {
                        clicked => { root.fb-navigate(entry.full-path); }
                    }

                    HorizontalLayout {
                        padding-left: 12px; padding-right: 12px;
                        padding-top: 4px; padding-bottom: 4px;
                        spacing: 8px;

                        Text {
                            text: entry.is-dir ? (entry.name == ".." ? ".." : (entry.is-vault ? "[V]" : "[D]")) : "[F]";
                            font-size: 12px; color: EinkTheme.text-secondary;
                            vertical-alignment: center;
                            width: 28px; horizontal-alignment: center;
                        }

                        Text {
                            text: entry.name;
                            font-size: 14px; color: EinkTheme.btn-fg;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }

                        if entry.is-vault: Text {
                            text: "vault";
                            font-size: 11px; color: EinkTheme.text-secondary;
                            vertical-alignment: center;
                            width: 44px;
                        }

                        if root.fb-mode == 1 && !entry.is-dir: Rectangle {
                            width: 56px; height: 32px;
                            background: EinkTheme.btn-active-bg;
                            border-radius: 4px; border-width: 2px;
                            border-color: EinkTheme.btn-border;
                            Text { text: "Add"; font-size: 12px; color: EinkTheme.btn-active-fg;
                                   horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.fb-add-ics(entry.full-path); } }
                        }

                        if root.fb-mode == 2 && !entry.is-dir: Rectangle {
                            width: 56px; height: 32px;
                            background: EinkTheme.btn-active-bg;
                            border-radius: 4px; border-width: 2px;
                            border-color: EinkTheme.btn-border;
                            Text { text: "Use"; font-size: 12px; color: EinkTheme.btn-active-fg;
                                   horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.fb-select-profile-icon(entry.full-path); } }
                        }
                    }

                    Rectangle {
                        x: 0; y: parent.height - 1px;
                        width: parent.width; height: 1px;
                        background: EinkTheme.chrome-border; opacity: 0.3;
                    }
                }


                    if root.fb-entries.length == 0: Rectangle {
                        height: 48px;
                        background: EinkTheme.canvas-bg;
                        Text {
                            text: "Empty folder";
                            font-size: 13px; color: EinkTheme.text-secondary;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

    // ── Connect setup modal (vault / calendar) ───────────────────────────
    connect-setup-dialog := Rectangle {
        visible: root.connect-setup-visible;
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        background: EinkTheme.chrome-bg;
        opacity: 0.97;

        Rectangle {
            x: (parent.width - 480px) / 2;
            y: (parent.height - (root.connect-setup-kind == "calendar" ? 580px : root.connect-setup-kind == "vault-git" ? 280px : 420px)) / 2;
            width: 480px;
            height: root.connect-setup-kind == "calendar" ? 580px : root.connect-setup-kind == "vault-git" ? 280px : 420px;
            background: EinkTheme.canvas-bg;
            border-radius: 8px;
            border-width: 3px;
            border-color: EinkTheme.chrome-border;

            VerticalLayout {
                padding: 20px; spacing: 12px;

                Text {
                    text: root.connect-setup-kind == "vault" ? "Set up Obsidian Vault"
                        : root.connect-setup-kind == "vault-git" ? "Vault git sync"
                        : "Add Calendar";
                    font-size: 16px; font-weight: 700; color: EinkTheme.btn-fg;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.connect-setup-kind == "vault"
                        ? "Choose the vault folder for this profile. Notes export as PDF (with transcribed text) under the folder below; vault search skips that folder."
                        : root.connect-setup-kind == "vault-git"
                        ? "This vault is a git repository. Enable automatic pull before search/updates and autocommit + push after note exports."
                        : "ICS subscribe link, local .ics file, or CalDAV server with credentials.";
                    font-size: 12px; color: EinkTheme.text-secondary;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                if root.connect-setup-kind == "vault": VerticalLayout {
                    spacing: 8px;

                    Text {
                        text: "Notes export folder (inside vault)";
                        font-size: 11px; color: EinkTheme.text-secondary;
                    }
                    Rectangle {
                        height: 40px;
                        border-radius: 4px; border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        background: EinkTheme.canvas-bg;
                        TextInput {
                            x: 10px; y: 0;
                            width: parent.width - 20px; height: parent.height;
                            font-size: 13px; color: EinkTheme.btn-fg;
                            text <=> root.connect-setup-export-subdir;
                            vertical-alignment: center;
                        }
                    }

                    if root.settings-vault-path != "": Text {
                        text: "Vault: " + root.settings-vault-path;
                        font-size: 11px; color: EinkTheme.text-secondary;
                        wrap: word-wrap;
                    }

                    if root.connect-setup-git-detected: Rectangle {
                        height: 40px;
                        background: root.connect-setup-git-enabled ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                        Text {
                            text: root.connect-setup-git-enabled
                                ? "Git sync: on (pull / autocommit / push)"
                                : "Git sync: off — tap to enable";
                            font-size: 13px;
                            color: root.connect-setup-git-enabled ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                        TouchArea {
                            clicked => {
                                root.connect-setup-git-enabled = !root.connect-setup-git-enabled;
                            }
                        }
                    }

                    Rectangle {
                        height: 44px;
                        background: EinkTheme.btn-active-bg;
                        border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                        Text {
                            text: root.connect-has-vault ? "Browse to change vault…" : "Browse for vault folder…";
                            font-size: 14px; color: EinkTheme.btn-active-fg;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                        TouchArea {
                            clicked => {
                                root.connect-setup-visible = false;
                                root.settings-browse-vault();
                            }
                        }
                    }

                    if root.connect-has-vault: Rectangle {
                        height: 44px;
                        background: EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                        Text {
                            text: "Save export & git settings";
                            font-size: 14px; color: EinkTheme.btn-fg;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                        TouchArea {
                            clicked => {
                                root.connect-vault-setup-confirm();
                                root.connect-setup-visible = false;
                            }
                        }
                    }
                }

                if root.connect-setup-kind == "vault-git": VerticalLayout {
                    spacing: 10px;

                    Rectangle {
                        height: 44px;
                        background: EinkTheme.btn-active-bg;
                        border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                        Text {
                            text: "Enable git sync";
                            font-size: 14px; color: EinkTheme.btn-active-fg;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                        TouchArea {
                            clicked => {
                                root.connect-setup-git-enabled = true;
                                root.connect-vault-setup-confirm();
                                root.connect-setup-visible = false;
                            }
                        }
                    }

                    Rectangle {
                        height: 44px;
                        background: EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                        Text {
                            text: "Not now";
                            font-size: 14px; color: EinkTheme.btn-fg;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                        TouchArea {
                            clicked => {
                                root.connect-setup-git-enabled = false;
                                root.connect-vault-setup-confirm();
                                root.connect-setup-visible = false;
                            }
                        }
                    }
                }

                if root.connect-setup-kind == "calendar": VerticalLayout {
                    spacing: 8px;

                    Rectangle {
                        height: 40px;
                        background: EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                        HorizontalLayout {
                            spacing: 8px; alignment: center;
                            Text {
                                text: Icons.folder;
                                font-family: "Material Icons"; font-size: 18px;
                                color: EinkTheme.btn-fg; vertical-alignment: center;
                            }
                            Text {
                                text: "Browse .ics file…";
                                font-size: 14px; color: EinkTheme.btn-fg;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea {
                            clicked => {
                                root.connect-setup-visible = false;
                                root.settings-browse-ics();
                            }
                        }
                    }

                    Text {
                        text: "ICS subscribe URL";
                        font-size: 11px; color: EinkTheme.text-secondary;
                    }

                    Rectangle {
                        height: 40px;
                        border-radius: 4px; border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        background: EinkTheme.canvas-bg;
                        TextInput {
                            x: 10px; y: 0;
                            width: parent.width - 20px; height: parent.height;
                            font-size: 13px; color: EinkTheme.btn-fg;
                            text <=> root.settings-new-url;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        height: 40px;
                        background: EinkTheme.btn-active-bg;
                        border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                        Text {
                            text: "Add ICS URL";
                            font-size: 14px; color: EinkTheme.btn-active-fg;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                        TouchArea {
                            clicked => {
                                if (root.settings-new-url != "") {
                                    root.settings-add-url(root.settings-new-url);
                                    root.settings-new-url = "";
                                    root.connect-setup-visible = false;
                                }
                            }
                        }
                    }

                    Rectangle { height: 1px; background: EinkTheme.chrome-border; }

                    Text {
                        text: "CalDAV server URL";
                        font-size: 11px; color: EinkTheme.text-secondary;
                    }

                    Rectangle {
                        height: 40px;
                        border-radius: 4px; border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        background: EinkTheme.canvas-bg;
                        TextInput {
                            x: 10px; y: 0;
                            width: parent.width - 20px; height: parent.height;
                            font-size: 13px; color: EinkTheme.btn-fg;
                            text <=> root.connect-setup-url;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: "Username";
                        font-size: 11px; color: EinkTheme.text-secondary;
                    }

                    Rectangle {
                        height: 40px;
                        border-radius: 4px; border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        background: EinkTheme.canvas-bg;
                        TextInput {
                            x: 10px; y: 0;
                            width: parent.width - 20px; height: parent.height;
                            font-size: 13px; color: EinkTheme.btn-fg;
                            text <=> root.connect-setup-user;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: "Password or app token";
                        font-size: 11px; color: EinkTheme.text-secondary;
                    }

                    Rectangle {
                        height: 40px;
                        border-radius: 4px; border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        background: EinkTheme.canvas-bg;
                        TextInput {
                            x: 10px; y: 0;
                            width: parent.width - 20px; height: parent.height;
                            font-size: 13px; color: EinkTheme.btn-fg;
                            text <=> root.connect-setup-pass;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        height: 40px;
                        background: EinkTheme.btn-active-bg;
                        border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                        Text {
                            text: "Add CalDAV";
                            font-size: 14px; color: EinkTheme.btn-active-fg;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                        TouchArea {
                            clicked => {
                                if (root.connect-setup-url != "" && root.connect-setup-user != "") {
                                    root.settings-add-caldav(
                                        root.connect-setup-url,
                                        root.connect-setup-user,
                                        root.connect-setup-pass
                                    );
                                    root.connect-setup-url = "";
                                    root.connect-setup-user = "";
                                    root.connect-setup-pass = "";
                                    root.connect-setup-visible = false;
                                }
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 16px; alignment: center;

                    Rectangle {
                        width: 120px; height: 44px;
                        background: EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                        Text { text: "Cancel"; font-size: 14px; color: EinkTheme.btn-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea {
                            clicked => {
                                root.connect-setup-visible = false;
                                root.settings-new-url = "";
                                root.connect-setup-url = "";
                                root.connect-setup-user = "";
                                root.connect-setup-pass = "";
                            }
                        }
                    }
                }
            }
        }
    }

    // ── Connect coming-soon info modal ───────────────────────────────────
    connect-soon-dialog := Rectangle {
        visible: root.connect-soon-visible;
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        background: EinkTheme.chrome-bg;
        opacity: 0.97;

        Rectangle {
            x: (parent.width - 400px) / 2;
            y: (parent.height - 220px) / 2;
            width: 400px; height: 220px;
            background: EinkTheme.canvas-bg;
            border-radius: 8px;
            border-width: 3px;
            border-color: EinkTheme.chrome-border;

            VerticalLayout {
                padding: 20px; spacing: 12px;

                Text {
                    text: Icons.info;
                    font-family: "Material Icons"; font-size: 28px;
                    color: EinkTheme.btn-fg;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.connect-soon-title;
                    font-size: 16px; font-weight: 700; color: EinkTheme.btn-fg;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.connect-soon-body;
                    font-size: 12px; color: EinkTheme.text-secondary;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    vertical-stretch: 1;
                }

                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 120px; height: 40px;
                        background: EinkTheme.btn-active-bg;
                        border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                        Text { text: "Got it"; font-size: 14px; color: EinkTheme.btn-active-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.connect-soon-visible = false; } }
                    }
                }
            }
        }
    }

    // ── Profile add / edit dialog ────────────────────────────────────────
    profile-edit-dialog := Rectangle {
        visible: root.profile-edit-dialog-visible;
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        background: EinkTheme.chrome-bg;
        opacity: 0.97;

        Rectangle {
            x: (parent.width - 480px) / 2;
            y: (parent.height - 480px) / 2;
            width: 480px; height: 480px;
            background: EinkTheme.canvas-bg;
            border-radius: 8px;
            border-width: 3px;
            border-color: EinkTheme.chrome-border;

            VerticalLayout {
                padding: 16px; spacing: 10px;

                Text {
                    text: root.profile-edit-is-new ? "New Profile" : "Edit Profile";
                    font-size: 16px; font-weight: 700; color: EinkTheme.btn-fg;
                    horizontal-alignment: center;
                }

                Rectangle {
                    height: 40px;
                    border-radius: 4px; border-width: 2px;
                    border-color: EinkTheme.btn-border;
                    background: EinkTheme.canvas-bg;
                    TextInput {
                        x: 8px; y: 0;
                        width: parent.width - 16px; height: parent.height;
                        font-size: 14px; color: EinkTheme.btn-fg;
                        text <=> root.profile-edit-name;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: "Icon — life scenarios";
                    font-size: 12px; color: EinkTheme.text-secondary;
                }

                // Row 1: work / home / private / person / kids
                HorizontalLayout {
                    spacing: 8px; alignment: center;
                    for icon-key in ["work", "home", "private", "person", "kids"]: Rectangle {
                        property <bool> sel: !root.profile-edit-has-custom && root.profile-edit-icon == icon-key;
                        property <string> ic:
                            icon-key == "work" ? Icons.profile-work :
                            icon-key == "home" ? Icons.profile-home :
                            icon-key == "private" ? Icons.profile-private :
                            icon-key == "kids" ? Icons.profile-kids :
                            Icons.profile-person;
                        width: 48px; height: 48px;
                        border-radius: 24px;
                        background: sel ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                        border-width: 2px; border-color: sel ? EinkTheme.btn-border : EinkTheme.chrome-border;
                        Text {
                            text: ic; font-family: "Material Icons"; font-size: 24px;
                            color: sel ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                            horizontal-alignment: center; vertical-alignment: center;
                            width: parent.width; height: parent.height;
                        }
                        TouchArea {
                            clicked => {
                                root.profile-edit-has-custom = false;
                                root.profile-edit-icon = icon-key;
                            }
                        }
                    }
                }

                // Row 2: family / party / pets / fitness / music
                HorizontalLayout {
                    spacing: 8px; alignment: center;
                    for icon-key in ["family", "party", "pets", "fitness", "music"]: Rectangle {
                        property <bool> sel: !root.profile-edit-has-custom && root.profile-edit-icon == icon-key;
                        property <string> ic:
                            icon-key == "family" ? Icons.profile-family :
                            icon-key == "party" ? Icons.profile-party :
                            icon-key == "pets" ? Icons.profile-pets :
                            icon-key == "fitness" ? Icons.profile-fitness :
                            Icons.profile-music;
                        width: 48px; height: 48px;
                        border-radius: 24px;
                        background: sel ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                        border-width: 2px; border-color: sel ? EinkTheme.btn-border : EinkTheme.chrome-border;
                        Text {
                            text: ic; font-family: "Material Icons"; font-size: 24px;
                            color: sel ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                            horizontal-alignment: center; vertical-alignment: center;
                            width: parent.width; height: parent.height;
                        }
                        TouchArea {
                            clicked => {
                                root.profile-edit-has-custom = false;
                                root.profile-edit-icon = icon-key;
                            }
                        }
                    }
                }

                // Row 3: cafe / food / travel / beach / creative
                HorizontalLayout {
                    spacing: 8px; alignment: center;
                    for icon-key in ["cafe", "food", "travel", "beach", "creative"]: Rectangle {
                        property <bool> sel: !root.profile-edit-has-custom && root.profile-edit-icon == icon-key;
                        property <string> ic:
                            icon-key == "cafe" ? Icons.profile-cafe :
                            icon-key == "food" ? Icons.profile-food :
                            icon-key == "travel" ? Icons.profile-travel :
                            icon-key == "beach" ? Icons.profile-beach :
                            Icons.profile-creative;
                        width: 48px; height: 48px;
                        border-radius: 24px;
                        background: sel ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                        border-width: 2px; border-color: sel ? EinkTheme.btn-border : EinkTheme.chrome-border;
                        Text {
                            text: ic; font-family: "Material Icons"; font-size: 24px;
                            color: sel ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                            horizontal-alignment: center; vertical-alignment: center;
                            width: parent.width; height: parent.height;
                        }
                        TouchArea {
                            clicked => {
                                root.profile-edit-has-custom = false;
                                root.profile-edit-icon = icon-key;
                            }
                        }
                    }
                }

                // Row 4: code / night / group / school / custom
                HorizontalLayout {
                    spacing: 8px; alignment: center;
                    for icon-key in ["code", "night", "group", "school"]: Rectangle {
                        property <bool> sel: !root.profile-edit-has-custom && root.profile-edit-icon == icon-key;
                        property <string> ic:
                            icon-key == "code" ? Icons.profile-code :
                            icon-key == "night" ? Icons.profile-night :
                            icon-key == "group" ? Icons.profile-group :
                            Icons.profile-school;
                        width: 48px; height: 48px;
                        border-radius: 24px;
                        background: sel ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                        border-width: 2px; border-color: sel ? EinkTheme.btn-border : EinkTheme.chrome-border;
                        Text {
                            text: ic; font-family: "Material Icons"; font-size: 24px;
                            color: sel ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                            horizontal-alignment: center; vertical-alignment: center;
                            width: parent.width; height: parent.height;
                        }
                        TouchArea {
                            clicked => {
                                root.profile-edit-has-custom = false;
                                root.profile-edit-icon = icon-key;
                            }
                        }
                    }
                    // Custom image
                    Rectangle {
                        property <bool> sel: root.profile-edit-has-custom;
                        width: 48px; height: 48px;
                        border-radius: 24px;
                        background: sel ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                        border-width: 2px; border-color: sel ? EinkTheme.btn-border : EinkTheme.chrome-border;
                        if sel: Image {
                            x: 8px; y: 8px; width: 32px; height: 32px;
                            source: root.profile-edit-custom-image;
                        }
                        if !sel: Text {
                            text: Icons.image;
                            font-family: "Material Icons"; font-size: 24px;
                            color: EinkTheme.btn-fg;
                            horizontal-alignment: center; vertical-alignment: center;
                            width: parent.width; height: parent.height;
                        }
                        TouchArea { clicked => { root.settings-browse-profile-icon(); } }
                    }
                }

                Text {
                    text: root.profile-edit-has-custom
                        ? "Custom image selected — tap image circle to change"
                        : "Last circle: choose a custom PNG/JPEG";
                    font-size: 11px; color: EinkTheme.text-secondary;
                    horizontal-alignment: center;
                }

                HorizontalLayout {
                    spacing: 16px; alignment: center;

                    Rectangle {
                        width: 120px; height: 44px;
                        background: EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                        Text { text: "Cancel"; font-size: 14px; color: EinkTheme.btn-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.profile-edit-dialog-visible = false; } }
                    }

                    Rectangle {
                        width: 120px; height: 44px;
                        background: EinkTheme.btn-active-bg;
                        border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                        Text { text: root.profile-edit-is-new ? "Create" : "Save"; font-size: 14px;
                               color: EinkTheme.btn-active-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea {
                            clicked => {
                                if (root.profile-edit-is-new) {
                                    root.settings-profile-add(root.profile-edit-name, root.profile-edit-icon);
                                } else {
                                    root.settings-profile-edit(root.profile-edit-id, root.profile-edit-name, root.profile-edit-icon);
                                }
                                root.profile-edit-dialog-visible = false;
                            }
                        }
                    }
                }
            }
        }
    }

    // ── Task add / edit dialog ───────────────────────────────────────────
    task-dialog := Rectangle {
        visible: root.task-dialog-visible;
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        background: EinkTheme.chrome-bg;
        opacity: 0.95;

        Rectangle {
            x: (parent.width - 460px) / 2;
            y: (parent.height - (root.task-dialog-has-source-note ? 610px : 560px)) / 2;
            width: 460px;
            height: root.task-dialog-has-source-note ? 610px : 560px;
            background: EinkTheme.canvas-bg;
            border-radius: 8px;
            border-width: 3px;
            border-color: EinkTheme.chrome-border;

            VerticalLayout {
                padding: 16px; spacing: 8px;

                Text {
                    text: root.task-dialog-is-edit ? "Edit Task" : "New Task";
                    font-size: 16px; font-weight: 700;
                    color: EinkTheme.btn-fg;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Title";
                    font-size: 11px; color: EinkTheme.text-secondary;
                }
                Rectangle {
                    height: 40px;
                    border-radius: 4px; border-width: 2px;
                    border-color: EinkTheme.btn-border;
                    background: EinkTheme.canvas-bg;

                    TextInput {
                        x: 8px; y: 0px;
                        width: parent.width - 16px;
                        height: parent.height;
                        font-size: 14px; color: EinkTheme.btn-fg;
                        text <=> root.task-dialog-title;
                        vertical-alignment: center;
                        single-line: true;
                    }
                }

                Text {
                    text: "Lane";
                    font-size: 11px; color: EinkTheme.text-secondary;
                }
                HorizontalLayout {
                    spacing: 6px; alignment: start;
                    for lid in ["now", "next", "later", "waiting", "someday"]: Rectangle {
                        property <bool> sel: root.task-dialog-lane == lid;
                        height: 28px; width: 70px;
                        background: sel ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                        Text { text: lid; font-size: 11px;
                               color: sel ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.task-dialog-lane = lid; } }
                    }
                }

                Text {
                    text: "Due (YYYY-MM-DD)";
                    font-size: 11px; color: EinkTheme.text-secondary;
                }
                Rectangle {
                    height: 36px;
                    border-radius: 4px; border-width: 2px;
                    border-color: EinkTheme.btn-border;
                    background: EinkTheme.canvas-bg;

                    TextInput {
                        x: 8px; y: 0px;
                        width: parent.width - 16px;
                        height: parent.height;
                        font-size: 14px; color: EinkTheme.btn-fg;
                        text <=> root.task-dialog-due;
                        vertical-alignment: center;
                        single-line: true;
                        input-type: text;
                    }
                }

                Text {
                    text: "Contexts (space-separated)";
                    font-size: 11px; color: EinkTheme.text-secondary;
                }
                Rectangle {
                    height: 36px;
                    border-radius: 4px; border-width: 2px;
                    border-color: EinkTheme.btn-border;
                    background: EinkTheme.canvas-bg;

                    TextInput {
                        x: 8px; y: 0px;
                        width: parent.width - 16px;
                        height: parent.height;
                        font-size: 14px; color: EinkTheme.btn-fg;
                        text <=> root.task-dialog-contexts;
                        vertical-alignment: center;
                        single-line: true;
                    }
                }

                Text {
                    text: "Waiting for";
                    font-size: 11px; color: EinkTheme.text-secondary;
                }
                Rectangle {
                    height: 36px;
                    border-radius: 4px; border-width: 2px;
                    border-color: EinkTheme.btn-border;
                    background: EinkTheme.canvas-bg;

                    TextInput {
                        x: 8px; y: 0px;
                        width: parent.width - 16px;
                        height: parent.height;
                        font-size: 14px; color: EinkTheme.btn-fg;
                        text <=> root.task-dialog-waiting;
                        vertical-alignment: center;
                        single-line: true;
                    }
                }

                Text {
                    text: "Tags (space-separated)";
                    font-size: 11px; color: EinkTheme.text-secondary;
                }
                Rectangle {
                    height: 36px;
                    border-radius: 4px; border-width: 2px;
                    border-color: EinkTheme.btn-border;
                    background: EinkTheme.canvas-bg;

                    TextInput {
                        x: 8px; y: 0px;
                        width: parent.width - 16px;
                        height: parent.height;
                        font-size: 14px; color: EinkTheme.btn-fg;
                        text <=> root.task-dialog-tags;
                        vertical-alignment: center;
                        single-line: true;
                    }
                }

                HorizontalLayout {
                    spacing: 6px; alignment: center;

                    Rectangle {
                        width: 70px; height: 32px;
                        background: root.task-dialog-priority == 0 ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                        Text { text: "Urgent"; font-size: 12px;
                               color: root.task-dialog-priority == 0 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.task-dialog-priority = 0; } }
                    }
                    Rectangle {
                        width: 70px; height: 32px;
                        background: root.task-dialog-priority == 1 ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                        Text { text: "High"; font-size: 12px;
                               color: root.task-dialog-priority == 1 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.task-dialog-priority = 1; } }
                    }
                    Rectangle {
                        width: 70px; height: 32px;
                        background: root.task-dialog-priority == 2 ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                        Text { text: "Med"; font-size: 12px;
                               color: root.task-dialog-priority == 2 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.task-dialog-priority = 2; } }
                    }
                    Rectangle {
                        width: 70px; height: 32px;
                        background: root.task-dialog-priority == 3 ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                        Text { text: "Low"; font-size: 12px;
                               color: root.task-dialog-priority == 3 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.task-dialog-priority = 3; } }
                    }
                }

                if root.task-dialog-is-edit && root.task-dialog-has-source-note: Rectangle {
                    height: 40px;
                    border-radius: 4px; border-width: 2px;
                    border-color: EinkTheme.btn-border;
                    background: EinkTheme.btn-bg;
                    HorizontalLayout {
                        spacing: 6px; alignment: center;
                        Text {
                            text: Icons.notes;
                            font-family: "Material Icons"; font-size: 18px;
                            color: EinkTheme.btn-fg;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "View associated note";
                            font-size: 14px; color: EinkTheme.btn-fg;
                            vertical-alignment: center;
                        }
                    }
                    TouchArea {
                        clicked => { root.task-view-source-note(root.task-dialog-id); }
                    }
                }

                HorizontalLayout {
                    spacing: 16px; alignment: center;

                    Rectangle {
                        width: 120px; height: 44px;
                        background: EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                        Text { text: "Cancel"; font-size: 15px; color: EinkTheme.btn-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.task-dialog-cancel(); } }
                    }

                    Rectangle {
                        width: 120px; height: 44px;
                        background: EinkTheme.btn-active-bg;
                        border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                        Text { text: "Save"; font-size: 15px; color: EinkTheme.btn-active-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea {
                            clicked => {
                                if (root.task-dialog-is-edit) {
                                    root.task-confirm-edit(
                                        root.task-dialog-id,
                                        root.task-dialog-title,
                                        root.task-dialog-priority,
                                        root.task-dialog-due,
                                        root.task-dialog-tags,
                                        root.task-dialog-lane,
                                        root.task-dialog-contexts,
                                        root.task-dialog-waiting);
                                } else {
                                    root.task-confirm-add(
                                        root.task-dialog-title,
                                        root.task-dialog-priority,
                                        root.task-dialog-due,
                                        root.task-dialog-tags,
                                        root.task-dialog-lane,
                                        root.task-dialog-contexts,
                                        root.task-dialog-waiting);
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ── Weekly review overlay ────────────────────────────────────────────
    review-dialog := Rectangle {
        visible: root.review-visible;
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        background: EinkTheme.chrome-bg;
        opacity: 0.95;

        Rectangle {
            x: (parent.width - 440px) / 2;
            y: (parent.height - 360px) / 2;
            width: 440px; height: 360px;
            background: EinkTheme.canvas-bg;
            border-radius: 8px;
            border-width: 3px;
            border-color: EinkTheme.chrome-border;

            VerticalLayout {
                padding: 20px; spacing: 12px;

                Text {
                    text: "Weekly review";
                    font-size: 16px; font-weight: 700;
                    color: EinkTheme.btn-fg;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.review-progress;
                    font-size: 12px; color: EinkTheme.text-secondary;
                    horizontal-alignment: center;
                }
                if root.review-stale: Text {
                    text: "Stale — needs a look";
                    font-size: 12px; color: EinkTheme.btn-fg;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.review-lane-label;
                    font-size: 12px; color: EinkTheme.text-secondary;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.review-title;
                    font-size: 18px; font-weight: 700;
                    color: EinkTheme.btn-fg;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Text {
                    text: root.review-meta;
                    font-size: 12px; color: EinkTheme.text-secondary;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 8px; alignment: center;
                    Rectangle {
                        width: 100px; height: 40px;
                        background: EinkTheme.btn-active-bg;
                        border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                        Text { text: "Looks good"; font-size: 12px; color: EinkTheme.btn-active-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.review-confirm(); } }
                    }
                    Rectangle {
                        width: 72px; height: 40px;
                        background: EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                        Text { text: "Edit"; font-size: 12px; color: EinkTheme.btn-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.review-edit(); } }
                    }
                    Rectangle {
                        width: 72px; height: 40px;
                        background: EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                        Text { text: "Done"; font-size: 12px; color: EinkTheme.btn-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.review-done(); } }
                    }
                    Rectangle {
                        width: 72px; height: 40px;
                        background: EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                        Text { text: "Skip"; font-size: 12px; color: EinkTheme.btn-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.review-skip(); } }
                    }
                }
                Rectangle {
                    width: 120px; height: 36px;
                    background: EinkTheme.btn-bg;
                    border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                    Text { text: "Close"; font-size: 13px; color: EinkTheme.btn-fg;
                           horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.review-close(); } }
                }
            }
        }
    }

    // ── Clarify after capture ────────────────────────────────────────────
    clarify-dialog := Rectangle {
        visible: root.clarify-visible;
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        background: EinkTheme.chrome-bg;
        opacity: 0.95;

        Rectangle {
            x: (parent.width - 440px) / 2;
            y: (parent.height - 400px) / 2;
            width: 440px; height: 400px;
            background: EinkTheme.canvas-bg;
            border-radius: 8px;
            border-width: 3px;
            border-color: EinkTheme.chrome-border;

            VerticalLayout {
                padding: 20px; spacing: 10px;

                Text {
                    text: "Clarify";
                    font-size: 16px; font-weight: 700;
                    color: EinkTheme.btn-fg;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.clarify-title;
                    font-size: 14px; color: EinkTheme.btn-fg;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Text {
                    text: "If it takes under two minutes, do it now — otherwise pick a lane.";
                    font-size: 11px; color: EinkTheme.text-secondary;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                Text { text: "Lane"; font-size: 11px; color: EinkTheme.text-secondary; }
                HorizontalLayout {
                    spacing: 6px; alignment: start;
                    for lid in ["now", "next", "later", "waiting", "someday"]: Rectangle {
                        property <bool> sel: root.clarify-lane == lid;
                        height: 28px; width: 70px;
                        background: sel ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                        Text { text: lid; font-size: 11px;
                               color: sel ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.clarify-lane = lid; } }
                    }
                }

                Text { text: "Contexts"; font-size: 11px; color: EinkTheme.text-secondary; }
                Rectangle {
                    height: 36px;
                    border-radius: 4px; border-width: 2px;
                    border-color: EinkTheme.btn-border;
                    TextInput {
                        x: 8px; width: parent.width - 16px; height: parent.height;
                        font-size: 13px; color: EinkTheme.btn-fg;
                        text <=> root.clarify-contexts;
                        vertical-alignment: center; single-line: true;
                    }
                }

                Text { text: "Waiting for"; font-size: 11px; color: EinkTheme.text-secondary; }
                Rectangle {
                    height: 36px;
                    border-radius: 4px; border-width: 2px;
                    border-color: EinkTheme.btn-border;
                    TextInput {
                        x: 8px; width: parent.width - 16px; height: parent.height;
                        font-size: 13px; color: EinkTheme.btn-fg;
                        text <=> root.clarify-waiting;
                        vertical-alignment: center; single-line: true;
                    }
                }

                HorizontalLayout {
                    spacing: 16px; alignment: center;
                    Rectangle {
                        width: 120px; height: 44px;
                        background: EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                        Text { text: "Skip"; font-size: 14px; color: EinkTheme.btn-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.clarify-skip(); } }
                    }
                    Rectangle {
                        width: 120px; height: 44px;
                        background: EinkTheme.btn-active-bg;
                        border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                        Text { text: "Save"; font-size: 14px; color: EinkTheme.btn-active-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea {
                            clicked => {
                                root.clarify-save(
                                    root.clarify-task-id,
                                    root.clarify-lane,
                                    root.clarify-contexts,
                                    root.clarify-waiting);
                            }
                        }
                    }
                }
            }
        }
    }

    // ── Event create dialog ──────────────────────────────────────────────
    event-dialog := Rectangle {
        visible: root.event-dialog-visible;
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        background: EinkTheme.chrome-bg;
        opacity: 0.95;

        Rectangle {
            x: (parent.width - 440px) / 2;
            y: (parent.height - 400px) / 2;
            width: 440px; height: 400px;
            background: EinkTheme.canvas-bg;
            border-radius: 8px;
            border-width: 3px;
            border-color: EinkTheme.chrome-border;

            VerticalLayout {
                padding: 20px; spacing: 12px;

                Text {
                    text: "New Event";
                    font-size: 16px; font-weight: 700;
                    color: EinkTheme.btn-fg;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Title";
                    font-size: 11px; color: EinkTheme.text-secondary;
                }
                Rectangle {
                    height: 44px;
                    border-radius: 4px; border-width: 2px;
                    border-color: EinkTheme.btn-border;
                    background: EinkTheme.canvas-bg;
                    TextInput {
                        x: 8px; y: 0px;
                        width: parent.width - 16px;
                        height: parent.height;
                        font-size: 14px; color: EinkTheme.btn-fg;
                        text <=> root.event-dialog-title;
                        vertical-alignment: center;
                        single-line: true;
                    }
                }

                Text {
                    text: "Date (YYYY-MM-DD)";
                    font-size: 11px; color: EinkTheme.text-secondary;
                }
                Rectangle {
                    height: 40px;
                    border-radius: 4px; border-width: 2px;
                    border-color: EinkTheme.btn-border;
                    background: EinkTheme.canvas-bg;
                    TextInput {
                        x: 8px; y: 0px;
                        width: parent.width - 16px;
                        height: parent.height;
                        font-size: 14px; color: EinkTheme.btn-fg;
                        text <=> root.event-dialog-date;
                        vertical-alignment: center;
                        single-line: true;
                    }
                }

                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        spacing: 4px; horizontal-stretch: 1;
                        Text {
                            text: "Start (HH:MM)";
                            font-size: 11px; color: EinkTheme.text-secondary;
                        }
                        Rectangle {
                            height: 40px;
                            border-radius: 4px; border-width: 2px;
                            border-color: EinkTheme.btn-border;
                            background: EinkTheme.canvas-bg;
                            opacity: root.event-dialog-all-day ? 0.4 : 1.0;
                            TextInput {
                                x: 8px; y: 0px;
                                width: parent.width - 16px;
                                height: parent.height;
                                font-size: 14px; color: EinkTheme.btn-fg;
                                text <=> root.event-dialog-start;
                                vertical-alignment: center;
                                single-line: true;
                                enabled: !root.event-dialog-all-day;
                            }
                        }
                    }
                    VerticalLayout {
                        spacing: 4px; horizontal-stretch: 1;
                        Text {
                            text: "End (HH:MM)";
                            font-size: 11px; color: EinkTheme.text-secondary;
                        }
                        Rectangle {
                            height: 40px;
                            border-radius: 4px; border-width: 2px;
                            border-color: EinkTheme.btn-border;
                            background: EinkTheme.canvas-bg;
                            opacity: root.event-dialog-all-day ? 0.4 : 1.0;
                            TextInput {
                                x: 8px; y: 0px;
                                width: parent.width - 16px;
                                height: parent.height;
                                font-size: 14px; color: EinkTheme.btn-fg;
                                text <=> root.event-dialog-end;
                                vertical-alignment: center;
                                single-line: true;
                                enabled: !root.event-dialog-all-day;
                            }
                        }
                    }
                }

                Rectangle {
                    height: 36px;
                    background: root.event-dialog-all-day ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                    border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                    Text {
                        text: root.event-dialog-all-day ? "All day ✓" : "All day";
                        font-size: 13px;
                        color: root.event-dialog-all-day ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    TouchArea {
                        clicked => { root.event-dialog-all-day = !root.event-dialog-all-day; }
                    }
                }

                HorizontalLayout {
                    spacing: 16px; alignment: center;
                    Rectangle {
                        width: 120px; height: 48px;
                        background: EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                        Text { text: "Cancel"; font-size: 15px; color: EinkTheme.btn-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.event-dialog-cancel(); } }
                    }
                    Rectangle {
                        width: 120px; height: 48px;
                        background: EinkTheme.btn-active-bg;
                        border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                        Text { text: "Save"; font-size: 15px; color: EinkTheme.btn-active-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea {
                            clicked => {
                                root.event-confirm-add(
                                    root.event-dialog-title,
                                    root.event-dialog-date,
                                    root.event-dialog-start,
                                    root.event-dialog-end,
                                    root.event-dialog-all-day);
                            }
                        }
                    }
                }
            }
        }
    }

    // ── Create-in-profile picker (late z-order above nav + notes) ─────────
    Rectangle {
        visible: root.show-create-profile-picker;
        x: 0; y: 0; width: parent.width; height: parent.height;
        background: #00000066;
        TouchArea {
            width: parent.width; height: parent.height;
            clicked => {
                root.show-create-profile-picker = false;
                root.create-profile-pick-cancel();
            }
        }
    }
    create-profile-picker-panel := Rectangle {
        visible: root.show-create-profile-picker;
        width: 280px;
        // All is aggregator-only — notes/recordings/canvas must pick a real profile.
        // Notebook create may still offer All (unassigned / visible-in-all).
        property <bool> show-all-row: root.create-picker-intent == "notebook";
        property <int> row-count: root.profile-list.length + (create-profile-picker-panel.show-all-row ? 1 : 0);
        height: 52px + create-profile-picker-panel.row-count * 48px + 12px + 48px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: EinkTheme.chrome-bg;
        border-width: 2px; border-color: EinkTheme.chrome-border;
        border-radius: 8px;
        clip: true;

        VerticalLayout {
            padding: 6px; spacing: 2px;

            Rectangle {
                height: 44px;
                Text {
                    text: "Add to profile…";
                    font-size: 14px; font-weight: 600;
                    color: EinkTheme.btn-fg;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width; height: parent.height;
                }
            }

            if create-profile-picker-panel.show-all-row: Rectangle {
                height: 48px;
                border-radius: 4px;
                background: EinkTheme.btn-bg;
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px;
                    spacing: 10px; alignment: start;
                    Text {
                        text: Icons.profile-group;
                        font-family: "Material Icons"; font-size: 22px;
                        color: EinkTheme.btn-fg;
                        vertical-alignment: center; width: 28px;
                    }
                    Text {
                        text: "All profiles";
                        font-size: 14px; color: EinkTheme.btn-fg;
                        vertical-alignment: center; horizontal-stretch: 1;
                    }
                }
                TouchArea {
                    width: parent.width; height: parent.height;
                    clicked => {
                        root.show-create-profile-picker = false;
                        root.create-profile-picked(root.create-picker-intent, "");
                    }
                }
            }

            for p in root.profile-list: Rectangle {
                height: 48px;
                border-radius: 4px;
                background: EinkTheme.btn-bg;
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px;
                    spacing: 10px; alignment: start;
                    ProfileIcon {
                        icon-char: p.icon-char; has-custom: p.has-custom-icon; custom-icon: p.custom-icon;
                        size: 24px; fg: EinkTheme.btn-fg;
                    }
                    Text {
                        text: p.name;
                        font-size: 14px; color: EinkTheme.btn-fg;
                        vertical-alignment: center; horizontal-stretch: 1;
                        overflow: elide;
                    }
                }
                TouchArea {
                    width: parent.width; height: parent.height;
                    clicked => {
                        root.show-create-profile-picker = false;
                        root.create-profile-picked(root.create-picker-intent, p.id);
                    }
                }
            }

            Rectangle {
                height: 48px;
                border-radius: 4px;
                background: EinkTheme.canvas-bg;
                border-width: 1px; border-color: EinkTheme.chrome-border;
                Text {
                    text: "Cancel";
                    font-size: 14px; color: EinkTheme.btn-fg;
                    horizontal-alignment: center; vertical-alignment: center;
                    width: parent.width; height: parent.height;
                }
                TouchArea {
                    width: parent.width; height: parent.height;
                    clicked => {
                        root.show-create-profile-picker = false;
                        root.create-profile-pick-cancel();
                    }
                }
            }
        }
    }

    // ── Note rename dialog ───────────────────────────────────────────────
    // Canvas / folder rename dialog
    canvas-rename-dialog := Rectangle {
        visible: root.canvas-rename-visible;
        x: 0; y: 0; width: parent.width; height: parent.height;
        background: #00000055;
        TouchArea { clicked => { root.canvas-rename-cancel(); } }
        Rectangle {
            x: (parent.width - 320px) / 2; y: (parent.height - 180px) / 2;
            width: 320px; height: 180px;
            background: EinkTheme.chrome-bg;
            border-width: 2px; border-color: EinkTheme.chrome-border; border-radius: 8px;
            VerticalLayout {
                padding: 16px; spacing: 12px;
                Text {
                    text: root.canvas-rename-kind == "folder" ? "Rename Folder" : "Rename Canvas";
                    font-size: 16px; font-weight: 700; color: EinkTheme.btn-fg;
                }
                Rectangle {
                    height: 40px; background: EinkTheme.btn-bg;
                    border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                    TextInput {
                        width: parent.width - 16px; x: 8px; height: parent.height;
                        text <=> root.canvas-rename-title;
                        font-size: 14px; color: EinkTheme.btn-fg;
                        single-line: true;
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        height: 40px; horizontal-stretch: 1; background: EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                        Text { text: "Cancel"; font-size: 14px; color: EinkTheme.btn-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.canvas-rename-cancel(); } }
                    }
                    Rectangle {
                        height: 40px; horizontal-stretch: 1; background: EinkTheme.btn-active-bg;
                        border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                        Text { text: "Rename"; font-size: 14px; color: EinkTheme.btn-active-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea {
                            clicked => {
                                root.canvas-rename-confirm(
                                    root.canvas-rename-kind, root.canvas-rename-id, root.canvas-rename-title);
                            }
                        }
                    }
                }
            }
        }
    }

    note-rename-dialog := Rectangle {
        visible: root.note-rename-visible;
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        background: EinkTheme.chrome-bg;
        opacity: 0.95;

        Rectangle {
            x: (parent.width - 380px) / 2;
            y: (parent.height - 200px) / 2;
            width: 380px; height: 200px;
            background: EinkTheme.canvas-bg;
            border-radius: 8px;
            border-width: 3px;
            border-color: EinkTheme.chrome-border;

            VerticalLayout {
                padding: 20px; spacing: 14px;

                Text {
                    text: "Rename Note";
                    font-size: 16px; font-weight: 700;
                    color: EinkTheme.btn-fg;
                    horizontal-alignment: center;
                }

                Rectangle {
                    height: 44px;
                    border-radius: 4px; border-width: 2px;
                    border-color: EinkTheme.btn-border;
                    background: EinkTheme.canvas-bg;

                    TextInput {
                        x: 8px; y: 0;
                        width: parent.width - 16px;
                        height: parent.height;
                        font-size: 14px; color: EinkTheme.btn-fg;
                        text <=> root.note-rename-title;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 12px; alignment: center;

                    Rectangle {
                        width: 110px; height: 42px;
                        background: EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        Text { text: "Cancel"; font-size: 14px; color: EinkTheme.btn-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.note-rename-cancel(); } }
                    }

                    Rectangle {
                        width: 110px; height: 42px;
                        background: EinkTheme.btn-active-bg;
                        border-radius: 4px; border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        Text { text: "Rename"; font-size: 14px; color: EinkTheme.btn-active-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea {
                            clicked => {
                                root.note-rename-confirm(root.note-rename-id, root.note-rename-title);
                            }
                        }
                    }
                }
            }
        }
    }

    // ── Note move dialog ─────────────────────────────────────────────────
    note-move-dialog := Rectangle {
        visible: root.note-move-visible;
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        background: EinkTheme.chrome-bg;
        opacity: 0.95;

        Rectangle {
            x: (parent.width - 360px) / 2;
            y: (parent.height - 320px) / 2;
            width: 360px;
            height: 320px;
            background: EinkTheme.canvas-bg;
            border-radius: 8px;
            border-width: 3px;
            border-color: EinkTheme.chrome-border;
            clip: true;

            VerticalLayout {
                padding: 0px; spacing: 0px;

                Rectangle {
                    height: 44px;
                    background: EinkTheme.canvas-bg;
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 16px;
                        padding-top: 8px; padding-bottom: 8px;
                        Text {
                            text: "Move to Folder";
                            font-size: 15px; font-weight: 700;
                            color: EinkTheme.btn-fg;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            horizontal-alignment: center;
                        }
                    }
                }

                Rectangle { height: 2px; background: EinkTheme.chrome-border; }

                // Root (unfiled)
                Rectangle {
                    height: 48px;
                    background: EinkTheme.canvas-bg;
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 16px;
                        padding-top: 8px; padding-bottom: 8px;
                        Text {
                            text: "Root (no folder)";
                            font-size: 14px; color: EinkTheme.btn-fg;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                    TouchArea {
                        clicked => {
                            root.note-move-confirm(root.note-move-note-id, "0");
                        }
                    }
                    Rectangle {
                        x: 0; y: parent.height - 1px;
                        width: parent.width; height: 1px;
                        background: EinkTheme.chrome-border; opacity: 0.3;
                    }
                }

                for nb[i] in root.notebook-list: Rectangle {
                    height: 48px;
                    background: EinkTheme.canvas-bg;

                    HorizontalLayout {
                        padding-left: 16px; padding-right: 16px;
                        padding-top: 8px; padding-bottom: 8px;
                        Text {
                            text: nb.title;
                            font-size: 14px; color: EinkTheme.btn-fg;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                    TouchArea {
                        clicked => {
                            root.note-move-confirm(root.note-move-note-id, nb.id);
                        }
                    }
                    Rectangle {
                        x: 0; y: parent.height - 1px;
                        width: parent.width; height: 1px;
                        background: EinkTheme.chrome-border; opacity: 0.3;
                    }
                }

                Rectangle {
                    height: 56px;
                    background: EinkTheme.canvas-bg;
                    HorizontalLayout {
                        padding: 10px;
                        alignment: center;
                        Rectangle {
                            width: 120px; height: 36px;
                            background: EinkTheme.btn-bg;
                            border-radius: 4px; border-width: 2px;
                            border-color: EinkTheme.btn-border;
                            Text { text: "Cancel"; font-size: 14px; color: EinkTheme.btn-fg;
                                   horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.note-move-cancel(); } }
                        }
                    }
                }
            }
        }
    }

    // ── Notebook rename / new-folder dialog ───────────────────────────────
    notebook-rename-dialog := Rectangle {
        visible: root.notebook-rename-visible;
        x: 0; y: 0; width: parent.width; height: parent.height;
        background: #00000040;

        Rectangle {
            x: parent.width / 2 - 220px;
            y: parent.height / 2 - 120px;
            width: 440px; height: 240px;
            background: EinkTheme.canvas-bg;
            border-radius: 8px; border-width: 2px; border-color: EinkTheme.chrome-border;

            VerticalLayout {
                padding: 20px; spacing: 16px;

                Text {
                    text: root.notebook-rename-is-create ? "New Folder" : "Rename Folder";
                    font-size: 16px; font-weight: 700;
                    color: EinkTheme.btn-fg;
                    horizontal-alignment: center;
                }

                Rectangle {
                    height: 48px;
                    border-radius: 6px; border-width: 2px; border-color: EinkTheme.btn-border;
                    background: EinkTheme.canvas-bg;
                    Text {
                        visible: root.notebook-rename-title == "";
                        x: 10px; y: 0;
                        width: parent.width - 20px; height: parent.height;
                        text: "Folder name";
                        font-size: 15px; color: EinkTheme.text-secondary;
                        vertical-alignment: center;
                    }
                    TextInput {
                        x: 10px; y: 0;
                        width: parent.width - 20px; height: parent.height;
                        font-size: 15px; color: EinkTheme.btn-fg;
                        text <=> root.notebook-rename-title;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 16px; alignment: center;

                    Rectangle {
                        width: 140px; height: 44px;
                        background: EinkTheme.btn-bg;
                        border-radius: 6px; border-width: 2px; border-color: EinkTheme.btn-border;
                        Text { text: "Cancel"; font-size: 14px; color: EinkTheme.btn-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.notebook-rename-cancel(); } }
                    }

                    Rectangle {
                        width: 140px; height: 44px;
                        background: EinkTheme.btn-active-bg;
                        border-radius: 6px; border-width: 2px; border-color: EinkTheme.btn-border;
                        Text {
                            text: root.notebook-rename-is-create ? "Create" : "Rename";
                            font-size: 14px; color: EinkTheme.btn-active-fg;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                        TouchArea {
                            clicked => {
                                root.notebook-rename-confirm(root.notebook-rename-id, root.notebook-rename-title);
                            }
                        }
                    }
                }
            }
        }
    }

    // ── Folder delete confirmation ────────────────────────────────────────
    notebook-delete-dialog := Rectangle {
        visible: root.notebook-delete-visible;
        x: 0; y: 0; width: parent.width; height: parent.height;
        background: #00000040;

        Rectangle {
            x: parent.width / 2 - 220px;
            y: parent.height / 2 - 110px;
            width: 440px; height: 220px;
            background: EinkTheme.canvas-bg;
            border-radius: 8px; border-width: 2px; border-color: EinkTheme.chrome-border;

            VerticalLayout {
                padding: 20px; spacing: 14px;

                Text {
                    text: "Delete folder?";
                    font-size: 16px; font-weight: 700;
                    color: EinkTheme.btn-fg;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.notebook-delete-title;
                    font-size: 14px; font-weight: 600;
                    color: EinkTheme.btn-fg;
                    horizontal-alignment: center;
                    overflow: elide;
                }

                Text {
                    text: root.notebook-delete-message;
                    font-size: 13px;
                    color: EinkTheme.text-secondary;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 16px; alignment: center;

                    Rectangle {
                        width: 140px; height: 44px;
                        background: EinkTheme.btn-bg;
                        border-radius: 6px; border-width: 2px; border-color: EinkTheme.btn-border;
                        Text { text: "Cancel"; font-size: 14px; color: EinkTheme.btn-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea {
                            width: parent.width; height: parent.height;
                            clicked => {
                                root.notebook-delete-visible = false;
                                root.notebook-delete-cancel();
                            }
                        }
                    }

                    Rectangle {
                        width: 140px; height: 44px;
                        background: EinkTheme.btn-active-bg;
                        border-radius: 6px; border-width: 2px; border-color: EinkTheme.btn-border;
                        Text { text: "Delete"; font-size: 14px; color: EinkTheme.btn-active-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea {
                            width: parent.width; height: parent.height;
                            clicked => {
                                root.notebook-delete-visible = false;
                                root.notebook-delete-confirm(root.notebook-delete-id);
                            }
                        }
                    }
                }
            }
        }
    }

    // ── Recording detail modal (transcript + play; title editable inline) ───
    rec-transcription-dialog := Rectangle {
        visible: root.rec-transcription-visible;
        x: 0; y: 0; width: parent.width; height: parent.height;
        background: #00000040;

        // Dismiss on backdrop tap (saves current text + title).
        TouchArea {
            width: parent.width; height: parent.height;
            clicked => { root.rec-transcription-save(root.rec-transcription-text); }
        }

        Rectangle {
            x: (parent.width - Math.min(parent.width - 32px, 520px)) / 2;
            y: (parent.height - Math.min(parent.height - 48px, 560px)) / 2;
            width: Math.min(parent.width - 32px, 520px);
            height: Math.min(parent.height - 48px, 560px);
            background: EinkTheme.canvas-bg;
            border-radius: 8px;
            border-width: 3px;
            border-color: EinkTheme.chrome-border;
            clip: true;

            // Swallow taps so backdrop dismiss doesn't fire from the card.
            TouchArea { width: parent.width; height: parent.height; }

            VerticalLayout {
                padding: 0px; spacing: 0px;

                Rectangle {
                    height: 52px;
                    background: EinkTheme.canvas-bg;
                    HorizontalLayout {
                        padding-left: 12px; padding-right: 12px;
                        padding-top: 8px; padding-bottom: 8px;
                        spacing: 8px;

                        Rectangle {
                            width: 36px; height: 36px;
                            background: transparent;
                            Text {
                                text: Icons.close;
                                font-family: "Material Icons"; font-size: 22px;
                                color: EinkTheme.btn-fg;
                                horizontal-alignment: center; vertical-alignment: center;
                                width: parent.width; height: parent.height;
                            }
                            TouchArea { clicked => { root.rec-transcription-save(root.rec-transcription-text); } }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            height: 36px;
                            border-radius: 4px; border-width: 2px;
                            border-color: EinkTheme.btn-border;
                            background: EinkTheme.canvas-bg;
                            TextInput {
                                x: 8px; y: 0;
                                width: parent.width - 16px; height: parent.height;
                                font-size: 15px; font-weight: 700;
                                color: EinkTheme.btn-fg;
                                text <=> root.rec-active-title;
                                vertical-alignment: center;
                                single-line: true;
                            }
                        }

                        Rectangle {
                            width: 36px; height: 36px;
                            background: EinkTheme.btn-bg;
                            border-radius: 4px; border-width: 2px;
                            border-color: EinkTheme.btn-border;
                            Text {
                                text: Icons.play;
                                font-family: "Material Icons"; font-size: 20px;
                                color: EinkTheme.btn-fg;
                                horizontal-alignment: center; vertical-alignment: center;
                                width: parent.width; height: parent.height;
                            }
                            TouchArea { clicked => { root.rec-play-tapped(root.rec-active-id); } }
                        }

                        Rectangle {
                            width: 36px; height: 36px;
                            background: transparent;
                            Text {
                                text: Icons.refresh;
                                font-family: "Material Icons"; font-size: 20px;
                                color: EinkTheme.btn-fg;
                                horizontal-alignment: center; vertical-alignment: center;
                                width: parent.width; height: parent.height;
                            }
                            TouchArea { clicked => { root.rec-transcription-retranscribe(); } }
                        }

                        Rectangle {
                            width: 56px; height: 36px;
                            background: EinkTheme.btn-active-bg;
                            border-radius: 4px; border-width: 2px;
                            border-color: EinkTheme.btn-border;
                            Text { text: "Save"; font-size: 13px; color: EinkTheme.btn-active-fg;
                                   horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.rec-transcription-save(root.rec-transcription-text); } }
                        }
                    }
                }

                Rectangle { height: 2px; background: EinkTheme.chrome-border; }

                Flickable {
                    vertical-stretch: 1;
                    interactive: true;
                    content-height: txn-input.preferred-height + 24px;

                    txn-input := TextInput {
                        x: 16px; y: 12px;
                        width: parent.width - 32px;
                        text <=> root.rec-transcription-text;
                        font-size: 14px; color: EinkTheme.btn-fg;
                        wrap: word-wrap;
                        single-line: false;
                    }
                }
            }
        }
    }

    // ── Recording rename dialog ──────────────────────────────────────────────
    rec-rename-dialog := Rectangle {
        visible: root.rec-rename-visible;
        x: 0; y: 0; width: parent.width; height: parent.height;
        background: #00000040;

        Rectangle {
            x: parent.width / 2 - 190px;
            y: parent.height / 2 - 100px;
            width: 380px; height: 200px;
            background: EinkTheme.canvas-bg;
            border-radius: 8px; border-width: 2px; border-color: EinkTheme.chrome-border;

            VerticalLayout {
                padding: 20px; spacing: 14px;

                Text {
                    text: "Rename Recording";
                    font-size: 16px; font-weight: 700;
                    color: EinkTheme.btn-fg;
                    horizontal-alignment: center;
                }

                Rectangle {
                    height: 44px;
                    border-radius: 4px; border-width: 2px;
                    border-color: EinkTheme.btn-border;
                    background: EinkTheme.canvas-bg;
                    TextInput {
                        x: 8px; y: 0;
                        width: parent.width - 16px; height: parent.height;
                        font-size: 14px; color: EinkTheme.btn-fg;
                        text <=> root.rec-rename-title;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 12px; alignment: center;
                    Rectangle {
                        width: 110px; height: 42px;
                        background: EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                        Text { text: "Cancel"; font-size: 14px; color: EinkTheme.btn-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.rec-rename-cancel(); } }
                    }
                    Rectangle {
                        width: 110px; height: 42px;
                        background: EinkTheme.btn-active-bg;
                        border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                        Text { text: "Rename"; font-size: 14px; color: EinkTheme.btn-active-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea {
                            clicked => {
                                root.rec-rename-confirm(root.rec-rename-id, root.rec-rename-title);
                            }
                        }
                    }
                }
            }
        }
    }

    // ── Recording status bar (persistent overlay while recording) ────────────
    // Visible over all views — placed late in z-order so it renders on top.
    rec-status-bar := Rectangle {
        visible: root.rec-state != 0;
        x: 0;
        y: parent.height - 44px;
        width: parent.width;
        height: 44px;
        background: EinkTheme.chrome-bg;
        border-width: 2px; border-color: EinkTheme.chrome-border;

        HorizontalLayout {
            padding-left: 12px; padding-right: 8px;
            padding-top: 6px; padding-bottom: 6px;
            spacing: 8px;

            // Record indicator dot
            Text {
                text: Icons.record-dot;
                font-family: "Material Icons";
                font-size: 18px;
                color: root.rec-state == 2 ? EinkTheme.text-secondary : EinkTheme.btn-fg;
                vertical-alignment: center;
                width: 22px;
            }

            // Duration counter
            Text {
                text: root.rec-duration-label;
                font-size: 14px; font-weight: 700;
                color: EinkTheme.btn-fg;
                vertical-alignment: center;
                width: 52px;
            }

            Rectangle { horizontal-stretch: 1; }

            // Pause / resume toggle
            Rectangle {
                width: 40px; height: 32px;
                background: EinkTheme.btn-bg;
                border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                Text {
                    text: root.rec-state == 2 ? Icons.play : Icons.pause;
                    font-family: "Material Icons"; font-size: 20px;
                    color: EinkTheme.btn-fg;
                    horizontal-alignment: center; vertical-alignment: center;
                    width: parent.width; height: parent.height;
                }
                TouchArea {
                    clicked => {
                        if (root.rec-state == 2) {
                            root.rec-resume-tapped();
                        } else {
                            root.rec-pause-tapped();
                        }
                    }
                }
            }

            // Stop and save (done icon = checkmark)
            Rectangle {
                width: 40px; height: 32px;
                background: EinkTheme.btn-active-bg;
                border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                Text {
                    text: Icons.done;
                    font-family: "Material Icons"; font-size: 20px;
                    color: EinkTheme.btn-active-fg;
                    horizontal-alignment: center; vertical-alignment: center;
                    width: parent.width; height: parent.height;
                }
                TouchArea { clicked => { root.rec-stop-tapped(); } }
            }

            // Discard (delete/trash icon)
            Rectangle {
                width: 40px; height: 32px;
                background: EinkTheme.btn-bg;
                border-radius: 4px; border-width: 2px; border-color: EinkTheme.btn-border;
                Text {
                    text: Icons.delete;
                    font-family: "Material Icons"; font-size: 20px;
                    color: EinkTheme.btn-fg;
                    horizontal-alignment: center; vertical-alignment: center;
                    width: parent.width; height: parent.height;
                }
                TouchArea { clicked => { root.rec-discard-tapped(); } }
            }
        }
    }

    // ── Canvas note title + rename pencil (shown right of nav rail when burger open) ──
    note-title-bar := Rectangle {
        visible: root.drawing-menu-open && root.is-canvas-context;
        x: root.nav-w + 8px;
        y: 8px;
        height: 44px;
        width: parent.width - root.nav-w - 60px;
        // Opaque chrome chip so ink behind the title stays readable on e-ink.
        background: EinkTheme.chrome-bg;
        border-width: 1px;
        border-color: EinkTheme.chrome-border;
        border-radius: 8px;

        HorizontalLayout {
            spacing: 4px;
            alignment: start;
            padding: 4px;
            padding-left: 10px;

            Text {
                text: root.page-title;
                font-size: 16px;
                font-weight: 700;
                color: EinkTheme.btn-fg;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }

            // Anchor chip: shown when this note is linked to a calendar day
            if root.note-anchor-label != "": Rectangle {
                height: 26px;
                width: 90px;
                border-radius: 13px;
                border-width: 1px;
                border-color: EinkTheme.btn-border;
                background: EinkTheme.btn-bg;
                HorizontalLayout {
                    spacing: 2px; padding-left: 6px; padding-right: 6px;
                    alignment: center;
                    Text {
                        text: Icons.calendar;
                        font-family: "Material Icons"; font-size: 13px;
                        color: EinkTheme.btn-fg;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.note-anchor-label;
                        font-size: 10px; color: EinkTheme.btn-fg;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                TouchArea { clicked => { root.note-anchor-tapped(); } }
            }

            Rectangle {
                width: 36px;
                background: transparent;
                Text {
                    text: Icons.edit;
                    font-family: "Material Icons";
                    font-size: 18px;
                    color: EinkTheme.btn-fg;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }
                TouchArea {
                    clicked => { root.rename-canvas-note(); }
                }
            }
        }
    }

    // ── Drawing mode burger button (top-right corner) ─────────────────────
    // On top of everything (last in z-order); only visible when canvas is active.
    // Closed state uses a filled chrome chip (not a faint outline) so it stays
    // readable on PineNote / e-ink where 0.3 opacity washes out.
    drawing-burger := Rectangle {
        visible: root.is-canvas-context;
        x: parent.width - 52px;
        y: 8px;
        width: 44px;
        height: 44px;
        background: root.drawing-menu-open ? EinkTheme.btn-active-bg : EinkTheme.chrome-bg;
        border-radius: 22px;
        border-width: 2px;
        border-color: EinkTheme.btn-border;
        opacity: 1.0;

        Text {
            text: root.drawing-menu-open ? Icons.close : Icons.menu;
            font-family: "Material Icons";
            font-size: 20px;
            color: root.drawing-menu-open ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: parent.width;
            height: parent.height;
        }
        TouchArea {
            clicked => { root.drawing-menu-open = !root.drawing-menu-open; }
        }
    }
}
