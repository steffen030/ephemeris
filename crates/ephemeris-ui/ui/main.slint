// Ephemeris main UI — eink-optimised layout (800 × 600 default)
//
// Layers (top → bottom in z-order):
//   1. StatusBar  — 24 px at top: page title + page index
//   2. Toolbar    — 48 px at bottom: tool buttons (Pen / Highlighter / Eraser / Clear)
//   3. Canvas     — fills remaining space: the ink stroke layer (seam for bead 6iy.2)
//
// All callbacks are wired to properties exposed to Rust so the bridge can
// react to button presses and canvas touch events without winit.
//
// ## Swipe gesture detection (bead 6iy.3)
//
// The canvas TouchArea tracks pointer-down and pointer-up positions.  On
// pointer-up, if:
//   • |dx| > SWIPE_THRESHOLD (50 px), AND
//   • |dx| > |dy|  (predominantly horizontal),
// then a `swipe-left` or `swipe-right` callback is emitted instead of a
// `canvas-touch`.  All other interactions are forwarded to `canvas-touch` as
// before, keeping drawing unaffected.
//
// ## Eink theme (bead 2ql.6)
//
// All chrome and button colors flow through the exported `EinkTheme` global so
// the Rust bridge can apply Config.theme ("light" / "dark") at runtime without
// touching the layout logic.  Defaults are the light eink theme: pure white
// background, pure black borders and text.  No grays, no color, no gradients.

/// A ranked task row for the start page.
export struct TaskEntry {
    title: string,
    priority-label: string,  // "!!!" / "!!" / "!" or ""
    due-label: string,       // "overdue" / "today" / "2d" / "" etc
    overdue: bool,
}

/// A calendar event row for the agenda view.
export struct AgendaEntry {
    title: string,
    time-label: string,    // "HH:MM" or "ddd HH:MM"
    location-label: string,
}

/// A task row for the full task CRUD view.
export struct TaskViewEntry {
    id: string,
    title: string,
    priority-label: string,
    due-label: string,
    overdue: bool,
    done: bool,
}

/// A filesystem entry for the settings file browser.
export struct FileBrowserEntry {
    name: string,
    full-path: string,
    is-dir: bool,
    is-vault: bool,
}

/// A configured calendar source (local file path or remote URL).
export struct CalSource {
    display: string,
    value: string,
}

/// A note entry in the note browser list.
export struct NoteEntry {
    id: string,
    title: string,
    date-label: string,
}

export global EinkTheme {
    in property <color> canvas-bg: white;
    in property <color> chrome-bg: white;
    in property <color> chrome-border: black;
    in property <color> btn-bg: white;
    in property <color> btn-fg: black;
    in property <color> btn-active-bg: black;
    in property <color> btn-active-fg: white;
    in property <color> btn-border: black;
    in property <color> text-secondary: black;
    in property <color> danger-fg: black;
}

export component EphemerisPage inherits Window {
    // ── Layout geometry ──────────────────────────────────────────────────
    preferred-width:  800px;
    preferred-height: 600px;
    background: EinkTheme.canvas-bg;

    // ── Exposed state ────────────────────────────────────────────────────

    /// Page title shown in the status bar.
    in property <string> page-title: "Untitled";

    /// Current page index (1-based, shown as "n / total").
    in property <int> page-index: 1;

    /// Total page count.
    in property <int> page-count: 1;

    /// Active tool label (drives toolbar button highlight).
    in-out property <string> active-tool: "pen";

    /// When true, the start page (tasks-ahead list) replaces the canvas.
    in property <bool> show-start-page: false;

    /// Ranked task list for the start page.
    in property <[TaskEntry]> task-list: [];

    /// Agenda range: 0 = Day, 1 = Week, 2 = Month.
    in-out property <int> agenda-range: 0;

    /// Agenda event list for the selected range.
    in property <[AgendaEntry]> agenda-list: [];

    callback agenda-range-changed(/* range */ int);

    // ── Action ring state ────────────────────────────────────────────────────

    /// Show the action ring overlay.
    in property <bool> ring-visible: false;

    /// Canvas-relative X center for the ring (from the triggering tap).
    in property <float> ring-cx: 400;

    /// Canvas-relative Y center for the ring (from the triggering tap).
    in property <float> ring-cy: 300;

    /// Show the Audio slice (only on mic-equipped devices like PineNote).
    in property <bool> ring-show-audio: true;

    callback ring-note-tapped();
    callback ring-calendar-tapped();
    callback ring-task-tapped();
    callback ring-audio-tapped();
    callback ring-dismissed();

    // ── Task CRUD view ────────────────────────────────────────────────────────

    /// Show the full task list view (CRUD) instead of the canvas/start-page.
    in property <bool> show-task-view: false;

    /// Full task list for the CRUD view.
    in property <[TaskViewEntry]> full-task-list: [];

    /// Add/edit dialog state.
    in-out property <bool> task-dialog-visible: false;
    in-out property <bool> task-dialog-is-edit: false;
    in-out property <string> task-dialog-id: "";
    in-out property <string> task-dialog-title: "";
    in-out property <int> task-dialog-priority: 1;

    /// Emitted when the user taps the page title in the status bar (→ home/start page).
    callback page-title-tapped();

    callback start-page-notes-tapped();
    callback start-page-tasks-tapped();
    callback task-back-tapped();
    callback task-complete-toggled(/* id */ string);
    callback task-edit-requested(/* id */ string);
    callback task-confirm-add(/* title */ string, /* priority */ int);
    callback task-confirm-edit(/* id */ string, /* title */ string, /* priority */ int);
    callback task-dialog-cancel();

    // ── Settings view state ──────────────────────────────────────────────────

    /// Show the settings view instead of the canvas/start-page.
    in property <bool> show-settings: false;

    /// Active theme index: 0 = light, 1 = dark.  Toggled by buttons in the view.
    in-out property <int> settings-theme-idx: 0;

    /// Currently configured vault path (empty string = not configured).
    in property <string> settings-vault-path: "";

    /// Currently configured calendar sources (files + URLs).
    in property <[CalSource]> settings-cal-sources: [];

    /// Staging field bound to the "Add URL" TextInput.
    in-out property <string> settings-new-url: "";

    callback settings-open();
    callback settings-back();
    callback settings-save();
    callback settings-clear-vault();
    callback settings-browse-vault();
    callback settings-browse-ics();
    callback settings-add-url(/* url */ string);
    callback settings-remove-source(/* index */ int);

    // ── File browser state ────────────────────────────────────────────────────

    /// Show the file browser view (navigates to vault or .ics selection).
    in property <bool> show-filebrowser: false;

    /// When true the user is selecting a vault folder; when false, an .ics file.
    in property <bool> fb-vault-mode: true;

    /// Absolute path of the directory currently displayed.
    in property <string> fb-current-path: "";

    /// Entries in the current directory (populated by Rust on navigation).
    in property <[FileBrowserEntry]> fb-entries: [];

    callback fb-navigate(/* path */ string);
    callback fb-select-vault(/* path */ string);
    callback fb-add-ics(/* path */ string);
    callback fb-cancel();

    // ── Navigation rail state ────────────────────────────────────────────────

    /// Width of the persistent left navigation rail.
    property <length> nav-w: 80px;

    /// Active navigation section: 0 = Overview, 1 = Notes.
    in-out property <int> nav-section: 0;

    callback nav-overview-tapped();
    callback nav-notes-tapped();

    // ── Note browser state ───────────────────────────────────────────────────

    /// Show the note browser list view (inside the Notes section).
    in property <bool> show-note-list: false;

    /// Note entries populated by the app layer.
    in property <[NoteEntry]> note-list: [];

    /// ID of the currently open note (empty = none open).
    in-out property <string> active-note-id: "";

    callback note-tapped(/* id */ string);
    callback note-new-tapped();

    // ── Note rename dialog state ──────────────────────────────────────────────

    in-out property <bool> note-rename-visible: false;
    in-out property <string> note-rename-id: "";
    in-out property <string> note-rename-title: "";

    callback note-rename-confirm(/* id */ string, /* title */ string);
    callback note-rename-cancel();

    // ── Swipe detection state (private) ─────────────────────────────────

    /// X coordinate (canvas-relative) where the current pointer contact began.
    private property <float> swipe-start-x: 0;
    /// Y coordinate (canvas-relative) where the current pointer contact began.
    private property <float> swipe-start-y: 0;
    /// Horizontal threshold (px) that must be exceeded to register a swipe.
    private property <float> swipe-threshold: 50;

    // ── Callbacks (wired to Rust via bridge) ────────────────────────────

    /// Emitted when the user taps or draws on the canvas (touch / mouse down).
    /// Fires only for contacts that do NOT resolve to a swipe gesture.
    callback canvas-touch(/* x */ float, /* y */ float);

    /// Emitted when the user completes a leftward swipe on the canvas
    /// (|dx| > threshold, dx < 0, |dx| > |dy|) → navigate to previous page.
    callback swipe-left();

    /// Emitted when the user completes a rightward swipe on the canvas
    /// (|dx| > threshold, dx > 0, |dx| > |dy|) → navigate to next page
    /// (auto-creating one when already on the last page).
    callback swipe-right();

    /// Emitted when the user selects a toolbar tool.
    callback tool-selected(/* tool name */ string);

    /// Emitted when the user presses the "clear page" button.
    callback clear-page();

    // ── Status bar ───────────────────────────────────────────────────────
    status-bar := Rectangle {
        x: 0; y: 0;
        width: parent.width;
        height: 24px;
        background: EinkTheme.chrome-bg;

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            alignment: space-between;

            // Tappable title — tap to return to start page (home).
            Rectangle {
                width: parent.width / 2;
                height: parent.height;
                background: transparent;
                Text {
                    text: root.page-title;
                    font-size: 13px;
                    color: EinkTheme.btn-fg;
                    vertical-alignment: center;
                }
                TouchArea { clicked => { root.page-title-tapped(); } }
            }

            Text {
                text: root.page-index + " / " + root.page-count;
                font-size: 13px;
                color: EinkTheme.text-secondary;
                vertical-alignment: center;
            }
        }

        // Bottom divider — 2 px black line separating status bar from canvas.
        Rectangle {
            x: 0; y: parent.height - 2px;
            width: parent.width; height: 2px;
            background: EinkTheme.chrome-border;
        }
    }

    // ── Toolbar ──────────────────────────────────────────────────────────
    toolbar := Rectangle {
        x: 0;
        y: parent.height - self.height;
        width: parent.width;
        height: 48px;
        background: EinkTheme.chrome-bg;

        HorizontalLayout {
            padding: 4px;
            spacing: 4px;

            // Pen button
            pen-btn := Rectangle {
                width: 80px; height: 40px;
                background: root.active-tool == "pen" ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                border-radius: 4px;
                border-width: 2px;
                border-color: EinkTheme.btn-border;

                Text {
                    text: "Pen";
                    font-size: 14px;
                    color: root.active-tool == "pen" ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    clicked => {
                        root.active-tool = "pen";
                        root.tool-selected("pen");
                    }
                }
            }

            // Highlighter button
            hl-btn := Rectangle {
                width: 100px; height: 40px;
                background: root.active-tool == "highlighter" ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                border-radius: 4px;
                border-width: 2px;
                border-color: EinkTheme.btn-border;

                Text {
                    text: "Highlighter";
                    font-size: 14px;
                    color: root.active-tool == "highlighter" ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    clicked => {
                        root.active-tool = "highlighter";
                        root.tool-selected("highlighter");
                    }
                }
            }

            // Eraser button
            eraser-btn := Rectangle {
                width: 80px; height: 40px;
                background: root.active-tool == "eraser" ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                border-radius: 4px;
                border-width: 2px;
                border-color: EinkTheme.btn-border;

                Text {
                    text: "Eraser";
                    font-size: 14px;
                    color: root.active-tool == "eraser" ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    clicked => {
                        root.active-tool = "eraser";
                        root.tool-selected("eraser");
                    }
                }
            }

            // Clear button
            clear-btn := Rectangle {
                width: 80px; height: 40px;
                background: EinkTheme.btn-bg;
                border-radius: 4px;
                border-width: 2px;
                border-color: EinkTheme.btn-border;

                Text {
                    text: "Clear";
                    font-size: 14px;
                    color: EinkTheme.danger-fg;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    clicked => { root.clear-page(); }
                }
            }

            // Flexible spacer — pushes Settings button to the right.
            Rectangle { horizontal-stretch: 1; }

            // Settings button (right-aligned in toolbar)
            cfg-btn := Rectangle {
                width: 80px; height: 40px;
                background: EinkTheme.btn-bg;
                border-radius: 4px;
                border-width: 2px;
                border-color: EinkTheme.btn-border;

                Text {
                    text: "Settings";
                    font-size: 13px;
                    color: EinkTheme.btn-fg;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    clicked => { root.settings-open(); }
                }
            }
        }

        // Top divider — 2 px black line separating canvas from toolbar.
        Rectangle {
            x: 0; y: 0;
            width: parent.width; height: 2px;
            background: EinkTheme.chrome-border;
        }
    }

    // ── Canvas (stroke layer — seam for bead 6iy.2) ──────────────────────
    //
    // This Rectangle occupies the space between the status bar and toolbar.
    // Ink rendering works via the canvas-touch callback → InkEngine →
    // EphemerisUi::render_frame().
    //
    // Swipe detection (bead 6iy.3):
    //   pointer-down  → record swipe-start-{x,y} and forward a canvas-touch.
    //   pointer-up    → measure dx/dy.  If |dx| > threshold and |dx| > |dy|,
    //                   emit swipe-left / swipe-right instead.  Otherwise no
    //                   additional callback (pointer-down already fired).
    canvas := Rectangle {
        x: 0;
        y: status-bar.height;
        width: parent.width;
        height: parent.height - status-bar.height - toolbar.height;
        background: EinkTheme.canvas-bg;
        clip: true;

        // Touch / mouse input — drawing + swipe gesture detection.
        TouchArea {
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    // Record the contact origin for later swipe measurement.
                    root.swipe-start-x = self.mouse-x / 1px;
                    root.swipe-start-y = self.mouse-y / 1px;
                    // Forward to ink engine immediately.
                    root.canvas-touch(self.mouse-x / 1px, self.mouse-y / 1px);
                } else if (event.kind == PointerEventKind.up) {
                    // Measure displacement from the contact origin.
                    // Note: on pointer-up, mouse-x/y is the release position.
                    // Slint's TouchArea keeps mouse-x/y at the last tracked
                    // position, which on up is the release coordinates.
                    // We intentionally re-read them here.
                    // Workaround for Slint not having local variables in
                    // pointer-event: compute inline with property arithmetic.
                    // dx and dy are both in logical pixels.
                    // Positive dx  → swipe right; negative dx → swipe left.
                    if (
                        // Horizontal displacement exceeds threshold.
                        (self.mouse-x / 1px - root.swipe-start-x >= root.swipe-threshold ||
                         root.swipe-start-x - self.mouse-x / 1px >= root.swipe-threshold) &&
                        // Predominantly horizontal: |dx| > |dy|.
                        ((self.mouse-x / 1px - root.swipe-start-x) * (self.mouse-x / 1px - root.swipe-start-x) >
                         (self.mouse-y / 1px - root.swipe-start-y) * (self.mouse-y / 1px - root.swipe-start-y))
                    ) {
                        if (self.mouse-x / 1px > root.swipe-start-x) {
                            root.swipe-right();
                        } else {
                            root.swipe-left();
                        }
                    }
                    // If not a swipe, the pointer-down already forwarded the
                    // touch to Rust — no duplicate callback needed here.
                }
            }
        }
    }

    // ── Start page (Tasks Ahead) ─────────────────────────────────────────────
    //
    // Shown when show-start-page is true. Renders the ranked task list returned
    // by the prioritization engine. Overlays the canvas in the same region.
    start-page := Rectangle {
        visible: root.show-start-page;
        x: root.nav-w;
        y: status-bar.height;
        width: parent.width - root.nav-w;
        height: parent.height - status-bar.height - toolbar.height;
        background: EinkTheme.canvas-bg;
        clip: true;

        VerticalLayout {
            padding: 16px;
            spacing: 0px;

            // Section header — "Tasks Ahead" label + "All Tasks" navigation button
            Rectangle {
                height: 44px;
                background: transparent;
                HorizontalLayout {
                    alignment: space-between;
                    padding-top: 4px;
                    padding-bottom: 4px;

                    Text {
                        text: "Tasks Ahead";
                        font-size: 18px;
                        font-weight: 700;
                        color: EinkTheme.btn-fg;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: 80px; height: 36px;
                        background: EinkTheme.btn-bg;
                        border-radius: 4px;
                        border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        Text {
                            text: "Notes \u{2192}";
                            font-size: 13px;
                            color: EinkTheme.btn-fg;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea { clicked => { root.start-page-notes-tapped(); } }
                    }

                    Rectangle {
                        width: 96px; height: 36px;
                        background: EinkTheme.btn-bg;
                        border-radius: 4px;
                        border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        Text {
                            text: "All Tasks \u{2192}";
                            font-size: 13px;
                            color: EinkTheme.btn-fg;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea { clicked => { root.start-page-tasks-tapped(); } }
                    }
                }
            }

            // Divider
            Rectangle {
                height: 2px;
                background: EinkTheme.chrome-border;
            }

            // Task rows
            for item[i] in root.task-list: Rectangle {
                height: 52px;
                background: transparent;

                HorizontalLayout {
                    padding-left: 4px;
                    padding-right: 4px;
                    spacing: 8px;
                    alignment: start;

                    // Priority badge
                    Text {
                        text: item.priority-label;
                        font-size: 14px;
                        color: EinkTheme.btn-fg;
                        vertical-alignment: center;
                        width: 28px;
                        horizontal-alignment: center;
                    }

                    // Title (stretches to fill)
                    Text {
                        text: item.title;
                        font-size: 14px;
                        color: EinkTheme.btn-fg;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }

                    // Due label (right-aligned)
                    Text {
                        text: item.due-label;
                        font-size: 12px;
                        color: item.overdue ? EinkTheme.danger-fg : EinkTheme.text-secondary;
                        vertical-alignment: center;
                        width: 64px;
                        horizontal-alignment: right;
                    }
                }

                // Row divider
                Rectangle {
                    x: 0; y: parent.height - 1px;
                    width: parent.width; height: 1px;
                    background: EinkTheme.chrome-border;
                    opacity: 0.3;
                }
            }

            // Empty state
            if root.task-list.length == 0: Rectangle {
                height: 80px;
                background: transparent;
                Text {
                    text: "All clear — no tasks ahead";
                    font-size: 14px;
                    color: EinkTheme.text-secondary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // ── Agenda section ───────────────────────────────────────────────

            // Spacing
            Rectangle { height: 12px; background: transparent; }

            // Agenda header + range tabs
            Rectangle {
                height: 36px;
                background: transparent;
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;

                    Text {
                        text: "Agenda";
                        font-size: 16px;
                        font-weight: 700;
                        color: EinkTheme.btn-fg;
                        vertical-alignment: center;
                        width: 70px;
                    }

                    // Day tab
                    Rectangle {
                        width: 44px; height: 28px;
                        background: root.agenda-range == 0 ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                        border-radius: 4px;
                        border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        Text {
                            text: "Day";
                            font-size: 12px;
                            color: root.agenda-range == 0 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            clicked => {
                                root.agenda-range = 0;
                                root.agenda-range-changed(0);
                            }
                        }
                    }

                    // Week tab
                    Rectangle {
                        width: 52px; height: 28px;
                        background: root.agenda-range == 1 ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                        border-radius: 4px;
                        border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        Text {
                            text: "Week";
                            font-size: 12px;
                            color: root.agenda-range == 1 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            clicked => {
                                root.agenda-range = 1;
                                root.agenda-range-changed(1);
                            }
                        }
                    }

                    // Month tab
                    Rectangle {
                        width: 58px; height: 28px;
                        background: root.agenda-range == 2 ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                        border-radius: 4px;
                        border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        Text {
                            text: "Month";
                            font-size: 12px;
                            color: root.agenda-range == 2 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            clicked => {
                                root.agenda-range = 2;
                                root.agenda-range-changed(2);
                            }
                        }
                    }
                }
            }

            // Agenda divider
            Rectangle { height: 2px; background: EinkTheme.chrome-border; }

            // Agenda event rows
            for item[i] in root.agenda-list: Rectangle {
                height: 48px;
                background: transparent;

                HorizontalLayout {
                    padding-left: 4px;
                    padding-right: 4px;
                    spacing: 8px;
                    alignment: start;

                    // Time label
                    Text {
                        text: item.time-label;
                        font-size: 12px;
                        color: EinkTheme.text-secondary;
                        vertical-alignment: center;
                        width: 64px;
                    }

                    // Title
                    Text {
                        text: item.title;
                        font-size: 14px;
                        color: EinkTheme.btn-fg;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }

                    // Location (optional)
                    Text {
                        text: item.location-label;
                        font-size: 11px;
                        color: EinkTheme.text-secondary;
                        vertical-alignment: center;
                        width: 100px;
                        overflow: elide;
                        horizontal-alignment: right;
                    }
                }

                Rectangle {
                    x: 0; y: parent.height - 1px;
                    width: parent.width; height: 1px;
                    background: EinkTheme.chrome-border;
                    opacity: 0.3;
                }
            }

            // Agenda empty state
            if root.agenda-list.length == 0: Rectangle {
                height: 48px;
                background: transparent;
                Text {
                    text: "No events in this period";
                    font-size: 13px;
                    color: EinkTheme.text-secondary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }

    // ── Task CRUD view ───────────────────────────────────────────────────────
    //
    // Full-screen list of all tasks with complete/edit/add actions.
    // Shown when show-task-view is true. Ring and dialog overlay above it.
    task-view := Rectangle {
        visible: root.show-task-view;
        x: root.nav-w; y: status-bar.height;
        width: parent.width - root.nav-w;
        height: parent.height - status-bar.height - toolbar.height;
        background: EinkTheme.canvas-bg;
        clip: true;

        VerticalLayout {
            padding: 0px;
            spacing: 0px;

            // Header: title + add + back buttons
            Rectangle {
                height: 44px;
                background: EinkTheme.canvas-bg;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 6px;
                    padding-bottom: 6px;
                    spacing: 8px;
                    alignment: start;

                    Text {
                        text: "All Tasks";
                        font-size: 16px;
                        font-weight: 700;
                        color: EinkTheme.btn-fg;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    Rectangle {
                        width: 60px; height: 32px;
                        background: EinkTheme.btn-bg;
                        border-radius: 4px;
                        border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        Text {
                            text: "+ Add";
                            font-size: 13px;
                            color: EinkTheme.btn-fg;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            clicked => {
                                root.task-dialog-is-edit = false;
                                root.task-dialog-id = "";
                                root.task-dialog-title = "New Task";
                                root.task-dialog-priority = 1;
                                root.task-dialog-visible = true;
                            }
                        }
                    }

                    Rectangle {
                        width: 56px; height: 32px;
                        background: EinkTheme.btn-bg;
                        border-radius: 4px;
                        border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        Text {
                            text: "Back";
                            font-size: 13px;
                            color: EinkTheme.btn-fg;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea { clicked => { root.task-back-tapped(); } }
                    }
                }
            }

            Rectangle { height: 2px; background: EinkTheme.chrome-border; }

            // Task rows
            for item[i] in root.full-task-list: Rectangle {
                height: 56px;
                background: transparent;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 8px;
                    alignment: start;

                    // Checkbox
                    Rectangle {
                        width: 36px; height: 36px;
                        border-radius: 4px;
                        border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        background: item.done ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                        Text {
                            text: item.done ? "v" : "";
                            font-size: 13px;
                            color: EinkTheme.btn-active-fg;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea { clicked => { root.task-complete-toggled(item.id); } }
                    }

                    // Priority badge
                    Text {
                        text: item.priority-label;
                        font-size: 13px;
                        color: EinkTheme.btn-fg;
                        vertical-alignment: center;
                        width: 28px;
                        horizontal-alignment: center;
                    }

                    // Title
                    Text {
                        text: item.title;
                        font-size: 14px;
                        color: EinkTheme.btn-fg;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }

                    // Due label
                    Text {
                        text: item.due-label;
                        font-size: 12px;
                        color: item.overdue ? EinkTheme.danger-fg : EinkTheme.text-secondary;
                        vertical-alignment: center;
                        width: 52px;
                        horizontal-alignment: right;
                    }

                    // Edit button
                    Rectangle {
                        width: 56px; height: 40px;
                        background: EinkTheme.btn-bg;
                        border-radius: 4px;
                        border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        Text {
                            text: "Edit";
                            font-size: 13px;
                            color: EinkTheme.btn-fg;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea { clicked => { root.task-edit-requested(item.id); } }
                    }
                }

                Rectangle {
                    x: 0; y: parent.height - 1px;
                    width: parent.width; height: 1px;
                    background: EinkTheme.chrome-border;
                    opacity: 0.3;
                }
            }

            // Empty state
            if root.full-task-list.length == 0: Rectangle {
                height: 60px;
                background: transparent;
                Text {
                    text: "No tasks yet — tap + Add to create one";
                    font-size: 14px;
                    color: EinkTheme.text-secondary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }

    // ── Note list / browser view ─────────────────────────────────────────────
    //
    // Shown when show-note-list is true.  Lists all notes (title + date) and
    // provides a "+ New Note" button.  Occupies the content area to the right of
    // the nav rail.
    note-list-view := Rectangle {
        visible: root.show-note-list;
        x: root.nav-w; y: status-bar.height;
        width: parent.width - root.nav-w;
        height: parent.height - status-bar.height - toolbar.height;
        background: EinkTheme.canvas-bg;
        clip: true;

        VerticalLayout {
            padding: 0px; spacing: 0px;

            // Header: title + "+ New Note" button
            Rectangle {
                height: 44px;
                background: EinkTheme.canvas-bg;
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px;
                    padding-top: 6px; padding-bottom: 6px;
                    spacing: 8px;

                    Text {
                        text: "Notes";
                        font-size: 16px; font-weight: 700;
                        color: EinkTheme.btn-fg;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    Rectangle {
                        width: 96px; height: 32px;
                        background: EinkTheme.btn-active-bg;
                        border-radius: 4px; border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        Text {
                            text: "+ New Note";
                            font-size: 13px; color: EinkTheme.btn-active-fg;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                        TouchArea { clicked => { root.note-new-tapped(); } }
                    }
                }
            }

            Rectangle { height: 2px; background: EinkTheme.chrome-border; }

            for note[i] in root.note-list: Rectangle {
                height: 56px;
                background: EinkTheme.canvas-bg;

                HorizontalLayout {
                    padding-left: 16px; padding-right: 8px;
                    padding-top: 10px; padding-bottom: 10px;
                    spacing: 8px;

                    // Tappable title + date area
                    Rectangle {
                        horizontal-stretch: 1;
                        background: transparent;

                        VerticalLayout {
                            spacing: 4px;
                            alignment: center;

                            Text {
                                text: note.title;
                                font-size: 14px; color: EinkTheme.btn-fg;
                                overflow: elide;
                            }
                            Text {
                                text: note.date-label;
                                font-size: 11px; color: EinkTheme.text-secondary;
                            }
                        }
                        TouchArea { clicked => { root.note-tapped(note.id); } }
                    }

                    // Rename button
                    Rectangle {
                        width: 64px; height: 36px;
                        background: EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        Text {
                            text: "Rename";
                            font-size: 11px; color: EinkTheme.btn-fg;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                        TouchArea {
                            clicked => {
                                root.note-rename-id = note.id;
                                root.note-rename-title = note.title;
                                root.note-rename-visible = true;
                            }
                        }
                    }
                }

                Rectangle {
                    x: 0; y: parent.height - 1px;
                    width: parent.width; height: 1px;
                    background: EinkTheme.chrome-border; opacity: 0.3;
                }
            }

            if root.note-list.length == 0: Rectangle {
                height: 80px;
                background: EinkTheme.canvas-bg;
                Text {
                    text: "No notes yet — tap + New Note";
                    font-size: 14px; color: EinkTheme.text-secondary;
                    horizontal-alignment: center; vertical-alignment: center;
                }
            }
        }
    }

    // ── Left navigation rail ─────────────────────────────────────────────────
    //
    // Always-visible 80px left strip that provides top-level navigation.
    // Declared after all content views so it sits on top of them, but before
    // ring-backdrop so the ring can float above it when visible.
    nav-rail := Rectangle {
        x: 0;
        y: status-bar.height;
        width: root.nav-w;
        height: parent.height - status-bar.height - toolbar.height;
        background: EinkTheme.chrome-bg;
        clip: true;

        VerticalLayout {
            padding: 0px; spacing: 0px;

            // Home / Overview item
            Rectangle {
                height: 72px;
                background: root.nav-section == 0 ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;

                VerticalLayout {
                    padding: 8px; spacing: 4px;
                    alignment: center;
                    Text {
                        text: "Home";
                        font-size: 12px;
                        color: root.nav-section == 0 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                        horizontal-alignment: center;
                    }
                }
                TouchArea {
                    clicked => {
                        root.nav-section = 0;
                        root.nav-overview-tapped();
                    }
                }
            }

            Rectangle { height: 1px; background: EinkTheme.chrome-border; }

            // Notes item
            Rectangle {
                height: 72px;
                background: root.nav-section == 1 ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;

                VerticalLayout {
                    padding: 8px; spacing: 4px;
                    alignment: center;
                    Text {
                        text: "Notes";
                        font-size: 12px;
                        color: root.nav-section == 1 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                        horizontal-alignment: center;
                    }
                }
                TouchArea {
                    clicked => {
                        root.nav-section = 1;
                        root.nav-notes-tapped();
                    }
                }
            }

            // Spacer fills remaining height
            Rectangle { vertical-stretch: 1; background: EinkTheme.chrome-bg; }
        }

        // Right border line
        Rectangle {
            x: root.nav-w - 2px; y: 0;
            width: 2px;
            height: parent.height;
            background: EinkTheme.chrome-border;
        }
    }

    // ── Action ring overlay ──────────────────────────────────────────────────
    //
    // Shown when Action::OpenActionRing fires (pen-button + tap via ActionRouter).
    // Four large eink-friendly buttons arranged in a cross around (ring-cx, ring-cy)
    // in canvas-relative coordinates.  A full-canvas backdrop captures taps outside
    // any button and dismisses the ring.
    //
    // Z-order: declared after nav-rail so the ring floats above it.
    ring-backdrop := Rectangle {
        visible: root.ring-visible;
        x: 0px;
        y: status-bar.height;
        width: parent.width;
        height: parent.height - status-bar.height - toolbar.height;

        // Tap outside any button dismisses the ring.
        TouchArea {
            clicked => { root.ring-dismissed(); }
        }

        // Note — top
        Rectangle {
            x: root.ring-cx * 1px - 50px;
            y: root.ring-cy * 1px - 96px;
            width: 100px; height: 48px;
            background: EinkTheme.btn-bg;
            border-radius: 6px;
            border-width: 2px;
            border-color: EinkTheme.btn-border;
            Text {
                text: "Note";
                font-size: 14px; color: EinkTheme.btn-fg;
                horizontal-alignment: center; vertical-alignment: center;
            }
            TouchArea { clicked => { root.ring-note-tapped(); } }
        }

        // Calendar — right
        Rectangle {
            x: root.ring-cx * 1px + 56px;
            y: root.ring-cy * 1px - 24px;
            width: 100px; height: 48px;
            background: EinkTheme.btn-bg;
            border-radius: 6px;
            border-width: 2px;
            border-color: EinkTheme.btn-border;
            Text {
                text: "Event";
                font-size: 14px; color: EinkTheme.btn-fg;
                horizontal-alignment: center; vertical-alignment: center;
            }
            TouchArea { clicked => { root.ring-calendar-tapped(); } }
        }

        // Task — bottom
        Rectangle {
            x: root.ring-cx * 1px - 50px;
            y: root.ring-cy * 1px + 48px;
            width: 100px; height: 48px;
            background: EinkTheme.btn-bg;
            border-radius: 6px;
            border-width: 2px;
            border-color: EinkTheme.btn-border;
            Text {
                text: "Task";
                font-size: 14px; color: EinkTheme.btn-fg;
                horizontal-alignment: center; vertical-alignment: center;
            }
            TouchArea { clicked => { root.ring-task-tapped(); } }
        }

        // Audio — left (hidden on devices without a microphone)
        Rectangle {
            visible: root.ring-show-audio;
            x: root.ring-cx * 1px - 156px;
            y: root.ring-cy * 1px - 24px;
            width: 100px; height: 48px;
            background: EinkTheme.btn-bg;
            border-radius: 6px;
            border-width: 2px;
            border-color: EinkTheme.btn-border;
            Text {
                text: "Audio";
                font-size: 14px; color: EinkTheme.btn-fg;
                horizontal-alignment: center; vertical-alignment: center;
            }
            TouchArea { clicked => { root.ring-audio-tapped(); } }
        }

        // Centre dismiss button — filled black/white for visual prominence.
        Rectangle {
            x: root.ring-cx * 1px - 24px;
            y: root.ring-cy * 1px - 24px;
            width: 48px; height: 48px;
            background: EinkTheme.btn-active-bg;
            border-radius: 24px;
            border-width: 2px;
            border-color: EinkTheme.btn-border;
            Text {
                text: "x";
                font-size: 18px; color: EinkTheme.btn-active-fg;
                horizontal-alignment: center; vertical-alignment: center;
            }
            TouchArea { clicked => { root.ring-dismissed(); } }
        }
    }

    // ── Settings view ────────────────────────────────────────────────────────
    //
    // Full-page view for configuring vault path, calendar sources, and theme.
    // Shown when show-settings is true.  Declared before the task dialog so
    // the dialog still floats above it when both are visible (edge case).
    settings-view := Rectangle {
        visible: root.show-settings;
        x: root.nav-w; y: status-bar.height;
        width: parent.width - root.nav-w;
        height: parent.height - status-bar.height - toolbar.height;
        background: EinkTheme.canvas-bg;
        clip: true;

        VerticalLayout {
            padding: 0px;
            spacing: 0px;

            // Header: Back + title + Save
            Rectangle {
                height: 44px;
                background: EinkTheme.canvas-bg;
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px;
                    padding-top: 6px; padding-bottom: 6px;
                    spacing: 8px;

                    Rectangle {
                        width: 56px; height: 32px;
                        background: EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        Text { text: "Back"; font-size: 13px; color: EinkTheme.btn-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.settings-back(); } }
                    }

                    Text {
                        text: "Settings";
                        font-size: 16px; font-weight: 700;
                        color: EinkTheme.btn-fg;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        horizontal-alignment: center;
                    }

                    Rectangle {
                        width: 56px; height: 32px;
                        background: EinkTheme.btn-active-bg;
                        border-radius: 4px; border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        Text { text: "Save"; font-size: 13px; color: EinkTheme.btn-active-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.settings-save(); } }
                    }
                }
            }

            Rectangle { height: 2px; background: EinkTheme.chrome-border; }

            // Theme row
            Rectangle {
                height: 44px;
                background: EinkTheme.canvas-bg;
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px;
                    padding-top: 6px; padding-bottom: 6px;
                    spacing: 8px;

                    Text {
                        text: "Theme";
                        font-size: 14px; color: EinkTheme.btn-fg;
                        vertical-alignment: center;
                        width: 80px;
                    }

                    Rectangle {
                        width: 72px; height: 32px;
                        background: root.settings-theme-idx == 0 ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        Text { text: "Light"; font-size: 13px;
                               color: root.settings-theme-idx == 0 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.settings-theme-idx = 0; } }
                    }

                    Rectangle {
                        width: 72px; height: 32px;
                        background: root.settings-theme-idx == 1 ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        Text { text: "Dark"; font-size: 13px;
                               color: root.settings-theme-idx == 1 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.settings-theme-idx = 1; } }
                    }

                    Rectangle { horizontal-stretch: 1; }
                }
            }

            Rectangle { height: 2px; background: EinkTheme.chrome-border; }

            // Vault row
            Rectangle {
                height: 48px;
                background: EinkTheme.canvas-bg;
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px;
                    padding-top: 6px; padding-bottom: 6px;
                    spacing: 8px;

                    Text {
                        text: "Vault";
                        font-size: 14px; color: EinkTheme.btn-fg;
                        vertical-alignment: center;
                        width: 56px;
                    }

                    Text {
                        text: root.settings-vault-path == "" ? "Not configured" : root.settings-vault-path;
                        font-size: 11px;
                        color: root.settings-vault-path == "" ? EinkTheme.text-secondary : EinkTheme.btn-fg;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }

                    if root.settings-vault-path != "": Rectangle {
                        width: 52px; height: 32px;
                        background: EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        Text { text: "Clear"; font-size: 12px; color: EinkTheme.btn-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.settings-clear-vault(); } }
                    }

                    Rectangle {
                        width: 76px; height: 32px;
                        background: EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        Text { text: "Browse..."; font-size: 12px; color: EinkTheme.btn-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.settings-browse-vault(); } }
                    }
                }
            }

            Rectangle { height: 2px; background: EinkTheme.chrome-border; }

            // Calendar section header
            Rectangle {
                height: 36px;
                background: EinkTheme.canvas-bg;
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px;
                    padding-top: 4px; padding-bottom: 4px;
                    Text {
                        text: "Calendar Sources";
                        font-size: 14px; font-weight: 700;
                        color: EinkTheme.btn-fg;
                        vertical-alignment: center;
                    }
                }
            }

            // Cal source rows
            for src[i] in root.settings-cal-sources: Rectangle {
                height: 40px;
                background: EinkTheme.canvas-bg;
                HorizontalLayout {
                    padding-left: 20px; padding-right: 12px;
                    padding-top: 4px; padding-bottom: 4px;
                    spacing: 8px;
                    Text {
                        text: src.display;
                        font-size: 12px; color: EinkTheme.btn-fg;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    Rectangle {
                        width: 36px; height: 32px;
                        background: EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        Text { text: "x"; font-size: 14px; color: EinkTheme.danger-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.settings-remove-source(i); } }
                    }
                }
                Rectangle {
                    x: 0; y: parent.height - 1px;
                    width: parent.width; height: 1px;
                    background: EinkTheme.chrome-border; opacity: 0.3;
                }
            }

            // Empty cal source state
            if root.settings-cal-sources.length == 0: Rectangle {
                height: 32px;
                background: EinkTheme.canvas-bg;
                Text {
                    x: 20px; y: 0; width: parent.width - 20px; height: parent.height;
                    text: "No sources configured";
                    font-size: 12px; color: EinkTheme.text-secondary;
                    vertical-alignment: center;
                }
            }

            // Browse .ics + Add URL row
            Rectangle {
                height: 44px;
                background: EinkTheme.canvas-bg;
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px;
                    padding-top: 6px; padding-bottom: 6px;
                    spacing: 8px;
                    Rectangle {
                        width: 120px; height: 32px;
                        background: EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        Text { text: "Browse .ics..."; font-size: 12px; color: EinkTheme.btn-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.settings-browse-ics(); } }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }

            // Add URL row
            Rectangle {
                height: 48px;
                background: EinkTheme.canvas-bg;
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px;
                    padding-top: 6px; padding-bottom: 6px;
                    spacing: 8px;

                    Text {
                        text: "Add URL";
                        font-size: 12px; color: EinkTheme.text-secondary;
                        vertical-alignment: center;
                        width: 52px;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 36px;
                        border-radius: 4px; border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        background: EinkTheme.canvas-bg;

                        TextInput {
                            x: 6px; y: 0;
                            width: parent.width - 12px;
                            height: parent.height;
                            font-size: 12px;
                            color: EinkTheme.btn-fg;
                            text <=> root.settings-new-url;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        width: 44px; height: 36px;
                        background: EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        Text { text: "Add"; font-size: 12px; color: EinkTheme.btn-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.settings-add-url(root.settings-new-url); } }
                    }
                }
            }
        }
    }

    // ── File browser view ────────────────────────────────────────────────────
    //
    // Lets the user navigate the filesystem to select an Obsidian vault folder
    // (fb-vault-mode = true) or an .ics calendar file (fb-vault-mode = false).
    fb-view := Rectangle {
        visible: root.show-filebrowser;
        x: root.nav-w; y: status-bar.height;
        width: parent.width - root.nav-w;
        height: parent.height - status-bar.height - toolbar.height;
        background: EinkTheme.canvas-bg;
        clip: true;

        VerticalLayout {
            padding: 0px; spacing: 0px;

            // Header: Back + current path
            Rectangle {
                height: 44px;
                background: EinkTheme.canvas-bg;
                HorizontalLayout {
                    padding-left: 8px; padding-right: 12px;
                    padding-top: 6px; padding-bottom: 6px;
                    spacing: 8px;

                    Rectangle {
                        width: 56px; height: 32px;
                        background: EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        Text { text: "Back"; font-size: 13px; color: EinkTheme.btn-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.fb-cancel(); } }
                    }

                    Text {
                        text: root.fb-current-path;
                        font-size: 11px; color: EinkTheme.text-secondary;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                }
            }

            Rectangle { height: 2px; background: EinkTheme.chrome-border; }

            // Select-as-vault button (vault mode only)
            if root.fb-vault-mode: Rectangle {
                height: 44px;
                background: EinkTheme.canvas-bg;
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px;
                    padding-top: 6px; padding-bottom: 6px;

                    Rectangle {
                        width: 240px; height: 32px;
                        background: EinkTheme.btn-active-bg;
                        border-radius: 4px; border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        Text { text: "Select this folder as Vault";
                               font-size: 12px; color: EinkTheme.btn-active-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.fb-select-vault(root.fb-current-path); } }
                    }

                    Rectangle { horizontal-stretch: 1; }
                }
            }

            // Directory / file entries
            for entry[i] in root.fb-entries: Rectangle {
                height: 44px;
                background: EinkTheme.canvas-bg;

                // Directory tap → navigate (covered by the HorizontalLayout above)
                if entry.is-dir: TouchArea {
                    clicked => { root.fb-navigate(entry.full-path); }
                }

                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px;
                    padding-top: 4px; padding-bottom: 4px;
                    spacing: 8px;

                    // Type indicator
                    Text {
                        text: entry.is-dir ? (entry.name == ".." ? ".." : (entry.is-vault ? "[V]" : "[D]")) : "[F]";
                        font-size: 12px; color: EinkTheme.text-secondary;
                        vertical-alignment: center;
                        width: 28px;
                        horizontal-alignment: center;
                    }

                    // Name
                    Text {
                        text: entry.name;
                        font-size: 14px; color: EinkTheme.btn-fg;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }

                    // Vault indicator label
                    if entry.is-vault: Text {
                        text: "vault";
                        font-size: 11px; color: EinkTheme.text-secondary;
                        vertical-alignment: center;
                        width: 44px;
                    }

                    // Add button for .ics files in ICS mode
                    if !root.fb-vault-mode && !entry.is-dir: Rectangle {
                        width: 56px; height: 32px;
                        background: EinkTheme.btn-active-bg;
                        border-radius: 4px; border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        Text { text: "Add"; font-size: 12px; color: EinkTheme.btn-active-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.fb-add-ics(entry.full-path); } }
                    }
                }

                Rectangle {
                    x: 0; y: parent.height - 1px;
                    width: parent.width; height: 1px;
                    background: EinkTheme.chrome-border; opacity: 0.3;
                }
            }

            // Empty state when no entries (e.g. empty dir or permission denied)
            if root.fb-entries.length == 0: Rectangle {
                height: 48px;
                background: EinkTheme.canvas-bg;
                Text {
                    text: "Empty folder";
                    font-size: 13px; color: EinkTheme.text-secondary;
                    horizontal-alignment: center; vertical-alignment: center;
                }
            }
        }
    }

    // ── Task add / edit dialog ───────────────────────────────────────────────
    //
    // Modal overlay for creating a new task or editing an existing one.
    // Shown above all other layers (declared last).
    task-dialog := Rectangle {
        visible: root.task-dialog-visible;
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        background: EinkTheme.chrome-bg;
        opacity: 0.95;

        // Dialog panel
        Rectangle {
            x: (parent.width - 420px) / 2;
            y: (parent.height - 300px) / 2;
            width: 420px;
            height: 300px;
            background: EinkTheme.canvas-bg;
            border-radius: 8px;
            border-width: 3px;
            border-color: EinkTheme.chrome-border;

            VerticalLayout {
                padding: 20px;
                spacing: 14px;

                // Dialog title
                Text {
                    text: root.task-dialog-is-edit ? "Edit Task" : "New Task";
                    font-size: 16px;
                    font-weight: 700;
                    color: EinkTheme.btn-fg;
                    horizontal-alignment: center;
                }

                // Title display (read-only; set programmatically before opening)
                Rectangle {
                    height: 48px;
                    border-radius: 4px;
                    border-width: 2px;
                    border-color: EinkTheme.btn-border;
                    background: EinkTheme.canvas-bg;

                    Text {
                        x: 8px;
                        y: 0px;
                        width: parent.width - 16px;
                        height: parent.height;
                        font-size: 14px;
                        color: EinkTheme.btn-fg;
                        text: root.task-dialog-title;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                // Priority selector
                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;

                    Rectangle {
                        width: 80px; height: 34px;
                        background: root.task-dialog-priority == 0 ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                        border-radius: 4px;
                        border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        Text {
                            text: "High";
                            font-size: 13px;
                            color: root.task-dialog-priority == 0 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea { clicked => { root.task-dialog-priority = 0; } }
                    }

                    Rectangle {
                        width: 80px; height: 34px;
                        background: root.task-dialog-priority == 1 ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                        border-radius: 4px;
                        border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        Text {
                            text: "Medium";
                            font-size: 13px;
                            color: root.task-dialog-priority == 1 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea { clicked => { root.task-dialog-priority = 1; } }
                    }

                    Rectangle {
                        width: 80px; height: 34px;
                        background: root.task-dialog-priority == 2 ? EinkTheme.btn-active-bg : EinkTheme.btn-bg;
                        border-radius: 4px;
                        border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        Text {
                            text: "Low";
                            font-size: 13px;
                            color: root.task-dialog-priority == 2 ? EinkTheme.btn-active-fg : EinkTheme.btn-fg;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea { clicked => { root.task-dialog-priority = 2; } }
                    }
                }

                // Action buttons
                HorizontalLayout {
                    spacing: 16px;
                    alignment: center;

                    Rectangle {
                        width: 120px; height: 48px;
                        background: EinkTheme.btn-bg;
                        border-radius: 4px;
                        border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        Text {
                            text: "Cancel";
                            font-size: 15px;
                            color: EinkTheme.btn-fg;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea { clicked => { root.task-dialog-cancel(); } }
                    }

                    Rectangle {
                        width: 120px; height: 48px;
                        background: EinkTheme.btn-active-bg;
                        border-radius: 4px;
                        border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        Text {
                            text: "Save";
                            font-size: 15px;
                            color: EinkTheme.btn-active-fg;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            clicked => {
                                if (root.task-dialog-is-edit) {
                                    root.task-confirm-edit(root.task-dialog-id, root.task-dialog-title, root.task-dialog-priority);
                                } else {
                                    root.task-confirm-add(root.task-dialog-title, root.task-dialog-priority);
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ── Note rename dialog ───────────────────────────────────────────────────
    //
    // Simple modal overlay with a TextInput for the new note title.
    // Declared last (highest z-order).
    note-rename-dialog := Rectangle {
        visible: root.note-rename-visible;
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        background: EinkTheme.chrome-bg;
        opacity: 0.95;

        Rectangle {
            x: (parent.width - 380px) / 2;
            y: (parent.height - 200px) / 2;
            width: 380px; height: 200px;
            background: EinkTheme.canvas-bg;
            border-radius: 8px;
            border-width: 3px;
            border-color: EinkTheme.chrome-border;

            VerticalLayout {
                padding: 20px; spacing: 14px;

                Text {
                    text: "Rename Note";
                    font-size: 16px; font-weight: 700;
                    color: EinkTheme.btn-fg;
                    horizontal-alignment: center;
                }

                Rectangle {
                    height: 44px;
                    border-radius: 4px; border-width: 2px;
                    border-color: EinkTheme.btn-border;
                    background: EinkTheme.canvas-bg;

                    TextInput {
                        x: 8px; y: 0;
                        width: parent.width - 16px;
                        height: parent.height;
                        font-size: 14px;
                        color: EinkTheme.btn-fg;
                        text <=> root.note-rename-title;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 12px; alignment: center;

                    Rectangle {
                        width: 110px; height: 42px;
                        background: EinkTheme.btn-bg;
                        border-radius: 4px; border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        Text { text: "Cancel"; font-size: 14px; color: EinkTheme.btn-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.note-rename-cancel(); } }
                    }

                    Rectangle {
                        width: 110px; height: 42px;
                        background: EinkTheme.btn-active-bg;
                        border-radius: 4px; border-width: 2px;
                        border-color: EinkTheme.btn-border;
                        Text { text: "Rename"; font-size: 14px; color: EinkTheme.btn-active-fg;
                               horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea {
                            clicked => {
                                root.note-rename-confirm(root.note-rename-id, root.note-rename-title);
                            }
                        }
                    }
                }
            }
        }
    }
}
